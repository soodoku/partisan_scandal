 be rehiring.]  [AG Edwards oil analyst Bill O'GRADY\u2020- says rising demand leads to rising prices.]", "segment_duration": 120, "segment_type_id": 2, "segment_start_time": "63780.0", "legacy_segment_id": 763484, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "1SY1K5Ig9t", "broadcast_date": "2004-08-21", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 763477, "segment_id": "ASi4zsIIg0", "segment_broadcast_id": "1SY1K5Ig9t", "segment_title": "Upcoming Items (Studio: Sharyl Attkisson)", "segment_description": "null", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "63900.0", "legacy_segment_id": 763485, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "1SY1K5Ig9t", "broadcast_date": "2004-08-21", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 763477, "segment_id": "ovnlfCOyRB", "segment_broadcast_id": "1SY1K5Ig9t", "segment_title": "(Commercial: Ex-Lax; Thompson's Water Seal; Dr. Scholl's; Singulair; Pfizer's Viagra; Prilosec; \"Face the Nation\")", "segment_description": "null", "segment_duration": 160, "segment_type_id": 3, "segment_start_time": "63910.0", "legacy_segment_id": 763486, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_