uration": 270, "segment_type_id": 2, "segment_start_time": "63770.0", "legacy_segment_id": 909833, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "Yk3dIV20nP", "broadcast_date": "2008-10-29", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1730, "broadcast_description": null, "legacy_broadcast_id": 909827, "segment_id": "m2lgcPh6b3", "segment_broadcast_id": "Yk3dIV20nP", "segment_title": "Upcoming Items (Studio: Katie Couric)", "segment_description": " ", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "64040.0", "legacy_segment_id": 909834, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "Yk3dIV20nP", "broadcast_date": "2008-10-29", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1730, "broadcast_description": null, "legacy_broadcast_id": 909827, "segment_id": "NpJ5NS5RUt", "segment_broadcast_id": "Yk3dIV20nP", "segment_title": "(Commercial: Smucker's; d-CON; Swanson; Just for Men; Glad; Healthy Choice; Tom DuBois; NewsChannel 5/\"Rachael Ray\")", "segment_description": " ", "segment_duration": 150, "segment_type_id": 3, "segment_start_time": "64050.0", "legacy_segment_id": 909835, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "Yk3dIV20nP", "broadcast_date": "2008-10-29", "