{"data": [{"broadcast_id": "6C5S6YYiJY", "broadcast_date": "2004-07-29", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 761055, "segment_id": "evEqpWwh82", "segment_broadcast_id": "6C5S6YYiJY", "segment_title": "Preview/Introduction Dan Rather (Democratic National Convention in Boston)", "segment_description": "null", "segment_duration": 50, "segment_type_id": 1, "segment_start_time": "63000.0", "legacy_segment_id": 761055, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Preview", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "6C5S6YYiJY", "broadcast_date": "2004-07-29", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 761055, "segment_id": "eB4MyKu5MX", "segment_broadcast_id": "6C5S6YYiJY", "segment_title": "Campaign 04 / Democratic Convention / Kerry", "segment_description": "(Boston: Dan Rather) Report introduced. \n (Convention floor: Byron Pitts) Senator John Kerry\u2019s appearance tonight at the Democratic National Convention featured; scenes shown of Kerry testing the podium this morning and biking in Boston; excerpts from Kerry\u2019s speech, which is expected to highlight national security, quoted; Kerry campaign video, meant to introduce him to America, shown. [In Virginia, New Jersey, & Georgia, undecided voters Michael OSBORNE&#134;, Kathleen GILLIGAN&#134;, Carlie BULLOCK-JONES&#134;- explain what they want to hear from Kerry.] \n (Boston: Dan Rather) Report introduced. \n (Convention floor: John Roberts) The success of the convention and the Democrats\u2019 positive message examined; details given of the Republicans\u2019 continuing attacks on Kerry and their characterization of the convention as a failure. [Last night, Senator John EDWARDS \u2013 says hope is on the way; calls Kerry decisive & strong.] [Kennedy School of Government David GERGEN&#134;- notes the view that the Democrats should have made the case against President Bush\u2019s administration in a more slashing way.] [Former New York City Mayor Rudolph GIULIANI \u2013 comments on Kerry\u2019s inconsistent Senate career with regard to terror.] [Last night, former candidate Rev. Al SHARPTON&#134;- criticizes Bush\u2019s decision to go to war in Iraq.] \n (Boston: Dan Rather, Bob Schieffer) The decision for Kerry\u2019s speech to focus on national security and the difficult task of convincing voters to change leaders in this time of war discussed. CBS coverage of Kerry\u2019s acceptance speech noted.", "segment_duration": 360, "segment_type_id": 2, "segment_start_time": "63050.0", "legacy_segment_id": 761056, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "6C5S6YYiJY", "broadcast_date": "2004-07-29", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 761055, "segment_id": "0VxmheXDCz", "segment_broadcast_id": "6C5S6YYiJY", "segment_title": "Pakistan / Al Qaeda / Ghailani Capture", "segment_description": "(Boston: Dan Rather) The capture in Pakistan of Tanzanian-born Al Qaeda operative Ahmed Ghailani&#134;, who is wanted for the 1998 bombings of US embassies in Africa, reported; scenes shown from the site of a raid in Gujrat, Pakistan.", "segment_duration": 30, "segment_type_id": 2, "segment_start_time": "63410.0", "legacy_segment_id": 761057, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "6C5S6YYiJY", "broadcast_date": "2004-07-29", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 761055, "segment_id": "SY83I1sW7k", "segment_broadcast_id": "6C5S6YYiJY", "segment_title": "Iraq / Attacks", "segment_description": "(Boston: Dan Rather) A US air strike in Fallujah and the death of an American soldier fighting in Iraq reported.", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "63440.0", "legacy_segment_id": 761058, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "6C5S6YYiJY", "broadcast_date": "2004-07-29", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 761055, "segment_id": "BAf6GuCsqh", "segment_broadcast_id": "6C5S6YYiJY", "segment_title": "FBI / Whistleblower", "segment_description": "(Boston: Dan Rather) Report introduced.   (FBI: Jim Stewart) Charges by former FBI interpreter Sibel Edmonds&#134; that she was fired partly because she blew the whistle on incompetent workers featured; details given of a letter from FBI director Robert Mueller confirming that a factor in Edmonds\u2019 firing was because she accused the bureau of ineptitude. [EDMONDS \u2013 states the problems involved security breaches & incompetence in the translation unit; says she was warned against making the matters public.]", "segment_duration": 120, "segment_type_id": 2, "segment_start_time": "63450.0", "legacy_segment_id": 761059, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "6C5S6YYiJY", "broadcast_date": "2004-07-29", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 761055, "segment_id": "eMj1B3Iko6", "segment_broadcast_id": "6C5S6YYiJY", "segment_title": "Weather / Floods", "segment_description": "(Boston: Dan Rather) Report introduced.   (New York: Jim Acosta) Flash flooding brought on by torrential rains in Texas & South Carolina featured; scenes shown of a man being rescued from rushing water, and flooding in Dallas and Greeneville, South Carolina. [In Dallas, MAN, flood victims Esther WILLIAMS&#134;, Cruz LOPEZ&#134;, emergency WORKER&nbsp- react.]", "segment_duration": 90, "segment_type_id": 2, "segment_start_time": "63570.0", "legacy_segment_id": 761060, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "6C5S6YYiJY", "broadcast_date": "2004-07-29", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 761055, "segment_id": "Vz26Noiqbb", "segment_broadcast_id": "6C5S6YYiJY", "segment_title": "Upcoming Items; fallen soldier Army 1st Lt. Erik McCrae&#134<!-- spelling on screen --> profiled. (Studio: Dan Rather)", "segment_description": "null", "segment_duration": 50, "segment_type_id": 2, "segment_start_time": "63660.0", "legacy_segment_id": 761061, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "6C5S6YYiJY", "broadcast_date": "2004-07-29", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 761055, "segment_id": "60UDwKCAXZ", "segment_broadcast_id": "6C5S6YYiJY", "segment_title": "(Commercial: Singulair; Olay; Oral-B; Viactiv; Drano.)", "segment_description": "null", "segment_duration": 160, "segment_type_id": 3, "segment_start_time": "63710.0", "legacy_segment_id": 761062, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "6C5S6YYiJY", "broadcast_date": "2004-07-29", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 761055, "segment_id": "g4mkuAmLX4", "segment_broadcast_id": "6C5S6YYiJY", "segment_title": "Inside Story (Kerry\u2019s Band of Brothers)", "segment_description": "(Boston: Dan Rather) Senator John Kerry\u2019s first appearance in the Senate, as a witness giving testimony about jungle combat in 1971, noted. The men who served with Kerry in the Vietnam War, some of whom will be on stage with Kerry at the Democratic National Convention tonight, featured; photos & footage shown. [KERRY \u2013 states he is proud of being a war hero and an anti-war leader.] [Kerry crewmates Del SANDUSKY&#134;, Jim WASSER&#134;- talk about Kerry\u2019s leadership & character.] [Former Georgia Senator Max CLELAND&#134;- explains what veterans see in Kerry; responds to Republicans\u2019 criticism of Kerry\u2019s record on defense.]", "segment_duration": 190, "segment_type_id": 2, "segment_start_time": "63870.0", "legacy_segment_id": 761063, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "6C5S6YYiJY", "broadcast_date": "2004-07-29", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 761055, "segment_id": "kemmx7wJKc", "segment_broadcast_id": "6C5S6YYiJY", "segment_title": "Upcoming Items (Boston: Dan Rather)", "segment_description": "null", "segment_duration": 20, "segment_type_id": 2, "segment_start_time": "64060.0", "legacy_segment_id": 761064, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "6C5S6YYiJY", "broadcast_date": "2004-07-29", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 761055, "segment_id": "TmzZRffrzY", "segment_broadcast_id": "6C5S6YYiJY", "segment_title": "(Commercial: Your Credit Card Companies; Thompson\u2019s Water Seal; Fixodent; Ambien; Bush\u2019s Beans; \"CBS Evening News.\")", "segment_description": "null", "segment_duration": 170, "segment_type_id": 3, "segment_start_time": "64080.0", "legacy_segment_id": 761065, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "6C5S6YYiJY", "broadcast_date": "2004-07-29", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 761055, "segment_id": "IDR588uNb6", "segment_broadcast_id": "6C5S6YYiJY", "segment_title": "Market Watch: Russian Oil Industry, Stocks", "segment_description": "(Boston: Dan Rather) The Russian government\u2019s withdrawal of its threat to shut down its largest oil company noted; Stock Market Report.", "segment_duration": 20, "segment_type_id": 2, "segment_start_time": "64250.0", "legacy_segment_id": 761066, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "6C5S6YYiJY", "broadcast_date": "2004-07-29", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 761055, "segment_id": "4yGJxbvDPg", "segment_broadcast_id": "6C5S6YYiJY", "segment_title": "Florida / Voting Problems", "segment_description": "(Boston: Dan Rather) Report introduced. \n (Miami: Mark Strassmann) Continuing questions about the reliability of Florida\u2019s new touch-screen voting machines, prompting concerns about an election disaster like that in 2000, featured; details given of data that was lost in recent elections in Miami-Dade County; states that will use the machines in the November election listed; statement from manufacturer Election Systems & Software quoted. [Miami-Dade Elections Office Seth KAPLAN&#134;- says it\u2019s not appropriate to guess whose fault it might have been.] [Miami-Dade Election Reform Coalition Lida RODRIGUEZ-TASEFF&#134;- says we are dealing with machines that nobody understands.] [Electionline.org Doug CHAPIN&#134;- says any problem will probably be front-page news.]", "segment_duration": 120, "segment_type_id": 2, "segment_start_time": "64270.0", "legacy_segment_id": 761067, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "6C5S6YYiJY", "broadcast_date": "2004-07-29", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 761055, "segment_id": "nSdAIdc95e", "segment_broadcast_id": "6C5S6YYiJY", "segment_title": "Upcoming Items (Boston: Dan Rather)", "segment_description": "null", "segment_duration": 20, "segment_type_id": 2, "segment_start_time": "64390.0", "legacy_segment_id": 761068, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "6C5S6YYiJY", "broadcast_date": "2004-07-29", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 761055, "segment_id": "yZk0DYhFlq", "segment_broadcast_id": "6C5S6YYiJY", "segment_title": "(Commercial: Swiffer; Nexium; Capital One; Dasani; Serenity; NewsChannel 5.)", "segment_description": "null", "segment_duration": 160, "segment_type_id": 3, "segment_start_time": "64410.0", "legacy_segment_id": 761069, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "6C5S6YYiJY", "broadcast_date": "2004-07-29", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 761055, "segment_id": "PsyabY1dwn", "segment_broadcast_id": "6C5S6YYiJY", "segment_title": "Crick Death", "segment_description": "(Boston: Dan Rather) The death of scientist Francis Crick reported.   (New York: Elizabeth Kaledin) Crick\u2019s groundbreaking discovery, along with partner James Watson, of the structure of DNA featured; animations shown; details given of the effects on the modern world. [New York Academy of Sciences Ellis RUBINSTEIN&#134;- says they understood that the gene was at the basis of a lot of our afflictions.] [Weill-Cornell Medical College Dr. Ron CRYSTAL&#134;- says this was the sentinel discovery in our lifetimes in medicine.]", "segment_duration": 120, "segment_type_id": 2, "segment_start_time": "64570.0", "legacy_segment_id": 761070, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "6C5S6YYiJY", "broadcast_date": "2004-07-29", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 761055, "segment_id": "3oNyWXl0AW", "segment_broadcast_id": "6C5S6YYiJY", "segment_title": "Good Night", "segment_description": "null", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "64690.0", "legacy_segment_id": 761071, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}]}