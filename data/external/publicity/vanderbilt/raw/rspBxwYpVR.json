{"data": [{"broadcast_id": "rspBxwYpVR", "broadcast_date": "2004-07-25", "broadcast_start_time": "61200.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 760915, "segment_id": "iVcp0QmeOb", "segment_broadcast_id": "rspBxwYpVR", "segment_title": "Preview/Introduction Dan Rather (Democratic National Convention in Boston)", "segment_description": "null", "segment_duration": 40, "segment_type_id": 1, "segment_start_time": "61200.0", "legacy_segment_id": 760915, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Preview", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "rspBxwYpVR", "broadcast_date": "2004-07-25", "broadcast_start_time": "61200.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 760915, "segment_id": "EdwroZpYIA", "segment_broadcast_id": "rspBxwYpVR", "segment_title": "Campaign 2004 / Bush vs. Kerry / Democratic Convention / The Delegates / Boston / Security / Edwards Interview", "segment_description": "(Boston: Dan Rather)  Report introduced. \n (Boston: John Roberts)  Findings of a CBS News/\"New York Times\" poll on the \"moderate\" nature of the Democratic National Convention delegates noted; scenes shown of delegates; poll statistics cited on the delegates.  [Maryland delegate Tom DOLINA&#134;, Virginia delegate Audrey COLLINS&#134;, Missouri delegate  Juanita CLARKE&#134;- comment.] \n (Boston: Dan Rather)  Report introduced. \n (Boston: Jim Axelrod)  The issue of the intense security in Boston for the convention this high-profile week featured; scenes shown of the subways, security perimeters, vehicles, the baseball brawl at Fenway Park.  [Boston police commission Kathleen O'TOOLE&#134;, Mayor Thomas MENINO&#134;- talk about the security plan.]  [Pizza shop owner Mark PASQUALE&#134;- reacts.] \n (Boston: Dan Rather)  Report introduced. \n (Columbus: Byron Pitts)  Senator John Kerry's campaigning in the battle ground state of Ohio featured; scenes shown from Columbus, Ohio.  [KERRY&nbsp- campaigns on the war on terror.]  [Voters Jessie AIKEN&#134;, Peter BRICKER&#134;- offer views on the two candidates.] \n (Boston: Dan Rather)  Taped interview held with vice presidential candidate Senator John Edwards.  [EDWARDS&nbsp- says national security is a huge issue; outlines the Democratic exit strategy for Iraq.]", "segment_duration": 510, "segment_type_id": 2, "segment_start_time": "61240.0", "legacy_segment_id": 760916, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "rspBxwYpVR", "broadcast_date": "2004-07-25", "broadcast_start_time": "61200.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 760915, "segment_id": "0qc0UFO5aY", "segment_broadcast_id": "rspBxwYpVR", "segment_title": "Upcoming Items (Boston: Dan Rather)", "segment_description": "null", "segment_duration": 20, "segment_type_id": 2, "segment_start_time": "61750.0", "legacy_segment_id": 760917, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "rspBxwYpVR", "broadcast_date": "2004-07-25", "broadcast_start_time": "61200.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 760915, "segment_id": "NlOjPBbjbs", "segment_broadcast_id": "rspBxwYpVR", "segment_title": "(Commercial: Just for Men; Olay; Celebrex; Nexium; Kraft dressing; Thompson's Water Seal; Ensure.)", "segment_description": "null", "segment_duration": 180, "segment_type_id": 3, "segment_start_time": "61770.0", "legacy_segment_id": 760918, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "rspBxwYpVR", "broadcast_date": "2004-07-25", "broadcast_start_time": "61200.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 760915, "segment_id": "dGzU95aaBp", "segment_broadcast_id": "rspBxwYpVR", "segment_title": "Iraq / Fighting", "segment_description": "(Boston: Dan Rather)  The battle in Iraq between US forces & Iraq police & insurgents & the death of a US soldier in Beiji reported; scenes shown from Buhriz.", "segment_duration": 30, "segment_type_id": 2, "segment_start_time": "61950.0", "legacy_segment_id": 760919, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "rspBxwYpVR", "broadcast_date": "2004-07-25", "broadcast_start_time": "61200.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 760915, "segment_id": "plooeegMAv", "segment_broadcast_id": "rspBxwYpVR", "segment_title": "Middle East / Israelis vs. Palestinians / Violence", "segment_description": "(Boston: Dan Rather)  A West Bank gun battle between Israeli soldiers & Palestinian militants reported; scenes shown from the Jewish settlement in Gaza that was hit by mortar shells & of an Israeli protest in Jerusalem against the planned Gaza withdrawal.", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "61980.0", "legacy_segment_id": 760920, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "rspBxwYpVR", "broadcast_date": "2004-07-25", "broadcast_start_time": "61200.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 760915, "segment_id": "MA3fcxHo8q", "segment_broadcast_id": "rspBxwYpVR", "segment_title": "Law / Medical Injury Lawsuits", "segment_description": "(Boston: Dan Rather)  Report introduced. \n (Philadelphia: Sharyn Alfonsi)  Efforts by President Bush's administration to block lawsuits by those claiming to be injured by prescription drugs or medical devices examined; details given of the argument that juries should not second guess the FDA's judgment.  [Suicide's father Tom WOODWARD&#134;- comments.]  [New York law school Harry WELLINGTON&#134;- calls it a shift in policy.]  [Former Bush adviser Jay LEFKOWITZ&#134;- comments on the fear of liability.]", "segment_duration": 120, "segment_type_id": 2, "segment_start_time": "61990.0", "legacy_segment_id": 760921, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "rspBxwYpVR", "broadcast_date": "2004-07-25", "broadcast_start_time": "61200.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 16