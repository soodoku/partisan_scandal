ion": 170, "segment_type_id": 3, "segment_start_time": "63930.0", "legacy_segment_id": 764872, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "h9hqBDmhll", "broadcast_date": "2004-09-09", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 764860, "segment_id": "f6dYIE7U3m", "segment_broadcast_id": "h9hqBDmhll", "segment_title": "A Closer Look (America Still at Risk: Lessons from Madrid) Part III", "segment_description": "(Studio: Peter Jennings)  A closer look at the lessons learned about terrorism from the train bombing in Madrid, Spain, introduced.   (Madrid: Jim Sciutto)  The lessons about railroad terrorism examined; scenes & diagrams shown from the March 11, 2004, bombings; details given about Al Qaeda capabilities on a local level & the impact of a terrorist attack on an election.  [Italian government public security undersecretary Alfredo MANTOVANO&#134;- {thru translator} talks about autonomous terrorist cells.]   (Studio: Peter Jennings)  A test of the damage from a single backpack explosive on a bus shown.   (Washington: Pierre Thomas)  An ABCNews hidden camera test to determine how easy it is to get a bomb onto a bus or train in a major American city presented; scenes shown from inside trains in suburban Maryland, Virginia & Washington, DC, & on which backpacks were left behind.  [Homeland security consultant Randall LARSEN&#134;- speculates on a terrorist successfully putting a bomb on a train.]  [Undersecretary of Homeland Security Asa HUTCHINSON&#134;- says the test confirms fears of vulnerability in the system.]  [American Public Transportation Assn. William MILLAR&#134;- says we need resources for security.]  The lack of screening on the nation's commuter railroads acknowledged.", "segment_duration": 270, "segment_type_id": 2, "segment_start_time": "64100.0", "legacy_segment_id": 764873, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "h9hqBDmhll", "broadcast_date": "2004-09-09", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 764860, "segment_id": "V4ldOsOwA4", "segment_broadcast_id": "h9hqBDmhll", "segment_title": "Upcoming Items (Studio: Peter Jennings)", "segment_description": "null", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "64370.0", "legacy_segment_id": 764874, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "h9hqBDmhll", "broadcast_date": "2004-09-09", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 764860, "segment_id": "LLWr3eGGHe", "segment_broadcast_id": "h9hqBDmhll", "segment_title": "(Commercial: Ascensia; Prevacid; Wal-Mart; LifeSavers; Ensure; college football on ABC; \"Emmy Awards\"; \"Good Morning America\")", "segment_description": "null", "segment_duration": 180, "segment_type_id": 3, "segment_start_time": "64380.0", "legacy_segment_id": 764875, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_role