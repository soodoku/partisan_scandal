{"data": [{"broadcast_id": "J0BZUId3Al", "broadcast_date": "2004-08-05", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 761586, "segment_id": "EPJe3Q5sU4", "segment_broadcast_id": "J0BZUId3Al", "segment_title": "Preview/Introduction Tom Brokaw (New York)", "segment_description": "null", "segment_duration": 50, "segment_type_id": 1, "segment_start_time": "63000.0", "legacy_segment_id": 761586, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "Preview", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "J0BZUId3Al", "broadcast_date": "2004-08-05", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 761586, "segment_id": "6dP0VNZoU3", "segment_broadcast_id": "J0BZUId3Al", "segment_title": "Iraq / Al-Sadr", "segment_description": "(Studio: Tom Brokaw) Fighting between the forces loyal to rogue Shiite cleric Muqtada al-Sadr, US troops & Iraqi police in Iraq, reported; death toll cited. \n (Baghdad: James Hattori) The fate of the truce with al-Sadr examined; scenes shown of fighting in Najaf, Baghdad, & Basra; details given about the breakdown of the truce between al-Sadr and US forces. [Iraqi Interior Minister Falah al-NAQIB&#134;- says we are going to fight those militias.] [Middle East expert George JOFFE&#134;- notes the importance for the Iraqi government to control the Mahdi army & al-Sadr.]", "segment_duration": 150, "segment_type_id": 2, "segment_start_time": "63050.0", "legacy_segment_id": 761587, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "J0BZUId3Al", "broadcast_date": "2004-08-05", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 761586, "segment_id": "cf1G6mFu3y", "segment_broadcast_id": "J0BZUId3Al", "segment_title": "Terrorism / Arrests", "segment_description": "(Studio: Tom Brokaw) Report introduced. \n (Washington: Pete Williams) Arrests of terror suspects in three operations featured; details given of arrests in Albany, New York, & Chicago, and of the arrest in Britain, of Issa al-Hindi&#134;, an Al Qaeda operative who relayed information from Muhammad Khan, the man arrested with his computer in Pakistan, to Al Qaeda cells in Western countries; scenes shown; excerpts from al-Hindi\u2019s book \u201cThe Army of Madinah in Kashmir\u201d quoted. [New York Governor George PATAKI&#134;- says we have to go after terrorists wherever it takes us.] [Federal prosecutor Patrick FITZGERALD&#134;- comments on the Chicago case.] [Terrorism expert Evan KOHLMANN&#134;- says al-Hindi seeks to destroy the US and the U.K.] [Deputy Attorney General James COMEY&#134;- comments on the leads obtained from Khan\u2019s computer.]", "segment_duration": 120, "segment_type_id": 2, "segment_start_time": "63200.0", "legacy_segment_id": 761588, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "J0BZUId3Al", "broadcast_date": "2004-08-05", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 761586, "segment_id": "8ysYmRwfcw", "segment_broadcast_id": "J0BZUId3Al", "segment_title": "Anthrax Investigation", "segment_description": "(Studio: Tom Brokaw) Searches in New York & New Jersey in connection with the anthrax attacks of 2001 reported; scenes shown from Lavallette, New Jersey.", "segment_duration": 20, "segment_type_id": 2, "segment_start_time": "63320.0", "legacy_segment_id": 761589, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "J0BZUId3Al", "broadcast_date": "2004-08-05", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 761586, "segment_id": "SHeAEW1yQE", "segment_broadcast_id": "J0BZUId3Al", "segment_title": "Defending America: How Safe? How Soon? (Part IV)", "segment_description": "(Studio: Tom Brokaw) Special series about the recommendations of the 9/11 Commission continued. \n (Washington: Andrea Mitchell) The gaps in security in America\u2019s transportation network featured; scenes shown of a terror drill at Los Angeles harbor; details given of shortfalls in funding for private aviation, air cargo, trains & ships. [Terrorism expert Stephen FLYNN\u2020- notes the focus on commercial passenger screening.] [Former Senator Gary HART\u2020\u2020- says we\u2019re a long way from achieving relative security.] [Senator Hillary CLINTON\u2020- comments on the need to get homeland security money to where it\u2019s needed most.]", "segment_duration": 150, "segment_type_id": 2, "segment_start_time": "63340.0", "legacy_segment_id": 761590, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "J0BZUId3Al", "broadcast_date": "2004-08-05", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 761586, "segment_id": "BxrC07HXqy", "segment_broadcast_id": "J0BZUId3Al", "segment_title": "Decision 2004 / Bush vs. Kerry / Concert Tour", "segment_description": "(Studio: Tom Brokaw) President Bush\u2019s signing of a new Pentagon spending bill, and Senator John Kerry\u2019s campaign appearance in St. Louis noted; scenes shown.   (Washington: Chip Reid) The \u201cVote for Change\u201d concert tour led by Bruce Springsteen, aimed at registering new voters and raising money for groups working to defeat Bush, featured; scenes shown of the artists participating in the tour; map shown of the tour route. [Singer Dave MATTHEWS&#134;- says there\u2019s a good chance we can swing this in a favorable direction.] [Media analyst Matthew FELLING&#134;- says this taps into an audience that was previously politically inert.] [Bush campaign spokesman Terry HOLT&#134;- says Democrats & liberals have a deaf ear in hearing mainstream America.]   (Studio: Tom Brokaw) More information on the presidential campaign on msnbc.com noted.", "segment_duration": 200, "segment_type_id": 2, "segment_start_time": "63490.0", "legacy_segment_id": 761591, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "J0BZUId3Al", "broadcast_date": "2004-08-05", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 761586, "segment_id": "FAuTfqCxYg", "segment_b