rist.\"]  [FactCheck.Org Viveca NOVAK&#134;- assesses the tax vote.]  The Obama claim about McCain slashing Social Security benefits reviewed.   (Studio: Katie Couric; Nashville: Bob Schieffer)  How the town hall meeting is McCain's favorite format, what he will try to do tonight and how Obama has established a lead in swing states discussed.   (Studio: Katie Couric, Jeff Greenfield)  How the town hall meeting will work discussed. ", "segment_duration": 250, "segment_type_id": 2, "segment_start_time": "63410.0", "legacy_segment_id": 907604, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "v2QSLulLhy", "broadcast_date": "2008-10-07", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 907602, "segment_id": "wCmTDD1kFk", "segment_broadcast_id": "v2QSLulLhy", "segment_title": "Upcoming Items (Studio: Katie Couric)", "segment_description": " ", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "63660.0", "legacy_segment_id": 907605, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "v2QSLulLhy", "broadcast_date": "2008-10-07", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 907602, "segment_id": "UOsViaoID6", "segment_broadcast_id": "v2QSLulLhy", "segment_title": "(Commercial: Claritin; V8; Advil; Boniva; Ensure.)", "segment_description": " ", "segment_duration": 