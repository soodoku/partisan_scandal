t_duration": 130, "segment_type_id": 2, "segment_start_time": "63860.0", "legacy_segment_id": 762582, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "OAVhMY5smA", "broadcast_date": "2004-08-18", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 762574, "segment_id": "MmflbHB7dK", "segment_broadcast_id": "OAVhMY5smA", "segment_title": "Upcoming Items (Studio: Scott Pelley)", "segment_description": "null", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "63990.0", "legacy_segment_id": 762583, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "OAVhMY5smA", "broadcast_date": "2004-08-18", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 762574, "segment_id": "WV28Dtfej6", "segment_broadcast_id": "OAVhMY5smA", "segment_title": "(Commercial: Folgers\u2019 Phillips\u2019; Big Lots; Cheerios; Bristol-Myers Squibb Co.; Tennessee Lottery; \"CBS Evening News.\")", "segment_description": "null", "segment_duration": 160, "segment_type_id": 3, "segment_start_time": "64000.0", "legacy_segment_id": 762584, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "OAVhMY5smA", "broadcast_d