{"data": [{"broadcast_id": "OAVhMY5smA", "broadcast_date": "2004-08-18", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 762574, "segment_id": "qqgBPN0Rrx", "segment_broadcast_id": "OAVhMY5smA", "segment_title": "Preview/Introduction Scott Pelley (New York)", "segment_description": "null", "segment_duration": 50, "segment_type_id": 1, "segment_start_time": "63000.0", "legacy_segment_id": 762574, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Preview", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "OAVhMY5smA", "broadcast_date": "2004-08-18", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 762574, "segment_id": "7A3fZyTVFz", "segment_broadcast_id": "OAVhMY5smA", "segment_title": "Iraq / Al-Sadr Revolt", "segment_description": "(Studio: Scott Pelley) Report introduced. \n (Baghdad: Barry Petersen) Radical Shiite cleric Muqtada al-Sadr\u2019s tentative agreement to a peace plan to end the fighting in Najaf, Iraq, featured; details given of militants\u2019 threat to kill kidnapped American journalist Micah Garen&#134;&#134; unless the US pulls out of Najaf and of al-Sadr\u2019s popularity; video show of Garen with hooded captors; scenes shown of fighting between US troops and Shiite militia in Baghdad and al-Sadr\u2019s supporters rallying inside the Imam Ali mosque. \n (Studio: Scott Pelley) The deaths of 3 more US troops in Iraq reported. Representative Doug Bereuter\u2019s letter to his constituents stating that the war in Iraq was a mistake quoted.", "segment_duration": 180, "segment_type_id": 2, "segment_sta