onse from Fidelity quoted; scenes shown of Fidelity owner Janet Reiswig&#134;&#134; joking about being under arrest. [Investment victims Dorese EBERT&#134;, Zelda BRODSKY&#134;, Michael CALABRESE&#134;- explain what happened to them.] [California Department of Corporations William WOOD&#134;- says the idea of selling a variable annuity that is going to mature in 15 years is ridiculous.]", "segment_duration": 150, "segment_type_id": 2, "segment_start_time": "64540.0", "legacy_segment_id": 765179, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "poonXPDyrx", "broadcast_date": "2004-09-10", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 765166, "segment_id": "Mkdxgd9XyJ", "segment_broadcast_id": "poonXPDyrx", "segment_title": "Good Night", "segment_description": "null", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "64690.0", "legacy_segment_id": 765180, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}]}