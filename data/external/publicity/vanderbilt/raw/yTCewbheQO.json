: "(Studio: Peter Jennings)  Demonstrations in Athens, Greece, over the planned visit by Secretary of State Colin Powell this weekend shown.  Today's results in men's basketball, women's long jump & relay race {including Marion Jones's performances} reported; photos shown. \n (Athens: Bob Woodruff)  The ongoing controversy over the men's all-round gymnastics event won by American Paul Hamm updated; details given from the stunning letter sent to Hamm from International Gymnastics Federation president Bruno Grandi&#134; asking him to give his gold medal to Korean Yang Tae-young.  [US Olympic Committee chairman Peter UEBERROTH&#134;- calls the request deplorable.]  [Hamm's coach Miles AVERY&#134;- says it should not be Hamm's decision to make.]  [Korean Olympic delegation's B.J. SHIN&#134;- promises a fight.]", "segment_duration": 180, "segment_type_id": 2, "segment_start_time": "63710.0", "legacy_segment_id": 763564, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "yTCewbheQO", "broadcast_date": "2004-08-27", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 763557, "segment_id": "YXiru6AuF7", "segment_broadcast_id": "yTCewbheQO", "segment_title": "Upcoming Items (Studio: Peter Jennings)", "segment_description": "null", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "63890.0", "legacy_segment_id": 763565, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "yTCewbheQO", "broadcast_date": "2004-08-27", "broadcast_start