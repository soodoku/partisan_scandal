{"data": [{"broadcast_id": "yTCewbheQO", "broadcast_date": "2004-08-27", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 763557, "segment_id": "BQkzXEwXv6", "segment_broadcast_id": "yTCewbheQO", "segment_title": "Preview/Introduction Peter Jennings (New York)", "segment_description": "null", "segment_duration": 50, "segment_type_id": 1, "segment_start_time": "63000.0", "legacy_segment_id": 763557, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "Preview", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "yTCewbheQO", "broadcast_date": "2004-08-27", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 763557, "segment_id": "fz2COW63Wh", "segment_broadcast_id": "yTCewbheQO", "segment_title": "Russia / Plane Crashes / Terrorism / Security", "segment_description": "(Studio: Peter Jennings)   Report introduced. \n (Moscow: Mike Lee)  Evidence that the two Russian airliners were brought down by female suicide bombers who may have been from Chechnya reported; scenes shown of the wreckage of the planes.  [Aviation analyst Paul DUFFY&#134;- outlines the likely cause.]  Animated diagrams shown of the sequence of events that led to the two crashes; details given about the chemical Hexogen & Russian security. \n (Studio: Peter Jennings)  Report introduced. \n (Pentagon: Martha Raddatz)  The detection of explosives at airports examined; details given of the Transportation Security Administration's recommendations for increasing security on flights from Russia.  [Homeland Security George Washington University associate vice president Frank CILLUFFO&#134;- outlines airport security for bomb-making materials.]  [Former NTSB managing director Peter GOELZ&#134;- explains how bomb material could get on board; notes Russia is a chaotic place.]", "segment_duration": 250, "segment_type_id": 2, "segment_start_time": "63050.0", "legacy_segment_id": 763558, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "yTCewbheQO", "broadcast_date": "2004-08-27", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 763557, "segment_id": "kGlTmRssq3", "segment_broadcast_id": "yTCewbheQO", "segment_title": "Bush / Intelligence Reform / Plane", "segment_description": "(Studio: Peter Jennings)  Report introduced. \n (White House: Terry Moran)  President Bush's pro-active measures on the crucial issue of intelligence reform examined; details given of his strengthening of the power of the CIA director & of the coming turf battle over control of intelligence & security. \n (Studio: Peter Jennings)  A close call on August 7 for Air Force Two carrying Vice President Dick Cheney reviewed.", "segment_duration": 100, "segment_type_id": 2, "segment_start_time": "63300.0", "legacy_segment_id": 763559, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "yTCewbheQO", "broadcast_date": "2004-08-27", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 763557, "segment_id": "C7DQeUXiXz", "segment_broadcast_id": "yTCewbheQO", "segment_title": "Campaign 2004 / Bush vs. Kerry / Social Security, Medicare", "segment_description": "(Studio: Peter Jennings)  Statement from Federal Reserve Board chairman Alan Greenspan&#134;&#134; about the future of Social Security & Medicare benefits in order to shape the presidential debate noted.", "segment_duration": 20, "segment_type_id": 2, "segment_start_time": "63400.0", "legacy_segment_id": 763560, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "yTCewbheQO", "broadcast_date": "2004-08-27", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 763557, "segment_id": "u69fgD7lhi", "segment_broadcast_id": "yTCewbheQO", "segment_title": "Iraq / Al-Sadr Revolt / Najaf", "segment_description": "(Studio: Peter Jennings)  Report introduced.   (Baghdad: Mike von Fremd)  The fragile truce in Najaf, Iraq, now that Grand Ayatollah Ali al-Sistani has engineered a deal examined; scenes shown of Sistani followers at the mosque; details given about what Shiite cleric Muqtada al-Sadr's militia may have done now.  [Army 1st Cavalry Capt. Peter GLASS&#134;- wonders about the militia.]  [Embedded producer Stephanie GOSK&#134;- comments on the reaction to grant amnesty to al-Sadr.]", "segment_duration": 120, "segment_type_id": 2, "segment_start_time": "63420.0", "legacy_segment_id": 763561, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "yTCewbheQO", "broadcast_