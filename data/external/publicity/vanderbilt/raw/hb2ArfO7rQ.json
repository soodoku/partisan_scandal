{"data": [{"broadcast_id": "hb2ArfO7rQ", "broadcast_date": "2008-10-21", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1710, "broadcast_description": null, "legacy_broadcast_id": 921773, "segment_id": "KoER72NqcB", "segment_broadcast_id": "hb2ArfO7rQ", "segment_title": "Preview/Introduction Brian Williams (New York)", "segment_description": null, "segment_duration": 50, "segment_type_id": 1, "segment_start_time": "63000.0", "legacy_segment_id": 921773, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "Preview", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "hb2ArfO7rQ", "broadcast_date": "2008-10-21", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1710, "broadcast_description": null, "legacy_broadcast_id": 921773, "segment_id": "3jv4d3HJR0", "segment_broadcast_id": "hb2ArfO7rQ", "segment_title": "Decision 2008 / Obama vs. McCain / Polls / Palin", "segment_description": "(Studio: Brian Williams) The latest NBC News/\"Wall Street Journal\" poll showing Senator Barack Obama with a lead over Senator John McCain and the feeling that Governor Sarah Palin is not qualified to be president cited.  \n\n(Washington: Andrea Mitchell) The presidential race updated; details given about Palin\u2019s faded popularity and racial attitudes in the campaign; poll findings on Palin, race and McCain\u2019s age cited. [PALIN, McCAIN \u2013 criticize Obama.] [OBAMA \u2013 refers to \u201cBush-McCain economics.\u201d] [In KUSA interview, PALIN \u2013 says the vice president is in charge of the Senate and can make policy changes.] [Representative John MURTHA \u2013 states Obama will have a tough time in Pennsylvania because of racism.] [Former Senate candidate Harvey GANTT&#134;&#134;- comments on race.]  \n\n(Studio: Brian Williams, Chuck Todd) Poll findings on former Secretary of State Colin Powell\u2019s endorsement of Obama, the issues, the qualities of the candidates and voter enthusiasm cited and discussed.  \n\n(Studio: Brian Williams) Program Note. ", "segment_duration": 370, "segment_type_id": 2, "segment_start_time": "63050.0", "legacy_segment_id": 921774, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "hb2ArfO7rQ", "broadcast_date": "2008-10-21", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1710, "broadcast_description": null, "legacy_broadcast_id": 921773, "segment_id": "JsK8MrnO90", "segment_broadcast_id": "hb2ArfO7rQ", "segment_title": "Decision 2008 / Senate Races", "segment_description": "(Studio: Brian Williams) Report introduced.   (Washington: John Yang) The battle for control of the Senate with some veteran Republicans, including Senators Mitch McConnell, Elizabeth Dole and Norm Coleman, in danger of losing their seats featured. [Coleman\u2019s opponent Al FRANKEN \u2013 comments.] [COLEMAN \u2013 says he feels weighted down by the economic collapse.] [Political analyst Stuart ROTHENBERG&#134;- says voters are holding the Republicans responsible; comments on the opportunity for the Democrats.] ", "segment_duration": 140, "segment_type_id": 2, "segment_start_time": "63420.0", "legacy_segment_id": 921775, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "hb2ArfO7rQ", "broadcast_date": "2008-10-21", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1710, "broadcast_description": null, "legacy_broadcast_id": 921773, "segment_id": "UvxFJR8Rzu", "segment_broadcast_id": "hb2ArfO7rQ", "segment_title": "Economy: Financial Crisis / SEC", "segment_description": "(Studio: Brian Williams) Treasury Secretary Henry Paulson\u2019s visit to the New York Stock Exchange shown; Stock Market Report.   (Washington: Lisa Myers) Criticism of the SEC for failing to alert the public to risky debt practices by investment banks, leading to the current economic meltdown, featured; details given of claims that chairman Christopher Cox was lax in enforcement and a report finding the SEC mishandled the Bear Stearns case. [Former SEC chief accountant Lynn TURNER&#134;- says they changed from being a watchdog to being a lapdog.] [Former SEC chairman Arthur LEVITT&#134;&#134;- says the commission went off course from its role as the investor\u2019s protector.] ", "segment_duration": 170, "segment_type_id": 2, "segment_start_time": "63560.0", "legacy_segment_id": 921776, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "hb2ArfO7rQ", "broadcast_date": "2008-10-21", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1710, "broadcast_description": null, "legacy_broadcast_id": 921773, "segment_id": "2bJUpef2Oe", "segment_broadcast_id": "hb2ArfO7rQ", "segment_title": "Upcoming Items (Studio: Brian Williams)", "segment_description": " ", "segment_duration": 30, "segment_type_id": 2, "segment_start_time": "63730.0", "legacy_segment_id": 921777, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "Ne