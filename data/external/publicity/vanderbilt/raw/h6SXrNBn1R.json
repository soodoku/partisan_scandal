, "location_names": null}, {"broadcast_id": "h6SXrNBn1R", "broadcast_date": "2004-08-16", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1740, "broadcast_description": null, "legacy_broadcast_id": 762442, "segment_id": "t9mzriaN4S", "segment_broadcast_id": "h6SXrNBn1R", "segment_title": "Upcoming Items (Athens: Tom Brokaw)", "segment_description": "null", "segment_duration": 20, "segment_type_id": 2, "segment_start_time": "63630.0", "legacy_segment_id": 762447, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "h6SXrNBn1R", "broadcast_date": "2004-08-16", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1740, "broadcast_description": null, "legacy_broadcast_id": 762442, "segment_id": "uZG8KObpJ5", "segment_broadcast_id": "h6SXrNBn1R", "segment_title": "(Commercial: Nexium; Crest; Thompson\u2019s Water Seal; Benefiber; Bristol-Myers Squibb Co.; \"Today.\")", "segment_description": "null", "segment_duration": 130, "segment_type_id": 3, "segment_start_time": "63650.0", "legacy_segment_id": 762448, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "h6SXrNBn1R", "broadcast_date": "2004-08-16", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1740, "broadcast_description": null, "legacy_broadcast_id": 762442, "segment_id": "VHf0uDsKB0", "segment_broadcast_id": "h6SXrNBn1R", "segment_title": "In Depth (Crisis in Iraq)", "segment_description": "(Athens: Tom Brokaw) Report introduced. \n (Pentagon: Jim Miklaszewski) The efforts of the new Iraqi government to control the conflict in Najaf, Iraq, featured; scenes shown of fighting between US troops & radical cleric Muqtada al-Sadr\u2019s militias, an American tank destroyed in Baghdad\u2019s Sadr City and a pro-Sadr demonstration in Kut; details given of the dilemma for interim Iraqi Prime Minister Iyad Allawi over the decision to order military action against al-Sadr from the US. [Iraq National Conference delegate Assim AZZOZ&#134;- comments on the call for US troops to withdraw from Najaf.] [Iraq expert Shibley TELHAMI&#134;- notes the government\u2019s appearance of helplessness & illegitimacy in conflicts of this sort.]", "segment_duration": 130, "segment_type_id": 2, "segment_start_time": "63780.0", "legacy_segment_id": 762449, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "h6SXrNBn1R", "broadcast_date": "2004-08-16", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1740, "broadcast_description": null, "legacy_broadcast_id": 762442, "segment_id": "gcSHyOxHoq", "segment_broadcast_id": "h6SXrNBn1R", "segment_title": "Upcoming Items (Athens: Tom Brokaw)", "segment_description": "null", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "63910.0", "legacy_segment_id": 762450, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "h6SXrNBn1R", "broadcast_date": "2004-08-16", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1740, "broadcast_description": null, "legacy_broadcast_id": 762442, "segment_id": "F10CNzhQX5", "segment_broadcast_id": "h6SXrNBn1R", "segment_title": "(Commercial: Transitions; Total; Imitrex; Capital One; Home Caf\u00e9.)", "segment_description": "null", "segment_duration": 160, "segment_type_id": 3, "segment_start_time": "63920.0", "legacy_segment_id": 762451, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "h6SXrNBn1R", "broadcast_date": "2004-08-16", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1740, "broadcast_description": null, "legacy_broadcast_id": 762442, "segment_id": "qTkVrPeHgD", "segment_broadcast_id": "h6SXrNBn1R", "segment_title": "Olympic Games / Attendance / US Teams", "segment_description": "(Athens: Tom Brokaw) Report introduced.   (Athens: Brian Williams) The slow attendance at the Olympic Games in Athens, Greece, featured; details given of the thwarted American pursuit for medals, sluggish ticket sales and decreased business; scenes shown of the US men's basketball team losing to Puerto Rico and empty seats at many events. [Athens BUSINESSWOMAN \u2013 wonders where the tourists are.] [Athens Olympic Organizing Committee Michalis ZACHARATOS\u2020- says we still have 15 days ahead of us.]   (Athens: Tom Brokaw) Today\u2019s competition reviewed. The concern of US Olympic officials about the images projected by US athletes due to the wave of anti-American sentiment featured; details given about former US swimmer Janet Evans' advice to athletes on how to behave. [EVANS \u2013 says Olympians are held to a higher standard; comments on security issues involving the display of the American flag.]", "segment_duration": 290, "segment_type_id": 2, "segment_start_time": "64080.0", "legacy_segment_id": 762452, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "h6SXrNBn1R", "broadcast_date": "2004-08-16", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1740, "broadcast_description": null, "legacy_broadcast_id": 762442, "segment_id": "32rBH0Dm0M", "segment_broadcast_id": "h6SXrNBn1R", "segment_title": "Upcoming Items (Athens: Tom Brokaw)", "segment_description": "null", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "64370.0", "legacy_segment_id": 762453, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "h6SXrNBn1R", "broadcast_date": "2004-08-16", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1740, "broadcast_description": null, "legacy_broadcast_id": 762442, "segment_id": "3RiV6weMsm", "segment_broadcast_id": "h6SXrNBn1R", "segment_title": "(Commercial: Fidelity Investments; Gas-X; Beneful; Sonicare; Celebrex; Channel 4 News.)", "segment_description": "null", "segment_duration": 170, "segment_type_id": 3, "segment_start_time": "64380.0", "legacy_segment_id": 762454, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "h6SXrNBn1R", "broadcast_date": "2004-08-16", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1740, "broadcast_description": null, "legacy_broadcast_id": 762442, "segment_id": "OutHgKetMm", "segment_broadcast_id": "h6SXrNBn1R", "segment_title": "Olympic Games / Gymnastics / Wilson", "segment_description": "(Athens: Tom Brokaw) Report introduced. \n (Columbus, Ohio: Roger O\u2019Neil) American gymnast Blaine Wilson profiled; details given of his former \u201cbad boy\u201d image; scenes shown of Wilson at the 2000 Olympics in Sydney, Australia, preparing for the 2004 Athens, Greece, games and tearing his bicep at the Visa American Cup last February. [WILSON \u2013 talks about the loss of his infant son; comments on living every day to the fullest.] [Wife Makare DISILETS&#134;&#134;- comments on becoming stronger.] \n (Athens: Tom Brokaw) The results of the US men\u2019s gymnastics team at the games noted.", "segment_duration": 190, "segment_type_id": 2, "segment_start_time": "64550.0", "legacy_segment_id": 762455, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "h6SXrNBn1R", "broadcast_date": "2004-08-16", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1740, "broadcast_description": null, "legacy_broadcast_id": 762442, "segment_id": "p51pIit2ey", "segment_broadcast_id": "h6SXrNBn1R", "segment_title": "Good Night", "segment_description": "null", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "64740.0", "legacy_segment_id": 762456, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "