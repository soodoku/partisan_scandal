{"data": [{"broadcast_id": "qo9vyvTzHp", "broadcast_date": "2008-09-22", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 918571, "segment_id": "kTwjD0MySM", "segment_broadcast_id": "qo9vyvTzHp", "segment_title": "Preview/Introduction Brian Williams (New York)", "segment_description": null, "segment_duration": 50, "segment_type_id": 1, "segment_start_time": "63000.0", "legacy_segment_id": 918571, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "Preview", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "qo9vyvTzHp", "broadcast_date": "2008-09-22", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 918571, "segment_id": "UnDwS6JHoz", "segment_broadcast_id": "qo9vyvTzHp", "segment_title": "Economy: Financial Crisis / Bailout Plan", "segment_description": "(Studio: Brian Williams) The financial crisis introduced.  \n\n(Washington: Tom Costello) The administration\u2019s 700-billion dollar bailout plan examined; details given of the changes demanded by Congress; statement from President Bush quoted. [Representatives Bradley SHERMAN\u2020, Clifford STEARNS\u2020- object to the bailout.] [Senator Christopher DODD\u2020- says we don\u2019t have a lot of time.] [From \u201cMeet the Press,\u201d Treasury Secretary Henry PAULSON \u2013 says financial institutions are clogged with illiquid loans.] [Representative Barney FRANK\u2020- says we\u2019ll get back most of the money.] [Senator Charles SCHUMER\u2020- calls for oversight.] [Representative Christopher SHAYS\u2020- objects to compensating executives from failing companies.]  \n\n(Studio: Brian Williams, Steve Liesman) The direness of this situation and the alternative to the bailout plan discussed. ", "segment_duration": 280, "segment_type_id": 2, "segment_start_time": "63050.0", "legacy_segment_id": 918572, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "qo9vyvTzHp", "broadcast_date": "2008-09-22", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 918571, "segment_id": "b07IC7fyoI", "segment_broadcast_id": "qo9vyvTzHp", "segment_title": "Economy: Paulson", "segment_description": "(Studio: Brian Williams) Statement on the power held by the Secretary of the Treasury quoted.  \n\n(Washington: Pete Williams) Treasury Secretary Henry \u201cHank\u201d Paulson profiled; details given about his background and career. [PAULSON \u2013 speaks of the plan to rescue the economy.] [Former Bush advisor Allan HUBBARD&#134;- comments on Paulson\u2019s behavior during a crisis.] [Former Federal Reserve official Vincent REINHART&#134;- questions Paulson\u2019s plan.] ", "segment_duration": 170, "segment_type_id": 2, "segment_start_time": "63330.0", "legacy_segment_id": 918573, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "qo9vyvTzHp", "broadcast_date": "2008-09-22", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 918571, "segment_id": "UaUE3Zrw9n", "segment_broadcast_id": "qo9vyvTzHp", "segment_title": "Decision 2008 / Obama vs. McCain / The Economy", "segment_description": "(Studio: Brian Williams) The response of presidential candidates Senators Barack Obama and John McCain to the government's bailout plan for the economy noted. [McCAIN, OBAMA \u2013 worry about giving so much power to one person with no accountability.]   (Studio: Brian Williams, John Harwood) The similarities and differences in the candidates\u2019 responses and the bump for Obama during this crisis discussed. ", "segment_duration": 160, "segment_type_id": 2, "segment_start_time": "63500.0", "legacy_segment_id": 918574, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "qo9vyvTzHp", "broadcast_date": "2008-09-22", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 918571, "segment_id": "MLBMbG9sJu", "segment_broadcast_id": "qo9vyvTzHp", "segment_title": "Upcoming Items (Studio: Brian Williams)", "segment_description": " ", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "63660.0", "legacy_segment_id": 918575, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "qo9vyvTzHp", "broadcast_date": "2008-09-22", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 918571, "segment_id": "9L4Poe5Srx", "segment_broadcast_id": "qo9vyvTzHp", "segment_t