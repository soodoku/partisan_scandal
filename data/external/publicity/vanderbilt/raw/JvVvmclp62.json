ohn Cochran)  Bush's campaigning in which he beat up on the opposition featured.  [In Springfield, Missouri, BUSH&nbsp- talks about the heart & soul of America; states Kerry voted against a bill supporting our troops in combat; jokes about Vice President Dick Cheney; asks for four more years.] \n (Studio: Terry Moran; Scranton, Pennsylvania: George Stephanopoulos)  Kerry's game plan after the convention while the president attacked today discussed.", "segment_duration": 450, "segment_type_id": 2, "segment_start_time": "63050.0", "legacy_segment_id": 761134, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "JvVvmclp62", "broadcast_date": "2004-07-30", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 761133, "segment_id": "mJgafxzgZN", "segment_broadcast_id": "JvVvmclp62", "segment_title": "Economy / The Figures", "segment_description": "(Studio: Terry Moran)  Commerce Department GDP report, record-high oil prices & the record-high federal deficit reported.", "segment_duration": 30, "segment_type_id": 2, "segment_start_time": "63500.0", "legacy_segment_id": 761135, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "JvVvmclp62", "broadcast_date": "2004-07-30", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 761133, "segment_id": "hHdMgWcgf3", "segment_broadcast_id": "JvVvmcl