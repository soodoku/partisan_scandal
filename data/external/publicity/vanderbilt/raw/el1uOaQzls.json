ews", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "el1uOaQzls", "broadcast_date": "2008-10-05", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 906753, "segment_id": "sby5XBqa2D", "segment_broadcast_id": "el1uOaQzls", "segment_title": "Upcoming Items (Studio: Lester Holt)", "segment_description": " ", "segment_duration": 20, "segment_type_id": 2, "segment_start_time": "63730.0", "legacy_segment_id": 906758, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "el1uOaQzls", "broadcast_date": "2008-10-05", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 906753, "segment_id": "yJ5wxrs2Xj", "segment_broadcast_id": "el1uOaQzls", "segment_title": "(Commercial: Advair; Obama ad; Citracal; Kashi.)", "segment_description": " ", "segment_duration": 140, "segment_type_id": 3, "segment_start_time": "63750.0", "legacy_segment_id": 906759, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "el1uOaQzls", "broadcast_date": "2008-10-05", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 906753, "segment_id": "mH68kHFPNw", "segment_broadcast_id": "el1uOaQzls", "segment_title": "Automobile Industry / Troubled Times", "segment_description": "(Studio: Lester Holt)  The impact of the sluggish economy on the auto industry introduced.  \n\n(Burbank, California: Chris Jansing)  The plight of American car dealers featured; scenes shown from car lots in Park Ridge, Illinois and Burbank, California; plummeting car sales statistics by company cited.  [Car loan seeker Valerie JACKSON&nbsp- worries.]  [CNBC's Phil LeBEAU&#134;- says people cannot get car loans.]  [Edmunds.com Karl BRAUER&#134;- says 600 dealers could close.]  [Former Bill Heard Chevrolet dealer employee Andy ESSA&#134;- comments.]  The plans by CarMax to lay off employees noted.  [In Burbank, Community Chevrolet Earl MANN&#134;- says people are waiting to buy.] ", "segment_duration": 130, "segment_type_id": 2, "segment_start_time": "63890.0", "legacy_segment_id": 906760, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "el1uOaQzls", "broadcast_date": "2008-10-05", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 906753, "segment_id": "QOIwVCIryo", "segment_broadcast_id": "el1uOaQzls", "segment_title": "Upcoming Items (Studio: Lester Holt)", "segment_description": " ", "segment_duration": 20, "segment_type_id": 2, "segment_start_time": "64020.0", "legacy_segment_id": 906761, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "el1uOaQzls", "broadcast_date": "2008-10-05", "broadca