segment_broadcast_id": "el1uOaQzls", "segment_title": "Supreme Court / The Docket", "segment_description": "(Studio: Lester Holt)  Five Supreme Court justices shown at the annual Red Mass at Washington's National Cathedral.   (Supreme Court: Pete Williams)  Five cases before the Supreme Court session that opens tomorrow on the first Monday in October examined; details given about the case of guitar player Diana Levine&#134;&#134;, who was given the Wyeth Co. drug Phenergan&#134; that led to the amputation of her right arm, of the case about suing cigarette companies, Pleasant Grove, Utah versus the Summum Church, whether TV networks can be fined for expletives blurted out during live programming and an environmentalists' case against the Navy's use of sonar harming whales.  [LEVINE&nbsp- describes what happened.]  [Wyeth attorney Bert REIN&#134;- says the benefits of both groups of patients have to be weighed.]  [Pleasant Grove attorney Jay SEKULOW&#134;- comments on the park monument case.] ", "segment_duration": 150, "segment_type_id": 2, "segment_start_time": "64190.0", "legacy_segment_id": 906764, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "el1uOaQzls", "broadcast_date": "2008-10-05", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 906753, "segment_id": "B5FEpsZbHY", "segment_broadcast_id": "el1uOaQzls", "segment_title": "Upcoming Items (Studio: Lester Holt)", "segment_description": " ", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "64340.0", "legacy_segment_id": 906765, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with