{"data": [{"broadcast_id": "2fKgDOgDDP", "broadcast_date": "2004-07-30", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1730, "broadcast_description": null, "legacy_broadcast_id": 761115, "segment_id": "7MljkBbBnT", "segment_broadcast_id": "2fKgDOgDDP", "segment_title": "Preview/Introduction Tom Brokaw (Pennsylvania)", "segment_description": "NOTE: Local weather bulletin on screen from 5:31:40 to 5:33:20 and 5:51:50 to 5:53:10.", "segment_duration": 50, "segment_type_id": 1, "segment_start_time": "63000.0", "legacy_segment_id": 761115, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "Preview", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "2fKgDOgDDP", "broadcast_date": "2004-07-30", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1730, "broadcast_description": null, "legacy_broadcast_id": 761115, "segment_id": "IG9XwhnAcV", "segment_broadcast_id": "2fKgDOgDDP", "segment_title": "Decision 2004 / Bush vs. Kerry / Kerry, Edwards, Interviews", "segment_description": "(Scranton: Tom Brokaw) The race between Senator John Kerry and President Bush noted; scenes shown of Kerry and Senator John Edwards leaving Boston. \n (Grand Rapids, Michigan: David Gregory) Bush\u2019s campaign, which is on the offensive following Kerry\u2019s speech at the Democratic National Convention, featured; details given of Bush\u2019s attacks on Kerry\u2019s national security credentials and Senate voting record, and his promotion of new workplace rules favoring women. [In Springfield, Missouri, BUSH \u2013 criticizes Kerry; says we are turning the corner.] [Michigan voter Nicki UTIER\u2021- explains what she wants to hear from Bush.] \n (Scranton: Tom Brokaw) Interview with Kerry and Edwards, who kicked off their bus tour across the country, about national security and Iraq; scenes shown of the candidates & their wives eating at Wendy\u2019s restaurant, a wedding anniversary tradition for the Edwardses. [On the bus, KERRY \u2013 says the administration has misled America; supports Saudi Arabia\u2019s proposal to create an Arab force to help secure Iraq.] [EDWARDS \u2013 explains why they voted for the war; says Bush misused his authority; comments on a role for NATO in providing security in Iraq.] [Scranton, Pennsylvania, voter Ann KNUTH\u2020- says she likes Kerry\u2019s positive campaign.] Kerry\u2019s phone conversations with South African President Thabo Mbeki & Israeli Prime Minister Ariel Sharon noted.] \n (NOTE: Local weather bulletin on screen.)", "segment_duration": 450, "segment_type_id": 2, "segment_start_time": "63050.0", "legacy_segment_id": 761116, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "2fKgDOgDDP", "broadcast_date": "2004-07-30", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1730, "broadcast_description": null, "legacy_broadcast_id": 761115, "segment_id": "xkrHQqkjEp", "segment_broadcast_id": "2fKgDOgDDP", "segment_title": "Terrorism: Pakistan, Uzbekistan", "segment_description": "(Scranton: Tom Brokaw) Report introduced.   (Boston: Andrea Mitchell) Terror attacks in Pakistan & Uzbekistan featured; details given of the assassination attempt on incoming Pakistani Prime Minister Shaukat Aziz&#134;&#134; at a time when Pakistan is intensifying its hunt for Al Qaeda leader Osama bin Laden, and the suicide bombings at the US & Israeli embassies in Tashkent, Uzbekistan. [Pakistan expert Stephen COHEN&#134;- says this affects our concern with Pakistan becoming a more moderate state.] [RAND Corp. Steven SIMON&#134;- says Al Qaeda provided the Islamic movement of Uzbekistan with weapons.]", "segment_duration": 120, "segment_type_id": 2, "segment_start_time": "63500.0", "legacy_segment_id": 761117, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "2fKgDOgDDP", "broadcast_date": "2004-07-30", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1730, "broadcast_description": null, "legacy_broadcast_id": 761115, "segment_id": "Q158yQsYm8", "segment_broadcast_id": "2fKgDOgDDP", "segment_title": "September 11 / Commission Report / Recommendations", "segment_description": "(Scranton: Tom Brokaw) Report introduced. \n (Capitol: Chip Reid) The Senate hearings on the 9/11 Commission\u2019s report featured; details given of the pressure on Congress to adopt the report\u2019s 2 central recommendations: the creation of a national counterterrorism center and a national intelligence director. [9/11 Commission chair Thomas KEAN&#134;- says no one was calling the play.] [Commission vice chair Lee HAMILTON&#134;- comments on the need for somebody to be \u201creally in charge.\u201d] [Senator Carl LEVIN&#134;, former CIA director Robert GATES&#134;&#134;- question putting the national intelligence director in the White House.] [Families of September 11 Stephen PUSH&#134;&#134;- stresses the importance for 9/11 victims\u2019 families of implementing the recommendations.] \n (Scranton: Tom Brokaw) Special NBC series on the 9/11 Commission\u2019s report next week noted.", "segment_duration": 170, "segment_type_id": 2, "segment_start_time": "63620.0", "legacy_segment_id": 761118, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "2fKgDOgDDP", "broadcast_date": "2004-07-30", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1730, "broadcast_description": null, "legacy_broadcast_id": 761115, "segment_id": "IyiwGPbkCk", "segment_broadcast_id": "2fKgDOgDDP", "segment_title": "Stock Market Report (Studio: Brian Williams)", "segment_description": "null", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "63790.0", "legacy_segment_id": 761119, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "2fKgDOgDDP", "broadcast_date": "2004-07-30", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1730, "broadcast_description": null, "legacy_broadcast_id": 761115, "segment_id": "rS5XWg7giy", "segment_broadcast_id": "2fKgDOgDDP", "segment_title": "Upcoming Items (Studio: Brian Williams)", "segment_description": "null", "segment_duration": 20, "segment_type_id": 2, "segment_start_time": "63800.0", "legacy_segment_id": 761120, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "2fKgDOgDDP", "broadcast_date": "2004-07-30", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1730, "broadcast_description": null, "legacy_b