l.]  [Mother Melinda BENNINGTON&#134;- talks about her late son's heroin use.] ", "segment_duration": 140, "segment_type_id": 2, "segment_start_time": "64290.0", "legacy_segment_id": 908944, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "HqFIzbIIzc", "broadcast_date": "2008-10-22", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1710, "broadcast_description": null, "legacy_broadcast_id": 908934, "segment_id": "ByIc7GiChn", "segment_broadcast_id": "HqFIzbIIzc", "segment_title": "Upcoming Items (Studio: Charles Gibson)", "segment_description": " ", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "64430.0", "legacy_segment_id": 908945, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "HqFIzbIIzc", "broadcast_date": "2008-10-22", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1710, "broadcast_description": null, "legacy_broadcast_id": 908934, "segment_id": "8E4kF4j1fQ", "segment_broadcast_id": "HqFIzbIIzc", "segment_title": "(Commercial: Progresso; Obama ad; MiraLAX; Caltrate; Coricidin; Lipitor; \"Life on Mars\"; \"Good Morning America\")", "segment_description": " ", "segment_duration": 180, "segment_type_id": 3, "segment_start_time": "64440.0", "legacy_segment_id": 908946, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names":