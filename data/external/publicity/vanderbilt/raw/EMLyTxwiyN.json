{"data": [{"broadcast_id": "EMLyTxwiyN", "broadcast_date": "2004-09-08", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 764841, "segment_id": "Y3dQuDR58X", "segment_broadcast_id": "EMLyTxwiyN", "segment_title": "Preview/Introduction Tom Brokaw (New York)", "segment_description": "null", "segment_duration": 50, "segment_type_id": 1, "segment_start_time": "63000.0", "legacy_segment_id": 764841, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "Preview", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "EMLyTxwiyN", "broadcast_date": "2004-09-08", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 764841, "segment_id": "NWDOw3nYxv", "segment_broadcast_id": "EMLyTxwiyN", "segment_title": "Decision 2004 / Bush vs. Kerry / Iraq War", "segment_description": "(Studio: Tom Brokaw) Report introduced. \n (Rochester, Minnesota: Kelly O\u2019Donnell) Senator John Kerry\u2019s new campaign strategy to link the Iraq war to the US economy featured; Kerry campaign ad shown; details given of fallout from Vice President Dick Cheney\u2019s comments about another terrorist attack if President Bush is not re-elected. [In Cincinnati, KERRY \u2013 comments on wrong leadership from Bush.] [In Cincinnati 2 years ago, BUSH \u2013 says the threat comes from Iraq.] [Yesterday, CHENEY \u2013 says if we make the wrong choice, the danger is we\u2019ll get hit again.] [Senator John EDWARDS&#134;- says the president should renounce Cheney\u2019s statement.] \n (Studio: Tom Brokaw) Report introduced. \n (White House: David Gregory) Bush\u2019s efforts to expose Kerry\u2019s inconsistencies about the war featured; details given about his own inconsistencies on the war. [BUSH \u2013 comments on the death toll reaching 1,000 US soldiers.] [From \u201cMeet the Press\u201d in 2003, KERRY \u2013 says we should increase funding for the war.] [Republican strategist Rick DAVIS&#134;- states Kerry is trying to find a position that suits the electorate.] [Iraq expert Bathsheba CROCKER&#134;- talks about ongoing problems in Iraq, including security, governance & basic services.]", "segment_duration": 300, "segment_type_id": 2, "segment_start_time": "63050.0", "legacy_segment_id": 764842, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "EMLyTxwiyN", "broadcast_date": "2004-09-08", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 764841, "segment_id": "nMsIuJfNNM", "segment_broadcast_id": "EMLyTxwiyN", "segment_title": "Iraq / Casualties", "segment_description": "(Studio: Tom Brokaw) The deaths of 2 more American soldiers in roadside attacks in Iraq reported. \n (Baghdad: Richard Engel) The reaction of the US Army 91st Engineering Battalion to the loss of each member of their group featured; scenes shown of fighting in Baghdad\u2019s Sadr City; photo shown of Spc. Clarence Adams&#134;, the 5th member of the 91st to die. [US Army 91st Engineering Battalion Pfc. Curtis McDONELL&#134;, Spc. Ryan WALLACE&#134;- comment on news that the death toll has reached 1,000; talk about Adams.] \n (Studio: Tom Brokaw) US air strikes on Fallujah noted; scenes shown.", "segment_duration": 170, "segment_type_id": 2, "segment_start_time": "63350.0", "legacy_segment_id": 764843, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "EMLyTxwiyN", "broadcast_date": "2004-09-08", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 764841, "segment_id": "xoflBwNenB", "segment_broadcast_id": "EMLyTxwiyN", "segment_title": "Bush / Military Service Record", "segment_description": "(Studio: Tom Brokaw) Report introduced.   (Washington: Andrea Mitchell) The re-emergence of questions about President Bush\u2019s National Guard service featured; details given from a \u201cBoston Globe\u201d report about his failure to fulfill his obligations; Webcast shown of former Texas Lt. Governor Ben Barnes&#134;&#134; admitting he helped Bush get into the National Guard to avoid being drafted. [Former Assistant Secretary of Defense Lawrence KORB&#134;- says Bush \u201cgamed the system\u201d and got away with it.] [In 1988, BUSH \u2013 comments on being helped into the Guard.] [From \u201cMeet the Press\u201d last February, BUSH \u2013 defends his military service.] [White House communications director Dan BARTLETT&#134;- says we don\u2019t agree with the \u201cBoston Globe\u201d\u2019s assessment.]", "segment_duration": 130, "segment_type_id": 2, "segment_start_time": "63520.0", "legacy_segment_id": 764844, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "EMLyTxwiyN", "broadcast_date": "2004-09-08", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 764841, "segment_id": "BZQ6lKMRGq", "segment_broadcast_id": "EMLyTxwiyN", "segment_title": "Upcoming Items (Studio: Tom Brokaw)", "segment_description": "null", "segment_duration": 20, "segment_type_id": 2, "segment_start_time": "63650.0", "legacy_segment_id": 764845, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "EMLyTxwiyN", "broadcast_date": "2004-09-08", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 764841, "segment_id": "rxhWkKvjRI", "segment_broadcast_id": "EMLyTxwiyN", "segment_title": "(Commercial: Michelin; Olay; Zantac; Advair; MSNBC; \"Dateline.\")", "segment_description": "null", "segment_duration": 150, "segment_type_id": 3, "segment_start_time": "63670.0", "legacy_segment_id": 764846, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "EMLyTxwiyN", "broadcast_date": "2004-09-08", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 764841, "segment_id": "sKNHvjxxjv", "segment_broadcast_id": "EMLyTxwiyN", "segment_title": "September 11 / Commission Report / Intelligence Reforms", "segment_description": "(Studio: Tom Brokaw) The administration\u2019s shift supporting giving budget authority to a national intelligence director reported.", "segment_duration": 20, "segment_type_id": 2, "segment_start_time