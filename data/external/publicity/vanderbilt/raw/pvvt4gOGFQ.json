{"data": [{"broadcast_id": "pvvt4gOGFQ", "broadcast_date": "2004-09-06", "broadcast_start_time": "63950.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 740, "broadcast_description": null, "legacy_broadcast_id": 764487, "segment_id": "bVwW64MFv3", "segment_broadcast_id": "pvvt4gOGFQ", "segment_title": "Preview/Introduction Dan Rather (New York)", "segment_description": "(NOTE: 1st half of broadcast pre-empted by tennis.)", "segment_duration": 10, "segment_type_id": 1, "segment_start_time": "63950.0", "legacy_segment_id": 764487, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Preview", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "pvvt4gOGFQ", "broadcast_date": "2004-09-06", "broadcast_start_time": "63950.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 740, "broadcast_description": null, "legacy_broadcast_id": 764487, "segment_id": "gEKUAMShnU", "segment_broadcast_id": "pvvt4gOGFQ", "segment_title": "Iraq / Attacks / Fallujah", "segment_description": "(Studio: Dan Rather) The deaths of 7 US Marines in a suicide attack on a convoy in Iraq reported; casualty figures cited.   (Baghdad: Barry Petersen) The many problems still facing American forces in Iraq examined; scenes shown from the site of the convoy attack near Fallujah; details given of the ongoing struggle in Fallujah, where an assault is planned to subdue the city before Iraqi elections next year. [Iraq expert Michael CLARKE&#134;- says Fallujah has been a no-go area since the fall of former Iraqi President Saddam Hussein.]", "segment_duration": 130, "segment_type_id": 2, "segment_start_time": "63960.0", "legacy_segment_id": 764488, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "pvvt4gOGFQ", "broadcast_date": "2004-09-06", "broadcast_start_time": "63950.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 740, "broadcast_description": null, "legacy_broadcast_id": 764487, "segment_id": "LSI5jjGSoU", "segment_broadcast_id": "pvvt4gOGFQ", "segment_title": "Hurricane Frances / Florida", "segment_description": "(Studio: Dan Rather) The death toll from Hurricane Frances cited; map shown of the second landfall in the Florida panhandle of the now-tropical storm.   (Apalachicola, Florida: Lee Cowan) The aftermath of Frances featured; storm & damage scenes shown; rainfall amounts cited; map shown of the projected paths of Frances and Hurricane Ivan, which is heading toward the Caribbean. [2 Florida RESIDENTS \u2013 react.] [WFOR-TV meteorologist Bryan NORCROSS&#134;- describes the strengthening of Ivan.]", "segment_duration": 150, "segment_type_id": 2, "segment_start_time": "64090.0", "legacy_segment_id": 764489, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "pvvt4gOGFQ", "broadcast_date": "2004-09-06", "broadcast_start_time": "63950.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 740, "broadcast_description": null, "legacy_broadcast_id": 764487, "segment_id": "OY0QPPJpr3", "segment_broadcast_id": "pvvt4gOGFQ", "segment_title": "Clinton / Health", "segment_description": "(Studio: Dan Rather) Former President Bill Clinton\u2019s recovery from heart bypass surgery noted. \n (New York-Presbyterian Hospital: Elizabeth Kaledin) Clinton\u2019s operation & prognosis reviewed; animation shown; details given of Clinton\u2019s health history. [Surgeon Dr. Craig SMITH&#134;- says he is recovering normally.] [Cardiologist Dr. Allan SCHWARTZ&#134;- says there is a likelihood that he would have had a substantial heart attack.] [Montefiore Hospital Dr. Jeffrey GOLD&#134;- explains the relation of age to recovery; notes the importance for Clinton to watch his lifestyle.]", "segment_duration": 160, "segment_type_id": 2, "segment_start_time": "64240.0", "legacy_segment_id": 764490, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "pvvt4gOGFQ", "broadcast_date": "2004-09-06", "broadcast_start_time": "63950.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 740, "broadcast_description": null, "legacy_broadcast_id": 764487, "segment_id": "2gUIGWeyhR", "segment_broadcast_id": "pvvt4gOGFQ", "segment_title": "Upcoming Items (Studio: Dan Rather)", "segment_description": "null", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "64400.0", "legacy_segment_id": 764491, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "pvvt4gOGFQ", "broadcast_date": "2004-09-06", "broadcast_start_time": "63950.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 740, "broadcast_description": null, "legacy_broadcast_id": 764487, "segment_id": "6m8tyugjVP", "segment_broadcast_id": "pvvt4gOGFQ", "segment_title": "(Commercial: Crest Whitestrips; Viagra; Maalox; Enbrel; Dr. Scholl\u2019s; American Egg Board.)", "segment_description": "null", "segment_duration": 150, "segment_type_id": 3, "segment_start_time": "64400.0", "legacy_segment_id": 764492, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "pvvt4gOGFQ", "broadcast_date": "2004-09-06", "broadcast_start_time": "63950.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 740, "broadcast_description": null, "legacy_broadcast_id": 764487, "segment_id": "xea12szfUO", "segment_broadcast_id": "pvvt4gOGFQ", "segment_title": "Campaign 04 / Bush vs. Kerry", "segment_description": "(Studio: Dan Rather) Report introduced. \n (Charleston, West Virginia: Byron Pitts) Senator John Kerry\u2019s Labor Day campaign focus on jobs, the economy, and a counterattack on President Bush featured; details given of Democrats\u2019 concern about Kerry\u2019s ability to defend himself against Republican attacks. [KERRY \u2013 says the \u201cW\u201d {in George W. Bush} stands for \u201cwrong.\u201d] [Earlier, in Pennsylvania, KERRY \u2013 responds to a heckler\u2019s comments about his being privileged.] \n (Studio: Dan Rather) Bush\u2019s response to Kerry\u2019s attacks on the decision to go to war in Iraq noted; scenes shown from Poplar Bluff, Missouri.", "segment_duration": 140, "segment_type_id": 2, "segment_start_time": "64550.0", "legacy_segment_id": 764493, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "pvvt4gOGFQ", "broadcast_date": "2004-09-06", "broadcast_start_time": "63950.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 740, "broadcast_description": null, "legacy_broadcast_id": 76