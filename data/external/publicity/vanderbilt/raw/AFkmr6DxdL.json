{"data": [{"broadcast_id": "AFkmr6DxdL", "broadcast_date": "2004-09-09", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 764926, "segment_id": "d9TGXMMbV3", "segment_broadcast_id": "AFkmr6DxdL", "segment_title": "Preview/Introduction Dan Rather (New York)", "segment_description": "null", "segment_duration": 50, "segment_type_id": 1, "segment_start_time": "63000.0", "legacy_segment_id": 764926, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Preview", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "AFkmr6DxdL", "broadcast_date": "2004-09-09", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 764926, "segment_id": "Iwve7Dfqna", "segment_broadcast_id": "AFkmr6DxdL", "segment_title": "Hurricane Ivan / Caribbean / Florida", "segment_description": "(Studio: Dan Rather) Map of the track of Hurricane Ivan across Grenada, Barbados and other Caribbean islands shown. \n (Punta Gorda, Florida: Lee Cowan) Concern about Ivan in Florida, which is still recovering from Hurricanes Charley & Frances, featured; scenes shown of damage in Grenada, preparations in Jamaica & people evacuating from the Florida Keys; maps shown. [On the phone from Grenada, medical student Federica PICHEL&#134;; Florida residents Don ERTEL&#134;, Mary BENDUS&#134;- comment.] [National Hurricane Center Max MAYFIELD&#134;- predicts we\u2019ll see more & stronger hurricanes.] [Charlotte County, Florida, Emergency Management director Wayne SALLADE&#134;- says there\u2019s no book that says what to do for 3 hurricanes in a month.] \n (Studio: Dan Rather) Taped discussion held with WFOR-TV meteorologist Bryan Norcross&#134; about Ivan\u2019s strength. [NORCROSS \u2013 cites wind speed; predicts the storm will strengthen; says it has the potential to do tremendous damage.]", "segment_duration": 260, "segment_type_id": 2, "segment_start_time": "63050.0", "legacy_segment_id": 764927, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "AFkmr6DxdL", "broadcast_date": "2004-09-09", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 764926, "segment_id": "eo4j7H20rH", "segment_broadcast_id": "AFkmr6DxdL", "segment_title": "Terrorism / Zawahiri Videotape", "segment_description": "(Studio: Dan Rather) Report introduced. \n (Washington: Jim Stewart) The new videotape from Al Qaeda leader Osama bin Laden\u2019s top lieutenant Ayman al-Zawahiri featured; details given of concern that tapes are often followed by terror attacks; examples cited; tape excerpts shown as Zawahiri\u2019s words are translated. [Al Qaeda expert Rohan GUNARATNA&#134;- talks about analysis of taped messages for hidden codes.]", "segment_duration": 120, "segment_type_id": 2, "segment_start_time": "63310.0", "legacy_segment_id": 764928, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "AFkmr6DxdL", "broadcast_date": "2004-09-09", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 764926, "segment_id": "5EZ1G7N71L", "segment_broadcast_id": "AFkmr6DxdL", "segment_title": "Iraq / Attacks", "segment_description": "(Studio: Dan Rather) Strikes by US & Iraqi government forces on Fallujah, Samarra & Tel Afar, Iraq, reported; scenes shown.", "segment_duration": 20, "segment_type_id": 2, "segment_start_time": "63430.0", "legacy_segment_id": 764929, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "AFkmr6DxdL", "broadcast_date": "2004-09-09", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 764926, "segment_id": "CR2AAHTGxo", "segment_broadcast_id": "AFkmr6DxdL", "segment_title": "Indonesia / Jakarta Terrorism", "segment_description": "(Studio: Dan Rather) A suicide car bombing at Australia\u2019s embassy in Jakarta, Indonesia, by an Al Qaeda-affiliated militant group reported; scenes shown.", "segment_duration": 20, "segment_type_id": 2, "segment_start_time": "63450.0", "legacy_segment_id": 764930, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "AFkmr6DxdL", "broadcast_date": "2004-09-09", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 764926, "segment_id": "Nu08w9x6S4", "segment_broadcast_id": "AFkmr6DxdL", "segment_title": "Campaign 04 / Bush vs. Kerry", "segment_description": "(Studio: Dan Rather) Findings of a CBS News poll on voter preference in the presidential campaign cited.   (New Orleans: Jim Axelrod) President Bush\u2019s lead over Senator John Kerry in the latest polls examined; poll results cited; details given of the problems for Kerry. [Kerry communications director Stephanie CUTTER&#134;- says we are ready to fight back.] [At the Democratic National Convention in July, KERRY \u2013 campaigns.] [At the Republican National Convention on August 30, former New York City Mayor Rudolph GIULIANI \u2013 emphasizes Bush\u2019s focus on terrorism.] [Tuesday, Vice President Dick CHENEY \u2013 warns against another terror attack unless Bush is re-elected.]", "segment_duration": 150, "segment_type_id": 2, "segment_start_time": "63470.0", "legacy_segment_id": 764931, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "AFkmr6DxdL", "broadcast_date": "2004-09-09", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 764926, "segment_id": "wK2MM3OzqX", "segment_broadcast_id": "AFkmr6DxdL", "segment_title": "Upcoming Items; fallen hero Marine Pfc. Moises Langhorst&#134<!-- spelling on screen --> profiled. (Studio: Dan Rather)", "segment_description": "null", "segment_duration": 50, "segment_type_id": 2, "segment_start_time": "63620.0", "legacy_segment_id": 764932, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "AFkmr6DxdL", "broadcast_date": "2004-09-09", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 764926, "segment_id": "cmMgXPZ5R6", "segment_broadcast_id": "AFkmr6DxdL", "segment_title": "(Commercial: Excellence; Minwax; Capital One; Campbell\u2019s Soup; Grape-Nuts; Serenity; Smart Balance.)", "segment_description": "null", "segment_duration": 150, "segment_type_id": 3, "segment_start_time": "63670.0", "legacy_segment_id": 764933, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "AFkmr6DxdL", "broadcast_date": "2004-09-09", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 764926, "segment_id": "bWwRgC9n98", "segment_broadcast_id": "AFkmr6DxdL", "segment_title": "Sudan / Genocide", "segment_description": "(Studio: Dan Rather) Secretary of State Colin Powell\u2019s statement accusing the government of Sudan of supporting genocide in the Darfur region noted; scenes shown of refugees in Chad and West Darfur.", "segment_duration": 30, "segment_type_id": 2, "segment_start_time": "63820.0", "legacy_segment_id": 764934, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "AFkmr6DxdL", "broadcast_date": "2004-09-09", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 764926, "segment_id": "pK58NitHXQ", "segment_broadcast_id": "AFkmr6DxdL", "segment_title": "Inside Story (Russian School Massacre)", "segment_description": "(Studio: Dan Rather) Russia\u2019s identification of some of the militants involved in last week\u2019s school massacre noted. \n (Moscow: Elizabeth Palmer) Anger in Russia over the government\u2019s handling of the Beslan school crisis featured; video shown of 10-year-old Georgy Farniyev&#134;&#134; on the floor next to an attacker with his foot on a bomb detonator; details given of the suppression of information. [FARNIYEV {thru translator} \u2013 talks about his ordeal.] [\u201cIzvestia\u201d newspaper former editor Raf SHAKIROV&#134;- comments on being fired for printing pictures of the siege.]", "segment_duration": 140, "segment_type_id": 2, "segment_start_time": "63850.0", "legacy_segment_id": 764935, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "AFkmr6DxdL", "broadcast_date": "2004-09-09", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 764926, "segment_id": "5565LYnfDr", "segment_broadcast_id": "AFkmr6DxdL", "segment_title": "Upcoming Items (Studio: Dan Rather)", "segment_description": "null", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "63990.0", "legacy_segment_id": 764936, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "AFkmr6DxdL", "broadcast_date": "2004-09-09", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 764926, "segment_id": "4GjNejsrie", "segment_broadcast_id": "AFkmr6DxdL", "segment_title": "(Commercial: Your Credit Card Companies; Hidden Valley Ranch; Claritin; Sure; Crest Whitestrips; LifeSavers.)", "segment_description": "null", "segment_duration": 150, "segment_type_id": 3, "segment_start_time": "64000.0", "legacy_segment_id": 764937, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "AFkmr6DxdL", "broadcast_date": "2004-09-09", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 764926, "segment_id": "ds3wSH8w7k", "segment_broadcast_id": "AFkmr6DxdL", "segment_title": "Bush / Military Service Record", "segment_description": "(Studio: Dan Rather) Democratic senators\u2019 request to Secretary of Defense Donald Rumsfeld for an investigation into the status of President Bush\u2019s National Guard service records noted.   (Johnstown, Pennsylvania: John Roberts) Political fallout from the \u201c60 Minutes\u201d revelations about Bush\u2019s military service featured; letters from Bush\u2019s former squadron commander Lt. Col. Jerry Killian&#134;&#134; quoted. [Senator Tom HARKIN&#134;- states Bush did not do his duty.] [Republican strategist Scott REED&#134;- comments on the fight by both candidates to \u201cwin the day.\u201d] [White House communications director Dan BARTLETT&#134;- criticizes former Texas Lt. Governor Ben Barnes&#134;, who admitted pulling strings to get Bush into the Guard.]", "segment_duration": 140, "segment_type_id": 2, "segment_start_time": "64150.0", "legacy_segment_id": 764938, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "AFkmr6DxdL", "broadcast_date": "2004-09-09", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 764926, "segment_id": "kBIMUidnu3", "segment_broadcast_id": "AFkmr6DxdL", "segment_title": "Market Watch: Overtime Rules, Stocks", "segment_description": "(Studio: Dan Rather) The House vote to block the administration\u2019s new rules for overtime pay reported; Stock Market Report.", "segment_duration": 20, "segment_type_id": 2, "segment_start_time": "64290.0", "legacy_segment_id": 764939, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "AFkmr6DxdL", "broadcast_date": "2004-09-09", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 764926, "segment_id": "tU3cJX3FVT", "segment_broadcast_id": "AFkmr6DxdL", "segment_title": "Upcoming Items (Studio: Dan Rather)", "segment_description": "null", "segment_duration": 20, "segment_type_id": 2, "segment_start_time": "64310.0", "legacy_segment_id": 764940, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "AFkmr6DxdL", "broadcast_date": "2004-09-09", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_descripti