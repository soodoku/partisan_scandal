n": "(Athens: Brian Williams)  Report introduced. \n (Athens: Jim Maceda)  The centuries-old controversy over the Elgin marbles, which were taken from the Parthenon in Athens, Greece, by Britain's Lord Elgin examined; scenes shown of the marble sculptures.  [Art expert Andrew GRAHAM- DIXON&#134;&#134;- praises the art; predicts the issue will \"run & run.\"]  [Historian Susan NAGEL&#134;, Greek deputy culture minister Fanni PALLI-PETRALIA&#134;, Greek archaeologist Elaina KORKA&#135;- offer differing opinions on the marbles & their ownership.]", "segment_duration": 180, "segment_type_id": 2, "segment_start_time": "64540.0", "legacy_segment_id": 763475, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "knYOcrhhSI", "broadcast_date": "2004-08-21", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 763462, "segment_id": "2pITS8UPAK", "segment_broadcast_id": "knYOcrhhSI", "segment_title": "Good Night", "segment_description": "null", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "64720.0", "legacy_segment_id": 763476, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}]}