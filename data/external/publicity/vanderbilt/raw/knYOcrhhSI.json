n": 150, "segment_type_id": 2, "segment_start_time": "63070.0", "legacy_segment_id": 763463, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "knYOcrhhSI", "broadcast_date": "2004-08-21", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 763462, "segment_id": "b0Xr6yrNFr", "segment_broadcast_id": "knYOcrhhSI", "segment_title": "Terrorism / Pakistan", "segment_description": "(Athens: Brian Williams)  Report introduced. \n (Washington: Rosiland Jordan)  The arrest in Pakistan of suspected Al Qaeda members accused of plotting to blow up the US Embassy & the ongoing hunt for Al Qaeda leader Abu Faraj&#134; featured; details given of Abu Faraj's background.  [Pakistan's interior minister Faisal HAJAK&#135;- talks about Abu Faraj as the architect of attacks & the insight from captured terrorists.]  [Terrorism expert Roger CRESSEY&nbsp- talks about Al Qaeda's plan for attacks inside the US.]", "segment_duration": 130, "segment_type_id": 2, "segment_start_time": "63220.0", "legacy_segment_id": 763464, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "knYOcrhhSI", "broadcast_date": "2004-08-21", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 763462, "segment_id": "peoqKGyGv6", "segment_broadcast_id": "knYOcrhhSI", "segment_title": "Iraq / Al-Sadr Revolt / Najaf", "segment_description": "(Athens: Brian Williams)  Report introduced. \n (Baghdad: Jennifer Eccleston)  The standoff in Najaf, Iraq, between the forces of the US, the Iraqi government & the insurgent militias featured; scenes shown of the armed, defiant supporters of Shiite cleric Muqtada al-Sadr.  [Via phone, \"Washington Post\" reporter Karl VICK&#134;- says the fighters still come & go from the shrine.]  Other fronts in the fighting reviewed; scenes shown from Ramadi, where a convoy was attacked.", "segment_duration": 110, "segment_type_id": 2, "segment_start_time": "63350.0", "legacy_segment_id": 763465, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "knYOcrhhSI", "broadcast_date": "2004-08-21", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 763462, "segment_id": "QWyPq0gb4S", "segment_broadcast_id": "knYOcrhhSI", "segment_title": "Olympic Games / Gymnastics / Medal Controversy", "segment_description": "(Athens: Brian Williams)  Report introduced.   (Athens: Martin Fletcher)  The controversies over the outcome of the men's all-around gymnastics event won by American Paul Hamm & in an equestrian event reviewed; scenes shown of the performances by Hamm & South Korean Yang Tae-young&#134;&#134;.  [Olympics historian David WALLECHINSKY&#134;- says a serious mistake was made.]  [Gold medal gymnast Tim DAGGETT&#134;- assesses the problems.]", "segment_duration": 130, "segment_type_id": 2, "segment_start_time": "63460.0", "legacy_segment_id": 763466, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": 