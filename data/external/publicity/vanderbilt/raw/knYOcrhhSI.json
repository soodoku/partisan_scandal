tion": "(Athens: Brian Williams)  The situation in Florida one week after Hurricane Charley outlined on screen. \n (Punta Gorda, Florida: Mark Potter)  The role of a National Guard unit in helping Floridians recover from the storm featured; scenes shown of the unit in Iraq & patrolling southwest Florida.  [Guardsman Capt. Joseph LYON&#134;, resident Myrtle WILLIAMS, Pfc. Homer MUNROE&#134;- comment on relief.]  [Punta Gorda resident Sandy SWEITZER&#134;- reacts to receiving a guardsman's patch.]", "segment_duration": 150, "segment_type_id": 2, "segment_start_time": "63760.0", "legacy_segment_id": 763469, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "knYOcrhhSI", "broadcast_date": "2004-08-21", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 763462, "segment_id": "Ld03kUDYEV", "segment_broadcast_id": "knYOcrhhSI", "segment_title": "Upcoming Items (Athens: Brian Williams)", "segment_description": "null", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "63910.0", "legacy_segment_id": 763470, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "knYOcrhhSI", "broadcast_date": "2004-08-21", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 763462, "segment_id": "p67yLw4WPy", "segment_broadcast_id": "knYOcrhhSI", "segment_title": "(Commercial: Capital One; Cheerios; Sonicare; Ex-Lax; Fidelity Investments.)", "segment_description": "null", "segment_duration": 140, "segment_type_id": 3, "segment_start_time": "63920.0", "legacy_segment_id": 763471, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "knYOcrhhSI", "broadcast_date": "2004-08-21", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 763462, "segment_id": "hKMLbXkneh", "segment_broadcast_id": "knYOcrhhSI", "segment_title": "Olympic Games / Results / Men's Basketball", "segment_description": "(Athens: Brian Williams)  The day's results from the Olympic Games in swimming & track outlined on screen.   (Athens: Rehema Ellis)  The defeat of the US men's basketball team against Lithuania featured; photos shown.  [Players Tim DUNCAN, Duane WADE, coach Larry BROWN&nbsp- comment.]  [\"Washington Post\" reporter Sally JENKINS&#134;- comments on the team's vanity & the American pro game.]   (Athens: Brian Williams)  Report introduced.   (Athens: Kerry Sanders)  The story of American triple jumper Yuliana Perez&#134;&#134;, who returned to Cuba after her parents, who had emigrated to the US, were killed, but then came back to the US for the Olympics, presented; scenes shown of Perez training.  [PEREZ&nbsp- says she did not want to give up her American citizenship; talks bout pursuing her American dreams.]", "segment_duration": 320, "segment_type_id": 2, "segment_start_time": "64060.0", "legacy_segment_id": 763472, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": nul