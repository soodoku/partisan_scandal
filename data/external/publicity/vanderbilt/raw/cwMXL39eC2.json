: 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 761279, "segment_id": "Z5nBn6IX6g", "segment_broadcast_id": "cwMXL39eC2", "segment_title": "Salt Lake City, Utah / Hacking Case", "segment_description": "(Studio: John Roberts) Murder charges in Salt Lake City against Mark Hacking for the murder of his wife, Lori Hacking, who has been missing for 2 weeks, reported.", "segment_duration": 20, "segment_type_id": 2, "segment_start_time": "64230.0", "legacy_segment_id": 761290, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "cwMXL39eC2", "broadcast_date": "2004-08-02", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 761279, "segment_id": "1fcYon6ACe", "segment_broadcast_id": "cwMXL39eC2", "segment_title": "Diet & Depression", "segment_description": "(Studio: John Roberts) Report introduced. \n (London: Sheila MacVicar) The controversial treatment of mental illness with nutritional therapy examined; clinical study results cited. [Patients Sukie MIRZOEFF-CRAIG&#134;&#134;, Gemma TOVEY&#134;- comment on their improvement.] [Institute of Optimum Nutrition Brain Bio Center Patrick HOLFORD&#134;&#134;- promotes using nutrients rather than chemicals.] [Institute of Psychiatry Dr. Peter McGUFFIN&#134;- warns against relying on nutrition alone.]", "segment_duration": 140, "segment_type_id": 2, "segment_start_time": "64250.0", "legacy_segment_id": 761291, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_role