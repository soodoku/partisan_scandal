XL39eC2", "segment_title": "New York, New York / Statue of Liberty", "segment_description": "(Studio: John Roberts) Report introduced.   (New York: Richard Schlesinger) The Statue of Liberty collection of Iris November&#134;&#134;, which has grown into a museum in Rochester, New York, featured; details given of tomorrow\u2019s reopening of the statue for the first time since the September 11 attacks. [NOVEMBER \u2013 points out pieces in her collection; says the statue is an expression of love for everybody.] [Statue of Liberty superintendent Cynthia GARRETT&#134;- notes Miss Liberty represents safety, security & freedom.]", "segment_duration": 130, "segment_type_id": 2, "segment_start_time": "64570.0", "legacy_segment_id": 761294, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "cwMXL39eC2", "broadcast_date": "2004-08-02", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 761279, "segment_id": "V40zS86oaK", "segment_broadcast_id": "cwMXL39eC2", "segment_title": "Good Night", "segment_description": "null", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "64700.0", "legacy_segment_id": 761295, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}]}