{"data": [{"broadcast_id": "bVKLnhcKKf", "broadcast_date": "2004-08-06", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 761785, "segment_id": "msrV0kSkOB", "segment_broadcast_id": "bVKLnhcKKf", "segment_title": "Preview/Introduction John Roberts (New York)", "segment_description": "null", "segment_duration": 50, "segment_type_id": 1, "segment_start_time": "63000.0", "legacy_segment_id": 761785, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Preview", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "bVKLnhcKKf", "broadcast_date": "2004-08-06", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 761785, "segment_id": "EzI9mCOEMy", "segment_broadcast_id": "bVKLnhcKKf", "segment_title": "Economy / Jobs / Bush vs. Kerry", "segment_description": "(Studio: John Roberts) Unemployment rate & job creation figures cited; Stock Market Report. \n (New York: Anthony Mason) The downturn in the job market examined; statistics cited; scenes shown of the presidential candidates in Iowa. [RBS Greenwich Capital Michelle GIRARD&#134;- says businesses may want to hold back on hiring.] [Economy.com Mark ZANDI&#134;- says we\u2019ve been creating low-paying jobs.] [Re-employed Iowa worker Jerry NOWADZKY&#134;&#134;- says he\u2019s making half as much as he used to.] [In Iowa, President BUSH, Senator John KERRY \u2013 talk jobs.] \n (Studio: John Roberts) Report introduced. \n (Smithville, Missouri: Jim Axelrod) The differing views of the presidential candidates on today\u2019s economic report featured; Bush\u2019s & Kerry\u2019s jobs plans compared; Kerry campaign ad shown. [In Missouri, KERRY \u2013 criticizes the jobs figures.] [In New Hampshire, BUSH \u2013 says the economy is continuing to move forward.]", "segment_duration": 280, "segment_type_id": 2, "segment_start_time": "63050.0", "legacy_segment_id": 761786, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "bVKLnhcKKf", "broadcast_date": "2004-08-06", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 761785, "segment_id": "uHQExu3yN6", "segment_broadcast_id": "bVKLnhcKKf", "segment_title": "Iraq / Unrest", "segment_description": "(Studio: John Roberts) US casualties in Iraq cited. \n (Baghdad: Kimberly Dozier) Renewed fighting between US forces and militiamen loyal to radical cleric Muqtada al-Sadr featured; scenes shown of fighting in Najaf & Baghdad and of a pro-Sadr rally; details given of al-Sadr\u2019s mixed messages of war & conciliation. [US Marines Col. Tony HASLAM&#134;- notes the slow progress in putting down the insurgency.] [US Marines Lt. Col. Gary JOHNSTON&#134;- says we are not at war with al-Sadr.] \n (Studio: John Roberts) The arrival of Iraqi Shiite spiritual leader Grand Ayatollah Ali al-Sistani&#134;&#134; in Britain for medical treatment noted; scenes shown.", "segment_duration": 150, "segment_type_id": 2, "segment_start_time": "63330.0", "legacy_segment_id": 761787, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "bVKLnhcKKf", "broadcast_date": "2004-08-06", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 761785, "segment_id": "It7pntfMLc", "segment_broadcast_id": "bVKLnhcKKf", "segment_title": "Terrorism / Ahmad Arrest", "segment_description": "(Studio: John Roberts) Report introduced.   (Pentagon: David Martin) The hearing in London, England, for captured Al Qaeda suspect Babar Ahmad&#134;&#134;, who is charged with raising money for the Taliban & Islamic terror groups through his Websites, featured; courtroom sketches by Julia Quenzler shown; details given of information on a US Navy battle group that was found on a computer disk and of an e-mail exchange with a US sailor who praised the attack on the USS Cole in 2000. [US attorney for Connecticut Kevin O\u2019CONNOR&#134;- explains the charges against Ahmad.] Ahmad\u2019s relationship to Mohammed Khan&#134;&#134; {aka Abu Talha}, whose capture in Pakistan uncovered surveillance reports on financial institutions in the US, noted.", "segment_duration": 130, "segment_type_id": 2, "segment_start_time": "63480.0", "legacy_segment_id": 761788, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "bVKLnhcKKf", "broadcast_date": "2004-08-06", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 761785, "segment_id": "CLuaLyFkUN", "segment_broadcast_id": "bVKLnhcKKf", "segment_title": "Upcoming Items; fallen soldier Army Capt. Kimberly Hampton&#134<!-- spelling on screen --> profiled. (Studio: John Roberts, Dan Rather)", "segment_description": "null", "segment_duration": 50, "segment_type_id": 2, "segment_start_time": "63610.0", "legacy_segment_id": 761789, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "bVKLnhcKKf", "broadcast_date": "2004-08-06", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 761785, "segment_id": "FCE5Uk6yzX", "segment_broadcast_id": "bVKLnhcKKf", "segment_title": "(Commercial: Covergirl; Ascensia; Detrol; Big Lots; Fidelity Investments.)", "segment_description": "null", "segment_duration": 150, "segment_type_id": 3, "segment_start_time": "63660.0", "legacy_segment_id": 761790, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "bVKLnhcKKf", "broadcast_date": "2004-08-06", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 761785, "segment_id": "1TTBumRKSY", "segment_broadcast_id": "bVKLnhcKKf", "segment_title": "Inside Story (Tainted Fish)", "segment_description": "(Studio: John Roberts) Report introduced. \n (Waynesville, Ohio: Bob Orr) The contamination of fish with mercury, partially due to pollution from coal-fired power plants, featured; map shown of states with mercury fish warnings; details given of criticism that the administration fashioned a rule favoring the industries and of the industry\u2019s argument that the pollution is blown here from Asia; statistics on mercury emissions cited. [EPA mercury working group John PAUL&#134;- criticizes the administration.] [EPA administrator Mike LEAVITT&#134;- says we don\u2019t have the technology to {reduce emissions} faster.] [American Electric Power Dale HEYDLAUFF&#134;- comments on the cost of retrofitting plants.]", "segment_duration": 160, "segment_type_id": 2, "segment_start_time": "63810.0", "legacy_segment_id": 761791, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "bVKLnhcKKf", "broadcast_date": "2004-08-06", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 761785, "segment_id": "W7vCG2EExF", "segment_broadcast_id": "bVKLnhcKKf", "segment_title": "Hungary / Fireworks Explosion", "segment_description": "(Studio: John Roberts) A deadly explosion at a fireworks warehouse in Torokbalint, Hungary, reported; scenes shown.", "segment_duration": 20, "segment_type_id": 2, "segment_start_time": "63970.0", "legacy_segment_id": 761792, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "bVKLnhcKKf", "broadcast_date": "2004-08-06", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 761785, "segment_id": "D6MtPPhWt3", "segment_broadcast_id": "bVKLnhcKKf", "segment_title": "Upcoming Items (Studio: John Roberts)", "segment_description": "null", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "63990.0", "legacy_segment_id": 761793, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "bVKLnhcKKf", "broadcast_date": "2004-08-06", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 761785, "segment_id": "E3gwSpJ8D4", "segment_broadcast_id": "bVKLnhcKKf", "segment_title": "(Commercial: Lamisil; Pantene; Philip Morris USA; Tennessee Lottery; \"CBS Evening News.\")", "segment_description": "null", "segment_duration": 170, "segment_type_id": 3, "segment_start_time": "64000.0", "legacy_segment_id": 761794, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "bVKLnhcKKf", "broadcast_date": "2004-08-06", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 761785, "segment_id": "MNKGpkXy45", "segment_broadcast_id": "bVKLnhcKKf", "segment_title": "Tennessee / Highway Accident", "segment_description": "(Studio: John Roberts) A deadly highway crash involving a Greyhound bus and a tractor-trailer near Jackson, Tennessee, reported; scenes shown.", "segment_duration": 20, "segment_type_id": 2, "segment_start_time": "64170.0", "legacy_segment_id": 761795, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "bVKLnhcKKf", "broadcast_date": "2004-08-06", "broadcast_start_ti