d": "bVKLnhcKKf", "segment_title": "Iraqi Wrestling Team", "segment_description": "(Studio: John Roberts) Report introduced. \n (Colorado Springs: Richard Schlesinger) The Iraqi wrestling team featured; scenes shown of the Iraqis training at the US Olympic Training Center in Colorado Springs. [Iraqi WRESTLER, COACH {thru translator} \u2013 comment.] [US wrestler 1st Lt. Eric Albarracin&#134;&#134;, Iraqi wrestler Mohammed MOHAMMED&#135;- comment on Albarracin\u2019s learning of Arabic in the event he is sent to Iraq with the US Army.]", "segment_duration": 140, "segment_type_id": 2, "segment_start_time": "64520.0", "legacy_segment_id": 761800, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "bVKLnhcKKf", "broadcast_date": "2004-08-06", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 761785, "segment_id": "T2L096weFq", "segment_broadcast_id": "bVKLnhcKKf", "segment_title": "Good Night", "segment_description": "null", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "64660.0", "legacy_segment_id": 761801, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}]}