{"data": [{"broadcast_id": "gaKHtTlX65", "broadcast_date": "2004-09-07", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 764720, "segment_id": "LF8fri2TY5", "segment_broadcast_id": "gaKHtTlX65", "segment_title": "Preview/Introduction Peter Jennings (New York)", "segment_description": "null", "segment_duration": 10, "segment_type_id": 1, "segment_start_time": "63000.0", "legacy_segment_id": 764720, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "Preview", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "gaKHtTlX65", "broadcast_date": "2004-09-07", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 764720, "segment_id": "NZPV4XInhJ", "segment_broadcast_id": "gaKHtTlX65", "segment_title": "Iraq / 1,000 Dead / Attacks", "segment_description": "(Studio: Peter Jennings)  The milestone of 1,000 dead Americans in Iraq noted.  [President BUSH&nbsp- says we will complete the mission.]  [Senator John KERRY&nbsp- comments.] \n (Baghdad: Mike von Fremd)  The fighting in Baghdad's Sadr City with Shiite cleric Muqtada al-Sadr's insurgents featured; scenes shown of a damaged tank, a bombed Iraqi government motorcade & of a US strike in Fallujah against insurgent strongholds. \n (Studio: Peter Jennings)  Report introduced. \n (Pentagon: Martha Raddatz)  The worsening violence in Iraq featured; statistics cited on the average number of attacks per week, IED attacks in Sadr City & the number of Iraqi civilian & security force deaths.  [Secretary of Defense Donald RUMSFELD&nbsp- calls the violence \"understandable.\"]", "segment_duration": 290, "segment_type_id": 2, "segment_start_time": "63000.0", "legacy_segment_id": 764721, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "gaKHtTlX65", "broadcast_date": "2004-09-07", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 764720, "segment_id": "raEWHgfEqV", "segment_broadcast_id": "gaKHtTlX65", "segment_title": "Russia / School Standoff / Aftermath", "segment_description": "(Studio: Peter Jennings)  Report introduced. \n (Moscow: Jim Sciutto)  The images from inside the Beslan, Russian, school that was taken over by terrorists last week featured; hostage-taker video inside the gymnasium & a demonstration against terrorism in Moscow shown; details given of Russian President Vladimir Putin&#134;'s refusal to negotiate with the rebels in Chechnya.", "segment_duration": 130, "segment_type_id": 2, "segment_start_time": "63290.0", "legacy_segment_id": 764722, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "gaKHtTlX65", "broadcast_date": "2004-09-07", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 764720, "segment_id": "Kv56NA3x5Y", "segment_broadcast_id": "gaKHtTlX65", "segment_title": "Campaign 2004 / Bush vs. Kerry / Cheney", "segment_description": "(Studio: Peter Jennings)  Report introduced.   (Washington: Jake Tapper)  Statement from Vice President Dick Cheney that the country is in danger of another terrorist attack if it makes the wrong choice in the presidential election examined; details given about this debate.  [CHENEY\u00a0- says the danger is we will be hit again.]  [Senator John EDWARDS\u00a0- responds to Cheney's scare tactics.]  [July 29, Senator John KERRY\u00a0- promises a swift response to an attack.]   (Studio: Peter Jennings)  Report introduced.   (Cincinnati: Dean Reynolds)  Kerry's campaigning in the battleground state of Ohio featured; details given of Kerry's muddling of his campaign & of the coming major thrust in Florida & the Midwest.  [KERRY\u00a0- says \"W\" stands for wrong directions, wrong choices....\"]", "segment_duration": 220, "segment_type_id": 2, "segment_start_time": "63420.0", "legacy_segment_id": 764723, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "gaKHtTlX65", "broadcast_date": "2004-09-07", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 764720, "segment_id": "VtGq0O3oTY", "segment_broadcast_id": "gaKHtTlX65", "segment_title": "Upcoming Items (Studio: Peter Jennings)", "segment_description": "null", "segment_duration": 40, "segment_type_id": 2, "segment_start_time": "63640.0", "legacy_segment_id": 764724, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "gaKHtTlX65", "broadcast_date": "2004-09-07", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "bro