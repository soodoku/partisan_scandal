: "(Boston: Tom Brokaw) American cyclist Lance Armstrong\u2019s sixth victory in the Tour de France bike race noted. \n (Paris: Ann Curry) Armstrong\u2019s training featured; scenes shown of Armstrong racing & training; details given of improvements in the design of Armstrong\u2019s helmet, bike & uniform and other technological advances. [ARMSTRONG \u2013 comments on his will to win; denies using performance-enhancing drugs and responds to doping allegations from former cycling champion Greg LeMond.] \n (NOTE: Local weather bulletin on screen.)", "segment_duration": 150, "segment_type_id": 2, "segment_start_time": "64350.0", "legacy_segment_id": 760718, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "XivhgwA8xD", "broadcast_date": "2004-07-26", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1740, "broadcast_description": null, "legacy_broadcast_id": 760708, "segment_id": "q7qaI5sxpI", "segment_broadcast_id": "XivhgwA8xD", "segment_title": "Upcoming Items (Boston: Tom Brokaw)", "segment_description": "null", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "64500.0", "legacy_segment_id": 760719, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "XivhgwA8xD", "broadcast_date": "2004-07-26", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1740, "broadcast_description": null, "legacy_broadcast_id": 760708, "segment_id": "VJEqGiq5ql", "segment_broadcast_id": "XivhgwA8xD", 