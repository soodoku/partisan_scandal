ment_title": "Iraq / Attacks", "segment_description": "(Studio: Bob Schieffer) The sabotage of an oil pipeline in Riyadh&#134;, Iraq, noted; scenes shown.", "segment_duration": 20, "segment_type_id": 2, "segment_start_time": "63640.0", "legacy_segment_id": 764459, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "qeC3v1h7DN", "broadcast_date": "2004-09-03", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1670, "broadcast_description": null, "legacy_broadcast_id": 764454, "segment_id": "Au6BlVJoSH", "segment_broadcast_id": "qeC3v1h7DN", "segment_title": "Upcoming Items; fallen hero Marine Sgt. Michael Lalush&#134<!-- spelling on screen --> profiled. (Studio: Bob Schieffer, Dan Rather)", "segment_description": "null", "segment_duration": 50, "segment_type_id": 2, "segment_start_time": "63660.0", "legacy_segment_id": 764460, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "qeC3v1h7DN", "broadcast_date": "2004-09-03", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1670, "broadcast_description": null, "legacy_broadcast_id": 764454, "segment_id": "i9sJSWq5fn", "segment_broadcast_id": "qeC3v1h7DN", "segment_title": "(Commercial: Capital One; Sea-Bond; Benefiber; Ace Hardware; Lincoln; Claritin.)", "segment_description": "null", "segment_duration": 150, "segment_type_id": 3, "segment_start_time": "63710.0", "legacy_segment_id": 764461, "network_name": "CBS", "broadcast_type_name": "Evening News", 