{"data": [{"broadcast_id": "qeC3v1h7DN", "broadcast_date": "2004-09-03", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1670, "broadcast_description": null, "legacy_broadcast_id": 764454, "segment_id": "RzC9rqx8aQ", "segment_broadcast_id": "qeC3v1h7DN", "segment_title": "Preview/Introduction Dan Rather (Florida)", "segment_description": "null", "segment_duration": 50, "segment_type_id": 1, "segment_start_time": "63000.0", "legacy_segment_id": 764454, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Preview", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "qeC3v1h7DN", "broadcast_date": "2004-09-03", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1670, "broadcast_description": null, "legacy_broadcast_id": 764454, "segment_id": "kevr1KndGv", "segment_broadcast_id": "qeC3v1h7DN", "segment_title": "Hurricane Frances / Florida", "segment_description": "(Palm Beach: Dan Rather) The concern about Hurricane Frances, which is approaching Florida, featured; scenes shown of wind & rain in the Bahamas and of people evacuating; maps shown. [WFOR-TV meteorologist Bryan NORCROSS&#134;- predicts rainfall; mentions Hurricane Charley\u2019s impact.] [EVACUEE \u2013 comments.] [Palm Beach Emergency Management director Bob WEISMAN&#134;- notes the size & slow movement of the storm.] \n (Vero Beach, Florida: Mark Strassmann) The impact that is already being felt in Florida featured; details given of mass evacuations and of Governor Jeb Bush\u2019s order to raise weight restrictions on trucks to facilitate delivery of emergency assistance; scenes shown from shelters and of raincoated tourists at Disney\u2019s Magic Kingdom. [Evacuees Pauline BRAMAN&#134;, Conrad ODOM&#134;, American Red Cross Bob ESCARILLA&#134;, BUSH, store owner Roy SCAFIDI&#134;- comment.] \n (Palm Beach: Dan Rather) Upcoming stories previewed.", "segment_duration": 280, "segment_type_id": 2, "segment_start_time": "63050.0", "legacy_segment_id": 764455, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "qeC3v1h7DN", "broadcast_date": "2004-09-03", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1670, "broadcast_description": null, "legacy_broadcast_id": 764454, "segment_id": "Md3uLQ2eRs", "segment_broadcast_id": "qeC3v1h7DN", "segment_title": "Clinton / Health", "segment_description": "(Studio: Bob Schieffer) The hospitalization of former President Bill Clinton, who needs heart bypass surgery, noted. \n (New York: Mika Brzezinski) Clinton\u2019s health featured. [Senator Hillary CLINTON&#134;- relates the doctors\u2019 advice for surgery.] [Montefiore Medical Center Dr. Jeffrey GOLD&#134;- cites the risks of the procedure.] [In \u201c60 Minutes\u201d interview, CLINTON \u2013 comments on his changes in diet.] [From the campaign trail, Senator John KERRY, President BUSH \u2013 wish Clinton well.]", "segment_duration": 150, "segment_type_id": 2, "segment_start_time": "63330.0", "legacy_segment_id": 764456, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "qeC3v1h7DN", "broadcast_date": "2004-09-03", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1670, "broadcast_descr