 Dr. Gary SMALL&#134;- talks about brain scan tests.]", "segment_duration": 150, "segment_type_id": 2, "segment_start_time": "63660.0", "legacy_segment_id": 760621, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "Me1OHru4vr", "broadcast_date": "2004-07-23", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 760615, "segment_id": "GgKnf42ML9", "segment_broadcast_id": "Me1OHru4vr", "segment_title": "Upcoming Items (Studio: Peter Jennings)", "segment_description": "null", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "63810.0", "legacy_segment_id": 760622, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "Me1OHru4vr", "broadcast_date": "2004-07-23", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 760615, "segment_id": "h00HndqwtH", "segment_broadcast_id": "Me1OHru4vr", "segment_title": "(Commercial: Ambien; Total; Bayer; Thompson's Water Seal; Terminix; \"World News Tonight.\")", "segment_description": "null", "segment_duration": 170, "segment_type_id": 3, "segment_start_time": "63820.0", "legacy_segment_id": 760623, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_