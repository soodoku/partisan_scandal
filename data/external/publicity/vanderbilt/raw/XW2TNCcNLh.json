ews", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 762155, "segment_id": "mDUmeAIlTS", "segment_broadcast_id": "XW2TNCcNLh", "segment_title": "What Does it Mean to You? (Veterans Administration)", "segment_description": "(Studio: Scott Pelley) Special Eye on America series focusing on key issues in the presidential election continued. \n (Quincy, Massachusetts: Mark Strassmann) The positions of President Bush and Senator John Kerry on veterans\u2019 benefits compared; details given of the Veterans Administration\u2019s new, tougher enrollment requirements. [World War II veteran John SAVAGE\u2020- comments on the V.A.\u2019s rejection of his application.] [American Legion national commander John BRIEDEN\u2020- says we earned this benefit.] [KERRY, BUSH \u2013 state their positions.]", "segment_duration": 160, "segment_type_id": 2, "segment_start_time": "64240.0", "legacy_segment_id": 762168, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "XW2TNCcNLh", "broadcast_date": "2004-08-12", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 762155, "segment_id": "SXR3ZeZ14i", "segment_broadcast_id": "XW2TNCcNLh", "segment_title": "Upcoming Items (Studio: Scott Pelley)", "segment_description": "null", "segment_duration": 20, "segment_type_id": 2, "segment_start_time": "64400.0", "legacy_segment_id": 762169, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "XW2TNCcNLh", "broadcast_date"