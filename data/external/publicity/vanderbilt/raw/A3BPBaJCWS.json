_title": "In Depth (Rove Interview)", "segment_description": "(New York: Tom Brokaw) Taped interview held with President Bush\u2019s political advisor Karl Rove about the presidential election; findings of an NBC News/\"Wall Street Journal\" poll cited. [ROVE \u2013 says the election will be about Iraq and the economy; comments on images of Bush aboard the USS Lincoln; responds to Bush\u2019s acknowledgement that he miscalculated in Iraq; comments on ads from the \u201cSwifties\u201d {Swift Boat Veterans for Truth} attacking Senator John Kerry\u2019s Vietnam war record and other ads from 527s.]", "segment_duration": 170, "segment_type_id": 2, "segment_start_time": "63840.0", "legacy_segment_id": 763964, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "A3BPBaJCWS", "broadcast_date": "2004-08-30", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 763957, "segment_id": "LdV4esfEW6", "segment_broadcast_id": "A3BPBaJCWS", "segment_title": "Upcoming Items (New York: Tom Brokaw)", "segment_description": "null", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "64010.0", "legacy_segment_id": 763965, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "A3BPBaJCWS", "broadcast_date": "2004-08-30", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 763957, "segment_id": 