{"data": [{"broadcast_id": "A3BPBaJCWS", "broadcast_date": "2004-08-30", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 763957, "segment_id": "3clY9pNZf2", "segment_broadcast_id": "A3BPBaJCWS", "segment_title": "Preview/Introduction Tom Brokaw (Republican National Convention in New York)", "segment_description": "null", "segment_duration": 50, "segment_type_id": 1, "segment_start_time": "63000.0", "legacy_segment_id": 763957, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "Preview", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "A3BPBaJCWS", "broadcast_date": "2004-08-30", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 763957, "segment_id": "HbMeju1ogO", "segment_broadcast_id": "A3BPBaJCWS", "segment_title": "Decision 2004 / Republican Convention", "segment_description": "(New York: Tom Brokaw) The opening of the Republican National Convention in New York noted. \n (Convention floor: Brian Williams) Campaigning by President Bush in the days before his appearance at the convention featured; scenes shown of Bush campaigning in New Hampshire & Michigan, of Vice President Dick Cheney arriving at the convention, and of security surrounding the convention site; details given of the campaign themes of strength & leadership and of the standings of Bush & Senator John Kerry in key battleground states. [BUSH \u2013 campaigns.] [NBC News Tim RUSSERT \u2013 comments on Bush\u2019s strategy.] \n (New York: Tom Brokaw) Report introduced. \n (Taylor, Michigan: David Gregory) Republican efforts to win over swing voters with moderate views featured; scenes shown of Bush with Senators John McCain & Zell Miller&#134;&#134;, former New York City Mayor Rudolph Giuliani & California Governor Arnold Schwarzenegger. [Representative Rahm EMANUEL&#134;- says Bush is using these men to vouch for him that he is not as bad as his record.] [At the 2000 convention, BUSH \u2013 promotes compassionate conservatism.] [Delegate David STORK&#135;- comments.] [Republican strategist Scott REED&#134;- says the moderates are the final part of the coalition that Bush needs to win.] \n (New York: Tom Brokaw) Report introduced. \n (New York: Carl Quintanilla) Democrats\u2019 criticism of Bush\u2019s recent statements on the war on terror & the war in Iraq featured. [Senator John EDWARDS \u2013 notes Bush\u2019s acknowledgement that he miscalculated in Iraq.] [August 6, BUSH \u2013 asks if Kerry would vote for the war.] [From \u201cToday,\u201d BUSH \u2013 states you can\u2019t win it {war on terror}, but\u2026] [While windsurfing in Nantucket, Massachusetts, KERRY \u2013 agrees the war on terror can be won.] [Emory University Dr. Merle BLACK&#134;- notes Edwards\u2019s lack of military background makes it easy for the Bush campaign to dismiss him.]", "segment_duration": 440, "segment_type_id": 2, "segment_start_time": "63050.0", "legacy_segment_id": 763958, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "A3BPBaJCWS", "broadcast_date": "2004-08-30", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 763957, "segment_id": "RMIWQsyIND", "segment_broadcast_id": "A3BPBaJCWS", "segment_title": "Iraq Watch", "segment_description": "(New York: Tom Brokaw) Rebel cleric Muqtada al-Sadr\u2019s announcement that he will join the political process in Iraq; the halt in oil production after insurgents sabotaged another pipeline, and the plea of 2 kidnapped French journalists for their government to drop the ban on head scarves in schools reported.", "segment_duration": 50, "segment_type_id": 2, "segment_start_time": "63490.0", "legacy_segment_id": 763959, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "A3BPBaJCWS", "broadcast_date": "2004-08-30", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 763957, "segment_id": "WdysfojT7A", "segment_broadcast_id": "A3BPBaJCWS", "segment_title": "Pentagon / Espionage Investigation", "segment_description": "(New York: Tom Brokaw) Report introduced.   (Pentagon: Jim Miklaszewski) The investigation into possible spying at the Pentagon by Lawrence Franklin, who works for undersecretary for policy Douglas Feith&#134;&#134; and may have passed US plans regarding Iran to Israel through AIPAC, featured; details given about the investigation\u2019s connection to allegations that Iraqi National Congress leader Ahmed Chalabi fed US secrets to Iran and about claims that the investigation is meant to embarrass Feith and Deputy Secretary of Defense Paul Wolfowitz. [Sunday, AIPAC\u2019s Bernice MANOCHERIAN&#134;- calls the allegations outrageous & baseless.]", "segment_duration": 130, "segment_type_id": 2, "segment_start_time": "63540.0", "legacy_segment_id": 763960, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "locati