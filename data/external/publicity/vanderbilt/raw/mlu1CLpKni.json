{"data": [{"broadcast_id": "mlu1CLpKni", "broadcast_date": "2004-08-27", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 763664, "segment_id": "1Tfn6WFmkJ", "segment_broadcast_id": "mlu1CLpKni", "segment_title": "Preview/Introduction Brian Williams (Greece)", "segment_description": "null", "segment_duration": 70, "segment_type_id": 1, "segment_start_time": "63000.0", "legacy_segment_id": 763664, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "Preview", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "mlu1CLpKni", "broadcast_date": "2004-08-27", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 763664, "segment_id": "jpZvzdosOp", "segment_broadcast_id": "mlu1CLpKni", "segment_title": "Iraq / Al-Sadr Revolt / Najaf", "segment_description": "(Athens: Brian Williams) Report introduced. \n (Baghdad: Preston Mendenhall) The danger remaining in Iraq despite the peace deal for Najaf arranged by Grand Ayatollah Ali al-Sistani featured; scenes shown of rebel cleric Muqtada al-Sadr\u2019s fighters leaving the Imam Ali mosque in Najaf, of Fallujah, where US troops bombed insurgents, and of the site of a car bombing in Mosul; video & photos shown of Italian journalist Enzo Baldoni&#134;&#134;, who was murdered by militants. [Iraqi MAN {thru translator} \u2013 says we hope peace can return.] [Iraq analyst M.J. GOHEL&#134;- worries there will be more trouble from al-Sadr.] \n (Athens: Brian Williams) President Bush\u2019s acknowledgement that he miscalculated the post-war conditions in Iraq reported.", "segment_duration": 160,