{"data": [{"broadcast_id": "2yvVfZmFko", "broadcast_date": "2004-08-05", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 761605, "segment_id": "yLdAZjSkVl", "segment_broadcast_id": "2yvVfZmFko", "segment_title": "Preview/Introduction Elizabeth Vargas (New York)", "segment_description": "null", "segment_duration": 50, "segment_type_id": 1, "segment_start_time": "63000.0", "legacy_segment_id": 761605, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "Preview", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "2yvVfZmFko", "broadcast_date": "2004-08-05", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 761605, "segment_id": "SCFh56KlVe", "segment_broadcast_id": "2yvVfZmFko", "segment_title": "Economy / Oil Prices", "segment_description": "(Studio: Elizabeth Vargas)  Oil price & Stock Market Report figures cited. \n (Studio: Betsy Stark)  The oil impact examined; details given of the anxiety over whether there is enough oil to satisfy demand & of the effect of rising oil prices on consumer spending & on businesses, like airlines.  [Alaron Trading Corp. energy analyst Phil FLYNN\u2020- says we are one disruption away....]  [Economists Bill CHENEY\u2020, Anthony CHAN\u2020- talk about the dent in other spending & the implications for the economy.]", "segment_duration": 160, "segment_type_id": 2, "segment_start_time": "63050.0", "legacy_segment_id": 761606, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "2yvVfZmFko", "broadcast_date": "2004-08-05", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 761605, "segment_id": "xtMzWdPqB6", "segment_broadcast_id": "2yvVfZmFko", "segment_title": "Terrorism / Al Qaeda Threat / Financial Institutions", "segment_description": "(Studio: Elizabeth Vargas)  Report introduced. \n (Washington: Pierre Thomas)  The recent arrest in Britain of Eisa al-Hindi&#134;, the man Al Qaeda leader Osama bin Laden&#134;&#134; sent to case targets in New York City, featured; details given about the evidence in the computer files of Muhammad Khan&#134;, who was arrested in Pakistan; scenes shown of the security presence in Washington, DC, due to the threat to financial institutions.  [Former counterterrorism official Richard CLARKE&#134;- talks about the digital pocket litter on computers.]  [In Pakistan in 2001, Mohammed BABAR&#134;- threatens to kill Americans.]  Concerns that more people like Babar are living in the US noted. \n (Studio: Elizabeth Vargas)  Report introduced. \n (Washington: Jonathan Karl)  The Al Qaeda strategy for terrorism attacks examined; Al Qaeda home video of the World Trade Center taken in 1997 shown; details given of Ali Mohamed's testimony about making pictures & diagrams of the US embassy in Kenya in 1993, five years before the bombing & of the planning for the attack on the USS Cole.  [Former US attorney Mary Jo WHITE&#134;- says the Al Qaeda M.O. is to wait years before putting an active plot into action.] \n (Studio: Elizabeth Vargas)  The arrest in Albany, New York, of two men from a mosque plotting to buy a shoulder-fired missile updated & the arrest in Chicago of Gale Nettles&#134;&#134; in a plot to blow up a courthouse reported.", "segment_duration": 300, "segment_type_id": 2, "segment_start_time": "63210.0", "legacy_segment_id": 761607, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "2yvVfZmFko", "broadcast_date": "2004-08-05", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 761605, "segment_id": "Bfhb9sXNRd", "segment_broadcast_id": "2yvVfZmFko", "segment_title": "Campaign 2004 / Bush vs. Kerry / September 11", "segment_description": "(Studio: Elizabeth Vargas)  Report introduced.   (Jefferson City, Missouri: Dan Harris)  The comments from presidential candidate Senator John Kerry criticizing President Bush's response immediately after the attacks of September 11, 2001, featured; details given of the political differences of the two men on the terrorism & security issue.  [KERRY&nbsp- outlines what he would have told the school children; states he can fight a better war on terrorism.]  [White House press secretary Scott McCLELLAN&nbsp- criticizes Kerry for making a political comment.]", "segment_duration": 130, "segment_type_id": 2, "segment_start_time": "63510.0", "legacy_segment_id": 761608, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "2yvVfZmFko", "broadcast_date": "2004-08-05", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 761605, "segment_id": "BFv8h86c02", "segment_broadcast_id": "2yvVfZmFko", "segment_title": "Iraq / Fighting", "segment_description": "(Studio: Elizabeth Vargas)  The heavy fighting in Najaf, Iraq, between the US, Iraqis & militias loyal to Shiite cleric Muqtada al-Sadr reported; scenes shown.", "segment_duration": 30, "segment_type_id": 2, "segment_start_time": "63640.0", "legacy_segment_id": 761609, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "2yvVfZmFko", "broadcast_date": "2004-08-05", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 761605, "segment_id": "EMqYf1IWDc", "segment_broadcast_id": "2yvVfZmFko", "segment_title": "Upcoming Items (Studio: Elizabeth Vargas)", "segment_description": "null", "segment_duration": 30, "segment_type_id": 2, "segment_start_time": "63670.0", "legacy_segment_id": 761610, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "2yvVfZmFko", "broadcast_date": "2004-08-05", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 761605, "segment_id": "uWYekhJJHL", "segment_broadcast_id": "2yvVfZmFko", "segment_title": "(Commercial: Viactiv; Bayer; LifeSavers; Beneful; Preparation H; Wal-Mart.)", "segment_description": "null", "segment_duration": 150, "segment_type_id": 3, "segment_start_time": "63700.0", "legacy_segment_id": 761611, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_w