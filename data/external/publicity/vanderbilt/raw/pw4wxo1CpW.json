{"data": [{"broadcast_id": "pw4wxo1CpW", "broadcast_date": "2004-08-12", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 762173, "segment_id": "FOahG9WCZd", "segment_broadcast_id": "pw4wxo1CpW", "segment_title": "Preview/Introduction Tom Brokaw (Greece)", "segment_description": "null", "segment_duration": 50, "segment_type_id": 1, "segment_start_time": "63000.0", "legacy_segment_id": 762173, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "Preview", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "pw4wxo1CpW", "broadcast_date": "2004-08-12", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 762173, "segment_id": "ct3EEMqJrD", "segment_broadcast_id": "pw4wxo1CpW", "segment_title": "New Jersey / McGreevey Resignation", "segment_description": "(Athens: Tom Brokaw) Report introduced. \n (New York: Tom Costello) The stunning announcement by New Jersey Governor James McGreevey that he is gay and that he is resigning featured; details given of reports that former aide Golan Cipel&#134; is planning to file a sexual harassment lawsuit. [McGREEVEY \u2013 says \u201cI am a gay American\u201d; admits an adulterous affair with a man.] [Political analyst Charlie COOKE&#134;- says McGreevey\u2019s November resignation date keeps the state in Democratic hands.]", "segment_duration": 140, "segment_type_id": 2, "segment_start_time": "63050.0", "legacy_segment_id": 762174, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "pw4wxo1CpW", "broadcast_date": "2004-08-12", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 762173, "segment_id": "eZIinf9rzw", "segment_broadcast_id": "pw4wxo1CpW", "segment_title": "California / Same-Sex Marriage", "segment_description": "(Athens: Tom Brokaw) The California supreme court\u2019s invalidation of gay marriages performed in San Francisco earlier this year reported.", "segment_duration": 30, "segment_type_id": 2, "segment_start_time": "63190.0", "legacy_segment_id": 762175, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "pw4wxo1CpW", "broadcast_date": "2004-08-12", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 762173, "segment_id": "CQ4Tmf0Arc", "segment_broadcast_id": "pw4wxo1CpW", "segment_title": "Hurricane Charley / Florida", "segment_description": "(Athens: Tom Brokaw) The double threat to Florida of Hurricane Charley & Tropical Storm Bonnie noted; map shown. \n (Key West: Martin Savidge) Preparations for Charley featured; details given of Bonnie\u2019s weakened impact on the Panhandle; scenes shown of people evacuating, boarding up buildings. [RESIDENT, TOURISTS&nbsp- react.] [National Hurricane Center director Max MAYFIELD&#134;- expresses concern about storm surge flooding on the Gulf Coast.]", "segment_duration": 140, "segment_type_id": 2, "segment_start_time": "63220.0", "legacy_segment_id": 762176, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "pw4wxo1CpW", "broadcast_date": "2004-08-12", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 762173, "segment_id": "bWyOhTWcYR", "segment_broadcast_id": "pw4wxo1CpW", "segment_title": "Iraq / Al-Sadr Revolt", "segment_description": "(Athens: Tom Brokaw) Report introduced.   (Baghdad: Preston Mendenhall) The US military\u2019s final assault on troops loyal to radical Shiite cleric Muqtada al-Sadr in Najaf, Iraq, featured; scenes shown of fighting, which stopped short of the Imam Ali mosque, and bombs exploding near al-Sadr\u2019s house in Najaf, of a protest in Basra, and of fighting in Kut & Baghdad; video shown of insurgents firing a mortar from the mosque; details given of al-Sadr\u2019s vow to fight to the death. [US military spokesman Lt. Col. Jim RAINEY&#134;- says we\u2019re being careful to stay away from the mosque.] [Voice of \u201cWashington Post\u201d\u2019s Karl VICK&#134;- says it doesn\u2019t seem to be dying down.]", "segment_duration": 130, "segment_type_id": 2, "segment_start_time": "63360.0", "legacy_segment_id": 762177, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "pw4wxo1CpW", "broadcast_date": "2004-08-12", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 762173, "segment_id": "4BlzFIt6Zo", "segment_broadcast_id": "pw4wxo1CpW", "segment_title": "Olympic Games / Bakoyannis", "segment_description": "(Athens: Tom Brokaw) The roles of the Athens Organizing Committee\u2019s Gianna Angelopoulos-Daskalaki&#134;&#134; and Athens Mayor Dora Bakoyannis&#134;&#134; in pulling together the Olympic Games noted. Bakoyannis profiled; details given of the death of her husband in a terrorist assault in 1989 and an assassination attempt on her own life. [BAKOYANNIS&NBSP- comments on the increased role of women in politics; comments on the US approach to terrorism; states she would like to be prime minister.] [Son Costas BAKOYANNIS&#134;&#134;- comments on his mother\u2019s power & popularity.]", "segment_duration": 190, "segment_type_id": 2, "segment_start_time": "63490.0", "legacy_segment_id": 762178, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "pw4wxo1CpW", "broadcast_date": "2004-08-12", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 762173, "segment_id": "aCnhon3pwr", "segment_broadcast_id": "pw4wxo1CpW", "segment_title": "Upcoming Items (Athens: Tom Brokaw)", "segment_description": "null", "segment_duration": 20, "segment_type_id": 2, "segment_start_time": "63680.0", "legacy_segment_id": 762179, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "pw4wxo1CpW", "broadcast_date": "2004-08-12", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 762173, "segment_id": "icGMu5bdqn", "segment_broadcast_id": "pw4wxo1CpW", "segment_title": "(Commercial: Pantene; Kia Spectra; American Egg Board; Fidelity Investments; Benefiber; Kia Spectra; \"Today.\")", "segment_description": "null", "segment_duration": 130, "segment_type_id": 3, "segment_start_time": "63700.0", "legacy_segment_id": 762180, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "pw4wxo1CpW", "broadcast_date": "2004-08-12", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 762173, "segment_id": "hspuTNuWgj", "segment_broadcast_id": "pw4wxo1CpW", "segment_title": "In Depth (Olympics / Drug Testing)", "segment_description": "(Athens: Tom Brokaw) Report introduced. \n (Athens: Brian Williams) Surprise testing for illegal drug use by athletes at the Olympics featured; details given of the investigation of California\u2019s Balco Laboratories, where officials were charged with distributing THG, and of the new test for human growth hormone; photos shown of athletes missing from the Games because of drug accusations. [US Olympic Committee Chief of Sport Jim SCHERR&#134;- says the majority of our athletes are drug-free.] [US Olympic drug testing lab Dr. Don CATLIN&#134;- talks about THG.] [World Anti-Doping Agency Dick POUND&#134;- says there is a serious problem.] [Cyclist Gideon MASSEY&#134;&#134;- comments on the testing.] The investigation of sprinter Marion Jones and the re-testing of samples from medal winners at the Salt Lake City Games mentioned.", "segment_duration": 190, "segment_type_id": 2, "segment_start_time": "63830.0", "legacy_segment_id": 762181, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "pw4wxo1CpW", "broadcast_date": "2004-08-12", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 762173, "segment_id": "DyevypMWtV", "segment_broadcast_id": "pw4wxo1CpW", "segment_title": "Upcoming Items (Athens: Tom Brokaw)", "segment_description": "null", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "64020.0", "legacy_segment_id": 762182, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "pw4wxo1CpW", "broadcast_date": "2004-08-12", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 762173, "segment_id": "yanZhmH1UZ", "segment_broadcast_id": "pw4wxo1CpW", "segment_title": "(Commercial: Cheerios; Sonicare; Minwax; Cheez-It; Procrit; Imitrex; Wal-Mart.)", "segment_description": "null", "segment_duration": 150, "segment_type_id": 3, "segment_start_time": "64030.0", "legacy_segment_id": 762183, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "pw4wxo1CpW", "broadcast_date": "2004-08-12", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 762173, "segment_id": "SC3nIlTS7N", "segment_broadcast_id": "pw4wxo1CpW", "segment_title": "Decision 2004 / Bush vs. Kerry / War on Terror", "segment_description": "(Athens: Tom Brokaw) President & Laura Bush shown visiting Nancy Reagan at her home in Bel Air, California, despite their differences on stem cell research. Vice President Dick Cheney\u2019s attack on Senator John Kerry over his statement that he would fight a more \u201csensitive\u201d war on terror noted. [In Dayton, Ohio, CHENEY \u2013 criticizes Kerry.]", "segment_duration": 100, "segment_type_id": 2, "segment_start_time": "64180.0", "legacy_segment_id": 762184, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "pw4wxo1CpW", "broadcast_date": "2004-08-12", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 762173, "segment_id": "tHMfc4Ejhi", "segment_broadcast_id": "pw4wxo1CpW", "segment_title": "Terrorism / Helicopters", "segment_description": "(Athens: Tom Brokaw) The detention in St. Louis of an NBC team that tried to charter a helicopter to test the government\u2019s anti-terror measures in the wake of the announcement that Al Qaeda might try to use helicopters as weapons reported; scenes shown. [Homeland Security spokesman Brian ROEHRKASSE&#134;- says this scenario shows that the system works.]", "segment_duration": 50, "segment_type_id": 2, "segment_start_time": "64280.0", "legacy_segment_id": 762185, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_na