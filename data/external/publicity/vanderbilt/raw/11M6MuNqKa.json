{"data": [{"broadcast_id": "11M6MuNqKa", "broadcast_date": "2004-09-01", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 764255, "segment_id": "aIg2cy9bgY", "segment_broadcast_id": "11M6MuNqKa", "segment_title": "Preview/Introduction Dan Rather (Republican National Convention in New York)", "segment_description": "null", "segment_duration": 50, "segment_type_id": 1, "segment_start_time": "63000.0", "legacy_segment_id": 764255, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Preview", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "11M6MuNqKa", "broadcast_date": "2004-09-01", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 764255, "segment_id": "73cpjDrvdO", "segment_broadcast_id": "11M6MuNqKa", "segment_title": "Campaign 04 / Republican National Convention", "segment_description": "(New York: Dan Rather) President Bush shown campaigning in Columbus, Ohio, after which he will travel to the Republican National Convention in New York City to give his acceptance speech.", "segment_duration": 20, "segment_type_id": 2, "segment_start_time": "63050.0", "legacy_segment_id": 764256, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "11M6MuNqKa", "broadcast_date": "2004-09-01", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 764255, "segment_id": "Ie0dms6UMT", "segment_broadcast_id": "11M6MuNqKa", "segment_title": "Hurricane Frances", "segment_description": "(New York: Dan Rather) Map shown of the projected path of Hurricane Frances. \n (Orlando, Florida: Mark Strassmann) Precautions taken as the storm approaches Florida, which is still recovering from Hurricane Charley, featured; scenes shown of people boarding up buildings & buying supplies, damage from Charley; maps shown. [WFOR-TV meteorologist Bryan NORCROSS&#134;- says somebody is going to have a very bad hurricane event.] [Florida Governor Jeb BUSH \u2013 comments on evacuation orders.] [Charley victim Perry GRANGER&#134;- reacts to damage to his home.]", "segment_duration": 160, "segment_type_id": 2, "segment_start_time": "63070.0", "legacy_segment_id": 764257, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "11M6MuNqKa", "broadcast_date": "2004-09-01", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 764255, "segment_id": "SfS0jcSBJv", "segment_broadcast_id": "11M6MuNqKa", "segment_title": "Russia / School Standoff", "segment_description": "(New York: Dan Rather) Report introduced. \n (Moscow: Elizabeth Palmer) The invasion of a school in Beslan, Russia, by armed militants who are holding many hostages, including children, featured; scenes shown of Russian soldiers surrounding the school and distraught family members; details recalled of recent violence involving rebels from Chechnya.", "segment_duration": 130, "segment_type_id": 2, "segment_start_time": "63230.0", "legacy_segment_id": 764258, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "11M6MuNqKa", "broadcast_date": "2004-09-01", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 764255, "segment_id": "JY53kiKVuM", "segment_broadcast_id": "11M6MuNqKa", "segment_title": "Iraq / Unrest", "segment_description": "(New York: Dan Rather) Civilian deaths in the US bombing of a suspected militant hideout in Fallujah, Iraq, and the release of 7 hostages while 2 kidnapped French journalists remain under a death threat reported; scenes shown of the freed men in Kuwait City.", "segment_duration": 20, "segment_type_id": 2, "segment_start_time": "63360.0", "legacy_segment_id": 764259, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "11M6MuNqKa", "broadcast_date": "2004-09-01", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 764255, "segment_id": "6l2J6jt704", "segment_broadcast_id": "11M6MuNqKa", "segment_title": "Afghanistan / Prisoner Abuse", "segment_description": "(New York: Dan Rather) Charges against US soldiers in the deaths of 2 prisoners in Afghanistan noted.", "segment_duration": 20, "segment_type_id": 2, "segment_start_time": "63380.0", "legacy_segment_id": 764260, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "11M6MuNqKa", "broadcast_date": "2004-09-01", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 764255, "segment_id": "N4OldO7SuH", "segment_broadcast_id": "11M6MuNqKa", "segment_title": "Campaign 04 / Republican Convention", "segment_description": "(New York: Dan Rather) Day 3 of the Republican National Convention in New York City, where Vice President Dick Cheney will speak, introduced.   (Convention floor: John Roberts) The action at the convention tonight previewed; details given of controversy surrounding Cheney, including his comments regarding gay marriage, and of the keynote speech by Democratic Senator Zell Miller; Republican Party platform outlined. [MILLER \u2013 supports President Bush; criticizes Senator John Kerry\u2019s anti-war activism.] [New York University Paul LIGHT&#134;- likens the convention to \u201ctheater of the moderate.\u201d] The plan for the Bush campaign to name former Secretary of State James Baker as chief negotiator for the presidential debates noted.   (New York: Dan Rather) Report introduced.   (Nashville, Tennessee: Byron Pitts) Kerry\u2019s defense against Republican attacks in a break with tradition by speaking during the opposition\u2019s convention featured; details given about possible problems within the Kerry campaign. [Before the American Legion in Nashville, KERRY \u2013 says he would have done almost everything differently {regarding Iraq}; disagrees with Bush\u2019s comments about not being able to win the war on terror.] [University of Virginia Larry SABATO&#134;- says when a candidate is his own campaign manager, he\u2019s halfway to losing.]", "segment_duration": 290, "segment_type_id": 2, "segment_start_time": "63400.0", "legacy_segment_id": 764261, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "11M6MuNqKa", "broadcast_date": "2004-09-01", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 764255, "segment_id": "ne8LQXzTNV", "segment_broadcast_id": "11M6MuNqKa", "segment_title": "Upcoming Items; fallen hero Army CWO2 Lawrence \"Shane\" Colton&#134<!-- spelling on screen --> profiled. (New York: Dan Rather)", "segment_description": "null", "segment_duration": 50, "segment_type_id": 2, "segment_start_time": "63690.0", "legacy_segment_id": 764262, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "11M6MuNqKa", "broadcast_date": "2004-09-01", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 764255, "segment_id": "29X7cYd2cg", "segment_broadcast_id": "11M6MuNqKa", "segment_title": "(Commercial: Pepto-Bismol; Claritin; Sea-Bond; Plavix; Ensure; Ace Hardware.)", "segment_description": "null", "segment_duration": 160, "segment_type_id": 3, "segment_start_time": "63740.0", "legacy_segment_id": 764263, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "11M6MuNqKa", "broadcast_date": "2004-09-01", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 764255, "segment_id": "qwYc633xNO", "segment_broadcast_id": "11M6MuNqKa", "segment_title": "Colorado / Bryant Rape Case", "segment_description": "(New York: Dan Rather) Report introduced. \n (Los Angeles: Sandra Hughes) The decision by Colorado prosecutors to drop criminal rape charges against basketball player Kobe Bryant featured; details given of the series of adverse rulings that led to the collapse of the case and of the accuser\u2019s civil suit against Bryant. [Loyola Law School Laurie LEVENSON&#134;- suggests the prosecution didn\u2019t know the whole story when they started.]", "segment_duration": 130, "segment_type_id": 2, "segment_start_time": "63900.0", "legacy_segment_id": 764264, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "11M6MuNqKa", "broadcast_date": "2004-09-01", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 764255, "segment_id": "mSAkO2rBEw", "segment_broadcast_id": "11M6MuNqKa", "segment_title": "Market Watch: Oil Prices, Stocks", "segment_description": "(New York: Dan Rather) Crude oil prices cited; Stock Market Report.", "segment_duration": 20, "segment_type_id": 2, "segment_start_time": "64030.0", "legacy_segment_id": 764265, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "11M6MuNqKa", "broadcast_date": "2004-09-01", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 764255, "segment_id": "lH7g34IZmd", "segment_broadcast_id": "11M6MuNqKa", "segment_title": "Upcoming Items (New York: Dan Rather)", "segment_description": "null", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "64050.0", "legacy_segment_id": 764266, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "11M6MuNqKa", "broadcast_date": "2004-09-01", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 764255, "segment_id": "31alWGsu92", "segment_broadcast_id": "11M6MuNqKa", "segment_title": "(Commercial: Capital One; Alka-Seltzer; Fixodent; Lamisil; Summit Medical Center.)", "segment_description": "null", "segment_duration": 150, "segment_type_id": 3, "segment_start_time": "64060.0", "legacy_segment_id": 764267, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "11M6MuNqKa", "broadcast_date": "2004-09-01", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 764255, "segment_id": "MXl1WNXcwT", "segment_broadcast_id": "11M6MuNqKa", "segment_title": "Terrorism / Detroit, Michigan", "segment_description": "(New York: Dan Rather) The Justice Department\u2019s recommendation for dismissing convictions in a Detroit terror cell case after admitting to a pattern of mistakes by prosecutors reported.", "segment_duration": 20, "segment_type_id": 2, "segment_start_time": "64210.0", "legacy_segment_id": 764268, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "11M6MuNqKa", "broadcast_date": "2004-09-01", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 764255, "segment_id": "OZA2WIvAuM", "segment_broadcast_id": "11M6MuNqKa", "segment_title": "Inside Story (The Bush Promise: Foreign Policy) Part III", "segment_description": "(New York: Dan Rather) Special convention-week look at what has become of the promises made by President Bush during his 2000 presidential campaign continued. \n (Baghdad: Barry Petersen) Bush\u2019s promise regarding the use of military force examined; details given about shifting goals in Iraq and the impact of the Iraq war on the fight against terrorism. [At the Republican National Convention in August, 2000, BUSH \u2013 speaks about using force in the world; says he would be careful about using our troops as nation-builders.] [Carnegie Endowment for International Peace Jessica Tuchman MATHEWS&#134;- says the war has made us less safe.]", "segment_duration": 160, "segment_type_id": 2, "segment_start_time": "64230.0", "legacy_segment_id": 764269, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "11M6MuNqKa", "broadcast_date": "2004-09-01", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 764255, "segment_id": "ydAqZqJzf2", "segment_broadcast_id": "11M6MuNqKa", "segment_title": "Upcoming Items (New York: Dan Rather)", "segment_description": "null", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "64390.0", "legacy_segment_id": 764270, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "11M6MuNqKa", "broadcast_date": "2004-09-01", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 764255, "segment_id": "Sypyx7V5XU", "segment_broadcast_id": "11M6MuNqKa", "segment_title": "(Commercial: Sea-Bond; Cialis; Beltone; Beano; Capital One; Olay; Hyundai Sonata; NewsChannel 5.)", "segment_description": "null", "segment_duration": 160, "segment_type_id": 3, "segment_start_time": "64400.0", "legacy_segment_id": 764271, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "11M6MuNqKa", "broadcast_date": "2004-09-01", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 764255, "segment_id": "E6dEHcjEAI", "segment_broadcast_id": "11M6MuNqKa", "segment_title": "Campaign 04 / Republican National Convention / Protests", "segment_description": "(New York: Dan Rather) Protestors against President Bush\u2019s policies shown outside the Republican National Convention.   (New York: Jim Axelrod) The arrests of hundreds of protestors during the convention featured; scenes shown; figures compared to the 1968 Democratic convention in Chicago. [New York City Mayor Michael BLOOMBERG \u2013 says when you got out of hand, we arrested you.] [Bike rider Austin MULLER&#134;- says the cops have been acting without any discretion.] [\u201cVillage Voice\u201d Tom ROBBINS&#134;- says both sides have been trying to hold back.] [New York University School of Law Karen GREENBERG&#134;- says this is not about wanting violence.]", "segment_duration": 130, "segment_type_id": 2, "segment_start_time": "64560.0", "legacy_segment_id": 764272, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "11M6MuNqKa", "broadcast_date": "2004-09-01", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 764255, "segment_id": "BITdYEba46", "segment_broadcast_id": "11M6MuNqKa", "segment_title": "Good Night", "segment_description": "null", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "64690.0", "legacy_segment_id": 764273, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}]}