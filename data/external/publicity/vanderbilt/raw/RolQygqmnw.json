{"data": [{"broadcast_id": "RolQygqmnw", "broadcast_date": "2004-07-26", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 760681, "segment_id": "j2Ei4qIjZf", "segment_broadcast_id": "RolQygqmnw", "segment_title": "Preview/Introduction Peter Jennings (Democratic National Convention)", "segment_description": "null", "segment_duration": 60, "segment_type_id": 1, "segment_start_time": "63000.0", "legacy_segment_id": 760681, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "Preview", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "RolQygqmnw", "broadcast_date": "2004-07-26", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 760681, "segment_id": "5M6OKDFBpo", "segment_broadcast_id": "RolQygqmnw", "segment_title": "Campaign 2004 / Democratic Convention / Kerry Campaign", "segment_description": "(Convention floor: Peter Jennings)  Live coverage from the Democratic National Convention presented; scenes shown from the noisy convention floor; details given of ABC News/\"Washington Post\" poll findings on the public's view of Senator John Kerry & the issues that indicate Kerry slippage. \n (Convention floor: Peter Jennings, George Stephanopoulos)  Kerry's likely reaction to the low poll numbers, his need to close the numbers on leadership & the importance of his coming speech discussed. \n (Convention floor: Kate Snow)  The opening day of the convention featured; scenes shown from the crowded convention floor & of security; details given about speeches tonight by former Vice President Al Gore & former President Bill Clinton.  [Minnesota delegate Dan BROWN\u2020, filmmaker Michael MOORE, New Mexico Governor Bill RICHARDSON\u00a0- speak about what needs to be done here.]  [Republican National Committee chairman Ed GILLESPIE\u2020- calls the Democrats angry & bitter.] \n (Convention floor: Peter Jennings)  The careful choreography of this week of political events noted. \n (Norfolk, Virginia: Dan Harris)  Kerry's six-day rolling tour of battleground states on the way to the convention featured; scenes shown from the Kennedy Space Center.  [KERRY\u00a0- talks about \"launching\" something from Cape Canaveral.]  [In 1971, KERRY\u00a0- asks how you ask a man to be the last to die for a mistake.]  [\"Boston Globe\" reporter Michael KRANISH\u2020- says Kerry needs to recapture the passion of 1971.]  [Last night with Pennsylvania delegates, wife Teresa Heinz KERRY\u00a0- comments on \"un-American traits.\"]  [Later, in exchange with newspaper journalist Colin McNickle\u2020, KERRY\u00a0- denies saying it; tells him \"to shove it.\"]  [Senator KERRY\u00a0- reacts.]", "segment_duration": 550, "segment_type_id": 2, "segment_start_time": "63060.0", "legacy_segment_id": 760682, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "RolQygqmnw", "broadcast_date": "2004-07-26", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 760681, "segment_id": "ckb3G2rq4z", "segment_broadcast_id": "RolQygqmnw", "segment_title": "Upcoming Items (Convention floor: Peter Jennings)", "segment_description": "null", "segment_duration": 30, "segment_type_id": 2, "segment_start_time": "63610.0", "legacy_segment_id": 760683, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "RolQygqmnw", "broadcast_date": "2004-07-26", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 760681, "segment_id": "E6SC6EyXo9", "segment_broadcast_id": "RolQygqmnw", "segment_title": "(Commercial: York; Maalox; Wal-Mart; Procrit; Centrum; Terminix; Merck.)", "segment_description": "null", "segment_duration": 160, "segment_type_id": 3, "segment_start_time": "63640.0", "legacy_segment_id": 760684, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "RolQygqmnw", "broadcast_date": "2004-07-26", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 760681, "segment_id": "ChAj5LaGj1", "segment_broadcast_id": "RolQygqmnw", "segment_title": "Campaign 2004 / The Money Trail (Convention Campaign Finances) Part I", "segment_description": "(Boston: Peter Jennings)  Report introduced. \n (Boston: Brian Ross)  The loophole in the campaign finance law allowing companies to spend as much as they want at conventions examined; scenes shown of last night's fireworks in Boston harbor paid for by Time Warner for Representative Nancy Pelosi, who refused to answer & other corporate-paid parties, including the one for Senator Hillary Clinton.  [Democracy21.com president Fred WERTHEIMER&#134;- talks about finance rules & this \"ethics-free zone.\"]  [Time Warner chairman Richard PARSONS&#134;- comments.]  The Congressional laws that allow companies to reveal how much they spent on parties to make friends & influence people noted.", "segment_duration": 230, "segment_type_id": 2, "segment_start_time": "63800.0", "legacy_segment_id": 760685, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "RolQygqmnw", "broadcast_date": "2004-07-26", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 760681, "segment_id": "XP2BbBz8Lu", "segment_broadcast_id": "RolQygqmnw", "segment_title": "Upcoming Items (Boston: Peter Jennings)", "segment_description": "null", "segment_duration": 20, "segment_type_id": 2, "segment_start_time": "64030.0", "legacy_segment_id": 760686, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "RolQygqmnw", "broadcast_date": "2004-07-26", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 760681, "segment_id": "GLg664Pt4c", "segment_broadcast_id": "RolQygqmnw", "segment_title": "(Commercial: Philip Morris PSA; Nexium; Transitions; Thompson's Water Seal; Bayer.)", "segment_description": "null", "segment_duration": 150, "segment_type_id": 3, "segment_start_time": "64050.0", "legacy_segment_id": 760687, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_r