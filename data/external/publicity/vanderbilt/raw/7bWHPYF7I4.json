{"data": [{"broadcast_id": "7bWHPYF7I4", "broadcast_date": "2004-09-06", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 764682, "segment_id": "UUtlyhgIrn", "segment_broadcast_id": "7bWHPYF7I4", "segment_title": "Preview/Introduction Charles Gibson (New York)", "segment_description": "null", "segment_duration": 50, "segment_type_id": 1, "segment_start_time": "63000.0", "legacy_segment_id": 764682, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "Preview", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "7bWHPYF7I4", "broadcast_date": "2004-09-06", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 764682, "segment_id": "21QEQJdpHo", "segment_broadcast_id": "7bWHPYF7I4", "segment_title": "Clinton / Health / Bypass Surgery", "segment_description": "(Studio: Charles Gibson)  Report introduced. \n (New York: John Berman)  Former President Bill Clinton's heart bypass surgery reviewed; details given about the operation with an animated diagram shown.  [Chief of cardiothoracic surgery Dr. Craig SMITH&#134;- says the operation was \"routine.\"]  [Chief of cardiology Dr. Allan SCHWARTZ&#134;- says he would likely have had a substantial heart attack.]  Statement from Senator Hillary Clinton & daughter Chelsea quoted. \n (Studio: Charles Gibson; Boston: Tim Johnson)  The background to Clinton's heart surgery, his going off statin drugs & his cholesterol levels discussed. \n (Studio: Charles Gibson)  That fact that Clinton's physician, Dr. Smith, is a contributor to President Bush's campaign noted.", "segment_duration": 230, "segment_type_id": 2, "segment_start_time": "63050.0", "legacy_segment_id": 764683, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "7bWHPYF7I4", "broadcast_date": "2004-09-06", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 764682, "segment_id": "S0BAPCQeJC", "segment_broadcast_id": "7bWHPYF7I4", "segment_title": "Hurricane Frances / Florida", "segment_description": "(Studio: Charles Gibson)  Map shown of the route of now  Tropical Storm Frances. \n (Shell Point, Florida: Barbara Pinto)  The rain from Hurricane Frances in the Florida panhandle reviewed; scenes shown of a sunken boat & the seas. \n (Studio: Charles Gibson)  Report introduced. \n (Ft. Pierce, Florida: Jeffrey Kofman)  The damage from Hurricane Frances featured; scenes shown of waves, rain, wind, damaged homes, flooded streets, of people in Ft. Pierce in line for water, gasoline & supplies & repair trucks; details given of the extent of the power outages.  [Three WOMEN, TRUCKER&nbsp- comment.]  [OFFICIAL&nbsp- says the storm has impacted the entire state.]  The course of Hurricane Ivan noted. \n (Studio: Charles Gibson)  The one-two punch for Florida from Hurricanes Charley & Frances noted. \n (Lake Wales, Florida: David Muir)  The hammering of homes by the two hurricanes featured; scenes shown from the small community of Lake Wales.  [Homeowners Annie GRAVES, Sam COURTNEY, his DAUGHTER&nbsp- describe what happened with Frances.]", "segment_duration": 360, "segment_type_id": 2, "segment_start_time": "63280.0", "legacy_segment_id": 764684, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "7bWHPYF7I4", "broadcast_date": "2004-09-06", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 764682, "segment_id": "vqByUymwGm", "segment_broadcast_id": "7bWHPYF7I4", "segment_title": "Upcoming Items (Studio: Charles Gibson)", "segment_description": "null", "segment_duration": 30, "segment_type_id": 2, "segment_start_time": "63640.0", "legacy_segment_id": 764685, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "7bWHPYF7I4", "broadcast_date": "2004-09-06", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 764682, "segment_id": "r976nNgzxX", "segment_broadcast_id": "7bWHPYF7I4", "segment_title": "(Commercial: Cialis; Bayer; Wal-Mart; Maalox; ThermaCare.)", "segment_description": "null", "segment_duration": 160, "segment_type_id": 3, "segment_start_time": "63670.0", "legacy_segment_id": 764686, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "7bWHPYF7I4", "broadcast_date": "2004-09-06", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 764682, "segment_id": "evds6QNF1E", "segment_broadcast_id": "7bWHPYF7I4", "segment_title": "Iraq / Attacks", "segment_description": "(Studio: Charles Gibson)  Report introduced. \n (Baghdad: Mike von Fremd)  The death of seven US Marines in a suicide attack near Fallujah, Iraq, featured; scenes shown of the burning convoy; details given of the failure of Iraqi forces to hold Fallujah after the US pulled out & of the day's casualties in Baghdad.  [Brookings Inst. Michael O'HANLON&#134;- assesses the situation.] \n (Studio: Charles Gibson)  US casualty figures updated.", "segment_duration": 100, "segment_type_id": 2, "segment_start_time": "63830.0", "legacy_segment_id": 764687, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "7bWHPYF7I4", "broadcast_date": "2004-09-06", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 764682, "segment_id": "A59r54uhXw", "segment_broadcast_id": "7bWHPYF7I4", "segment_title": "Campaign 2004 / Bush vs. Kerry / Labor Day", "segment_description": "(Studio: Charles Gibson)  Report introduced. \n (Cleveland: Dean Reynolds)  Senator John Kerry's campaign emphasizing domestic issues while dealing with his position on the war in Iraq featured.  [In Pennsylvania & Cleveland, KERRY&nbsp- says it's the wrong war in the wrong place....; asserts the \"W\" stand for wrong choices, wrong judgment, wrong priorities & wrong direction.]  [President BUSH&nbsp- accuses Kerry of taking a new position.]  [Kerry-Edwards campaign adviser Joe LOCKHART&#134;- says former President Bill Clinton is an invaluable resource for the Kerry campaign.]", "segment_duration": 130, "segment_type_id": 2, "segment_start_time": "63930.0", "legacy_segment_id": 764688, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "7bWHPYF7I4", "broadcast_date": "2004-09-06", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 764682, "segment_id": "X18pkn37Fj", "segment_broadcast_id": "7bWHPYF7I4", "segment_title": "Upcoming Items (Studio: Charles Gibson)", "segment_description": "null", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "64060.0", "legacy_segment_id": 764689, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "7bWHPYF7I4", "broadcast_date": "2004-09-06", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 764682, "segment_id": "aTW9Z6VUYz", "segment_broadcast_id": "7bWHPYF7I4", "segment_title": "(Commercial: Fosamax; Total; Levitra; Ecotrin; Pepcid; \"World News Tonight\")", "segment_description": "null", "segment_duration": 170, "segment_type_id": 3, "segment_start_time": "64070.0", "legacy_segment_id": 764690, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "7bWHPYF7I4", "broadcast_date": "2004-09-06", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "b