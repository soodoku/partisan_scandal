bama presidency and his campaign\u2019s attempts to change the subject from the economy discussed. [McCAIN \u2013 says Obama is a decent person and you do not have to be scared.] The lineup for \u201cFace the Nation\u201d reviewed. ", "segment_duration": 190, "segment_type_id": 2, "segment_start_time": "63530.0", "legacy_segment_id": 920947, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "v8x7sohDmE", "broadcast_date": "2008-10-10", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 920943, "segment_id": "oEyGfqBZvg", "segment_broadcast_id": "v8x7sohDmE", "segment_title": "Upcoming Items (Studio: Maggie Rodriguez)", "segment_description": " ", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "63720.0", "legacy_segment_id": 920948, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "v8x7sohDmE", "broadcast_date": "2008-10-10", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 920943, "segment_id": "W3IiG6uffp", "segment_broadcast_id": "v8x7sohDmE", "segment_title": "(Commercial: Healthy Choice; Lipitor; Red Lobster; Florida orange juice; One-A-Day; Glucerna.)", "segment_description": " ", "segment_duration": 150, "segment_type_id": 3, "segment_start_time": "63730.0", "legacy_segment_id": 920949, "network_name": "CBS", "broadcast_type_name": "Evening News", "seg