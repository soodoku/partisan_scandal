legacy_broadcast_id": 763506, "segment_id": "YWqrRcZnAt", "segment_broadcast_id": "IuHqlw1FaC", "segment_title": "In Depth (Tribunal)", "segment_description": "(Athens: Brian Williams)  Report introduced. \n (Heidelberg: Fred Francis)  The investigation into the prisoner abuse scandal in Iraq examined; abuse photos shown; details given about the testimony at the tribunal about leadership & policy.  [In Heidelberg, Germany, defense attorney Harvey VOLZER&#135;- says the military intelligence personnel authorized everything that happened & the generals put things in motion.]  [Cpl. Charles Graner's defense attorney Guy WOMACK&#134;- says the soldiers thought what they did was lawful.]", "segment_duration": 140, "segment_type_id": 2, "segment_start_time": "63870.0", "legacy_segment_id": 763513, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "IuHqlw1FaC", "broadcast_date": "2004-08-22", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1710, "broadcast_description": null, "legacy_broadcast_id": 763506, "segment_id": "Pw5n9QP4uT", "segment_broadcast_id": "IuHqlw1FaC", "segment_title": "Upcoming Items (Athens: Brian Williams)", "segment_description": "null", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "64010.0", "legacy_segment_id": 763514, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "IuHqlw1FaC", "broadcast_date": "2004-08-22", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_d