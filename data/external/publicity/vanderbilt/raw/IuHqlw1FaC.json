adcast_id": "IuHqlw1FaC", "broadcast_date": "2004-08-22", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1710, "broadcast_description": null, "legacy_broadcast_id": 763506, "segment_id": "9pxyavvAOu", "segment_broadcast_id": "IuHqlw1FaC", "segment_title": "Campaign 2004 / Bush vs. Kerry / Kerry's War Record", "segment_description": "(Athens: Brian Williams)  Report introduced. \n (New York: Carl Quintanilla)  The controversy in the presidential election campaign over Senator John Kerry's Vietnam war record updated; details given about the day's accounts.  [Swift Boat Veterans for Truth John O'NEILL&#134;- asks Kerry to directly answer charges.]  [Senator John EDWARDS&nbsp- appeals to President Bush.]  [On talk shows, Kerry campaign advisor Tad DEVINE&#134;, Bush campaign manager Ken MEHLMAN&#134;- comment.]  Bush campaign statement about Ken Cordier&#134;, who appeared in the Swift boat campaign ad, quoted.  [On CNN, former Senator Bob DOLE&nbsp- questions Kerry's record.] \n (Athens: Brian Williams)  The rumors that Bush might show up at the Olympic Games in Athens, Greece, mentioned. \n (Crawford: Norah O'Donnell)  Bush's campaign themes a week before the Republican National Convention featured; details given about the promises kept & promises unfulfilled; scenes shown of Bush with Senator John McCain.  [BUSH&nbsp- campaigns.]  [DEVINE&nbsp- says Bush has broken commitments.]  [Former presidential advisor David GERGEN&#134;- talks about the critical battleground states.]", "segment_duration": 270, "segment_type_id": 2, "segment_start_time": "63180.0", "legacy_segment_id": 763508, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "IuHqlw1FaC", "broadcast_date": "2004-08-22", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1710, "broadcast_description": null, "legacy_broadcast_id": 763506, "segment_id": "7JcLZM5Gmu", "segment_broadcast_id": "IuHqlw1FaC", "segment_title": "Norway / \"The Scream\" Heist", "segment_description": "(Athens: Brian Williams)  Report introduced.   (London: Charles Sabine)  The audacious theft in Norway of two paintings by Edvard Munch, including the famous \"The Scream,\" featured; videotape shown; details given about the iconic nature of this painting.  [Museum VISITORS&nbsp- describe what happened.]  [Art theft expert Sarah JACKSON&#134;- outlines what the thieves may try to do with the paintings.]", "segment_duration": 120, "segment_type_id": 2, "segment_start_time": "63450.0", "legacy_segment_id": 763509, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "IuHqlw1FaC", "broadcast_date": "2004-08-22", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1710, "broadcast_description": null, "legacy_broadcast_id": 763506, "segment_id": "jQTE54BAtR", "segment_broadcast_id": "IuHqlw1FaC", "segment_title": "Hurricane Charley / Florida", "segment_description": "(Athens: Brian Williams)  Report introduced.   (Sarasota & Punta Gorda: Mark Potter)  The impact of Hurricane Charley on Florida's children featured; scenes shown of the devastation & of kids in one county getting an extra week of summer vacation before school.  [Mother Kathy HEIL&#135;- says the children will need counseling.]", "segment_duration": 150, "segment_type_id": 2, "segment_start_time": "63570.0", "legacy_segment_id": 763510, "network_name": "NBC", "broadcast_type