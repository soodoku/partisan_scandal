": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1710, "broadcast_description": null, "legacy_broadcast_id": 763506, "segment_id": "jyc0QmAEbl", "segment_broadcast_id": "IuHqlw1FaC", "segment_title": "Olympic Games / Beach Volleyball", "segment_description": "(Athens: Brian Williams)  Report introduced. \n (Athens: Rehema Ellis)  The popular Olympic sport of beach volleyball featured; game scenes shown; details given about the best American pair.  [Players Kerri WALSH&#134;&#134;, Misty MAY&#134;&#134;- talk about their sport & playing together.] \n (Athens: Brian Williams)  The result of the 100m men's race outlined on screen.", "segment_duration": 170, "segment_type_id": 2, "segment_start_time": "64330.0", "legacy_segment_id": 763517, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "IuHqlw1FaC", "broadcast_date": "2004-08-22", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1710, "broadcast_description": null, "legacy_broadcast_id": 763506, "segment_id": "CYREq85Sbh", "segment_broadcast_id": "IuHqlw1FaC", "segment_title": "(Commercial: Nexium; Sure; Benefiber; Advair.)", "segment_description": "null", "segment_duration": 140, "segment_type_id": 3, "segment_start_time": "64500.0", "legacy_segment_id": 763518, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "IuHqlw1FaC", "broadcast_date": "2004-08-22", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1710, "broad