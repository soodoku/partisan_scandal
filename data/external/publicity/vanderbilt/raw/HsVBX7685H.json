{"data": [{"broadcast_id": "HsVBX7685H", "broadcast_date": "2004-08-09", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1730, "broadcast_description": null, "legacy_broadcast_id": 761824, "segment_id": "J3OZLGV6uz", "segment_broadcast_id": "HsVBX7685H", "segment_title": "Preview/Introduction Tom Brokaw (New York)", "segment_description": "null", "segment_duration": 50, "segment_type_id": 1, "segment_start_time": "63000.0", "legacy_segment_id": 761824, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "Preview", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "HsVBX7685H", "broadcast_date": "2004-08-09", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1730, "broadcast_description": null, "legacy_broadcast_id": 761824, "segment_id": "MI55VrmZst", "segment_broadcast_id": "HsVBX7685H", "segment_title": "Iraq / Al-Sadr Revolt / Chalabi", "segment_description": "(Studio: Tom Brokaw) Report introduced. \n (Baghdad: Preston Mendenhall) The efforts of the Iraqi government to deal with ongoing violence & political rivalry featured; details given about the uprising of Shiite cleric Muqtada al-Sadr\u2019s militias, which prompted a suspension of oil production, and about counterfeiting charges against former government leader Ahmed Chalabi; scenes shown of fighting in Najaf & Basra. [Criminal judge Zuhair al-MALIKY&#134;&#134;- comments on the Chalabi case.] [In Iran, CHALABI \u2013 denies the charges.] [Iraq analyst Amatzia BARAM&#134;- comments on the blow to Chalabi\u2019s credibility after no weapons of mass destruction were discovered in Iraq.] [State Department spokesman J. Adam ERELI&#134;- says this is the Iraqi justice system at work.] The murder accusation against Chalabi\u2019s nephew, Salem Chalabi, noted. [In London, S. CHALABI \u2013 denies charges.] \n (Studio: Tom Brokaw) A deadly car bombing in Baquba aimed at a local government official and the State Department\u2019s defense of the decision to ban Al Jazeera from Iraq for 30 days noted; scenes shown from Baquba.", "segment_duration": 210, "segment_type_id": 2, "segment_start_time": "63050.0", "legacy_segment_id": 761825, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "HsVBX7685H", "broadcast_date": "2004-08-09", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1730, "broadcast_description": null, "legacy_broadcast_id": 761824, "segment_id": "sqeAr1H0qo", "segment_broadcast_id": "HsVBX7685H", "segment_title": "Terrorism / Al Qaeda Threat", "segment_description": "(Studio: Tom Brokaw) Report introduced. \n (Washington: Pete Williams) The evolving evidence of an Al Qaeda plot to attack the US featured; details given of the FBI\u2019s warnings about the use of limousines or helicopters as weapons and of investigations into terror suspects Issa al-Hindi, captured in Britain last week, and Adnan Shukrijumah. [New York City Mayor Michael BLOOMBERG \u2013 describes helicopter security since 9/11.]", "segment_duration": 120, "segment_type_id": 2, "segment_start_time": "63260.0", "legacy_segment_id": 761826, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "HsVBX7685H", "broadcast_date": "2004-08-09", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1730, "broadcast_description": null, "legacy_broadcast_id": 761824, "segment_id": "HedXAmHwN3", "segment_broadcast_id": "HsVBX7685H", "segment_title": "Decision 2004 / Bush vs. Kerry / Stem Cell Research", "segment_description": "(Studio: Tom Brokaw) Report introduced.   (White House: David Gregory) The debate over stem cell research in the presidential election examined; details given of President Bush\u2019s decision to limit the use of federal funds for stem cell research to cell lines already in existence; results of a National Annenberg Election Survey cited. [First Lady Laura BUSH \u2013 downplays the usefulness of stem cells in curing Alzheimer\u2019s disease.] [In 2001, BUSH \u2013 says he has an obligation to foster & encourage respect for life.] [July 29, Senator John KERRY \u2013 supports stem cell research.] [Juvenile Diabetes Research Foundation Peter VAN ETTEN&#134;- notes how Bush\u2019s limitation will set the field back.] [Democratic pollster Peter HART&#134;- says Democrats can talk to constituencies they usually lose on social issues.]", "segment_duration": 170, "segment_type_id": 2, "segment_start_time": "63380.0", "legacy_segment_id": 761827, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "HsVBX7685H", "broadcast_date": "2004-08-09", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1730, "broadcast_description": null, "legacy_broadcast_id": 761824, "segment_id": "aXouAHvMCj", "segment_broadcast_id": "HsVBX7685H", "segment_title": "Greece / Olympic Games", "segment_description": "(Studio: Tom Brokaw) The arrival of athletes in Athens, Greece, for the Olympic Games noted; scenes shown of an American flag-raising ceremony.   (Athens, Greece: Dennis Murphy) The progress of construction in Athens featured; scenes shown of new stadiums, rail lines, roads; Australian ad ridiculing the slow construction pace shown; details given about poor ticket sales and the decrease in tourism. [Deputy Minister of Culture Fanni PALLI-PETRALIA&#134;- says we are ready for the world.] [Newspaper editor Niko CONSTANDEROS&#135;- says the world is very unsettled.]", "segment_duration": 180, "segment_type_id": 2, "segment_start_time": "63550.0", "legacy_segment_id": 761828, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "HsVBX7685H", "broadcast_date": "2004-08-09", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1730, "broadcast_description": null, "legacy_broadcast_id": 761824, "segment_id": "v0Yo0ytmQa", "segment_broadcast_id": "HsVBX7685H", "segment_title": "Upcoming Items (Studio: Tom Brokaw)", "segment_description": "null", "segment_duration": 20, "segment_type_id": 2, "segment_start_time": "63730.0", "legacy_segment_id": 761829, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "HsVBX7685H", "broadcast_date": "2004-08-09", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1730, "broadcast_description": null, "legacy_broadcast_id": 761824, "segment_id": "PD4xtTPH4V", "segment_broadcast_id": "HsVBX7685H", "segment_title": "(Commercial: shuteye.com; Benefiber; cholesterol PSA; Nexiu