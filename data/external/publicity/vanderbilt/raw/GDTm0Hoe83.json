gn 04 / Bush vs. Kerry / Kerry Interview", "segment_description": "(Studio: Dan Rather) Presidential candidate Senator John Kerry\u2019s response to the final report of the 9/11 Commission noted. Taped interview held with Kerry about his Vietnam service and his later anti-war stance. [KERRY \u2013 says he is proud of being a war hero and an anti-war leader; admits he has made mistakes; admits being irritated with President Bush, who spent his time during the Vietnam War in the National Guard and is now trying to diminish Kerry\u2019s military service.] The beginning of the Democratic National Convention next week noted.", "segment_duration": 160, "segment_type_id": 2, "segment_start_time": "64210.0", "legacy_segment_id": 760566, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "GDTm0Hoe83", "broadcast_date": "2004-07-22", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 760553, "segment_id": "h1ZkoJmmHE", "segment_broadcast_id": "GDTm0Hoe83", "segment_title": "Upcoming Items (Studio: Dan Rather)", "segment_description": "null", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "64370.0", "legacy_segment_id": 760567, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "GDTm0Hoe83", "broadcast_date": "2004-07-22", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 