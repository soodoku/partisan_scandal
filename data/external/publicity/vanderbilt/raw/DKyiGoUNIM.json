.  \n\n(New York; Sharyn Alfonsi)  The call from the National Assn. of College Admission Counseling for universities to consider dropping SAT and ACT tests examined; details given about the test prep industry to help students \"beat\" the tests.  [Fairtest.org Jesse MERMELL&#134;- comments on the tests and test scores.]  College Board vice president Laurence BUNIN&#134;- cites \"rampant grade inflation\" as the need for SATs.] ", "segment_duration": 140, "segment_type_id": 2, "segment_start_time": "63900.0", "legacy_segment_id": 905456, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "DKyiGoUNIM", "broadcast_date": "2008-09-22", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 905450, "segment_id": "dI3M2knUQu", "segment_broadcast_id": "DKyiGoUNIM", "segment_title": "Upcoming Items (Studio: Charles Gibson)", "segment_description": " ", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "64040.0", "legacy_segment_id": 905457, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "DKyiGoUNIM", "broadcast_date": "2008-09-22", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 905450, "segment_id": "qw0DlxhofE", "segment_broadcast_id": "DKyiGoUNIM", "segment_title": "(Commercial: Silk Soymilk; Just for Men; Phillips' Colon Health; Cymbalta; Campbell's Soup.)", "seg