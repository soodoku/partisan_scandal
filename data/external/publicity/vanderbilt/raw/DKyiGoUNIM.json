s.]  [Prostate cancer patient Ken DUPUY&#134;- expresses amazement over his acupuncture treatment.]  [Memorial Sloan-Kettering Cancer Center Barrie CASSILEH&#134;- backs acupuncture.] ", "segment_duration": 140, "segment_type_id": 2, "segment_start_time": "64210.0", "legacy_segment_id": 905460, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "DKyiGoUNIM", "broadcast_date": "2008-09-22", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 905450, "segment_id": "ebo93TTDwl", "segment_broadcast_id": "DKyiGoUNIM", "segment_title": "Upcoming Items (Studio: Charles Gibson)", "segment_description": " ", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "64350.0", "legacy_segment_id": 905461, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "DKyiGoUNIM", "broadcast_date": "2008-09-22", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 905450, "segment_id": "MCBPiy99Gq", "segment_broadcast_id": "DKyiGoUNIM", "segment_title": "(Commercial: Kashi; Ford; \"Flash of Genius\"; McCain ad; Crest; Healthy Choice; \"Boston Legal\"; \"Good Morning America\")", "segment_description": " ", "segment_duration": 190, "segment_type_id": 3, "segment_start_time": "64350.0", "legacy_segment_id": 905462, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name":