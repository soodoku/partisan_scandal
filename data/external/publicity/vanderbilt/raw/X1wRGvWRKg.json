rt introduced. \n (Norwell, Massachusetts: Roger O\u2019Neil) The idea of 13-year-old Brittany Bergquist&#134;&#134; and her 12-year-old brother Robbie to collect old cell phones, which they sell to recyclers and then buy calling cards for soldiers in Iraq, featured. [BERGQUISTS \u2013 talk about their project and how much money they have collected.] [In Iraq, Pvt. Wilson OUTOO&#135;- calls his wife.] [Kids\u2019 father Bob BERGQUIST&#134;&#134;\u2013 comments.]", "segment_duration": 190, "segment_type_id": 2, "segment_start_time": "64540.0", "legacy_segment_id": 761313, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "X1wRGvWRKg", "broadcast_date": "2004-08-02", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1730, "broadcast_description": null, "legacy_broadcast_id": 761296, "segment_id": "bF2TmgA9Wh", "segment_broadcast_id": "X1wRGvWRKg", "segment_title": "Good Night", "segment_description": "null", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "64730.0", "legacy_segment_id": 761314, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}]}