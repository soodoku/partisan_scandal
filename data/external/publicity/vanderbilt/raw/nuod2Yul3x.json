{"data": [{"broadcast_id": "nuod2Yul3x", "broadcast_date": "2008-10-07", "broadcast_start_time": "63010.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 907587, "segment_id": "e3zCUgFEw3", "segment_broadcast_id": "nuod2Yul3x", "segment_title": "Preview/Introduction Charles Gibson (Bowling Green, Ohio)", "segment_description": null, "segment_duration": 50, "segment_type_id": 1, "segment_start_time": "63010.0", "legacy_segment_id": 907587, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "Preview", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "nuod2Yul3x", "broadcast_date": "2008-10-07", "broadcast_start_time": "63010.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 907587, "segment_id": "POdSfY5lKh", "segment_broadcast_id": "nuod2Yul3x", "segment_title": "Economy: Stock Market, Credit Crisis / AIG Hearings", "segment_description": "(Studio: Charles Gibson)  The ABC News bus tour through the Midwest noted.  Stock Market Report  \n\n(Studio: Betsy Stark)  Another bad day on Wall Street due to the unprecedented credit crisis featured; details given about the Federal Reserve's plan to use taxpayer dollars; statistics on the money spent bailing out Bears Stearns, Fannie Mae, Freddie Mac and AIG and extending credit to distressed banks and the CBO estimates of the amount of retirement assets lost cited.  [Economic Outlook Group economist Bernard BAUMOHL&#134;- offers perspective on the credit crisis.]  [DMJ Advisors CEO David JONES&#134;- says the Fed keeps coming up with a new idea; states no one is shielded from this credit crisis.]  [Federal Reserve Board chairman Ben BERNANKE&#134;- says we are addressing a problem of historic dimensions.]  [Standard and Poor's investment strategist Sam STOVALL&#134;- says investors are waiting.]  [Representative George MILLER&nbsp- says retirement money is gone.]  \n\n(Studio: Charles Gibson)  Report introduced.  \n\n(Studio: Brian Ross)  How AIG executives were living it up after taxpayers bailed out the company featured; scenes shown from the St. Regis Hotel and Spa in Monarch, California and from Congressional hearings.  [Representatives Elijah CUMMINGS&#134;, Jackie SPEER&#134;- criticize the CEOs.]  [At hearings, former AIG CEOs Robert WILLUMSTAD&#134;, Martin SULLIVAN&#134;- defend AIG.] ", "segment_duration": 370, "segment_type_id": 2, "segment_start_time": "63060.0", "legacy_segment_id": 907588, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "nuod2Yul3x", "broadcast_date": "2008-10-07", "broadcast_start_time": "63010.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 907587, "segment_id": "wYVTubxYX1", "segment_broadcast_id": "nuod2Yul3x", "segment_title": "Campaign 2008 / Obama vs. McCain / Nashville Debate", "segment_description": "(Studio: Charles Gibson)  Tonight's debate between presidential candidates Senators John McCain and Barack Obama introduced.   (Nashville: Jake Tapper)  The personal attacks in the presidential election campaign on the eve of the debate featured; McCain and Obama TV ads shown.  [Governor Sarah PALIN&nbsp- criticizes Obama's ties to a domestic terrorist.]  [McCain campaign adviser Nicole WALLACE&#134;- says we are telling the truth about Obama and his record.]  [Obama campaign strategist David AXELROD&#134;- responds.]  Earlier town hall meeting-style debates shown.   (Studio: Charles Gibson; Nashville: George Stephanopoulos)  What the two candidates have to do in the debate hall tonight with preparations for questions from moderator Tom Brokaw and the audience and the need to establish a connection with the audience members discussed.   (Studio: Charles Gibson)  Tonight's debate coverage noted. ", "segment_duration": 260, "segment_type_id": 2, "segment_start_time": "63430.0", "legacy_segment_id": 907589, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "nuod2Yul3x", "broadcast_date": "2008-10-07", "broadcast_start_time": "63010.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 907587, "segment_id": "a7he15Y592", "segment_broadcast_id": "nuod2Yul3x", "segment_title": "Upcoming Items (Studio: Charles Gibson)", "segment_description": " ", "segment_duration": 20, "segment_type_id": 2, "segment_start_time": "63690.0", "legacy_segment_id": 907590, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "nuod2Yul3x", "broadcast_date": "2008-10-07", "broadcast_start_time": "63010.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 907587, "segment_id": "Qf94Nb2Pwu", "segment_broadcast_id": "nuod2Yul3x", "segment_title": "(Commercial: Advil; Boniva; Caduet.)", "segment_description": " ", "segment_duration": 160, "segment_type_id": 3, "segment_start_time": "63710.0", "legacy_segment_id": 90759