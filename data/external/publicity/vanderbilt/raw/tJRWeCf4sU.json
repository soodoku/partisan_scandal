{"data": [{"broadcast_id": "tJRWeCf4sU", "broadcast_date": "2004-08-04", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1670, "broadcast_description": null, "legacy_broadcast_id": 761433, "segment_id": "rIwLwdLOZd", "segment_broadcast_id": "tJRWeCf4sU", "segment_title": "Preview/Introduction John Roberts (New York)", "segment_description": "null", "segment_duration": 50, "segment_type_id": 1, "segment_start_time": "63000.0", "legacy_segment_id": 761433, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Preview", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "tJRWeCf4sU", "broadcast_date": "2004-08-04", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1670, "broadcast_description": null, "legacy_broadcast_id": 761433, "segment_id": "ED01ls9FAg", "segment_broadcast_id": "tJRWeCf4sU", "segment_title": "Terrorism / Al Qaeda Threat", "segment_description": "(Studio: John Roberts) Report introduced. \n (Pentagon: David Martin) Support for the belief that the plot to attack financial institutions is still in the works outlined; details given about evidence obtained from the questioning of captured Al Qaeda operative Abu Talha&#134; {aka Mohammed Khan&#134;&#134;} and from documents on his computer, including building surveillance & phone calls to the US. The search of terror suspects\u2019 homes in Britain noted; scenes shown.", "segment_duration": 140, "segment_type_id": 2, "segment_start_time": "63050.0", "legacy_segment_id": 761434, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "tJRWeCf4sU", "broadcast_date": "2004-08-04", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1670, "broadcast_description": null, "legacy_broadcast_id": 761433, "segment_id": "tF87tNBM6g", "segment_broadcast_id": "tJRWeCf4sU", "segment_title": "Guantanamo Bay, Cuba / Tribunals / Prisoner Abuse", "segment_description": "(Studio: John Roberts) Report introduced. \n (New York: Jim Acosta) The allegations of prisoner abuse that came out during military tribunals at Guantanamo Bay, Cuba, featured; details given of claims of religious humiliation by the prison\u2019s immediate reaction force and of the fight to have the tribunals. [Secretary of the Navy Gordon ENGLAND&#134;- comments on the validity of the tribunals.] [Detainees\u2019 attorney Michael RATNER&#134;- calls for an investigation of the abuse.]", "segment_duration": 130, "segment_type_id": 2, "segment_start_time": "63190.0", "legacy_segment_id": 761435, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "tJRWeCf4sU", "broadcast_date": "2004-08-04", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1670, "broadcast_description": null, "legacy_broadcast_id": 761433, "segment_id": "kDvBTbA47E", "segment_broadcast_id": "tJRWeCf4sU", "segment_title": "Campaign 04 / Bush vs. Kerry / Davenport, Iowa", "segment_description": "(Studio: John Roberts) Report introduced. \n (Davenport, Iowa: Jim Axelrod) Campaign appearances by both President Bush & Senator John Kerry in Davenport, Iowa, at the same time featured; scenes shown from both rallies and of the three banks that were robbed while police were providing security; map shown of battleground states, including Iowa, where the candidates are campaigning hard. [KERRY, BUSH \u2013 campaign.] [Davenport VOTER \u2013 comments.] [Davenport police Chief Mike BLADEL&#134;- says we want everybody to have a good time except the bank robbers.] [Cuba City, Wisconsin, voter Bruce WILSON&#134;- notes Bush\u2019s bus did not stop in his town.]", "segment_duration": 170, "segment_type_id": 2, "segment_start_time": "63320.0", "legacy_segment_id": 761436, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "tJRWeCf4sU", "broadcast_date": "2004-08-04", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1670, "broadcast_description": null, "legacy_broadcast_id": 761433, "segment_id": "q5yvxY7u6s", "segment_broadcast_id": "tJRWeCf4sU", "segment_title": "Same-Sex Marriage: Missouri, Washington", "segment_description": "(Studio: John Roberts) The vote in Missouri to ban same-sex marriage, and a Seattle judge\u2019s ruling that gay marriage is legal reported.", "segment_duration": 20, "segment_type_id": 2, "segment_start_time": "63490.0", "legacy_segment_id": 761437, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "tJRWeCf4sU", "broadcast_date": "2004-08-04", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1670, "broadcast_description": null, "legacy_broadcast_id": 761433, "segment_id": "OfZfvNBnjy", "segment_broadcast_id": "tJRWeCf4sU", "segment_title": "Iraq / Muslim Force", "segment_description": "(Studio: John Roberts) Report introduced.   (Baghdad: Kimberly Dozier) The rejection by Iraq\u2019s interim president of proposed military help from other Muslim & Arab countries featured; scenes shown of fighting between insurgents & Iraqi security forces in Mosul; details given of the Arab League\u2019s accusations that Arab armies would be used to camouflage the US occupation of Iraq. [July 30, Secretary of State Colin POWELL \u2013 explains Saudi Arabia\u2019s proposal for a Muslim force.] [Kings College Michael CLARK&#134;- says there is no way the Arab nations are going to get the US out of the mess it\u2019s in.]   (Studio: John Roberts) A raid on Fallujah by an Iraqi tribal chief to free 4 Jordanian hostages, and the release of 2 Turkish truck drivers noted.", "segment_duration": 130, "segment_type_id": 2, "segment_start_time": "63510.0", "legacy_segment_id": 761438, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "tJRWeCf4sU", "broadcast_date": "2004-08-04", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1670, "broadcast_description": null, "legacy_broadcast_id": 761433, "segment_id": "yTuB69ro3O", "segment_broadcast_id": "tJRWeCf4sU", "segment_title": "Upcoming Items; fallen soldier Army Sgt. Ryan Young&#134<!-- spelling on screen --> profiled. (Studio: John Roberts, Dan Rather)", "segment_description": "null", "segment_duration": 50, "segment_type_id": 2, "segment_start_time": "63640.0", "legacy_segment_id": 761439, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "tJRWeCf4sU", "broadcast_date": "2004-08-04", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1670, "broadcast_description": null, "legacy_broadcast_id": 761433, "segment_id": "FExSJ10WBm", "segment_broadcast_id": "tJRWeCf4sU", "segment_title": "(Commercial: Centrum; OneTouch; Nexium; Terminix; Hidden Valley Ranch; Big Lots.)", "segment_description": "null", "segment_duration": 150, "segment_type_id": 3, "segment_start_time": "63690.0", "legacy_segment_id": 761440, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "tJRWeCf4sU", "broadcast_date": "2004-08-04", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1670, "broadcast_description": null, "legacy_broadcast_id": 761433, "segment_id": "aucxRkeWKH", "segment_broadcast_id": "tJRWeCf4sU", "segment_title": "Letourneau Case", "segment_description": "(Studio: John Roberts) The release from prison of former schoolteacher Mary Kay Letourneau&#134;&#134;, who was convicted of raping her 12 year-old student, and the former student\u2019s request to have the restraining order against Letourneau lifted noted.", "segment_duration": 30, "segment_type_id": 2, "segment_start_time": "63840.0", "legacy_segment_id": 761441, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "tJRWeCf4sU", "broadcast_date": "2004-08-04", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1670, "broadcast_description": null, "legacy_broadcast_id": 761433, "segment_id": "DHrvWERG7i", "segment_broadcast_id": "tJRWeCf4sU", "segment_title": "Inside Story (Sex with Minors)", "segment_description": "(Studio: John Roberts) Report introduced. \n (Arlington, Virginia: Sharyl Attkisson) The growing problem of adults having sex with minors featured; police video shown of the confession of softball coach Andrew Garver, who ran off with a 15-year-old player; scenes shown of former Oregon Governor Neil Goldschmidt, who admitted he dated a 14-year-old; Virginia teen pregnancy study findings cited; details given of Virginia\u2019s \u201cIsn\u2019t She a Little Young&#135;\u201d awareness campaign. [Sexual assault counselor Melissa SCHMISEK&#134;- says it\u2019s predatory.] [Virginia Department of Health Robert FRANKLIN&#134;- says we need to start talking to the men.]", "segment_duration": 130, "segment_type_id": 2, "segment_start_time": "63870.0", "legacy_segment_id": 761442, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "tJRWeCf4sU", "broadcast_date": "2004-08-04", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1670, "broadcast_description": null, "legacy_broadcast_id": 761433, "segment_id": "Tbd7JRlVAR", "segment_broadcast_id": "tJRWeCf4sU", "segment_title": "Upcoming Items (Studio: John Roberts)", "segment_description": "null", "segment_duration": 20, "segment_type_id": 2, "segment_start_time": "64000.0", "legacy_segment_id": 761443, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "locatio