rity of surfing in the wake created by oil supertankers off the Texas coast featured; excerpt shown from the film \u201cStep into Liquid\u201d; scenes shown of surfers. [Surfers James FULBRIGHT&#134;, Michelle CERROS&#135;- comment.]", "segment_duration": 140, "segment_type_id": 2, "segment_start_time": "64530.0", "legacy_segment_id": 761450, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "tJRWeCf4sU", "broadcast_date": "2004-08-04", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1670, "broadcast_description": null, "legacy_broadcast_id": 761433, "segment_id": "1s6QocXsVp", "segment_broadcast_id": "tJRWeCf4sU", "segment_title": "Good Night", "segment_description": "null", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "64670.0", "legacy_segment_id": 761451, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}]}