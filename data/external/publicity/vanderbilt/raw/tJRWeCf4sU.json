De91hvzIB8", "segment_broadcast_id": "tJRWeCf4sU", "segment_title": "Airlines / O\u2019Hare Airport / Flight Delays", "segment_description": "(Studio: John Roberts) Report introduced. \n (Washington: Bob Orr) Flight delays at Chicago\u2019s O\u2019Hare International Airport that are causing nationwide disruption featured; statistics cited; details given of the government\u2019s ultimatum, targeting United & American Airlines, calling for cutbacks on Chicago flights. [Secretary of Transportation Norman MINETA&#134;- says we will not allow this critical hub to become a choking point.] [PASSENGER \u2013 complains.] [FAA administrator Marion BLAKEY&#134;- says the airlines are going to have to step up to the plate.]", "segment_duration": 130, "segment_type_id": 2, "segment_start_time": "64210.0", "legacy_segment_id": 761446, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "tJRWeCf4sU", "broadcast_date": "2004-08-04", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1670, "broadcast_description": null, "legacy_broadcast_id": 761433, "segment_id": "5pC1HVNSDc", "segment_broadcast_id": "tJRWeCf4sU", "segment_title": "Cartier-Bresson Death", "segment_description": "(Studio: John Roberts) The death of photographer Henri Cartier-Bresson reported; photos shown.", "segment_duration": 20, "segment_type_id": 2, "segment_start_time": "64340.0", "legacy_segment_id": 761447, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "tJRWeCf4sU", "broadcast_date": "2004-08-04", "broadcast_start_time": "63000.0", "networ