{"data": [{"broadcast_id": "inrLshwxRT", "broadcast_date": "2008-10-28", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 922183, "segment_id": "q4srBqXl9P", "segment_broadcast_id": "inrLshwxRT", "segment_title": "Preview/Introduction Brian Williams (New York)", "segment_description": null, "segment_duration": 60, "segment_type_id": 1, "segment_start_time": "63000.0", "legacy_segment_id": 922183, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "Preview", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "inrLshwxRT", "broadcast_date": "2008-10-28", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 922183, "segment_id": "BYZjCNf1x3", "segment_broadcast_id": "inrLshwxRT", "segment_title": "Decision 2008 / Obama vs. McCain / The Campaign", "segment_description": "(Studio: Brian Williams) The final week in the presidential race between Senators Barack Obama and John McCain introduced.  \n\n(Harrisonburg, Virginia: Lee Cowan) Obama's campaign featured; scenes shown from a rally in Philadelphia, where the weather was cold and rainy, and from Virginia. [OBAMA&nbsp- criticizes McCain on the economy and his health care plan.] [From \u201cThe Tonight Show with Jay Leno,\u201d Michelle OBAMA \u2013 recounts daughter Malia\u2019s concern about her dad\u2019s 30-minute commercials.]  \n\n(Fayetteville, North Carolina: Kelly O\u2019Donnell) McCain's campaign featured; details given of McCain\u2019s criticism of the Obama campaign\u2019s discrepancies on tax cuts; McCain ad shown. [In Hershey, Pennsylvania, Governor Sarah PALIN \u2013 says \u201cJoe, the Chocolate Maker.\u201d] [Senator Joe BIDEN \u2013 says tax cuts should go to people making under 100,000 a year.] [McCAIN \u2013 says their definition of rich has a way of creeping down; says Obama is running to be redistributionist in chief.] ", "segment_duration": 300, "segment_type_id": 2, "segment_start_time": "63060.0", "legacy_segment_id": 922184, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "inrLshwxRT", "broadcast_date": "2008-10-28", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 922183, "segment_id": "mZW9hM5FQE", "segment_broadcast_id": "inrLshwxRT", "segment_title": "Economy: Small Businesses", "segment_description": "(Studio: Brian Williams) A rally in the stock market and a plunge in consumer confidence noted; figures cited.   (Washington: Tom Costello) The impact of the economic downturn on small businesses featured; statistics cited. [Hudson Cleaners owner Brian FERWERDA\u2020\u2020- says everybody is in survival mode.] [At House hearing, Association of Equipment Manufacturers Richard BROWN\u2020, US Women\u2019s Chamber of Commerce Margot DORFMAN\u2020- outline the problems for small businesses.] [Representatives Nydia VELAZQUEZ\u2020, Steve CHABOT\u2020- comment on the intent of the stimulus plan.] ", "segment_duration": 180, "segment_type_id": 2, "segment_start_time": "63360.0", "legacy_segment_id": 922185, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "inrLshwxRT", "broadcast_date": "2008-10-28", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 922183, "segment_id": "evbZkAOoyv", "segment_broadcast_id": "inrLshwxRT", "segment_title": "Weather / Early Snowstorm", "segment_description": "(Studio: Brian Williams) Report introduced.   (Utica, New York: Tetiana Anderson) The impact of an early snowstorm in the East featured; scenes shown from the postponed World Series, snow, traffic accidents, people bundled up in Tampa. [Weather Channel meteorologist Kevin ROBINSON&#134;- calls it an historic October snowstorm.] ", "segment_duration": 130, "segment_type_id": 2, "segment_start_time": "63540.0", "legacy_segment_id": 922186, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "inrLshwxRT", "broadcast_date": "2008-10-28", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 922183, "segment_id": "5A3Zuw3Qeb", "segment_broadcast_id": "inrLshwxRT", "segment_title": "Afghanistan War / Petraeus Remarks", "segment_description": "(Studio: Brian Williams) Report introduced.  \n\n(Baghdad: Richard Engel) The declaration from top military commander Gen. David Petraeus that the US should talk to the Taliban if it wants to get the upper hand in Afghanistan featured; details given of Petraeus\u2019s success in negotiating with insurgents in Iraq. ", "segment_duration": 90, "segment_type_id": 2, "segment_start_time": "63670.0", "legacy_segment_id": 922187, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "inrLshwxRT", "broadcast_date": "2008-10-28", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 922183, "segment_id": "B5Ft484pKd", "segment_broadcast_id": "inrLshwxRT", "segment_title": "Upcoming Items (Studio: Brian Williams)", "segment_description": " ", "segment_duration": 20, "segment_type_id": 2, "segment_start_time": "63760.0", "legacy_segment_id": 922188, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "inrLshwxRT", "broadcast_date": "2008-10-28", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 922183, "segment_id": "dVQPBji2xe", "segment_broadcast_id": "inrLshwxRT", "segment_title": "(Commercial: Glad; Aleve; Centrum; \u201cTinker Bell\u201d; Olay; Red Lobster.)", "segment_description": " ", "segment_duration": 120, "segment_type_id": 3, "segment_start_time": "63780.0", "legacy_segment_id": 922189, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "inrLshwxRT", "broadcast_date": "2008-10-28", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 922183, "segment_id": "iZG871EZcD", "segment_broadcast_id": "inrLshwxRT", "segment_title": "Arthritis: Fighting the Pain (Cartilage Research)", "segment_description": "(Studio: Brian Williams) Report introduced.  \n\n(New York: Robert Bazell) Research on an alternative to joint replacement surgery for treating arthritis reviewed; diagrams shown of eroded cartilage and a procedure in which the hole is replaced with material made from the patient\u2019s cells; details given of research involving adult stem cells. [Osteoarthritis patient James HARSHAW&#134;&#134;- reacts to his knee pain.] [Hospital for Special Surgery Dr. Riley WILLIAMS&#134;&#134;- explains the procedure.] [University of California at San Francisco Rik DERYNCK&#134;- says it\u2019s doable that in ten years from now we can replace cartilage, muscle and bone.] ", "segment_duration": 150, "segment_type_id": 2, "segment_start_time": "63900.0", "legacy_segment_id": 922190, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "inrLshwxRT", "broadcast_date": "2008-10-28", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 922183, "segment_id": "38irnlbXWV", "segment_broadcast_id": "inrLshwxRT", "segment_title": "Upcoming Items (Studio: Brian Williams)", "segment_description": " ", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "64050.0", "legacy_segment_id": 922191, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "inrLshwxRT", "broadcast_date": "2008-10-28", "broadcast_start_time": "63000