{"data": [{"broadcast_id": "t1ZQiD4SpR", "broadcast_date": "2008-09-25", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 918899, "segment_id": "WHHy1xNSLx", "segment_broadcast_id": "t1ZQiD4SpR", "segment_title": "Preview/Introduction Brian Williams (Washington, DC)", "segment_description": null, "segment_duration": 50, "segment_type_id": 1, "segment_start_time": "63000.0", "legacy_segment_id": 918899, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "Preview", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "t1ZQiD4SpR", "broadcast_date": "2008-09-25", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 918899, "segment_id": "qQZSeLrlOg", "segment_broadcast_id": "t1ZQiD4SpR", "segment_title": "Economy: Bailout Deal ", "segment_description": "(Washington: Brian Williams) Report introduced.  \n\n(Capitol: Tom Costello) The negotiations on the administration\u2019s bailout bill featured; scenes shown of the meeting between President Bush, Senators Barack Obama and John McCain and other Congressmembers; details given of the principles agreed upon and the opposition of conservative Republicans. [BUSH&nbsp- says this meeting is an attempt to move the process forward.] [Senators Christopher DODD&#134;, Robert BENNETT&#134;- comment on reaching agreement.] [Representative Ted POE&#134;- opposes the plan.] [Speaker of the House Nancy PELOSI \u2013 says we intend to proceed with a stimulus package.] McCain\u2019s suspension of his presidential campaign recalled. [Representative Barney FRANK&#134;- comments.] [Talk show host David LETTERMAN \u2013 jokes about McCain cancelling an appearance on his show.] ", "segment_duration": 240, "segment_type_id": 2, "segment_start_time": "63050.0", "legacy_segment_id": 918900, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "t1ZQiD4SpR", "broadcast_date": "2008-09-25", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 918899, "segment_id": "J02D3oPHNi", "segment_broadcast_id": "t1ZQiD4SpR", "segment_title": "Decision 2008 / Obama vs. McCain / Interviews / Palin", "segment_description": "(Washington: Brian Williams) Earlier interviews with presidential candidates Senators John McCain and Barack Obama about the economic bailout plan presented. [McCAIN \u2013 comments on his decision to suspend his campaign; says if we restore our economy and cut out-of-control spending we\u2019ll be okay; states he knows how to rein in the government and spending; says he is hopeful that he\u2019ll be at the debate; notes Obama has not accepted his request to engage in 10 town hall meetings.] Technical difficulties with Obama\u2019s interview acknowledged.   \n\n(Washington: Brian Williams; Oxford, Mississippi: Chuck Todd) Governor Sarah Palin\u2019s interview with CBS\u2019s Katie Couric discussed. [In interview, PALIN \u2013 explains how Alaska\u2019s proximity to Russia and Canada enhances her foreign policy experience.] Palin\u2019s tough week and the belief that the Republicans have kept her too sheltered noted.  \n\n(Washington: Brian Williams) Today\u2019s conversation with Obama presented. [OBAMA \u2013 says it\u2019s amazing how much can get done when folks aren\u2019t worried about taking the credit; outlines the 4 principles he wants in the bailout bill; comments on the relationship of the economy to foreign affairs; says a president has to be able to do more than one thing at a time and he hopes McCain shows up at the debate.] ", "segment_duration": 580, "segment_type_id": 2, "segment_start_time": "63290.0", "legacy_segment_id": 918901, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "t1ZQiD4SpR", "broadcast_date": "2008-09-25", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 918899, "segment_id": "k6IGD3WgTg", "segment_broadcast_id": "t1ZQiD4SpR", "segment_title": "Upcoming Items (Washington: Brian Williams)", "segment_description": " ", "segment_duration": 20, "segment_type_id": 2, "segment_start_time": "63870.0", "legacy_segment_id": 918902, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "t1ZQiD4SpR", "broadcast_date": "2008-09-25", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 918899, "segment_id": "PrTgsiwI0U", "segment_broadcast_id": "t1ZQiD4SpR", "segment_title": "(Commercial: Advair; \u201cFlash of Genius.\u201d)", "segment_description": " ", "segment_duration": 120, "segment_type_id": 3, "segment_start_time": "63890.0", "legacy_segment_id": 918903, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributor