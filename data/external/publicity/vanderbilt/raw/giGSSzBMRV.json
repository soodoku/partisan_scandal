{"data": [{"broadcast_id": "giGSSzBMRV", "broadcast_date": "2004-08-16", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 762425, "segment_id": "MFt6TlqkPG", "segment_broadcast_id": "giGSSzBMRV", "segment_title": "Preview/Introduction Scott Pelley (New York)", "segment_description": "null", "segment_duration": 50, "segment_type_id": 1, "segment_start_time": "63000.0", "legacy_segment_id": 762425, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Preview", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "giGSSzBMRV", "broadcast_date": "2004-08-16", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 762425, "segment_id": "mah2lKMznW", "segment_broadcast_id": "giGSSzBMRV", "segment_title": "Hurricane Charley / Florida / Aftermath", "segment_description": "(Studio: Scott Pelley) Statistics on the impact of Hurricane Charley cited. \n (Punta Gorda, Florida: Jim Acosta) The storm's impact on Punta Gorda, Florida, featured; scenes shown of damage, supply stations. [Residents MAN, Henry STEVENS\u2020, Everett COWAN\u2020, Florida National Guard S/Sgt. Lee ROGERS\u2020, homeowner Robert WYLER\u2020\u2013 comment on the storm, relief efforts & the post-hurricane heat wave.] [Florida Power & Light Kenny MATTOX\u2020- comments on efforts to restore power.] [Charlotte County Emergency commander Wayne SALLADE\u2020- comments on the lower-than-expected death rate.] \n (Studio: Scott Pelley) Report introduced. \n (Sanibel Causeway, Florida: Mark Strassmann) The devastation on Sanibel Island, where residents have been barred from returning, featured; scenes shown of damage & patrols with guns guarding island access. [Sanibel residents Rudy & Nancy MOSNY\u2020- express frustration at not knowing the extent of damage to their home.] [Sanibel Mayor Marty HARRITY\u2020- says there\u2019s danger there.]", "segment_duration": 270, "segment_type_id": 2, "segment_start_time": "63050.0", "legacy_segment_id": 762426, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "giGSSzBMRV", "broadcast_date": "2004-08-16", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 762425, "segment_id": "WN5IFeXPG2", "segment_broadcast_id": "giGSSzBMRV", "segment_title": "Military / Troop Movements", "segment_description": "(Studio: Scott Pelley) Report introduced. \n (Traverse City, Michigan: Bill Plante) President Bush\u2019s announcement of plans for redeploying US military forces worldwide, with the exclusion of troops in Iraq & Afghanistan, featured; details given of Bush\u2019s focus on national security following opponent Senator John Kerry\u2019s criticism of his handling of Iraq. [BUSH \u2013 says the new plan will help us win the wars of the 21st century; criticizes Kerry\u2019s plan to reduce troops in Iraq and his vote against supplemental funding for the war.] [Retired Gen. Wesley CLARK&#134;- states the plan shows bad leadership.] [Pew Research Center Andrew KOHUT&#134;- comments on Bush\u2019s vulnerability because of the Iraq war.]", "segment_duration": 140, "segment_type_id": 2, "segment_start_time": "63320.0", "legacy_segment_id": 762427, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "giGSSzBMRV", "broadcast_date": "2004-08-16", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 762425, "segment_id": "8R4XHNW2rC", "segment_broadcast_id": "giGSSzBMRV", "segment_title": "Iraq / Unrest", "segment_description": "(Studio: Scott Pelley) The deaths of three American troops and the kidnapping of a US journalist in Iraq reported.   (Baghdad: Barry Petersen) The Iraqi government\u2019s difficulty in establishing democracy & order featured; details given of ongoing fighting in Baghdad & Najaf and the increase in the forces of radical Shiite cleric Muqtada al-Sadr, who are now being aided by Sunni Muslims; scenes shown from a conference to choose an interim parliament; photo shown of kidnapped American journalist Micah Garen&#134;&#134;.", "segment_duration": 140, "segment_type_id": 2, "segment_start_time": "63460.0", "legacy_segment_id": 762428, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "giGSSzBMRV", "broadcast_date": "2004-08-16", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 762425, "segment_id": "eqW0Z08MLY", "segment_broadcast_id": "giGSSzBMRV", "segment_title": "Upcoming Items; fallen hero Army Spc. James Wolf&#134<!-- spelling on screen --> profiled. (Studio: Scott Pelley; Dan Rather)", "segment_description": "null", "segment_duration": 50, "segment_type_id": 2, "segment_start_time": "63600.0", "legacy_segment_id": 762429, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "giGSSzBMRV", "broadcast_date": "2004-08-16", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 762425, "segment_id": "cOJO8ZJ9mR", "segment_broadcast_id": "giGSSzBMRV", "segment_title": "(Commercial: Fidelity Investments; Lamisil; Oust; Maxwell House.)", "segment_description": "null", "segment_duration": 150, "segment_type_id": 3, "segment_start_time": "63650.0", "legacy_segment_id": 762430, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "giGSSzBMRV", "broadcast_date": "2004-08-16", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 762425, "segment_id": "aAi47tnsls", "segment_broadcast_id": "giGSSzBMRV", "segment_title": "Inside Story (Internet Terrorism) Part I", "segment_description": "(Studio: Scott Pelley) Two-part series on the fight against the spread of terrorism on the Internet introduced. \n (London: Mark Phillips) The Internet sting set up by Glen Jenvey&#134; {aka Pervez Khan} that helped bring in British terror suspect Abu Hamza al-Masri featured; details given of how Jenvey set up a false Islamic extremist Website called \u201cIslamic News\u201d to flush out terrorists; video of Hamza shown. [JENVEY \u2013 says terrorists provided video & audiotapes of private meetings.] [In tapes, HAMZA \u2013 encourages jihad & intifada.] [May 27, New York City police department Commissioner Raymond KELLY&#134;- says the arrest of Abu Hamza is a major development in the fight against global terror.] The tapes\u2019 provision of proof of Hamza\u2019s connection to American James Ujaama noted.", "segment_duration": 190, "segment_type_id": 2, "segment_start_time": "63800.0", "legacy_segment_id": 762431, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "giGSSzBMRV", "broadcast_date": "2004-08-16", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 762425, "segment_id": "PYf4JIYqvE", "segment_broadcast_id": "giGSSzBMRV", "segment_title": "Market Watch: Oil Prices, Stocks", "segment_description": "(Studio: Scott Pelley) A drop in oil prices following the news that Venezuelan President Hugo Chavez survived a recall vote noted; prices cited; Stock Market Report.", "segment_duration": 20, "segment_type_id": 2, "segment_start_time": "63990.0", "legacy_segment_id": 762432, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "giGSSzBMRV", "broadcast_date": "2004-08-16", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 762425, "segment_id": "AREyOeEGfq", "segment_broadcast_id": "giGSSzBMRV", "segment_title": "Upcoming Items (Studio: Scott Pelley)", "segment_description": "null", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "64010.0", "legacy_segment_id": 762433, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "giGSSzBMRV", "broadcast_date": "2004-08-16", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 762425, "segment_id": "NKlOQHin80", "segment_broadcast_id": "giGSSzBMRV", "segment_title": "(Commercial: Ambien; Capital One; Prevacid; Lanacane; Tennessee Lottery; \"CBS News.\")", "segment_description": "null", "segment_duration": 160, "segment_type_id": 3, "segment_start_time": "64020.0", "legacy_segment_id": 762434, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "giGSSzBMRV", "broadcast_date": "2004-08-16", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 762425, "segment_id": "FZpPFpteH3", "segment_broadcast_id": "giGSSzBMRV", "segment_title": "Colorado / Bryant Rape Case", "segment_description": "(Studio: Scott Pelley) The ruling in the Kobe Bryant rape case that information about the accuser\u2019s sex life will be allowed as evidence noted; scenes shown from Eagle, Colorado.", "segment_duration": 30, "segment_type_id": 2, "segment_start_time": "64180.0", "legacy_segment_id": 762435, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "giGSSzBMRV", "broadcast_date": "2004-08-16", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 762425, "segment_id": "q2CfGaq0Hh", "segment_broadcast_id": "giGSSzBMRV", "segment_title": "Jackson / Child Molestation Case", "segment_description": "(Studio: Scott Pelley) Report introduced. \n (Santa Maria, California: Vince Gonzales) A pre-trial hearing where district attorney Thomas Sneddon took the stand in the child molestation case against Michael Jackson featured; scenes shown of Jackson with several siblings arriving at the courthouse and of fans outside; details given of questions about Sneddon\u2019s surveillance & raid on the office of investigator Bradley Miller&#134;&#134;, who was hired by Jackson\u2019s former attorney Mark Geragos; courtroom sketches by Bill Robles shown; exchange between Sneddon & Jackson attorney Tom Mesereau&#134; quoted. [Trial consultant Kathy KELLERMANN&#134;, former federal prosecutor Laurie LEVENSON&#134;- comment on Jackson\u2019s appearance at the hearing.] [Legal analyst Trent COPELAND&#134;- comments on the potential implications of the Miller raid.] The status of the investigation into Jackson\u2019s claims of police abuse noted.", "segment_duration": 140, "segment_type_id": 2, "segment_start_time": "64210.0", "legacy_segment_id": 762436, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "giGSSzBMRV", "broadcast_date": "2004-08-16", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": nul