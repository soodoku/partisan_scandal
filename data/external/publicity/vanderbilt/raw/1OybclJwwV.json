{"data": [{"broadcast_id": "1OybclJwwV", "broadcast_date": "2004-08-20", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 762732, "segment_id": "rbk1AsLD4w", "segment_broadcast_id": "1OybclJwwV", "segment_title": "Preview/Introduction Scott Pelley (New York)", "segment_description": "null", "segment_duration": 40, "segment_type_id": 1, "segment_start_time": "63000.0", "legacy_segment_id": 762732, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Preview", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "1OybclJwwV", "broadcast_date": "2004-08-20", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 762732, "segment_id": "cvWWMGKC65", "segment_broadcast_id": "1OybclJwwV", "segment_title": "Iraq / Al-Sadr Revolt", "segment_description": "(Studio: Scott Pelley) Announcement from the forces of radical cleric Muqtada al-Sadr that they will hand over the Imam Ali mosque in Najaf, and the deaths of more US troops in Iraq reported; casualty figures cited. \n (Baghdad: Barry Petersen) The continuing insurgency despite the letup of the fighting in Najaf featured; scenes shown of street fighting; video shown of kidnapped American journalist Micah Garen&#134;&#134;, who declared he is being treated well. [Iraqi National Security Advisor Mowaffak al-RUBAIE&#134;- states al-Sadr should stop fighting and take a seat in the government.]", "segment_duration": 160, "segment_type_id": 2, "segment_start_time": "63040.0", "legacy_segment_id": 762733, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "1OybclJwwV", "broadcast_date": "2004-08-20", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 762732, "segment_id": "6xI1V54FLL", "segment_broadcast_id": "1OybclJwwV", "segment_title": "Economy / Oil Prices", "segment_description": "(Studio: Scott Pelley) Crude oil prices, driven partly by the fighting in Iraq, cited. \n (New York: Randall Pinkston) The impact of the high oil prices at the gas pump and the effect on the US economy examined; last year\u2019s oil price vs. today\u2019s compared; details given of the fears of disruption in oil production in Iraq, Venezuela & Russia, & of higher worldwide demand. [Barclays Capital Carl LARRY&#134;- comments on the oil supply.] [US Trust chief economist Tim McGEE&#134;- explains the impact of oil prices on economic growth.]", "segment_duration": 120, "segment_type_id": 2, "segment_start_time": "63200.0", "legacy_segment_id": 762734, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "1OybclJwwV", "broadcast_date": "2004-08-20", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 762732, "segment_id": "xYQjgizErS", "segment_broadcast_id": "1OybclJwwV", "segment_title": "Campaign 04 / Bush vs. Kerry / Kerry\u2019s War Record / Olympics Ad", "segment_description": "(Studio: Scott Pelley) Report introduced. \n (Fort Myers, Florida: Byron Pitts) The flap over a veterans group\u2019s attack on Senator John Kerry\u2019s Vietnam war service featured; details given of his complaint to the Federal Election Commission calling for taking the ads off the air; ad from Swift Boat Veterans for Truth shown. [KERRY \u2013 talks about defending the country.] [White House press secretary Scott McCLELLAN \u2013 responds to Kerry\u2019s accusation that President Bush was behind the ads.] \n (Studio: Scott Pelley) Report introduced. \n (Athens: Lee Cowan) The controversy over Bush\u2019s campaign ad featuring Afghan & Iraqi athletes competing in the Olympic Games in Athens, Greece, featured; ad shown; Iraqi soccer player\u2019s & coach\u2019s statements about the team\u2019s displeasure with being used for political purposes quoted from \u201cSports Illustrated.\u201d [BUSH \u2013 says the athletes wouldn\u2019t have been free if the US had not acted.] [Iraqi soccer team director general Tiras ANWAYA&#134;- says every athlete & official in Iraq is free to express himself.]", "segment_duration": 270, "segment_type_id": 2, "segment_start_time": "63320.0", "legacy_segment_id": 762735, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "1OybclJwwV", "broadcast_date": "2004-08-20", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 762732, "segment_id": "qXb0ziAda1", "segment_broadcast_id": "1OybclJwwV", "segment_title": "Upcoming Items; fallen hero Marine L/Cpl. Shane Goldman&#134<!-- spelling on screen --> profiled. (Studio: Scott Pelley; Dan Rather)", "segment_description": "null", "segment_duration": 50, "segment_type_id": 2, "segment_start_time": "63590.0", "legacy_segment_id": 762736, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "1OybclJwwV", "broadcast_date": "2004-08-20", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 762732, "segment_id": "dd7UT3OYsD", "segment_broadcast_id": "1OybclJwwV", "segment_title": "(Commercial: Ziploc; Florida orange juice; Benefiber; Centrum; OneTouch Ultra; Prilosec; Viagra.)", "segment_description": "null", "segment_duration": 150, "segment_type_id": 3, "segment_start_time": "63640.0", "legacy_segment_id": 762737, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "1OybclJwwV", "broadcast_date": "2004-08-20", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 762732, "segment_id": "t4OYM7jXKO", "segment_broadcast_id": "1OybclJwwV", "segment_title": "Prescription Drugs / Imports", "segment_description": "(Studio: Scott Pelley) Rx Depot\u2019s withdrawal of its legal fight to distribute prescription drugs imported from Canada reported.", "segment_duration": 30, "segment_type_id": 2, "segment_start_time": "63790.0", "legacy_segment_id": 762738, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "1OybclJwwV", "broadcast_date": "2004-08-20", "broadcast_start_time": "63