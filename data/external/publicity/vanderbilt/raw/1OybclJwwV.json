cause his name is on a security watch list reported.", "segment_duration": 20, "segment_type_id": 2, "segment_start_time": "63980.0", "legacy_segment_id": 762740, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "1OybclJwwV", "broadcast_date": "2004-08-20", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 762732, "segment_id": "ofMXlSxF9i", "segment_broadcast_id": "1OybclJwwV", "segment_title": "Upcoming Items; Stock Market Report (Studio: Scott Pelley)", "segment_description": "null", "segment_duration": 20, "segment_type_id": 2, "segment_start_time": "64000.0", "legacy_segment_id": 762741, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "1OybclJwwV", "broadcast_date": "2004-08-20", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 762732, "segment_id": "OSl2pigfyH", "segment_broadcast_id": "1OybclJwwV", "segment_title": "(Commercial: Splenda; Viagra; Lamisil; Allegra; Congressman Lincoln Davis; \"CBS Evening News.\")", "segment_description": "null", "segment_duration": 170, "segment_type_id": 3, "segment_start_time": "64020.0", "legacy_segment_id": 762742, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": n