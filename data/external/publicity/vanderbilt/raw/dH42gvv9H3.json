{"data": [{"broadcast_id": "dH42gvv9H3", "broadcast_date": "2004-08-24", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 763153, "segment_id": "Q8YE4zK5ke", "segment_broadcast_id": "dH42gvv9H3", "segment_title": "Preview/Introduction Dan Rather (New York)", "segment_description": "null", "segment_duration": 50, "segment_type_id": 1, "segment_start_time": "63000.0", "legacy_segment_id": 763153, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Preview", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "dH42gvv9H3", "broadcast_date": "2004-08-24", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 763153, "segment_id": "KHnaWLw3td", "segment_broadcast_id": "dH42gvv9H3", "segment_title": "Iraq / Prisoner Abuse Scandal / Frederick", "segment_description": "(Studio: Dan Rather) Report introduced. \n (Pentagon: Bob Orr) The findings of the report of the Defense Department commission that investigated the abuse of prisoners at Abu Ghraib in Iraq featured; excerpts quoted; details given of charges that MPs were poorly trained and of the assignment of blame to top leaders, including CENTCOM and the Joint Chiefs of Staff. [Commission member James SCHLESINGER&#134;- says it was a kind of animal house on the night shift.] [Commission member Tillie FOWLER&#134;- comments on leadership failures.] \n (Studio: Dan Rather) Report introduced. \n (Mannheim, Germany: Tom Fenton) S/Sgt. Ivan \u201cChip\u201d Frederick&#134;\u2019s plea of guilty to some of the charges in his hearing in the prisoner abuse scandal featured; details given of pressure for senior officers to be called as witnesses and possibly face charges themselves. [FREDERICK \u2013states he wasn\u2019t given any guidelines.] [Frederick\u2019s attorney Gary MYERS&#134;- says after today, we will no longer hear that it was just 7 rogue soldiers.] [Wife Martha FREDERICK&#134;- comments.]", "segment_duration": 270, "segment_type_id": 2, "segment_start_time": "63050.0", "legacy_segment_id": 763154, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "dH42gvv9H3", "broadcast_date": "2004-08-24", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 763153, "segment_id": "o34P8qh4PR", "segment_broadcast_id": "dH42gvv9H3", "segment_title": "Iraq / Al-Sadr Revolt", "segment_description": "(Studio: Dan Rather) US bombing of guerrilla positions near the sacred mosque held by Shiite militia forces in Najaf, Iraq, noted. \n (Baghdad: Barry Petersen) The continued fighting against insurgents led by radical cleric Muqtada al-Sadr reviewed; scenes shown from Baghdad\u2019s Sadr City; details given about al-Sadr\u2019s offers of peace, which he later reneged. [1st Cavalry Division Spc. Michael KAMM&#134;- comments on the use of crowds as shields.]", "segment_duration": 150, "segment_type_id": 2, "segment_start_time": "63320.0", "legacy_segment_id": 763155, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "dH42gvv9H3", "broadcast_date": "2004-08-24", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 763153, "segment_id": "0n78ArdW0l", "segment_broadcast_id": "dH42gvv9H3", "segment_title": "Guantanamo Bay, Cuba / Tribunals", "segment_description": "(Studio: Dan Rather) Report introduced.   (Guantanamo Bay, Cuba: Mark Strassmann) The military tribunals for detainees with Al Qaeda ties who are being held at Guantanamo Bay, Cuba, featured; details given of the charges against Salim Hamdan&#134;&#134;, a driver for Al Qaeda leader Osama bin Laden, and 3 others {named} and of challenges against the constitutionality of the proceedings; courtroom sketches by Art Lien shown. [In November, 2001, President BUSH \u2013 says we will act with fairness and deliver justice.] [Hamdan\u2019s attorney Lt. Cmdr. Charles SWIFT&#134;- states punishing bin Laden\u2019s driver is a poor substitute for justice.] [Commissions supervisor retired Maj. Gen. John ALTENBURG&#134;- comments on protecting national security.]   (Studio: Dan Rather) The continuing hunt for bin Laden in Afghanistan and the belief that Al Qaeda agents are operating in Iran & Saudi Arabia noted.", "segment_duration": 160, "segment_type_id": 2, "segment_start_time": "63470.0", "legacy_segment_id": 763156, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "dH42gvv9H3", "broadcast_date": "2004-08-24", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 763153, "segment_id": "AtlYKczprF", "segment_broadcast_id": "dH42gvv9H3", "segment_title": "Russia / Plane Crashes", "segment_description": "(Studio: Dan Rather) An airplane crash in the Tula Region of Russia and the loss of contact with another aircraft over Rostov reported.", "segment_duration": 30, "segment_type_id": 2, "segment_start_time": "63630.0", "legacy_segment_id": 763157, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "dH42gvv9H3", "broadcast_date": "2004-08-24", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 763153, "segment_id": "EVvwJ1LjPV", "segment_broadcast_id": "dH42gvv9H3", "segment_title": "Upcoming Items; fallen hero Army Capt. Tristan Aitken&#134<!-- spelling on screen --> profiled. (Studio: Dan Rather)", "segment_description": "null", "segment_duration": 50, "segment_type_id": 2, "segment_start_time": "63660.0", "legacy_segment_id": 763158, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "dH42gvv9H3", "broadcast_date": "2004-08-24", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 763153, "segment_id": "FZdrdrWBXw", "segment_broadcast_id": "dH42gvv9H3", "segment_title": "(Commercial: Kia Spectra; Cheerios; Senokot; American Egg Board; Wisp; Minwax; Sure; Kia Spectra.)", "segment_description": "null", "segment_duration": 150, "segment_type_id": 3, "segment_start_time": "63710.0", "legacy_segment_id": 763159, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "dH42gvv9H3", "broadcast_date": "2004-08-24", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 763153, "segment_id": "aHtXbNyAwg", "segment_broadcast_id": "dH42gvv9H3", "segment_title": "Same-Sex Marriage / Cheney", "segment_description": "(Studio: Dan Rather) Vice President Dick Cheney\u2019s views on same-sex relationships and a constitutional amendment banning gay marriage noted; scenes shown from Davenport, Iowa.", "segment_duration": 30, "segment_type_id": 2, "segment_start_time": "63860.0", "legacy_segment_id": 763160, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "dH42gvv9H3", "broadcast_date": "2004-08-24", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 763153, "segment_id": "5oCQ0XIYNN", "segment_broadcast_id": "dH42gvv9H3", "segment_title": "Campaign 04 / Bush vs. Kerry", "segment_description": "(Studio: Dan Rather) Senator John Kerry\u2019s accusation that President Bush is waging an attack campaign instead of talking about issues reported; scenes shown from New York City.", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "63890.0", "legacy_segment_id": 763161, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "dH42gvv9H3", "broadcast_date": "2004-08-24", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 763153, "segment_id": "mSWD5PtIeP", "segment_broadcast_id": "dH42gvv9H3", "segment_title": "Inside Story (527s)", "segment_description": "(Studio: Dan Rather) The call by President Bush\u2019s campaign to end negative attack ads placed by outside support groups noted. \n (White House: John Roberts) The Bush campaign\u2019s opposition to 527s, groups that provide funding {soft money} for attack ads and other political activities, examined; details given of the loophole in the campaign finance reform law that allows 527s to raise unlimited money; 527 contributions to the two parties compared. [Yesterday, BUSH \u2013 criticizes the groups.] [Center for Responsive Politics Larry NOBLE&#134;- notes the Democratic 527s are more active than those on the Republican side.] [Republican pollster Frank LUNTZ&#134;- describes the impact of 527s on Senator John Kerry\u2019s campaign.]", "segment_duration": 150, "segment_type_id": 2, "segment_start_time": "63900.0", "legacy_segment_id": 763162, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "dH42gvv9H3", "broadcast_date": "2004-08-24", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 763153, "segment_id": "kb32bcBkMY", "segment_broadcast_id": "dH42gvv9H3", "segment_title": "Upcoming Items (Studio: Dan Rather)", "segment_description": "null", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "64050.0", "legacy_segment_id": 763163, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "dH42gvv9H3", "broadcast_date": "2004-08-24", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 763153, "segment_id": "CFROIDLK8Z", "segment_broadcast_id": "dH42gvv9H3", "segment_title": "(Commercial: Alavert; Nexium; Olay; Bush\u2019s Beans; Ex-Lax; Viagra.)", "segment_description": "null", "segment_duration": 160, "segment_type_id": 3, "segment_start_time": "64060.0", "legacy_segment_id": 763164, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "dH42gvv9H3", "broadcast_date": "2004-08-24", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 763153, "segment_id": "c5N25BjCbv", "segment_broadcast_id": "dH42gvv9H3", "segment_title": "Eye on America (Protestants in America)", "segment_description": "(Studio: Dan Rather) Report introduced. \n (Dallas: Bob McNamara) The decline in the number of Protestants in the US examined; scenes shown from a Valley, Nebraska, church where Baptists, Presbyterians and Methodists worship together; details given of the growth of Protestant mega-churches. [Methodist Cindy MATTEO&#134;- explains why three faiths joined together.] [National Opinion Research Center Tom W. SMITH&#134;- says America is becoming a society with no majority.] [Methodist Sharon OLSON&#134;- explains why many people do not attend church.] [Valley Community Church pastor Rev. Carl RATCLIFF&#134;- says mega-churches are not presenting a clear picture of the Gospel.]", "segment_duration": 160, "segment_type_id": 2, "segment_start_time": "64220.0", "legacy_segment_id": 763165, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "dH42gvv9H3", "broadcast_date": "2004-08-24", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 763153, "segment_id": "wj3HR494A4", "segment_broadcast_id": "dH42gvv9H3", "segment_title": "Medicine / Blueberries", "segment_description": "(Studio: Dan Rather) The discovery that blueberries contain a compound that helps reduce cholesterol and may prevent diabetes noted.", "segment_duration": 20, "segment_type_id": 2, "segment_start_time": "64380.0", "legacy_segment_id": 763166, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "dH42gvv9H3", "broadcast_date": "2004-08-24", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 763153, "segment_id": "e0GvlvJBqo", "segment_broadcast_id": "dH42gvv9H3", "segment_title": "Upcoming Items (Studio: Dan Rather)", "segment_description": "null", "segment_duration": 20, "segment_type_id": 2, "segment_start_time": "64400.0", "legacy_segment_id": 763167, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "dH42gvv9H3", "broadcast_date": "2004-08-24", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 763153, "segment_id": "j3u0wj48l1", "segment_broadcast_id": "dH42gvv9H3", "segment_title": "(Commercial: Pantene; American Egg Board; Prevacid; Singulair; Fidelity Investments; NewsChannel 5.)", "segment_description": "null", "segment_duration": 160, "segment_type_id": 3, "segment_start_time": "64420.0", "legacy_segment_id": 763168, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "dH42gvv9H3", "broadcast_date": "2004-08-24", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 763153, "segment_id": "7JglcRBsNU", "segment_broadcast_id": "dH42gvv9H3", "segment_title": "Olympic Games / Gymnastics / Judging Controversy", "segment_description": "(Studio: Dan Rather) Report introduced.   (Athens: Lee Cowan) The controversy over the judges\u2019 scoring of Russian gymnast Aleksei Nemov&#134;&#134; at the Olympic Games in Athens, Greece, featured; scenes shown of the performance & of the crowd expressing disapproval of the score, which prompted 2 judges to change their scores; details given of Russia\u2019s complaint to the IOC about a judging preference for wealthy countries, including the US. [US gymnast Paul HAMM&#134;- comments on the crowd\u2019s reaction.] [MAN \u2013 questions whether the people or the judges are doing the judging.] South Korea\u2019s protest against the judges noted. [HAMM \u2013 says he did deserve the {all-around} gold medal.]", "segment_duration": 110, "segment_type_id": 2, "segment_start_time": "64580.0", "legacy_segment_id": 763169, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "dH42gvv9H3", "broadcast_date": "2004-08-24", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 763153, "segment_id": "Jujg3GJwhv", "segment_broadcast_id": "dH42gvv9H3", "segment_title": "Good Night", "segment_description": "null", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "64690.0", "legacy_segment_id": 763170, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}]}