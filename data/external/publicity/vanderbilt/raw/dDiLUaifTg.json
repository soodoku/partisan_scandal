{"data": [{"broadcast_id": "dDiLUaifTg", "broadcast_date": "2004-09-07", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 764792, "segment_id": "QPn0WSjBD0", "segment_broadcast_id": "dDiLUaifTg", "segment_title": "Preview/Introduction Dan Rather (New York)", "segment_description": "null", "segment_duration": 50, "segment_type_id": 1, "segment_start_time": "63000.0", "legacy_segment_id": 764792, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Preview", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "dDiLUaifTg", "broadcast_date": "2004-09-07", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 764792, "segment_id": "bh49FbUx4N", "segment_broadcast_id": "dDiLUaifTg", "segment_title": "Iraq / Attacks / Sadr City", "segment_description": "(Studio: Dan Rather) The escalation of the US military death toll in Iraq to 1,000 noted. \n (Sadr City: Barry Petersen) The continuing fighting between US troops & followers of radical cleric Muqtada al-Sadr in Baghdad\u2019s Sadr City featured; scenes shown. [US Army Lt. Col. Lopez CARTER&#134;- comments on the \u201ccost of doing business.\u201d]", "segment_duration": 140, "segment_type_id": 2, "segment_start_time": "63050.0", "legacy_segment_id": 764793, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "dDiLUaifTg", "broadcast_date": "2004-09-07", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 764792, "segment_id": "35h2YtL7uK", "segment_broadcast_id": "dDiLUaifTg", "segment_title": "Campaign 04 / Bush vs. Kerry / Iraq War", "segment_description": "(Studio: Dan Rather) Vice President Dick Cheney\u2019s campaign comments about the danger of another terrorist attack and Senator John Edwards\u2019s response noted. \n (Columbia, Missouri: John Roberts) The accuracy of President Bush\u2019s attacks on Senator John Kerry as a \u201cflip-flopper\u201d in order to undercut Kerry\u2019s credibility on Iraq outlined. [Pollster Frank LUNTZ&#134;- notes Bush succeeded in getting the message out in Ohio.] [BUSH \u2013 mocks Kerry\u2019s position as being that of his former rival Howard Dean; criticizes Kerry\u2019s voting record.] [Yesterday, KERRY; earlier DEAN \u2013 state this was the wrong war at the wrong time.] [KERRY \u2013 says he would have done everything differently in Iraq.]", "segment_duration": 170, "segment_type_id": 2, "segment_start_time": "63190.0", "legacy_segment_id": 764794, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "dDiLUaifTg", "broadcast_date": "2004-09-07", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 764792, "segment_id": "8RbCU0D7zm", "segment_broadcast_id": "dDiLUaifTg", "segment_title": "Russia / School Standoff / Video", "segment_description": "(Studio: Dan Rather) Report introduced.   (Moscow: Elizabeth Palmer) The release of video of the inside of the Beslan, Russia, school during the takeover by rebels from Chechnya featured; scenes shown of masked terrorists assembling bombs, hostages in the gym, blood on the floor.", "segment_duration": 140, "segment_type_id": 2, "segment_start_time": "63360.0", "legacy_segment_id": 764795, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "dDiLUaifTg", "broadcast_date": "2004-09-07", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 764792, "segment_id": "ti6I1d135g", "segment_broadcast_id": "dDiLUaifTg", "segment_title": "Air Security / Suicide Bombers", "segment_description": "(Studio: Dan Rather) The recent crashes of two planes in Russia mentioned.   (Washington: Bob Orr) Efforts to tighten security on US planes to prevent a suicide bombing featured; details given of new screening measures; scenes shown from the Russian crash sites; airports with explosive \u201csniffer\u201d machines listed. [PASSENGER \u2013 reacts.]", "segment_duration": 120, "segment_type_id": 2, "segment_start_time": "63500.0", "legacy_segment_id": 764796, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "dDiLUaifTg", "broadcast_date": "2004-09-07", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 764792, "segment_id": "DHzOd73Qn3", "segment_broadcast_id": "dDiLUaifTg", "segment_title": "Hurricane Frances", "segment_description": "(Studio: Dan Rather) Damage in Georgia from the remnants of Hurricane Frances, which has been downgraded to a tropical depression, and the impact of the storm on Florida residents noted; scenes shown from Atlanta and Palm Beach; map shown of the location of Hurricane Ivan.", "segment_duration": 40, "segment_type_id": 2, "segment_start_time": "63620.0", "legacy_segment_id": 764797, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "dDiLUaifTg", "broadcast_date": "2004-09-07", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 764792, "segment_id": "7nZyW9Q6Ct", "segment_broadcast_id": "dDiLUaifTg", "segment_title": "Upcoming Items; fallen hero Army Spc. Jon Fettig&#134<!-- spelling on screen --> profiled. (Studio: Dan Rather)", "segment_description": "null", "segment_duration": 50, "segment_type_id": 2, "segment_start_time": "63660.0", "legacy_segment_id": 764798, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "dDiLUaifTg", "broadcast_date": "2004-09-07", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 764792, "segment_id": "13D7ODzdzT", "segment_broadcast_id": "dDiLUaifTg", "segment_title": "(Commercial: Procrit; Grape-Nuts; Bayer; Serenity; Prevacid; Viagra.)", "segment_description": "null", "segment_duration": 150, "segment_type_id": 3, "segment_start_time": "63710.0", "legacy_segment_id": 764799, "network_name": "CBS", "