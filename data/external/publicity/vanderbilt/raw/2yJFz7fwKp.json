{"data": [{"broadcast_id": "2yJFz7fwKp", "broadcast_date": "2004-08-20", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 762750, "segment_id": "tKdfsPrF1u", "segment_broadcast_id": "2yJFz7fwKp", "segment_title": "Preview/Introduction Brian Williams (Greece)", "segment_description": "null", "segment_duration": 70, "segment_type_id": 1, "segment_start_time": "63000.0", "legacy_segment_id": 762750, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "Preview", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "2yJFz7fwKp", "broadcast_date": "2004-08-20", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 762750, "segment_id": "JDhyuNSg3l", "segment_broadcast_id": "2yJFz7fwKp", "segment_title": "Iraq / Politics", "segment_description": "(Athens: Brian Williams) Report introduced. \n (Baghdad: Preston Mendenhall) The overshadowing of political developments in Iraq by the confusion over the status of the cease-fire in the battle for Najaf featured; scenes shown from a public airing of political views in Baghdad. [On the phone, \u201cWashington Post\u201d Karl VICK&#134;- says there seems to be a more weakened guerrilla force {in Najaf.}] [Iraqi council member Dr. Raja KHUZAI&#134;&#134;- says we hope everything will settle and we\u2019ll live a normal life.]", "segment_duration": 120, "segment_type_id": 2, "segment_start_time": "63070.0", "legacy_segment_id": 762751, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "2yJFz7fwKp", "broadcast_date": "2004-08-20", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 762750, "segment_id": "kuliDyQ2Zg", "segment_broadcast_id": "2yJFz7fwKp", "segment_title": "Terrorism / Pakistan / Libi", "segment_description": "(Athens: Brian Williams) The hunt in Pakistan for Abu Faraj al-Libbi, an associate of Al Qaeda leader Osama bin Laden who is believed to be the successor of Khalid Shaikh Mohammed\u2020\u2020 and may have been behind assassination attempts on Pakistani President Pervez Musharraf, noted.", "segment_duration": 40, "segment_type_id": 2, "segment_start_time": "63190.0", "legacy_segment_id": 762752, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "2yJFz7fwKp", "broadcast_date": "2004-08-20", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 762750, "segment_id": "HYlFL7j0gM", "segment_broadcast_id": "2yJFz7fwKp", "segment_title": "Terrorism / Hamas Charges", "segment_description": "(Athens: Brian Williams) Attorney General John Ashcroft\u2019s announcement of terror charges against 3 men accused of funneling money to Hamas reported.", "segment_duration": 20, "segment_type_id": 2, "segment_start_time": "63230.0", "legacy_segment_id": 762753, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "2yJFz7fwKp", "broadcast_date": "2004-08-20", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 762750, "segment_id": "AXefvuElRs", "segment_broadcast_id": "2yJFz7fwKp", "segment_title": "Economy / Oil Prices", "segment_description": "(Athens: Brian Williams) Report introduced. \n (New York: Anne Thompson) The impact of skyrocketing oil prices on the economy examined; details given of fears of terrorism and increased demand and of the effect on gas and heating oil prices. [Wells Fargo Dr. Sung Won SOHN&#134;- says we may have to live with the high price of oil for an indefinite period; notes the impact on jobs.] [Alaron Trading Phil FLYNN&#134;- notes we consume every barrel of oil we produce every day.] [Winthrop, Massachusetts, resident Louis DiVENDETTA&#135;- worries about his heating bill.]", "segment_duration": 130, "segment_type_id": 2, "segment_start_time": "63250.0", "legacy_segment_id": 762754, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "2yJFz7fwKp", "broadcast_date": "2004-08-20", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 762750, "segment_id": "AdSxpxOZsZ", "segment_broadcast_id": "2yJFz7fwKp", "segment_title": "Stock Market Report (Athens: Brian Williams)", "segment_description": "null", "segment_duration": 20, "segment_type_id": 2, "segment_start_time": "63380.0", "legacy_segment_id": 762755, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "2yJFz7fwKp", "broadcast_date": "2004-08-20", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 762750, "segment_id": "peQrsOiHpY", "segment_broadcast_id": "2yJFz7fwKp", "segment_title": "Decision 2004 / Bush vs. Kerry / Kerry\u2019s War Record", "segment_description": "(Athens: Brian Williams) Report introduced.   (Fort Myers, Florida: Carl Quintanilla) More fallout from the Vietnam veterans running ads attacking Senator John Kerry\u2019s military service featured; scenes shown of Kerry surveying hurricane damage in Florida; details given of a \"New York Times\" report documenting the funding of Swift Boat Veterans for Truth by associates of presidential advisor Karl Rove and former President George Bush; ad focusing on Kerry\u2019s anti-war activities in the 1970s shown. [In Florida, KERRY \u2013 talks jobs.] [White House press secretary Scott McCLELLAN \u2013 says Kerry should not lash out at the president.] [Kerry-Edwards campaign advisor Tad DEVINE&#134;- says the group is advancing the president\u2019s agenda.] [Democratic pollster Geoffrey GARIN&#134;- downplays the impact of the ads.]", "segment_duration": 130, "segment_type_id": 2, "segment_start_time": "63400.0", "legacy_segment_id": 762756, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "2yJFz7fwKp", "broadcast_date": "2004-08-20", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 762750, "segment_id": "7WzXuAgwB6", "segment_broadcast_id": "2yJFz7fwKp", "segment_title": "Upcoming Items (Athens: Brian Williams)", "segment_description": "null", "segment_duration": 20, "segment_type_id": 2, "segment_start_time": "63530.0", "legacy_segment_id": 762757, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "2yJFz7fwKp", "broadcast_date": "2004-08-20", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 762750, "segment_id": "tGHqoXRaSx", "segment_broadcast_id": "2yJFz7fwKp", "segment_title": "(Commercial: Allegra; Gas-X; Olay; Plavix.)", "segment_description": "null", "segment_duration": 120, "segment_type_id": 3, "segment_start_time": "63550.0", "legacy_segment_id": 762758, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "2yJFz7fwKp", "broadcast_date": "2004-08-20", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 762750, "segment_id": "rGgFiERhpo", "segment_broadcast_id": "2yJFz7fwKp", "segment_title": "Olympic Games / Baseball", "segment_description": "(Athens: Brian Williams) Report introduced. \n (Athens: Jim Maceda) The busiest day of the Olympic Games in Athens, Greece, reviewed; details given about the pickup in ticket sales & TV ratings; scenes shown of crowds, including New York City Mayor Michael Bloomberg, who hopes to have the 2012 games in his city. [BLOOMBERG \u2013 comments on Athens\u2019 accomplishment.] [US swimmer Michael PHELPS \u2013 explains why he gave up his relay spot to teammate Ian Crocker.] [\u201cLos Angeles Times\u201d Alan ABRAHAMSON&#134;- comments on security.] \n (Athens: Brian Williams) The day\u2019s results reviewed. The Greek baseball team featured; details given of the idea of Baltimore Orioles owner Peter Angelos&#134;&#134; to have a team of American players with Greek ancestry. [Player Nick THEODORO&#134;&#134;- expresses pride in playing for the team where his grandfather & mother came from.] [Nick\u2019s parents Georgia & Anthony THEDOROU&#134;- comment on going to Greece to support their son.] [Angelos\u2019 son Louis&#134;&#134; ANGELOS \u2013 comments on what it means for Greeks to come together & represent Greece.] [Player Clay BELLINGER&#134;&#134;- comments on playing in the Olympics.] [Greek MAN \u2013 wonders about how the game is played.] The failure of a US team to qualify for the Olympics noted.", "segment_duration": 390, "segment_type_id": 2, "segment_start_time": "63670.0", "legacy_segment_id": 762759, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "2yJFz7fwKp", "broadcast_date": "2004-08-20", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 762750, "segment_id": "PfvLrgU1JX", "segment_broadcast_id": "2yJFz7fwKp", "segment_title": "Upcoming Items (Athens: Brian Williams)", "segment_description": "null", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "64060.0", "legacy_segment_id": 762760, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "2yJFz7fwKp", "broadcast_date": "2004-08-20", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 762750, "segment_id": "G4RUSgvftH", "segment_broadcast_id": "2yJFz7fwKp", "segment_title": "(Commercial: Transitions; Hyundai Santa Fe; Prevacid; Caltrate; \"Meet the Press.\")", "segment_description": "null", "segment_duration": 160, "segment_type_id": 3, "segment_start_time": "64070.0", "legacy_segment_id": 762761, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "2yJFz7fwKp", "broadcast_date": "2004-08-20", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 762750, "segment_id": "HBCO036705", "segment_broadcast_id": "2yJFz7fwKp", "segment_title": "Viagra / New Ads", "segment_description": "(Athens: Brian Williams) Report introduced. \n (Washington: Bob Faw) The new, sexier ads for Viagra featured; ads shown; details given of competition from new products to treat sexual dysfunction, including Levitra and Cialis. [Pfizer consumer marketing vice president Dorothy WETZEL&#134;- comments on efforts to reach men who haven\u2019t gone to their doctor.] [Advertising executive Jerry DELLA FEMINA&#134;- states the ad might be seen as silly.] [Conservative family advocate Genevieve WOOD&#134;- opposes the ads.]", "segment_duration": 130, "segment_type_id": 2, "segment_start_time": "64230.0", "legacy_segment_id": 762762, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "2yJFz7fwKp", "broadcast_date": "2004-08-20", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 762750, "segment_id": "llDk6PRp3b", "segment_broadcast_id": "2yJFz7fwKp", "segment_title": "Upcoming Items (Athens: Brian Williams)", "segment_description": "null", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "64360.0", "legacy_segment_id": 762763, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "2yJFz7fwKp", "broadcast_date": "2004-08-20", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 762750, "segment_id": "I3qyRHT9o2", "segment_broadcast_id": "2yJFz7fwKp", "segment_title": "(Commercial: Singulair; Thompson\u2019s Water Seal; Cheerios; Imitrex; Crest; Channel 4 News.)", "segment_description": "null", "segment_duration": 170, "segment_type_id": 3, "segment_start_time": "64370.0", "legacy_segment_id": 762764, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "2yJFz7fwKp", "broadcast_date": "2004-08-20", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "br