  The Biden-Palin debate next Tuesday noted. ", "segment_duration": 310, "segment_type_id": 2, "segment_start_time": "63830.0", "legacy_segment_id": 905471, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "Dm66eqJVgO", "broadcast_date": "2008-09-22", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1730, "broadcast_description": null, "legacy_broadcast_id": 905465, "segment_id": "yOkcjoUanp", "segment_broadcast_id": "Dm66eqJVgO", "segment_title": "Upcoming Items (Studio: Katie Couric)", "segment_description": " ", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "64140.0", "legacy_segment_id": 905472, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "Dm66eqJVgO", "broadcast_date": "2008-09-22", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1730, "broadcast_description": null, "legacy_broadcast_id": 905465, "segment_id": "N3DaeiE5EG", "segment_broadcast_id": "Dm66eqJVgO", "segment_title": "(Commercial: Healthy Choice; Januvia; BP; Aquinas College.)", "segment_description": " ", "segment_duration": 150, "segment_type_id": 3, "segment_start_time": "64150.0", "legacy_segment_id": 905473, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "Dm66eqJVgO", "broadcast_date": "2008-09-22", "b