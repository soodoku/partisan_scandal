port introduced.   (New York: Robert Bazell) Concern about the safety and effectiveness of cough and cold medicines for young children examined; statistics on deaths related to decongestants and antihistamines cited. [Baltimore health commissioner Dr. Joshua SHARFSTEIN&#134;- says marketing claims are not true.] [Consumer Healthcare Products Assn. Linda SUYDAM&#134;- says misuse is the cause of most of these adverse events.] [Parent Jen BAIRD&#135;- comments.] ", "segment_duration": 120, "segment_type_id": 2, "segment_start_time": "63960.0", "legacy_segment_id": 919863, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "4Xy47DW6S3", "broadcast_date": "2008-10-02", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 919854, "segment_id": "vLV34b6UTb", "segment_broadcast_id": "4Xy47DW6S3", "segment_title": "Upcoming Items (Studio: Brian Williams)", "segment_description": " ", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "64080.0", "legacy_segment_id": 919864, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "4Xy47DW6S3", "broadcast_date": "2008-10-02", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 919854, "segment_id": "nqm3IS9swr", "segment_broadcast_id": "4Xy47DW6S3", "segment_title": "(Commercial: V8; \u201cFlash of Genius\u201d; John McCain; Red Lobs