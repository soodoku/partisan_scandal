{"data": [{"broadcast_id": "QbeVG8KZFw", "broadcast_date": "2008-10-09", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1710, "broadcast_description": null, "legacy_broadcast_id": 920178, "segment_id": "T6iy2gMqeu", "segment_broadcast_id": "QbeVG8KZFw", "segment_title": "Preview/Introduction Brian Williams (New York)", "segment_description": null, "segment_duration": 50, "segment_type_id": 1, "segment_start_time": "63000.0", "legacy_segment_id": 920178, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "Preview", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "QbeVG8KZFw", "broadcast_date": "2008-10-09", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1710, "broadcast_description": null, "legacy_broadcast_id": 920178, "segment_id": "IhwWHi82l2", "segment_broadcast_id": "QbeVG8KZFw", "segment_title": "Economy: Stock Market / Wachovia / Charlotte, North Carolina", "segment_description": "(Studio: Brian Williams) The huge drop in the stock market with a fall of over 5000 points in one year noted; graph shown.  \n\n(New York Stock Exchange: Maria Bartiromo) The freefall in the market due to fear over a global economic slowdown, the credit crunch and failing banks examined; details given of the impact on auto makers; the drop in GM stock cited. [Blackrock Bob DOLL&#134;- agrees this is a crash.] [CNBC\u2019s Phil LeBEAU&#134;- notes concern about GM\u2019s financial status.]  \n\n(Studio: Brian Williams) Report introduced.  \n\n(White House: John Yang) The indifferent response of the markets to actions taken by world finance ministers featured.  \n\n(Studio: Brian Williams) The impact of the economic crisis on state budgets with specific examples outlined.  \n\n(Charlotte, North Carolina: Kerry Sanders) The impact of the sale of Wachovia bank on the headquarters city of Charlotte, North Carolina, featured. [University of North Carolina at Charlotte Tony PLATH&#134;- says there is a ripple effect all through the job market.] [Realtor Dan COTTINGHAM&#134;- says the news is devastating when you lose a corporate citizen.] [YWCA Jane McINTYRE&#134;- worries about the consequences of losing donations.] [Mayor Pat McCRORY&#134;- says it\u2019s a difficult hit in the gut.] ", "segment_duration": 470, "segment_type_id": 2, "segment_start_time": "63050.0", "legacy_segment_id": 920179, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "QbeVG8KZFw", "broadcast_date": "2008-10-09", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1710, "broadcast_description": null, "legacy_broadcast_id": 920178, "segment_id": "14jRVgFFn5", "segment_broadcast_id": "QbeVG8KZFw", "segment_title": "Decision 2008 / Obama vs. McCain ", "segment_description": "(Studio: Brian Williams) Reports introduced.   (Mosinee, Wisconsin: Kelly O\u2019Donnell) Senator John McCain\u2019s campaign featured; scenes shown from a rally with Governor Sarah Palin in Wisconsin, where supporters vented about McCain running behind Senator Barack Obama and the issues; NBC News/\"Wall Street Journal\" poll results on Obama\u2019s stand among women cited. [PALIN \u2013 speaks to women.] [McCAIN \u2013 says we need to trust the next president.]   (Portsmouth, Ohio: Lee Cowan) Obama\u2019s campaign featured; campaign ads shown; figures on his spending cited; details given about the tone of Obama\u2019s ads vs. McCain\u2019s. [In Dayton, Ohio, OBAMA \u2013 criticizes McCain\u2019s economic proposal.] [Senator Joe BIDEN \u2013 criticizes McCain\u2019s negative ads.] Obama\u2019s plan to buy 30-minute blocks of network ad space noted. ", "segment_duration": 250, "segment_type_id": 2, "segment_start_time": "63520.0", "legacy_segment_id": 920180, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "QbeVG8KZFw", "broadcast_date": "2008-10-09", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1710, "broadcast_description": null, "legacy_broadcast_id": 920178, "segment_id": "FOgpPZxPmr", "segment_broadcast_id": "QbeVG8KZFw", "segment_title": "Upcoming Items (Studio: Brian Williams)", "segment_description": " ", "segment_duration": 20, "segment_type_id": 2, "segment_start_time": "63770.0", "legacy_segment_id": 920181, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "QbeVG8KZFw", "broadcast_date": "2008-10-09", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1710, "broadcast_description": null, "legacy_broadcast_id": 920178, "segment_id": "LVSIwK4fxm", "segment_broadcast_id": "QbeVG8KZFw", "segment_title": "(Commercial: Plavix; All-Bran; Valpak.)", "segment_description": " ", "segment_duration": 120, "segment_type_id": 3, "segment_start_time": "63790.0", "legacy_segment_id": 920182, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "QbeVG8KZFw", "broadcast_date": "2008-10-09", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1710, "broadcast_description": null, "legacy_broadcast_id": 920178, "segment_id": "wypGWuMT9C", "segment_broadcast_id": "QbeVG8KZFw", "segment_title": "Nebraska / Safe Haven Law", "segment_description": "(Studio: Brian Williams) Report introduced.  \n\n(Omaha: Janet Shamlian) Nebraska's safe-haven law, which was created to protect newborns abandoned by their mothers but has resulted in children and teens being left at hospital emergency rooms, featured. [2 WOMEN \u2013 react to the law.] [Nebraska senator Ernie CHAMBERS&#134;- says the term \u201cchild\u201d had no definition.] [Governor Dave HEINEMAN&#134;- says the law needs to be changed.] [Nebraska Family support Network Eve BLEYHL&#134;- says these families need help.] [Boys Town Robert PICK&#134;- says there are agencies people can call.] ", "segment_duration": 130, "segment_type_id": 2, "segment_start_time": "63910.0", "legacy_segment_id": 920183, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "QbeVG8KZFw", "broadcast_date": "2008-10-09", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1710, "broadcast_description": null, "legacy_broadcast_id": 920178, "segment_id": "2D3z7EldKs", "segment_broadcast_id": "QbeVG8KZFw", "segment_title": "Upcoming Items (Studio: Brian Williams)", "segment_description": " ", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "64040.0", "legacy_segment_id": 920184, "network_name": "NBC", "broadcast_type_name": "Evening News