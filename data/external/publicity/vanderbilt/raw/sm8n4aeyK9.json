 Russ Mitchell)  A video of two French journalists taken hostage in Iraq noted. \n (Baghdad: Barry Petersen)  The three-week battle in the holy city of Najaf, Iraq, updated; scenes shown from Najaf, where the militias slipped away after the peace deal brokered by Grand Ayatollah Ali al-Sistani; details given about how the interim government is losing Iraq one city at a time.", "segment_duration": 120, "segment_type_id": 2, "segment_start_time": "63890.0", "legacy_segment_id": 763621, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "sm8n4aeyK9", "broadcast_date": "2004-08-28", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 763614, "segment_id": "9PMmQOrr3M", "segment_broadcast_id": "sm8n4aeyK9", "segment_title": "Olympic Games / Results", "segment_description": "(Studio: Russ Mitchell)  Today's results in women's & men's basketball at the Olympic Games & Secretary of State Colin Powell's cancellation of his plans to attend the closing ceremonies reported; scenes shown of anti-US protests in Athens, Greece.", "segment_duration": 30, "segment_type_id": 2, "segment_start_time": "64010.0", "legacy_segment_id": 763622, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "sm8n4aeyK9", "broadcast_date": "2004-08-28", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 763614, "segment_i