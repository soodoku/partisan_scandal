orting the patient's legal/illegal status examined; scenes shown from an Los Angeles hospital.  [Los Angeles emergency room physician Dr. Brian JOHNSTON&#134;- says the immigrants will be scared away.]  [Center for Medicine & Medicaid Services Dr. Mark McCLELLAN&#134;- defends the program to help immigrants.]  [Illegal IMMIGRANT&nbsp- {thru translator} says she would be afraid to go to the hospital.]  [Representative Dana ROHRABACHER&nbsp- questions the hospital policy.]", "segment_duration": 140, "segment_type_id": 2, "segment_start_time": "64210.0", "legacy_segment_id": 763625, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "sm8n4aeyK9", "broadcast_date": "2004-08-28", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 763614, "segment_id": "NRB35mRoMG", "segment_broadcast_id": "sm8n4aeyK9", "segment_title": "Upcoming Items (Studio: Russ Mitchell)", "segment_description": "null", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "64350.0", "legacy_segment_id": 763626, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "sm8n4aeyK9", "broadcast_date": "2004-08-28", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 763614, "segment_id": "lAbhvMroAk", "segment_broadcast_id": "sm8n4aeyK9", "segment_title": "(Commercial: Ex-Lax; Vioxx; Prevacid; Claritin; :CBS Even