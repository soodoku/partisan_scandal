{"data": [{"broadcast_id": "nMz79c2xNg", "broadcast_date": "2008-09-30", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1710, "broadcast_description": null, "legacy_broadcast_id": 906452, "segment_id": "fveh8cvL1a", "segment_broadcast_id": "nMz79c2xNg", "segment_title": "Preview/Introduction Charles Gibson (New York)", "segment_description": null, "segment_duration": 50, "segment_type_id": 1, "segment_start_time": "63000.0", "legacy_segment_id": 906452, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "Preview", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "nMz79c2xNg", "broadcast_date": "2008-09-30", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1710, "broadcast_description": null, "legacy_broadcast_id": 906452, "segment_id": "Ij26Z1Uy82", "segment_broadcast_id": "nMz79c2xNg", "segment_title": "Economy: Rescue Plan / Stock and Credit Markets", "segment_description": "(Studio: Charles Gibson)  The question of what will follow the House defeat of the rescue plan for the financial system introduced; many newspaper headlines shown.  Stock Market Report.  \n\n(Studio: Betsy Stark)  The remarkable rebound in the stock market and the ongoing problems in the credit system examined; details given about the jump in the inter-bank lending rate {LIBOR}.  [On the street, two PEOPLE&nbsp- react.]  [Charles Schwab CIO Liz Ann SONDERS&#134;- says the credit market is shut down.]  [MIT Sloan School professor Simon JOHNSON&#134;- says banks don't trust each other.]  [Council on Foreign Relations economist Brad SETSER&#134;- cites the likely drag on economic activities.]  \n\n(Studio: Charles Gibson)  Report introduced.  \n\n(Washington: Jake Tapper)  The efforts to get an economic relief package back on track featured; details given about the votes in Congress.  [In Muncie, Indiana, Representative Mike PENCE&nbsp- explains his objection to using taxpayer dollars.]  [Constituent Gina ROBINSON&#134;- reacts.]  [President BUSH&nbsp- calls the situation urgent.]  [Senator Bob BENNETT, Representative Chris VAN HOLLEN&nbsp- outline consequences.]  The issue of the term \"bailout\" and the response of constituents that overloaded the House Website noted.  \n\n(Studio: Charles Gibson)  The reaction of presidential candidates Senators John McCain and Barack Obama to the rescue package noted..  [McCAIN&nbsp- says the constituents weighed in against a bailout.]  [OBAMA&nbsp- says the people will get help as well as the \"big boys.\"] ", "segment_duration": 430, "segment_type_id": 2, "segment_start_time": "63050.0", "legacy_segment_id": 906453, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "nMz79c2xNg", "broadcast_date": "2008-09-30", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1710, "broadcast_description": null, "legacy_broadcast_id": 906452, "segment_id": "HzDnAVi6Go", "segment_broadcast_id": "nMz79c2xNg", "segment_title": "Campaign 2008 / Obama vs. McCain / Poll", "segment_description": "(Studio: Charles Gibson)  The standings of presidential candidates Senators John McCain and Barack Obama in the latest ABC News/\"Washington Post\" poll cited.   (Studio: Charles Gibson; Washington: George Stephanopoulos)  How independent and white women voters are shifting back and forth, the record disapproval rating for President Bush, which hurts McCain and the view of Obama as commander-in-chief reviewed. ", "segment_duration": 120, "segment_type_id": 2, "segment_start_time": "63480.0", "legacy_segment_id": 906454, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "nMz79c2xNg", "broadcast_date": "2008-09-30", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1710, "broadcast_description": null, "legacy_broadcast_id": 906452, "segment_id": "ENv5az2D4I", "segment_broadcast_id": "nMz79c2xNg", "segment_title": "Campaign 2008 / Obama vs. McCain / North Dakota", "segment_description": "(Studio: Charles Gibson)  Report introduced.  \n\n(Fargo, North Dakota: Neal Karlinsky)  The view of the economy and the presidential race from North Dakota featured; scenes shown from Fargo.  [Local radio talk show host Scott HENNEN&#134;, Fargo resident Maryann NAGLE&#134;, Representative Earl POMEROY&#134;, small businesswoman Nancy NERLAND&#134;&#134;; on a rural farm, Sue OVERBO&#134;&#134;- comment on the times and the bailout bill.] ", "segment_duration": 130, "segment_type_id": 2, "segment_start_time": "63600.0", "legacy_segment_id": 906455, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "nMz79c2xNg", "broadcast_date": "2008-09-30", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1710, "broadcast_description": null, "legacy_broadcast_id": 906452, "segment_id": "Qbcu35xBFS", "segment_broadcast_id": "nMz79c2xNg", "segment_title": "Upcoming Items (Studio: Charles Gibson)", "segment_description": " ", "segment_duration": 30, "