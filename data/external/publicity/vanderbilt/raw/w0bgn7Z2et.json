: "2004-08-27", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 763646, "segment_id": "7jrBOzIjfe", "segment_broadcast_id": "w0bgn7Z2et", "segment_title": "September 11 / Commission Report / Intelligence Reforms", "segment_description": "(Studio: Dan Rather) Report introduced. \n (White House: John Roberts) President Bush\u2019s adoption of intelligence system reforms recommended by the 9/11 Commission\u2019s report featured; photo shown of Bush signing 3 orders {listed}; details given about the importance of the issue in the presidential election and about criticism that he did not appoint a national intelligence director. [BUSH \u2013 talks about security.] [9/11 Commission vice chairman Lee HAMILTON \u2013 says the president is taking an interim step before legislation comes along.] [Senator John EDWARDS \u2013 says the president still doesn\u2019t get it.] [Brookings Institution Michael O\u2019HANLON&#134;- says Bush can show he\u2019s a worthy commander-in-chief.]", "segment_duration": 120, "segment_type_id": 2, "segment_start_time": "63220.0", "legacy_segment_id": 763648, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "w0bgn7Z2et", "broadcast_date": "2004-08-27", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 763646, "segment_id": "GJ9shzLWcz", "segment_broadcast_id": "w0bgn7Z2et", "segment_title": "Russia / Plane Crashes", "segment_description": "(Studio: Dan Rather) Report introduced. \n (Moscow: Richard Roth) Growing evidence that the planes that crashed in Russia were brought down by female Islamic suicide bombers, possibly from Chechnya, examined; scenes shown of the wreckage, where traces of the explosive hexogen were found; details given about women\u2019s roles in Chechen terror and about concerns about security at Moscow\u2019s Domodedovo&#134;&#134; International Airport. [Aviation consultant Paul DUFFY&#134;- reviews the theory.] [Jane\u2019s Aviation Chris YATES&#134;- says there are still significant holes in the system.]", "segment_duration": 140, "segment_type_id": 2, "segment_start_time": "63340.0", "legacy_segment_id": 763649, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "w0bgn7Z2et", "broadcast_date": "2004-08-27", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 763646, "segment_id": "vPK8iYmq5d", "segment_broadcast_id": "w0bgn7Z2et", "segment_title": "Iraq / Al-Sadr Revolt / Peace Deal", "segment_description": "(Studio: Dan Rather) The return of Shiite worshippers to the Imam Ali shrine after a letup in the fighting in Najaf, Iraq, brought about by a peace deal shown.", "segment_duration": 30, "segment_type_id": 2, "segment_start_time": "63480.0", "legacy_segment_id": 763650, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "w0bgn7Z2et", "broadcast_date": "2004-08-27", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 763646, "segment_id": "OCBvksT3ld", "segment_broadcast_id": "w0bgn7Z2et", "segment_title": "Campaign 04 / Bush vs. Kerry / Florida", "segment_description": "(Studio: Dan Rather) President Bush\u2019s campaign trip to Florida, where he announced an increase in federal disaster aid to help in the recovery from Hurricane Charley, noted; scenes shown from Miami.   (Palm Beach County, Florida: Mark Strassmann) A collaborative report with the \"New York Times\" on changes in Florida\u2019s election system since the 2000 election presented; voting changes outlined. [Palm Beach County Democrats Ruth PLEVA&#134;, Ellie RAKOWITZ&#134;- worry about the fairness of the election.] [Palm Beach County Elections Supervisor Theresa LePORE&#134;- says south Florida is being held to a higher standard than any other jurisdiction.] [Palm Beach County Republican chairman Sid DINERSTEIN&#134;- states Democrats will try to get in court what they can\u2019t get in the voting booth.]", "segment_duration": 130, "segment_type_id": 2, "segment_start_time": "63510.0", "legacy_segment_id": 763651, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "w0bgn7Z2et", "broadcast_date": "2004-08-27", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 763646, "segment_id": "t4oDunA4rE", "segment_broadcast_id": "w0bgn7Z2et", "segment_title": "Upcoming Items; fallen hero Army Sfc. Paul Smith profiled. (Studio: Dan Rather)", "segment_description": "null", "segment_duration": 60, "segment_type_id": 2, "segment_start_time": "63640.0", "legacy_segment_id": 763652, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Ne