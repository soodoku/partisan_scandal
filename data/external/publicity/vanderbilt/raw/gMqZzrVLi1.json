{"data": [{"broadcast_id": "gMqZzrVLi1", "broadcast_date": "2004-08-13", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 762247, "segment_id": "t5VmDYy1vh", "segment_broadcast_id": "gMqZzrVLi1", "segment_title": "Preview/Introduction Dan Rather (New York)", "segment_description": "null", "segment_duration": 50, "segment_type_id": 1, "segment_start_time": "63000.0", "legacy_segment_id": 762247, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Preview", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "gMqZzrVLi1", "broadcast_date": "2004-08-13", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 762247, "segment_id": "jnKcr7aHQ1", "segment_broadcast_id": "gMqZzrVLi1", "segment_title": "Hurricane Charley / Florida / Carpenter Interview", "segment_description": "(Studio: Dan Rather) Hurricane Charley\u2019s strike on the Florida Gulf Coast noted; maps shown. \n (Port Charlotte, Florida: Jim Acosta) Charley\u2019s impact on southwest Florida featured; scenes shown of high winds & waves, rain, damage, people in shelters. [CBS News analyst Bryan NORCROSS&#134;- says people cannot survive the storm surge we\u2019ll get with this hurricane.] [In shelter, WOMAN \u2013 reacts.] \n (Studio: Dan Rather) Telephone interview held with Port Charlotte Sheriff\u2019s Office public information officer Bob Carpenter&#134; about riding out the storm. [CARPENTER \u2013 says they can\u2019t get emergency vehicles out on the road; comments on the severity of the storm; outlines the types of emergency calls.] \n (North Redington Beach: Mark Strassmann) The sense of relief in the Tampa-St. Petersburg area from being spared a direct hit by Charley featured; details given of the danger for people who fled inland and may now be facing greater danger; scenes shown of lines of traffic, boarded-up buildings. [Evacuating resident Lynn HECKLER&#134;- points out the potential impact of storm surge on her home.] [Clearwater, Florida, Mayor Brian AUNGST&#134;- says this is a matter of life & death.] [Residents Bruce WILLIAMS&#134;, Bill QUEEN&#135;- offer views on evacuating.] \n (Studio: Dan Rather) Charley\u2019s similarity to 1960\u2019s Hurricane Donna noted; footage shown; death & damage statistics cited.", "segment_duration": 450, "segment_type_id": 2, "segment_start_time": "63050.0", "legacy_segment_id": 762248, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "gMqZzrVLi1", "broadcast_date": "2004-08-13", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 762247, "segment_id": "aGkrvAEY4P", "segment_broadcast_id": "gMqZzrVLi1", "segment_title": "Iraq / Najaf", "segment_description": "(Studio: Dan Rather) The suspension of the US offensive in Najaf, Iraq, against Shiite militia forces noted; scenes shown.   (London: Richard Roth) Anti-American anger across the Muslim world prompted by the US assault on the holy city of Najaf featured; scenes shown of the Imam Ali mosque and of a demonstration in Iran. [Iraq expert Charles TRIPP&#134;- notes the significance of the mosque for the Shiia.] [Supreme Council of the Islamic Revolution in Iraq Ali al-BAYATI&#134;- says there will be problems all over the world {if the mosque is damaged.}]", "segment_duration": 110, "segment_type_id": 2, "segment_start_time": "63500.0", "legacy_segment_id": 762249, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "gMqZzrVLi1", "broadcast_date": "2004-08-13", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 762247, "segment_id": "5j5NRQuBi8", "segment_broadcast_id": "gMqZzrVLi1", "segment_title": "Olympic Games / Doping", "segment_description": "(Studio: Dan Rather) The opening ceremonies of the Olympic Games in Athens, Greece, noted. \n (Athens: Lee Cowan) A drug test scandal involving two athletes from Greece, Kostas Kenteris&#134;&#134; & Katerina Thanou&#134;&#134;, detailed.", "segment_duration": 80, "segment_type_id": 2, "segment_start_time": "63610.0", "legacy_segment_id": 762250, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "gMqZzrVLi1", "broadcast_date": "2004-08-13", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 762247, "segment_id": "1rjnuOVxXi", "segment_broadcast_id": "gMqZzrVLi1", "segment_title": "New Jersey / McGreevey Resignation", "segment_description": "(Studio: Dan Rather) Report introduced. \n (New York: Randall Pinkston) The fallout from the resignation of New Jersey Governor James McGreevey examined; details given of the scandal involving McGreevey\u2019s purported lover, Golan Cipel&#134;, and of criticism of McGreevey\u2019s political motivation in post-dating his resignation for November. [\u201cBergen Record\u201d political columnist Mike KELLY&#134;- comments on McGreevey\u2019s relationship with Cipel.] [New Jersey senator Joseph KYRILLOS&#134;- says people have a right to choose their leadership.]", "segment_duration": 120, "segment_type_id": 2, "segment_start_time": "63690.0", "legacy_segment_id": 762251, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "gMqZzrVLi1", "broadcast_date": "2004-08-13", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 762247, "segment_id": "h6HlyMuzlH", "segment_broadcast_id": "gMqZzrVLi1", "segment_title": "Upcoming Items; fallen hero Air Force Airman 1st Class Antoine Holt&#134<!-- spelling on screen --> profiled. (Studio: Dan Rather)", "segment_description": "null", "segment_duration": 50, "segment_type_id": 2, "segment_start_time": "63810.0", "legacy_segment_id": 762252, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "gMqZzrVLi1", "broadcast_date": "2004-08-13", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 762247, "segment_id": "uT3rOW94KR", "segment_broadcast_id": "gMqZzrVLi1", "segment_title": "(Commercial: Kia Sorento; Ace Hardware; Gas-X; Capital One; IcyHot Sleeve; shuteye.com; Kia Sorento.)", "segment_description": "null", "segment_duration": 150, "segment_type_id": 3, "segment_start_time": "63860.0", "legacy_segment_id": 762253, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "gMqZzrVLi1", "broadcast_date": "2004-08-13", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 762247, "segment_id": "LulQkCbp8u", "segment_broadcast_id": "gMqZzrVLi1", "segment_title": "Inside Story (Campaign 04 / Bush Campaign)", "segment_description": "(Studio: Dan Rather) The end of Senator John Kerry\u2019s cross-country campaign trip reported; scenes shown of a Kerry rally in Portland, Oregon, just miles from where President Bush also spoke to supporters.   (Las Vegas: Bill Plante) Measures to ensure that that there are no hecklers and only enthusiastic supporters at Bush\u2019s rallies featured; details given of pre-screening of attendees. [BUSH \u2013 addresses a crowd.]", "segment_duration": 140, "segment_type_id": 2, "segment_start_time": "64010.0", "legacy_segment_id": 762254, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "gMqZzrVLi1", "broadcast_date": "2004-08-13", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 762247, "segment_id": "exiefUpvDJ", "segment_broadcast_id": "gMqZzrVLi1", "segment_title": "Upcoming Items (Studio: Dan Rather)", "segment_description": "null", "segment_duration": 10, "segment_type_id": 2, "segment