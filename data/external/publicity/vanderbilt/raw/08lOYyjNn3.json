{"data": [{"broadcast_id": "08lOYyjNn3", "broadcast_date": "2004-08-30", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 763974, "segment_id": "qzn2AH8VxE", "segment_broadcast_id": "08lOYyjNn3", "segment_title": "Preview/Introduction Dan Rather (Republican National Convention in New York)", "segment_description": "null", "segment_duration": 50, "segment_type_id": 1, "segment_start_time": "63000.0", "legacy_segment_id": 763974, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Preview", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "08lOYyjNn3", "broadcast_date": "2004-08-30", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 763974, "segment_id": "GnK2wqFFc2", "segment_broadcast_id": "08lOYyjNn3", "segment_title": "Campaign 04 / Republican Convention / Giuliani Interview", "segment_description": "(New York: Dan Rather) The opening of the Republican National Convention in New York City, where President Bush was officially nominated, noted. \n (Convention floor: John Roberts) The Republicans\u2019 strategy to convey a combined message of leadership & moderation featured; scenes shown from the convention floor and of protestors in the streets; footage shown of Bush atop the wreckage of the World Trade Center after September 11; details given about Bush\u2019s contradictory statement on the war on terror {quoted}. [Senator John EDWARDS \u2013 says a strong leader should lead with ideas about how we win the war on terror.] [Republican National Committee chairman Ed GILLESPIE&#134;- notes the importance of discussing the meaning of September 11.] [Republican strategist Scott REED&#134;- says Bush has to bring the moderate, independent women back to the fold.] \n (New York: Dan Rather) Taped discussion held with former New York City Mayor Rudolph Giuliani about his campaigning for Bush despite their disagreements on certain issues. [GIULIANI \u2013 says the Republican Party is broader than the way it\u2019s described; explains his stance on several issues; comments on the debate over Senator John Kerry\u2019s war record; talks about the possibility of replacing Vice President Dick Cheney on the Republican ticket.]", "segment_duration": 330, "segment_type_id": 2, "segment_start_time": "63050.0", "legacy_segment_id": 763975, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "08lOYyjNn3", "broadcast_date": "2004-08-30", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 763974, "segment_id": "v77HfOnNrm", "segment_broadcast_id": "08lOYyjNn3", "segment_title": "Iraq / Unrest", "segment_description": "(New York: Dan Rather) Rebel cleric Muqtada al-Sadr\u2019s announcement that he will stop fighting & join the political process in Iraq; the halt in oil exportation due to sabotage of pipelines, and the plea of 2 kidnapped French journalists for their government to stop the ban on head scarves in schools reported.", "segment_duration": 30, "segment_type_id": 2, "segment_start_time": "63380.0", "legacy_segment_id": 763976, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "08lOYyjNn3", "broadcast_date": "2004-08-30", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 763974, "segment_id": "TQt02vwg8m", "segment_broadcast_id": "08lOYyjNn3", "segment_title": "Pentagon / Espionage Investigation", "segment_description": "(New York: Dan Rather) Report introduced.   (Washington: Jim Stewart) The FBI\u2019s investigation of Lawrence Franklin&#134;&#134;, a Pentagon analyst who works for undersecretary for policy Douglas Feith&#134;&#134; and is suspected of passing information about Iran to Israel, reviewed; details given about the search of the offices of lobby group AIPAC.", "segment_duration": 120, "segment_type_id": 2, "segment_start_time": "63410.0", "legacy_segment_id": 763977, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "08lOYyjNn3", "broadcast_date": "2004-08-30", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 763974, "segment_id": "BRwjn1Tp5E", "segment_broadcast_id": "08lOYyjNn3", "segment_title": "Weather Watch (Hurricane Season)", "segment_description": "(New York: Dan Rather) The impact of Tropical Storm Gaston noted; weather map shown.   (Atlanta: Mark Strassmann) This year\u2019s busy hurricane season featured; scenes shown from South & North Carolina during & after Gaston; satellite image of Hurricane Frances shown; details given about the impact of Hurricane Charley on Florida residents. [Storm victim Daniel THOMAS&#134;- reacts to Gaston.] [National Hurricane Center Max MAYFIELD&#134;- talks about preparing for Frances.] [Florida resident Julia KNOWLES&#135;- comments.]", "segment_duration": 110, "segment_type_id": 2, "segment_start_time": "63530.0", "legacy_segment_id": 763978, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "08lOYyjNn3", "broadcast_date": "2004-08-30", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 763974, "segment_id": "X08tQ2GEGY", "segment_broadcast_id": "08lOYyjNn3", "segment_title": "Upcoming Items; fallen hero Army Spc. Joshua Knowles&#134<!-- spelling on screen --> profiled. (New York: Dan Rather)", "segment_description": "null", "segment_duration": 50, "segment_type_id": 2, "segment_start_time": "63640.0", "legacy_segment_id": 763979, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "08lOYyjNn3", "broadcast_date": "2004-08-30", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 763974, "segment_id": "URdpfr4Sks", "segment_broadcast_id": "08lOYyjNn3", "segment_title": "(Commercial: Claritin; ThermaCare; Lamisil; Cheerios; Ace Hardware; Glucerna.)", "segment_description": "null", "segment_duration": 150, "segment_type_id": 3, "segment_start_time": "63690.0", "legacy_segment_id": 763980, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "08lOYyjNn3", "broadcast_date": "2004-08-30", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 763974, "segment_id": "fjxZkh3W6j", "segment_broadcast_id": "08lOYyjNn3", "segment_title": "Market Watch: Stocks, Consumer Spending", "segment_description": "(New York: Dan Rather) Stock Market Report; consumer spending figures cited.", "segment_duration": 20, "segment_type_id": 2, "segment_start_time": "63840.0", "legacy_segment_id": 763981, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "08lOYyjNn3", "broadcast_date": "2004-08-30", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 763974, "segment_id": "RTFVdjQoN1", "segment_broadcast_id": "08lOYyjNn3", "segment_title": "Inside Story (The Bush Promise: Tax Cuts) Part I", "segment_description": "(New York: Dan Rather) Special convention-week look at what has become of the promises made by President Bush during his 2000 presidential campaign introduced. \n (New York: Mika Brzezinski) Bush\u2019s tax cut program examined. [At the Republican National Convention in August 2000, BUSH \u2013 vows to reduce tax rates.] [Kennedy School of Government Roger PORTER&#134;- says he did achieve the goals he established.] [NYU Stern School of Business Lawrence WHITE&#134;- notes the growing deficit and problems with Social Security and Medicare.] [Saturday, BUSH \u2013 says the economy is strong & getting stronger.] [August 27, Senator John KERRY \u2013 comments on the disparity between the tax burden for the middle class & the wealthy.]", "segment_duration": 160, "segment_type_id": 2, "segment_start_time": "63860.0", "legacy_segment_id": 763982, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "08lOYyjNn3", "broadcast_date": "2004-08-30", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 763974, "segment_id": "5Rf6625n4U", "segment_broadcast_id": "08lOYyjNn3", "segment_title": "Upcoming Items (New York: Dan Rather)", "segment_description": "null", "segment_duration": 20, "segment_type_id": 2, "segment_start_time": "64020.0", "legacy_segment_id": 763983, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "08lOYyjNn3", "broadcast_date": "2004-08-30", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 763974, "segment_id": "EcwDkNZUME", "segment_broadcast_id": "08lOYyjNn3", "segment_title": "(Commercial: Oust; Cialis; Bayer; L\u2019Oreal; Metamucil; Minwax; Olshan.)", "segment_description": "null", "segment_duration": 150, "segment_type_id": 3, "segment_start_time": "64040.0", "legacy_segment_id": 763984, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"