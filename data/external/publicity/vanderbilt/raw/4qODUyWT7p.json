{"data": [{"broadcast_id": "4qODUyWT7p", "broadcast_date": "2004-08-28", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 763595, "segment_id": "hjmkEB4d0v", "segment_broadcast_id": "4qODUyWT7p", "segment_title": "Preview/Introduction Kate Snow (New York)", "segment_description": "null", "segment_duration": 50, "segment_type_id": 1, "segment_start_time": "63000.0", "legacy_segment_id": 763595, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "Preview", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "4qODUyWT7p", "broadcast_date": "2004-08-28", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 763595, "segment_id": "jdmOH654Al", "segment_broadcast_id": "4qODUyWT7p", "segment_title": "US-Israeli Relations / Espionage / Pentagon Spy", "segment_description": "(Studio: Kate Snow)  Report introduced. \n (Pentagon: Martha Raddatz)  FBI evidence of an Israeli spy working at a high level in the Pentagon examined; details given of the possible charges against the civilian who worked for the DIA & then the Pentagon & about the year-long investigation that found the suspect passed public papers on Iran to individuals at the American Israel Public Affairs Committee.  [Former counterterrorism official Vince CANNISTRARO&#134;- says he had indirect influence.] \n (Studio: Kate Snow)  Report introduced. \n (Washington: Dean Reynolds)  The complex friendship between Israel & the US reviewed; details given of issues in conflict between the two nations: Israeli settlements, Israeli's foreign sales of weapons information, the Jonathan Pollard spy case in the 1980s & the Israeli attack on the USS Liberty.  [\"The Missing Piece\" author Dennis ROSS&#134;- says all issues cannot be agreed on.]  [ABC News military analyst Tony CORDESMAN&#134;- talks about the significance of Iran for Israel.]", "segment_duration": 260, "segment_type_id": 2, "segment_start_time": "63050.0", "legacy_segment_id": 763596, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "4qODUyWT7p", "broadcast_date": "2004-08-28", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 763595, "segment_id": "dIkE3l20wg", "segment_broadcast_id": "4qODUyWT7p", "segment_title": "Campaign 2004 / Bush vs. Kerry / Ohio", "segment_description": "(Studio: Kate Snow)  Report introduced. \n (Perrysburg, Ohio: Jonathan Karl)  President Bush's campaign swing through battleground states before the Republican National Convention in New York City featured; scenes shown from Ohio; statistics cited on state job losses & unemployment.  [BUSH&nbsp- promises to carry Ohio & to continue economic growth.] \n (Studio: Kate Snow)  Senator John Kerry's rally in Tacoma, Washington, where retired Gen. Wesley Clark went after Bush reported; \"Time\" magazine poll figures of the standings of Bush vs. Kerry outlined on screen.", "segment_duration": 150, "segment_type_id": 2, "segment_start_time": "63310.0", "legacy_segment_id": 763597, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "4qODUyWT7p", "broadcast_date": "2004-08-28", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 763595, "segment_id": "Pm4f2FVpOX", "segment_broadcast_id": "4qODUyWT7p", "segment_title": "New York, New York / Convention Protests / Bomb Plot", "segment_description": "(Studio: Kate Snow)  Report introduced.   (New York: Bob Jamieson)  Protests in New York City just before the Republican National Convention featured; scenes shown of abortion rights protesters crossing the Brooklyn Bridge into Manhattan & of last night's anti-Bush bike protest that led to many arrests; details given about planned demonstrations.  [Two PROTESTERS&nbsp- speak out.]  [Presidential historian Michael BESCHLOSS&#134;- says diverse groups have less impact than one big group.]  Today's arrest of two men {Pakistan national Shahawar Siraj&#134;&#134; & American James El Shafay&#134;&#134;} charged with plotting to bomb a subway station reviewed; courtroom sketches by Christine Cornell shown.  [NYC police commissioner Ray KELLY&nbsp- comments on the arrested men.]", "segment_duration": 110, "segment_type_id": 2, "segment_start_time": "63460.0", "legacy_segment_id": 763598, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "4qODUyWT7p", "broadcast_date": "2004-08-28", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 763595, "segment_id": "TYRgJ7R3vE", "segment_broadcast_id": "4qODUyWT7p", "segment_title": "Upcoming Items (Studio: Kate Snow)", "segment_description": "null", "segment_duration": 30, "segment_type_id": 2, "segment_start_time": "635