{"data": [{"broadcast_id": "mrf6cAKfM7", "broadcast_date": "2004-08-04", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 761481, "segment_id": "qlIFXkHt4S", "segment_broadcast_id": "mrf6cAKfM7", "segment_title": "Preview/Introduction Elizabeth Vargas (New York)", "segment_description": "null", "segment_duration": 50, "segment_type_id": 1, "segment_start_time": "63000.0", "legacy_segment_id": 761481, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "Preview", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "mrf6cAKfM7", "broadcast_date": "2004-08-04", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 761481, "segment_id": "oh5jQENrkq", "segment_broadcast_id": "mrf6cAKfM7", "segment_title": "Terrorism / Al Qaeda Threat", "segment_description": "(Studio: Elizabeth Vargas)  Report introduced. \n (Washington: Pierre Thomas)  ABCNews exclusive report on the latest terrorism alert & on Mohammed Khan, the man arrested in Pakistan whose computer files offer clues on the Al Qaeda casing of the financial centers, featured; details given of the detailed commentary on the surveillance of the buildings.  [ABC consultant Jack CLOONAN&#134;- says these buildings were real targets.]  [Former FBI analyst Matthew LEVITT&#134;- says building employees will be investigated.]", "segment_duration": 130, "segment_type_id": 2, "segment_start_time": "63050.0", "legacy_segment_id": 761482, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "mrf6cAKfM7", "broadcast_date": "2004-08-04", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 761481, "segment_id": "EywRZeeIbG", "segment_broadcast_id": "mrf6cAKfM7", "segment_title": "Campaign 2004 / Bush vs. Kerry / Davenport, Iowa / Campaigning", "segment_description": "(Studio: Elizabeth Vargas)  Report introduced. \n (Davenport: Dan Harris)  The \"duel in Davenport\" when both presidential candidate were in the Iowa city at the same time featured; campaign scenes & political ads shown.  [President BUSH, Senator John KERRY&nbsp- campaign on \"turning the corner.\"]  [At the zoo, Bettendorf, Iowa, Betsy JUSTIS&#134;; Davenport resident Paul REGGINELLO&#134;, Davenport Mayor Charlie BROOKE&#134;- state their political views.] \n (Studio: Elizabeth Vargas)  Report introduced. \n (Washington: Jake Tapper)  The grassroots campaign aimed at specific groups {veterans, NASCAR, coal miners, Amish, anglers, surfers etc.} by both candidates examined; details given of the announcement by a collection of rock 'n roll royalty of a concert tour for Kerry; map shown.  [With Ted Koppel, singer Bruce SPRINGSTEEN&nbsp- says the aim is to mobilize voters.]  [Syracuse University professor Robert THOMPSON&#134;- says both are searching out the swing vote.]  [\"New York Post\" Robert GEORGE&nbsp- comments.] \n (Studio: Elizabeth Vargas)  The full interview with Springsteen on \"Nightline\" noted.", "segment_duration": 300, "segment_type_id": 2, "segment_start_time": "63180.0", "legacy_segment_id": 761483, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "mrf6cAKfM7", "broadcast_date": "2004-08-04", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 761481, "segment_id": "wbMxcbVdGS", "segment_broadcast_id": "mrf6cAKfM7", "segment_title": "Iraq: Tours of Duty (Tikrit)", "segment_description": "(Studio: Elizabeth Vargas)  An occasional series on Iraq introduced.   (Tikrit: Martha Raddatz)  The enemies on the road in Iraq travelled by the 1st Infantry Div. featured; scenes shown from the road to Tikrit & from a memorial service for two soldiers killed by bombs.  [Wounded soldier Spc. Andre GATSON&#134;- comments on the roadside bombs.]  [Division commander Maj. Gen. John BATISTE&#134;- talks about the bombs.]  [Sgt. Carrie ALLEN&#134;- leads service.]", "segment_duration": 140, "segment_type_id": 2, "segment_start_time": "63480.0", "legacy_segment_id": 761484, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "mrf6cAKfM7", "broadcast_date": "2004-08-04", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 761481, "segment_id": "V33BO9XgMd", "segment_broadcast_id": "mrf6cAKfM7", "segment_title": "Upcoming Items (Studio: Elizabeth Vargas)", "segment_description": "null", "segment_duration": 30, "segment_type_id": 2, "segment_start_time": "63620.0", "legacy_segment_id": 761485, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "m