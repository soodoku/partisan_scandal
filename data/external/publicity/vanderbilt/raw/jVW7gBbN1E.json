{"data": [{"broadcast_id": "jVW7gBbN1E", "broadcast_date": "2004-08-01", "broadcast_start_time": "61200.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 761334, "segment_id": "RjhGKl5ipr", "segment_broadcast_id": "jVW7gBbN1E", "segment_title": "Preview/Introduction John Roberts (New York)", "segment_description": "null", "segment_duration": 40, "segment_type_id": 1, "segment_start_time": "61200.0", "legacy_segment_id": 761334, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Preview", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "jVW7gBbN1E", "broadcast_date": "2004-08-01", "broadcast_start_time": "61200.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 761334, "segment_id": "pUVBlEl6iI", "segment_broadcast_id": "jVW7gBbN1E", "segment_title": "Terrorism / Al Qaeda Threat", "segment_description": "(Studio: John Roberts)  Report introduced. \n (Washington: Bob Orr)  Warning from the Department of Homeland Security that Al Qaeda is targeting US financial institutions examined; details given about the five sites in New York, New Jersey & Washington, DC, the source of the intelligence information of the Al Qaeda surveillance of the five locations & of the dangers from large truck bombs.  [Secretary of Homeland Security Tom RIDGE&nbsp- comments on the quality of the intelligence reports.] \n (Studio: John Roberts)  Report introduced. \n (New York: Randall Pinkston)  Stepped-up security in New York City due to the coming Republican National Convention as well as the threat to financial institutions examined.  [New Jersey Governor James McGREEVEY&nbsp- comments on security inspections.]  [New York City Mayor Michael BLOOMBERG&#134;- says we will protect the city.]  [Kroll, Inc., security expert Bill VORLICEK&#134;- points out the bad guys only have to be lucky once.]  [Anti-terrorism expert Robert STRANG&#134;- reacts to the threat.]", "segment_duration": 270, "segment_type_id": 2, "segment_start_time": "61240.0", "legacy_segment_id": 761335, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "jVW7gBbN1E", "broadcast_date": "2004-08-01", "broadcast_start_time": "61200.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 761334, "segment_id": "FNDYwYw5Sd", "segment_broadcast_id": "jVW7gBbN1E", "segment_title": "September 11 / Commission Report", "segment_description": "(Studio: John Roberts)  Report introduced. \n (White House: Joie Chen)  A warning against a rush to action in response to the recommendations from the commission that investigated September 11 examined; details given about the controversial plan for a new intelligence czar.  [Senator Joseph LIEBERMAN&nbsp- calls for adopting commission suggestions.]  [Lexington Inst. Daniel GOURE&#134;- worries about the wrong reforms making us more vulnerable.]", "segment_duration": 90, "segment_type_id": 2, "segment_start_time": "61510.0", "legacy_segment_id": 761336, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "jVW7gBbN1E", "broadcast_date": "2004-08-01", "broadcast_start_time": "61200.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 761334, "segment_id": "Orhz4Dcui1", "segment_broadcast_id": "jVW7gBbN1E", "segment_title": "Iraq / Attacks / Christians", "segment_description": "(Studio: John Roberts)  Report introduced.   (Baghdad: Kimberly Dozier)  The insurgent attacks against Christian minorities in Iraq featured; scenes shown from Baghdad of the series of coordinated car bombings against Sunday services; details given of attacks on Christian-run liquor stories by Muslim vigilantes.  [1st Cavalry Div. Capt. Neal MAYO&#134;- comments on the attacks.]  [Anglican Church Rev. Andrew WHITE&#134;- says Christians are being told you are not welcome here.]", "segment_duration": 100, "segment_type_id": 2, "segment_start_time": "61600.0", "legacy_segment_id": 761337, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "jVW7gBbN1E", "broadcast_date": "2004-08-01", "broadcast_start_time": "61200.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 761334, "segment_id": "ApDWZYs30s", "segment_broadcast_id": "jVW7gBbN1E", "segment_title": "Campaign 2004 / Bush vs. Kerry / Ohio", "segment_description": "(Studio: John Roberts)  Map shown of the Democratic bus tour through Ohio into Michigan.   (Bowling Green, Ohio: Jim Axelrod)  The battle for votes in Ohio featured; scenes shown of Senator John Kerry campaigning; details given about lost jobs in the state, including at the Timken Co. & about the weakness of the Democratic Party in the state.  [Senator John EDWARDS, \"Dayton Daily News\" William HERSHEY&#134;- comment on the campaign in Ohio.]  [President BUSH, KERRY&nbsp- campaign.]", "segment_duration": 140, "segment_type_id": 2, "segment_start_time": "61700.0", "legacy_segment_id": 761338, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "jVW7gBbN1E", "broadcast_date": "2004-08-01", "broadcast_start_time": "61200.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 761334, "segment_id": "mi5wX2ZCFS", "segment_broadcast_id": "jVW7gBbN1E", "segment_title": "Upcoming Items (Studio: John Roberts)", "segment_description": "null", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "61840.0", "legacy_segment_id": 761339, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "jVW7gBbN1E", "broadcast_date": "2004-08-01", "broadcast_start_time": "61200.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 761334, "segment_id": "wVHG2ON8Yz", "segment_broadcast_id": "jVW7gBbN1E", "segment_title": "(Commercial: Singulair; Thompson's Water Seal; Benefiber; Sea-Bond; Bush's Baked Beans; Best Western; Zantac.)", "segment_description": "null", "segment_duration": 180, "segment_type_id": 3, "segment_start_time": "61850.0", "legacy_segment_id": 761340, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "jVW7gBbN1E", "broadcast_date": "2004-08-01", "broadcast_start_time": "61200.0", "ne