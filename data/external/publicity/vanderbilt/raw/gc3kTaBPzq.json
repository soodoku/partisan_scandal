{"data": [{"broadcast_id": "gc3kTaBPzq", "broadcast_date": "2004-07-24", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 760845, "segment_id": "zc2IHzG8ef", "segment_broadcast_id": "gc3kTaBPzq", "segment_title": "Preview/Introduction Thalia Assuras (New York)", "segment_description": "null", "segment_duration": 30, "segment_type_id": 1, "segment_start_time": "63000.0", "legacy_segment_id": 760845, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Preview", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "gc3kTaBPzq", "broadcast_date": "2004-07-24", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 760845, "segment_id": "9H3xnE0JLh", "segment_broadcast_id": "gc3kTaBPzq", "segment_title": "Campaign 2004 / Bush vs. Kerry / Democrats / Edwards Interview", "segment_description": "(Studio: Thalia Assuras)  Report introduced. \n (Boston: Thalia Assuras)  Findings of a new CBS News/\"New York Times\" poll that indicates a polarized electorate examined; statistics cited on Republicans, the protectors vs. Democrats, the dividers, issues.  [Political analyst Curtis GANS&#134;- predicts more people are interested & will vote.]  [Voter Dana COGNETTA&#134;- offers her views.] \n (Studio: Thalia Assuras)  Report introduced. \n (Sioux City: Byron Pitts)  The softening of Senator John Kerry's campaign rhetoric as he heads into the convention featured; scenes shown from the campaign trail.  [KERRY&nbsp- says \"I love Iowa.\"]  [Wife Teresa Heinz KERRY&nbsp- campaigns.]  [In Milwaukee, wife Elizabeth EDWARDS&nbsp- campaigns on a divided country.]  [Iowa Kerry supporter Pat HAMMERSTROM&#134;- comments on issues.] \n (Studio: Thalia Assuras)  Report introduced. \n (Milwaukee: Dan Rather)  Taped interview held with vice presidential candidate Senator John Edwards.  [EDWARDS&nbsp- says the people want to hear about optimism & hope; says the entire government failed the American people re: September 11; states why we can do better in fighting terrorism.]", "segment_duration": 390, "segment_type_id": 2, "segment_start_time": "63030.0", "legacy_segment_id": 760846, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "gc3kTaBPzq", "broadcast_date": "2004-07-24", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 760845, "segment_id": "lvedORsj7d", "segment_broadcast_id": "gc3kTaBPzq", "segment_title": "September 11 / Commission Report / The Response", "segment_description": "(Studio: Thalia Assuras)  Report introduced.   (Washington: Joie Chen)  The plans of President Bush & Congress for a quick response to the report from the commission that investigated September 11 examined; details given of the timetable to put recommendations into place.  [Victim's daughter Carie LEMACK&#134;- opts for safety.]  [Senator Susan COLLINS&nbsp- says it won't be a sleepy August here!]  [In radio address, BUSH&nbsp- promises to examine the commission's ideas to prevent another attack.]", "segment_duration": 120, "segment_type_id": 2, "segment_start_time": "63420.0", "legacy_segment_id": 760847, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "gc3kTaBPzq", "broadcast_date": "2004-07-24", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 760845, "segment_id": "boff5m2lqy", "segment_broadcast_id": "gc3kTaBPzq", "segment_title": "Iraq / Attacks", "segment_description": "(Studio: Thalia Assuras)  The threat from Al Qaeda groups of an attack in Australia & Italy if those countries do not pull troops out of Iraq noted.   (Baghdad: Kimberly Dozier)  The call from Iraqi officials for Egypt not to give into terrorists after the kidnapping of Egyptian diplomat Mohamed Qutb&#134;&#134; examined; video shown of other foreign hostages.  [Iraqi interim Prime Minister Iyad ALLAWI&nbsp- calls for closing ranks against terrorism.]  [Egyptian foreign minister Ahmed Aboul GHEIT&#134;- comments on the sensitive situation.]  Statement from Shiite cleric Muqtada al-Sadr about the kidnappings noted.", "segment_duration": 120, "segment_type_id": 2, "segment_start_time": "63540.0", "legacy_segment_id": 760848, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "gc3kTaBPzq", "broadcast_date": "2004-07-24", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 760845, "segment_id": "5DMVsl2lk0", "segment_broadcast_id": "gc3kTaBPzq", "segment_title": "Upcoming Items (Studio: Thalia Assuras)", "segment_description": "null", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "63660.0", "legacy_segment_id": 760849, "network_name": "CBS", "broadcast_type_name": "Evening New