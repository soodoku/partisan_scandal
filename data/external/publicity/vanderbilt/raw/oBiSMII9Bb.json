listed. [BLAGOJEVICH \u2013 says we cannot ask the people to spend more money than they have to afford the medicine they need.] [FDA associate commissioner William HUBBARD&#134;&#134;- states the FDA can\u2019t bless the importation of unapproved, potentially unsafe foreign drugs.] [Drug import advocate Peter WYCKOFF&#134;&#134;- comments on the FDA upholding the profits of the pharmaceutical industry.] [Senior Beryl CLEMENS&#135;- comments on the cost of her medications.]", "segment_duration": 140, "segment_type_id": 2, "segment_start_time": "63700.0", "legacy_segment_id": 762489, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "oBiSMII9Bb", "broadcast_date": "2004-08-17", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1730, "broadcast_description": null, "legacy_broadcast_id": 762480, "segment_id": "9QW5bDZrSA", "segment_broadcast_id": "oBiSMII9Bb", "segment_title": "Upcoming Items (Athens: Tom Brokaw)", "segment_description": "null", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "63840.0", "legacy_segment_id": 762490, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "oBiSMII9Bb", "broadcast_date": "2004-08-17", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1730, "broadcast_description": null, "legacy_broadcast_id": 762480, "segment_id": "MbV5VgaZCj", "segment_broadcast_id": "oBiSMII9Bb", "segment_title": "(Commercial: Transitions; Thompson\u2019s Water Seal; Lanacane; Capital One; Pantene; Phillips\u2019; Wal-Mart.)", "segment_description": "null", "segment_duration": 150, "segment_type_id": 3, "segment_start_time": "63850.0", "legacy_segment_id": 762491, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "oBiSMII9Bb", "broadcast_date": "2004-08-17", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1730, "broadcast_description": null, "legacy_broadcast_id": 762480, "segment_id": "SB3FqJUKU5", "segment_broadcast_id": "oBiSMII9Bb", "segment_title": "Olympic Games / Basketball / Fencing", "segment_description": "(Athens: Tom Brokaw) The results of the men\u2019s basketball game between the US & Greece at the Olympic Games in Athens, Greece, noted.   (Athens: Brian Williams) Lowered expectations for the US men\u2019s basketball team featured; photos & scenes shown of the game between the US & Greece; details given of the differences between American & European basketball. [\u201cSports Illustrated\u201d senior writer Jack McCALLUM&#134;&#134;- comments on the diminished image of the men\u2019s basketball team since 1992\u2019s \u201cdream team.\u201d] [USA basketball Stephon MARBURY&#134;- says we\u2019re just a basketball team trying to win a gold medal.] The continuing poor attendance at the games noted; photos shown of empty seats at the US vs. Australia women\u2019s soccer game.   (Athens: Tom Brokaw) Report introduced.   (Atlanta: Roger O\u2019Neil) Sisters Sada&#134;&#134; & Emily Jacobson&#134;, who are competing for the US in fencing, profiled; scenes shown of the two sparring with sabers and training in Atlanta; details given of the history of the sport. [JACOBSONS \u2013 talk about competing.] [Parents Tina & David JACOBSON&#134;&#134;- support their daughters.]   (Athens: Tom Brokaw) Today\u2019s results reviewed.", "segment_duration": 370, "segment_type_id": 2, "segment_start_time": "64000.0", "legacy_segment_id": 762492, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "oBiSMII9Bb", "broadcast_date": "2004-08-17", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1730, "broadcast_description": null, "legacy_broadcast_id": 762480, "segment_id": "S277gRUGWh", "segment_broadcast_id": "oBiSMII9Bb", "segment_title": "(Commercial: L\u2019Oreal; Gas-X; Sonicare; Oust; Viagra; Swiffer; Fruit Harvest; Channel 4 News.)", "segment_description": "null", "segment_duration": 180, "segment_type_id": 3, "segment_start_time": "64370.0", "legacy_segment_id": 762494, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "oBiSMII9Bb", "broadcast_date": "2004-08-17", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1730, "broadcast_description": null, "legacy_broadcast_id": 762480, "segment_id": "SrXhmGvCna", "segment_broadcast_id": "oBiSMII9Bb", "segment_title": "Upcoming Items (Athens: Tom Brokaw)", "segment_description": "null", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "64370.0", "legacy_segment_id": 762493, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null