t_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "oBiSMII9Bb", "broadcast_date": "2004-08-17", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1730, "broadcast_description": null, "legacy_broadcast_id": 762480, "segment_id": "vEvUh4JQti", "segment_broadcast_id": "oBiSMII9Bb", "segment_title": "September 11 / Commission Report / Recommendations", "segment_description": "(Athens: Tom Brokaw) Report introduced. \n (Pentagon: Jim Miklaszewski) The determination of the families of victims of the September 11 attacks to see that the 9/11 Commission\u2019s recommendations are implemented despite cautions against moving too quickly examined; details given of the debate over President Bush\u2019s approval of the creation of a national intelligence director. [9/11 widow Kristen BREITWEISER\u2020- says people are being killed and we have an intel community failing to do its job.] [Secretary of Defense Donald RUMSFELD \u2013 says if  we move unwisely and get it wrong, the penalty would be great.] [Acting CIA director John McLAUGHLIN\u2020\u2020- warns against more layers of bureaucracy.]", "segment_duration": 130, "segment_type_id": 2, "segment_start_time": "63190.0", "legacy_segment_id": 762482, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "oBiSMII9Bb", "broadcast_date": "2004-08-17", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1730, "broadcast_description": null, "legacy_broadcast_id": 762480, "segment_id": "HQTgZAQGD4", "segment_broadcast_id": "oBiSMII9Bb", "segment_title": "Iraq Watch", "segment_description": "(Athens: Tom Brokaw) The refusal of maverick Shiite cleric Muqtada al-Sadr to meet with an Iraqi government delegation in Najaf, Iraq, to discuss ending his rebellion; continued fighting between al-Sadr\u2019s followers & US forces near the shrine in Najaf; a deadly mortar attack in Baghdad, and the Army\u2019s withholding of payment to Halliburton in a billing dispute reported; scenes shown from Najaf & Baghdad.", "segment_duration": 60, "segment_type_id": 2, "segment_start_time": "63320.0", "legacy_segment_id": 762483, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "oBiSMII9Bb", "broadcast_date": "2004-08-17", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1730, "broadcast_description": null, "legacy_broadcast_id": 762480, "segment_id": "zWp3hJvQqD", "segment_broadcast_id": "oBiSMII9Bb", "segment_title": "Hurricane Charley / Florida / Aftermath", "segment_description": "(Athens: Tom Brokaw) Report introduced.   (Punta Gorda, Florida: Martin Savidge) The hardships for survivors of Hurricane Charley in Florida featured; scenes shown of cleanup efforts. [Resident Tarrah NUNES\u2020- comments on radio station WIKX\u2019s broadcasting of relief information.] [WOMAN \u2013 comments.] [Florida attorney general Charlie CRIST\u2020- criticizes price-gouging charges against hotels.]", "segment_duration": 130, "segment_type_id": 2, "segment_start_time": "63380.0", "legacy_segment_id": 762484, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "locatio