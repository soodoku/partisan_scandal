{"data": [{"broadcast_id": "NYV2HfGxPn", "broadcast_date": "2004-09-12", "broadcast_start_time": "0.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1710, "broadcast_description": null, "legacy_broadcast_id": 765600, "segment_id": "PMHDb6Vaya", "segment_broadcast_id": "NYV2HfGxPn", "segment_title": "Preview/Introduction Terry Moran (New York)", "segment_description": "Note: Time numerals represent seconds into broadcast, not clock time, since the telecast originated in West Virginia", "segment_duration": 60, "segment_type_id": 1, "segment_start_time": "0.0", "legacy_segment_id": 765600, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "Preview", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "NYV2HfGxPn", "broadcast_date": "2004-09-12", "broadcast_start_time": "0.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1710, "broadcast_description": null, "legacy_broadcast_id": 765600, "segment_id": "wzWaoaLLFJ", "segment_broadcast_id": "NYV2HfGxPn", "segment_title": "Hurricane Ivan / Caribbean / Florida", "segment_description": "(Studio: Terry Moran)  The course of Hurricane Ivan in the Caribbean noted; weather maps shown. \n (Havana: John Berman)  The impact of Ivan on Cuba previewed; scenes shown from Havana of people evacuating & preparing in this totalitarian state for the storm; details given about the threat to the tobacco crop. \n (Studio: Terry Moran)  Report introduced. \n (Key West: Bob Woodruff)  The evacuation of Key West, Florida, as the season's third hurricane nears reported; scenes shown of a boarded-up hotel. \n (Lake Wales, Florida: David Muir)  The problem of homeowners' insurance in Florida examined; details given  about the state's catastrophic fund to insure the insurers after Hurricane Andrew.  [Lake Wales homeowner Willie ROBERSON&nbsp- comments.]  [Florida Department of Financial Services CEO Tom GALLAGHER&#134;- recalls the insurance losses from Hurricane Andrew.]  [Melbourne business owner Mona WEBB&#134;- reacts to losing her shop.] \n (Key West: Bob Woodruff)  Florida's hurricane-resistant housing featured; scenes shown of the devastation in 1992 from Andrew & of the homes.  [Sally O'BOYLE&nbsp- shows off her cement house.]  [Deltec Homes David IDE&#134;, Port Charlotte round house owner Roger McGILL&nbsp- talk about round houses.]  President Bush's request for emergency relief aid for Florida noted.", "segment_duration": 410, "segment_type_id": 2, "segment_start_time": "60.0", "legacy_segment_id": 765601, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "NYV2HfGxPn", "broadcast_date": "2004-09-12", "broadcast_start_time": "0.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1710, "broadcast_description": null, "legacy_broadcast_id": 765600, "segment_id": "WS6xiarkDP", "segment_broadcast_id": "NYV2HfGxPn", "segment_title": "Upcoming Items (Studio: Terry Moran)", "segment_description": "null", "segment_duration": 30, "segment_type_id": 2, "segment_start_time": "470.0", "legacy_segment_id": 765602, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "NYV2HfGxPn", "broadcast_date": "2004-09-12", "broadcast_start_time": "0.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1710, "broadcast_description": null, "legacy_broad