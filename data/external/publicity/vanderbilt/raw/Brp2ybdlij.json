ame": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "Brp2ybdlij", "broadcast_date": "2004-07-30", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 761098, "segment_id": "HmR7dEIaLM", "segment_broadcast_id": "Brp2ybdlij", "segment_title": "Japan / Princess Masako", "segment_description": "(Studio: Dan Rather) Report introduced. \n (Tokyo: Barry Petersen) The pressure on Japan\u2019s Crown Princess Masako to produce a male heir featured; details given of the marriage traditions inhibiting Japanese women. [Friend Yukie KUDO&#134;- comments on Masako\u2019s seclusion and depression over the criticism.] [Japan expert George FIELDS&#134;- notes young, career women feel Masako should be allowed to act as a person.] \n (Studio: Dan Rather) The election of the first female speaker to the upper house of the Japanese parliament noted.", "segment_duration": 140, "segment_type_id": 2, "segment_start_time": "64520.0", "legacy_segment_id": 761113, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "Brp2ybdlij", "broadcast_date": "2004-07-30", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 761098, "segment_id": "aN5Dce7xVF", "segment_broadcast_id": "Brp2ybdlij", "segment_title": "Good Night", "segment_description": "null", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "64660.0", "legacy_segment_id": 761114, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}]}