{"data": [{"broadcast_id": "PFqzIK2mK7", "broadcast_date": "2008-10-27", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1730, "broadcast_description": null, "legacy_broadcast_id": 909707, "segment_id": "ZKEt7QJLIE", "segment_broadcast_id": "PFqzIK2mK7", "segment_title": "Preview/Introduction Katie Couric (New York)", "segment_description": null, "segment_duration": 60, "segment_type_id": 1, "segment_start_time": "63000.0", "legacy_segment_id": 909707, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Preview", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "PFqzIK2mK7", "broadcast_date": "2008-10-27", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1730, "broadcast_description": null, "legacy_broadcast_id": 909707, "segment_id": "ylBCpnpkXy", "segment_broadcast_id": "PFqzIK2mK7", "segment_title": "Stevens Trial", "segment_description": "(Studio: Katie Couric)  Report introduced.  \n\n(Washington: Nancy Cordes)  The conviction of Republican Alaska Senator Ted Stevens on seven counts of felony corruption reviewed; details given about the prosecution's case about undisclosed gifts and home renovations by Veco oil with photos of the Stevens home shown.  [Acting assistant attorney general Matt FRIEDRICH\u2020- says Stevens hid freebies from an Alaska corporation.]  Excerpt of a phone conversation between Stevens and Veco's Bill Allen played.  Statement from Governor Sarah Palin about Stevens and corruption in her state quoted. ", "segment_duration": 160, "segment_type_id": 2, "segment_start_time": "63060.0", "legacy_segment_id": 909708, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "PFqzIK2mK7", "broadcast_date": "2008-10-27", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1730, "broadcast_description": null, "legacy_broadcast_id": 909707, "segment_id": "JXrR3TKOZg", "segment_broadcast_id": "PFqzIK2mK7", "segment_title": "Campaign 2008 / Obama vs. McCain / Pennsylvania and Ohio", "segment_description": "(Studio: Katie Couric)  The focus of presidential candidates Senators John McCain and Barack Obama on the battleground states of Ohio & Pennsylvania noted.  \n\n(Pottsville, Pennsylvania: Chip Reid)  McCain's campaign on the economy and Obama's policies with an increasing negative tone featured; McCain attack robo-call played.  [McCAIN\u00a0- says the difference is Obama thinks taxes have been too low; states it is amazing we are still learning more about Obama.]  Obama's response to a redistribution quote taken from 2001 noted.  \n\n(Studio: Katie Couric)  Report introduced.  \n\n(Pittsburgh: Dean Reynolds)  Obama's return to an early campaign message in Ohio and Pennsylvania featured; Obama TV ad shown.  [In Canton, Ohio, OBAMA\u00a0- speaks about change; states the country cannot take four more years of failed policies; says we cannot afford to let up in this last week.] ", "segment_duration": 260, "segment_type_id": 2, "segment_start_time": "63220.0", "legacy_segment_id": 909709, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "PFqzIK2mK7", "broadcast_date": "2008-10-27", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_dura