{"data": [{"broadcast_id": "2pXbUTWF9u", "broadcast_date": "2004-07-28", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 760986, "segment_id": "ZOiORubrI2", "segment_broadcast_id": "2pXbUTWF9u", "segment_title": "Preview/Introduction Dan Rather (Democratic National Convention in Boston)", "segment_description": "null", "segment_duration": 50, "segment_type_id": 1, "segment_start_time": "63000.0", "legacy_segment_id": 760986, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Preview", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "2pXbUTWF9u", "broadcast_date": "2004-07-28", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 760986, "segment_id": "Iqn27Q4Trr", "segment_broadcast_id": "2pXbUTWF9u", "segment_title": "Campaign 04 / Democratic Convention / Kerry", "segment_description": "(Boston: Dan Rather) Senator John Kerry\u2019s arrival in Boston, where he will accept the nomination for president at the Democratic National Convention tomorrow night, shown.", "segment_duration": 30, "segment_type_id": 2, "segment_start_time": "63050.0", "legacy_segment_id": 760987, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "2pXbUTWF9u", "broadcast_date": "2004-07-28", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 760986, "segment_id": "cWKUT50dxb", "segment_broadcast_id": "2pXbUTWF9u", "segment_title": "Iraq / Attacks / Baquba Bombing", "segment_description": "(Boston: Dan Rather) The murder of 2 Pakistani hostages and attacks by militants in Iraq noted. \n (Baghdad: Kimberly Dozier) The day\u2019s violence in Iraq, including a suicide bombing at a market in Baquba that killed dozens of Iraqis, reviewed; details given of clashes in Ramadi, Fallujah & Tikrit, a rocket attack in Baghdad and a US-Iraqi raid on insurgents in the south; scenes shown. \n (Boston: Dan Rather) Secretary of State Colin Powell\u2019s trip to Saudi Arabia, which is re-establishing diplomatic relations with Iraq, to seek help in assembling a military force from Muslim countries to help secure Iraq noted.", "segment_duration": 150, "segment_type_id": 2, "segment_start_time": "63080.0", "legacy_segment_id": 760988, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "2pXbUTWF9u", "broadcast_date": "2004-07-28", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 760986, "segment_id": "CUrjXcy1k9", "segment_broadcast_id": "2pXbUTWF9u", "segment_title": "Campaign 04 / Democratic Convention / National Security", "segment_description": "(Boston: Dan Rather) Report introduced. \n (Boston: Byron Pitts) Senator John Kerry\u2019s long road to Boston, where he will be formally nominated for president at the Democratic National Convention, featured; scenes shown of Kerry arriving in Boston by boat, flanked by his former Vietnam crewmates, including Jim Rassman&#134;&#134;; details given of the intense battle between the two parties; ads shown. [KERRY \u2013 quotes singer Bruce Springsteen.] \n (Boston: Dan Rather) Report introduced. \n (Convention floor: John Roberts) Tonight\u2019s agenda, including vice presidential candidate Senator John Edwards\u2019s speech, previewed; details given of the Democrats\u2019 challenge to close the national security gap with President Bush and to win undecided voters; CBS News poll results cited. [Former Joint Chiefs of Staff chairman retired Gen. John SHALIKASHVILI&#134;- supports Kerry.] [Last night, Teresa HEINZ KERRY \u2013 mentions Kerry\u2019s military medals.] [Last night, keynote speaker/Illinois senate candidate Barack OBAMA&#134;- says there is not a liberal America & a conservative America.] [\u201cPolitical Digest, Hotline\u201d editor Chuck TODD&#134;- comments on the Democrats\u2019 efforts to look moderate.] \n (Boston: Dan Rather) CBS coverage of the convention noted.", "segment_duration": 260, "segment_type_id": 2, "segment_start_time": "63230.0", "legacy_segment_id": 760989, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "2pXbUTWF9u", "broadcast_date": "2004-07-28", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 760986, "segment_id": "trCgiPJYC8", "segment_broadcast_id": "2pXbUTWF9u", "segment_title": "California / Baby Food Scare", "segment_description": "(Boston: Dan Rather) Report introduced.   (Los Angeles: Sandra Hughes) The FBI\u2019s investigation into Gerber baby food laced with the poison ricin in California featured; photo shown of suspect Charles Cage&#134;; details given of the conclusion that the incident was product-tampering rather than terrorism and about notes in the baby food jars. [Orange County district attorney Tony RACKAUCKAS&#134;- notes Cage is transient.]", "segment_duration": 100, "segment_type_id": 2, "segment_start_time": "63490.0", "legacy_segment_id": 760990, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "2pXbUTWF9u", "broadcast_date": "2004-07-28", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 760986, "segment_id": "oJF8gYu98C", "segment_broadcast_id": "2pXbUTWF9u", "segment_title": "Upcoming Items; fallen soldier Army S/Sgt. Kenneth Hendrickson&#134<!-- spelling on screen --> profiled. (Studio: Dan Rather)", "segment_description": "null", "segment_duration": 60, "segment_type_id": 2, "segment_start_time": "63590.0", "legacy_segment_id": 760991, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "2pXbUTWF9u", "broadcast_date": "2004-07-28", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 760986, "segment_id": "23Bbj4c4o7", "segment_broadcast_id": "2pXbUTWF9u", "segment_title": "(Commercial: Oral-B; Nexium; Life Savers; Serenity; Thompson\u2019s Water Seal; Excellence.)", "segment_description": "null", "segment_duration": 160, "segment_type_id": 3, "segment_start_time": "63650.0", "legacy_segment_id": 760992, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "2pXbUTWF9u", "broadcast_date": "2004-07-28", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 760986, "segment_id": "KoxYmewoor", "segment_broadcast_id": "2pXbUTWF9u", "segment_title": "Inside Story (Edwards Interview)", "segment_description": "(Boston: Dan Rather) Vice presidential candidate Senator John Edwards\u2019s speech at the Democratic National Convention tonight previewed. Interview held with Edwards on how he defines himself and the election; details given of his background. [EDWARDS \u2013 states he wants voters to see the toughness inside him; describes differences between himself and Vice President Dick Cheney; comments on strength of vision and character.] [Wife Elizabeth EDWARDS&#134;\u2013 comments on John\u2019s belief in being respectful to the people with whom you disagree.]", "segment_duration": 210, "segment_type_id": 2, "segment_start_time": "63810.0", "legacy_segment_id": 760993, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "2pXbUTWF9u", "broadcast_date": "2004-07-28", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 760986, "segment_id": "nvWhVf2HQ3", "segment_broadcast_id": "2pXbUTWF9u", "segment_title": "Upcoming Items (Boston: Dan Rather)", "segment_description": "null", "segment_duration": 20, "segment_type_id": 2, "segment_start_time": "64020.0", "legacy_segment_id": 760994, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "2pXbUTWF9u", "broadcast_date": "2004-07-28", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 760986, "segment_id": "GpE5mep5st", "segment_broadcast_id": "2pXbUTWF9u", "segment_title": "(Commercial: Lipitor; Capital One; Procrit; Tennessee Lottery.)", "segment_description": "null", "segment_duration": 150, "segment_type_id": 3, "segment_start_time": "64040.0", "legacy_segment_id": 760995, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "2pXbUTWF9u", "broadcast_date": "2004-07-28", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 760986, "segment_id": "bLTSdzf87o", "segment_broadcast_id": "2pXbUTWF9u", "segment_title": "France / Anti-Semitism", "segment_description": "(Boston: Dan Rather) Report introduced.   (Paris: Mark Phillips) The surge in anti-Semitic vandalism and violence that is forcing many Jews in France to emigrate to Israel featured; statistics cited on anti-Semitic crime; scenes shown of French Jews arriving in Israel and of desecrated Jewish cemeteries; details given of Muslim-Jewish tension in France. [2 French JEWS \u2013 speak of their fear.] [Israeli Prime Minister Ariel SHARON \u2013 tells French Jews to move to Israel.]", "segment_duration": 130, "segment_type_id": 2, "segment_start_time": "64190.0", "legacy_segment_id": 760996, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "2pXbUTWF9u", "broadcast_date": "2004-07-28", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 760986, "segment_id": "OU1cp6y77Z", "segment_broadcast_id": "2pXbUTWF9u", "segment_title": "Market Watch: Oil Prices, Stocks", "segment_description": "(Boston: Dan Rather) The rise in crude oil prices due to Russia\u2019s threat to shut down its biggest oil company cited; Stock Market Report.", "segment_duration": 30, "segment_type_id": 2, "segment_start_time": "64320.0", "legacy_segment_id": 760997, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "2pXbUTWF9u", "broadcast_date": "2004-07-28", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 760986, "segment_id": "1FyGOyvrdP", "segment_broadcast_id": "2pXbUTWF9u", "segment_title": "Upcoming Items (Boston: Dan Rather)", "segment_description": "null", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "64350.0", "legacy_segment_id": 760998, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "2pXbUTWF9u", "broadcast_date": "2004-07-28", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 760986, "segment_id": "q45SLboPQj", "segment_broadcast_id": "2pXbUTWF9u", "segment_title": "(Commercial: \"CBS Evening News\"; L.L. Bean; Visine; Bush\u2019s Beans; Senokot; Big Lots; Poligrip; NewsChannel 5.)", "segment_description": "null", "segment_duration": 190, "segment_type_id": 3, "segment_start_time": "64360.0", "legacy_segment_id": 760999, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "2pXbUTWF9u", "broadcast_date": "2004-07-28", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 760986, "segment_id": "RLIQkoJDEo", "segment_broadcast_id": "2pXbUTWF9u", "segment_title": "Political Conventions / Celebrities", "segment_description": "(Boston: Dan Rather) Report introduced. \n (Boston: Jim Axelrod) The Hollywood-style productions of the political conventions and the celebrities they attract featured; scenes shown of filmmaker Michael Moore, singer Bono & other celebrities at the Democratic National Convention. [BONO \u2013 comments.] [Pennsylvania Governor Ed RENDELL&#134;- says none of us are {actor} Ben Affleck.] [\u201cThe Daily Show\u201d host Jon STEWART&#134;- comments on the attention given to celebrities.]", "segment_duration": 110, "segment_type_id": 2, "segment_start_time": "64550.0", "legacy_segment_id": 761000, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "