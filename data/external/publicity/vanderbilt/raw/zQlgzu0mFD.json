{"data": [{"broadcast_id": "zQlgzu0mFD", "broadcast_date": "2004-08-09", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 761880, "segment_id": "nq5YEK85aX", "segment_broadcast_id": "zQlgzu0mFD", "segment_title": "Preview/Introduction Elizabeth Vargas (New York)", "segment_description": "null", "segment_duration": 50, "segment_type_id": 1, "segment_start_time": "63000.0", "legacy_segment_id": 761880, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "Preview", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "zQlgzu0mFD", "broadcast_date": "2004-08-09", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 761880, "segment_id": "HPynDHAYaf", "segment_broadcast_id": "zQlgzu0mFD", "segment_title": "Terrorism / Al Qaeda Threat / Methods of Attack", "segment_description": "(Studio: Elizabeth Vargas)  Report introduced. \n (Washington: Pierre Thomas)  The plans for an Al Qaeda attack on the US revealed by computer disks seized in Britain & Pakistan examined; details given of government concerns about ways of delivering bombs via helicopters, boats & limousines.  [Former counterterrorism official Vince CANNISTRARO\u2020- comments on the most feasible way of attacking targets.]  [Former counterterrorism chief Skip BRANDON\u2020- talks about the efficiency of chemical & biological weapons & the pressure now on intelligence analysts.] \n (Studio: Elizabeth Vargas)  The tightening of security in New York City due to the new evidence & the upcoming Republican National Convention noted. \n (New York: John Berman)  The possible methods of attack in New York City from the sea, ground & air reviewed; scenes shown of security at the heliport & from a helicopter over the city; photos shown of the World Trade Center in 2001; details given about limousine & water traffic.  [New York City Mayor Michael BLOOMBERG\u2020- talks about security for helicopters.]  [Senator Charles SCHUMER\u00a0- says small pleasure craft are unregulated.] \n (Studio: Elizabeth Vargas, Brian Ross)  The criticism of the US by Pakistan & Britain for disclosing the names of two top Al Qaeda suspects, Muhammad Khan & Eisa al-Hindi, discussed; details given about how the two names were released despite their being deep sources of information.", "segment_duration": 350, "segment_type_id": 2, "segment_start_time": "63050.0", "legacy_segment_id": 761881, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "zQlgzu0mFD", "broadcast_date": "2004-08-09", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 761880, "segment_id": "zyp9gccZvI", "segment_broadcast_id": "zQlgzu0mFD", "segment_title": "Iraq / Al-Sadr Revolt / Oil", "segment_description": "(Studio: Elizabeth Vargas)  The fifth day of fighting in Najaf, Iraq, between coalition forces & the militias of Shiite cleric Muqtada al-Sadr & the shutdown of oil production in southern Iraq reported; scenes shown of a holy shrine for Shiite Muslims in Najaf.", "segment_duration": 40, "segment_type_id": 2, "segment_start_time": "63400.0", "legacy_segment_id": 761882, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "zQlgzu0mFD", "broadcast_date": "2004-08-09", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 761880, "segment_id": "B9sTuSFRia", "segment_broadcast_id": "zQlgzu0mFD", "segment_title": "Campaign 2004 / Bush vs. Kerry / Stem Cell Research", "segment_description": "(Studio: Elizabeth Vargas)  Report introduced.   (White House: John Cochran)  The debate over embryonic stem cell research in the 2004 presidential election campaign featured; details given of President Bush's opposition to the use of federal funds for stem cells created after August 2001.  [Senators John KERRY, John EDWARDS&nbsp- back the research.]  [First Lady Laura BUSH&nbsp- downplays the implications of a cure for Alzheimer's disease.]  [May 8, Nancy REAGAN; July 27, son Ron REAGAN&nbsp- speak for stem cell research.]  Findings of the National Annenberg Election Survey on the public's view of funding for stem cells cited.", "segment_duration": 140, "segment_type_id": 2, "segment_start_time": "63440.0", "legacy_segment_id": 761883, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "zQlgzu0mFD", "broadcast_date": "2004-08-09", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 761880, "segment_id": "aVUvax7ZCo", "segment_broadcast_id": "zQlgzu0mFD", "segment_title": "Upcoming Items (Studio: Elizabeth Vargas)", "segment_description": "null", "segment_duration": 30, "segment_type_id": 2, "segment_start_time": "63580.0", "legacy_segment_id": 761