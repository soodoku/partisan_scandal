{"data": [{"broadcast_id": "Qa2myeY667", "broadcast_date": "2004-08-10", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 761920, "segment_id": "DZdSc5yBft", "segment_broadcast_id": "Qa2myeY667", "segment_title": "Preview/Introduction Scott Pelley (New York)", "segment_description": "null", "segment_duration": 50, "segment_type_id": 1, "segment_start_time": "63000.0", "legacy_segment_id": 761920, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Preview", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "Qa2myeY667", "broadcast_date": "2004-08-10", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 761920, "segment_id": "HcaX9AvLH5", "segment_broadcast_id": "Qa2myeY667", "segment_title": "CIA / Goss Nomination", "segment_description": "(Studio: Scott Pelley) Report introduced. \n (Pentagon: David Martin) President Bush\u2019s nomination of Representative Porter Goss&#134; to be the new CIA director featured; details given of the expectation for a tough confirmation process this election year, of the CIA\u2019s animosity over Goss\u2019 criticism of the agency and of uncertainty over how he will fit into the 9/11 Commission\u2019s recommendation for an intelligence czar. [BUSH, Senator Pat ROBERTS&#134;\u2013 support Goss.] [GOSS \u2013 says he looks forward to the confirmation process.] [Representative Nancy PELOSI&#134;- says a person should not be the director of intelligence when he has acted in a political way.]", "segment_duration": 140, "segment_type_id": 2, "segment_start_time": "63050.0", "legacy_segment_id": 761921, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "Qa2myeY667", "broadcast_date": "2004-08-10", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 761920, "segment_id": "k5RwfUePMy", "segment_broadcast_id": "Qa2myeY667", "segment_title": "Campaign 04 / Bush vs. Kerry / CIA", "segment_description": "(Studio: Scott Pelley) Report introduced. \n (Niceville, Florida: Bill Plante) President Bush\u2019s campaign trip to Florida, where he promoted his nomination of Representative Porter Goss to head the CIA, featured. [BUSH \u2013 announces the nomination; comments on Senator John McCain\u2019s joining him on this trip.] [Former CIA director Stansfield TURNER&#134;- says the appearance is there of turning this appointment into a political ploy.]", "segment_duration": 120, "segment_type_id": 2, "segment_start_time": "63190.0", "legacy_segment_id": 761922, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "Qa2myeY667", "broadcast_date": "2004-08-10", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 761920, "segment_id": "wwAU2gxv1E", "segment_broadcast_id": "Qa2myeY667", "segment_title": "Iraq / Al-Sadr Revolt", "segment_description": "(Studio: Scott Pelley) The assessment by a US Marine officer of the conflict with Shiite militants in Iraq noted. \n (Baghdad: Kimberly Dozier) The ongoing fight between US forces and radical followers of Shiite cleric Muqtada al-Sadr featured; scenes shown from Najaf; details given of the Iraqi government\u2019s approval for US troops to pursue the militants to a holy shrine and of signs that moderate clerics & local Iraqis are tired of the violence. [Baghdad University Mohammad al-DAAMI&#134;- comments on support for interim Iraqi Prime Minister Iyad Allawi from the majority of Iraqis.]", "segment_duration": 120, "segment_type_id": 2, "segment_start_time": "63310.0", "legacy_segment_id": 761923, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "Qa2myeY667", "broadcast_date": "2004-08-10", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 761920, "segment_id": "czGUBWCsh2", "segment_broadcast_id": "Qa2myeY667", "segment_title": "Terrorism / Las Vegas, Nevada", "segment_description": "(Studio: Scott Pelley) Report introduced.   (Las Vegas: Cynthia Bowers) The denial by Las Vegas tourism officials that they covered up video evidence of an Al Qaeda plot targeting casinos because they feared a warning might hurt tourism featured; details given of the inclusion on the tape of pre-September 11 scenes of New York and conversations mentioning terrorist Khalid Shaikh Mohammed&#134;&#134;. [Las Vegas Mayor Oscar GOODMAN&#134;- denies a cover-up.] [MGM Mirage CEO Terry LANNI&#134;- says it appeared in his security team\u2019s report that the tape was a family vacation photo.] [Investigative Management Group Bob STRANG&#134;- says Americans should have all information available to them.]", "segment_duration": 140, "segment_type_id": 2, "segment_start_time": "63430.0", "legacy_segment_id": 761924, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "Qa2myeY667", "broadcast_date": "2004-08-10", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 761920, "segment_id": "Rftm0WhLEg", "segment_broadcast_id": "Qa2myeY667", "segment_title": "Terrorism / Al Qaeda / Babar Case", "segment_description": "(Studio: Scott Pelley) The admission of Al Qaeda suspect Mohammed Babar\u2020\u2020 to smuggling money & equipment and arranging transportation for Al Qaeda terrorists reported.", "segment_duration": 20, "segment_type_id": 2, "segment_start_time": "63570.0", "legacy_segment_id": 761925, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "Qa2myeY667", "broadcast_date": "2004-08-10", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 761920, "segment_id": "HEQDU9C8I3", "segment_broadcast_id": "Qa2myeY667", "segment_title": "Hurricane Season", "segment_description": "(Studio: Scott Pelley) Map & NASA satellite images shown of the tracks of Tropical Storms Bonnie & Charley&#134;.", "segment_duration": 30, "segment_type_id": 2, "segment_start_time": "63590.0", "legacy_segment_id": 761926, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names":