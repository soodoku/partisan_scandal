ennings)  Architectural archivist/journalist Sheryl Oring&#135;, who enables people to have a political say in a different way, profiled; scenes shown of Sheryl typing postcards to the president as dictated by all sorts of people; details given of her background & how her experience in Germany gave her the idea of setting down public opinion on postcards.  [ORING&nbsp- talks about the symbolism of the typewriter, the mood set by her 1950s-style set up, how her project demonstrates how diverse America is in its opinions; hopes the president will read the postcards.]", "segment_duration": 250, "segment_type_id": 2, "segment_start_time": "64420.0", "legacy_segment_id": 764336, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "PtAevzacUv", "broadcast_date": "2004-09-03", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1670, "broadcast_description": null, "legacy_broadcast_id": 764325, "segment_id": "ql0PKFwea5", "segment_broadcast_id": "PtAevzacUv", "segment_title": "Good Night", "segment_description": "null", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "64670.0", "legacy_segment_id": 764337, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}]}