{"data": [{"broadcast_id": "WpLSukFHSM", "broadcast_date": "2008-10-20", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1710, "broadcast_description": null, "legacy_broadcast_id": 921754, "segment_id": "sJJOvNnsgg", "segment_broadcast_id": "WpLSukFHSM", "segment_title": "Preview/Introduction Brian Williams (New York)", "segment_description": null, "segment_duration": 50, "segment_type_id": 1, "segment_start_time": "63000.0", "legacy_segment_id": 921754, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "Preview", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "WpLSukFHSM", "broadcast_date": "2008-10-20", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1710, "broadcast_description": null, "legacy_broadcast_id": 921754, "segment_id": "IsGhIkpvs2", "segment_broadcast_id": "WpLSukFHSM", "segment_title": "Economy: Stimulus Plan", "segment_description": "(Studio: Brian Williams) Stock Market Report.  \n\n(Washington: Tom Costello) Federal Reserve Board chairman Ben Bernanke\u2019s call for a second stimulus package for the economy featured; details given of the Democrats\u2019 proposals. [BERNANKE \u2013 says consideration of a fiscal package by the Congress seems appropriate.] [Speaker of the House Nancy PELOSI \u2013 says there is a need for us to do this now.] [Representative Rosa DeLAURO&#134;- asks Bernanke what size an economic recovery package should be.] [Representative Paul RYAN&#134;- opposes adding to the deficit.] More signs of the troubled economy, including GM\u2019s money problems and budget shortfalls in 22 states, noted. [Treasury Secretary Henry PAULSON \u2013 calls for smaller banks to take government money.] ", "segment_duration": 180, "segment_type_id": 2, "segment_start_time": "63050.0", "legacy_segment_id": 921755, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "WpLSukFHSM", "broadcast_date": "2008-10-20", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1710, "broadcast_description": null, "legacy_broadcast_id": 921754, "segment_id": "cBYOzr195z", "segment_broadcast_id": "WpLSukFHSM", "segment_title": "Decision 2008 / Obama vs. McCain / The Campaign", "segment_description": "(Studio: Brian Williams) Report introduced.  \n\n(Washington: Andrea Mitchell) The presidential campaigns of Senators Barack Obama and John McCain reviewed; scenes shown of early voters in Florida and North Carolina; details given about Obama\u2019s money advantage and the endorsement from former Secretary of State Colin Powell. [Obama VOTER \u2013 comments on camping out to vote.] [OBAMA \u2013 urges Floridians to vote early.] [In Colorado, Governor Sarah PALIN \u2013 says early voting begins today.] [POWELL \u2013 says Palin is not ready to be president.] [Voice of Senator Joe BIDEN \u2013 says Obama will be tested when he takes office.] [McCAIN \u2013 responds to Biden\u2019s remarks.] Palin's appearance on \"Saturday Night Live\" shown. ", "segment_duration": 140, "segment_type_id": 2, "segment_start_time": "63230.0", "legacy_segment_id": 921756, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "WpLSukFHSM", "broadcast_date": "2008-10-20", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1710, "broadcast_description": null, "legacy_broadcast_id": 921754, "segment_id": "Y8MtcZDzvD", "segment_broadcast_id": "WpLSukFHSM", "segment_title": "Where They Stand (Medicare)", "segment_description": "(Studio: Brian Williams) Report introduced.   (Miami: Mark Potter) Where presidential candidates Senators John McCain and Barack Obama stand on Medicare examined; details given about their recommendations; Obama ad shown. [Several SENIORS \u2013 offer views on Medicare.] [McCAIN, OBAMA \u2013 outline their plans.] [Political analyst Susan MacMANUS&#134;- explains why they have not made Medicare a priority.] ", "segment_duration": 140, "segment_type_id": 2, "segment_start_time": "63370.0", "legacy_segment_id": 921757, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "WpLSukFHSM", "broadcast_date": "2008-10-20", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1710, "broadcast_description": null, "legacy_broadcast_id": 921754, "segment_id": "UaF04TzbFO", "segment_broadcast_id": "WpLSukFHSM", "segment_title": "Decision 2008 / Nader", "segment_description": "(Studio: Brian Williams) Report introduced.   (Buffalo, New York: Ron Allen) Ralph Nader\u2019s 5th run for president featured; details given about his stand on the economic bailout and Senators Barack Obama and John McCain; photo shown of his running mate, Matt Gonzalez&#134;. [NADER \u2013 calls for holding corporations accountable.] [In interview, NADER \u2013 explains why he keeps running; says he is not afraid to keep losing and losing.] ", "segment_duration": 120, "segment_type_id": 2, "segment_start_time": "63510.0", "legacy_segment_id": 921758, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "WpLSukFHSM", "broadcast_date": "2008-10-20", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1710, "broadcast_description": null, "legacy_broadcast_id": 921754, "segment_id": "E57Ofqrnge", "segment_broadcast_id": "WpLSukFHSM", "segment_title": "Upcoming Items (Studio: Brian Williams)", "segment_description": " ", "segment_duration": 20, "segment_type_id": 2, "segment_start_time": "63630.0", "legacy_segment_id": 921759, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "WpLSukFHSM", "broadcast_date": "2008-10-20", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1710, "broadcast_description": null, "legacy_broadcast_id": 921754, "segment_id": "qkBP2HGcIT", "segment_broadcast_id": "WpLSukFHSM", "segment_title": "(Commercial: Kashi; ThermaCare; Plavix.)", "segment_description": " ", "segment_duration": 130, "segment_type_id": 3, "segment_start_time": "63650.0", "legacy_segment_id": 921760, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "WpLSukFHSM", "broadcast_date": "2008-10-20", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1710, "broadcast_descriptio