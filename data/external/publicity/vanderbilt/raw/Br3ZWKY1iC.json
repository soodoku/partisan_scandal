ket Report. ", "segment_duration": 230, "segment_type_id": 2, "segment_start_time": "63050.0", "legacy_segment_id": 921902, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "Br3ZWKY1iC", "broadcast_date": "2008-10-23", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 921901, "segment_id": "BaUiyEck79", "segment_broadcast_id": "Br3ZWKY1iC", "segment_title": "Decision 2008 / McCain, Palin Interview (Part II)", "segment_description": "(Studio: Brian Williams) The unwelcome attention on Governor Sarah Palin, who will be deposed tomorrow in the Troopergate case in Alaska, while Senator John McCain continues his campaign in Florida; scenes shown from Ormond Beach. More of the earlier NBC interview with McCain and Palin presented. [PALIN \u2013 says there is no question that Bill Ayers is a terrorist; comments on her definition of domestic terrorism; says an elite is anyone who thinks they\u2019re better than someone else; states her views on feminism and women\u2019s rights.] [McCAIN \u2013 says Senator Barack Obama has not been forthcoming about his relationship with Ayers; denies he has involved Rev. Jeremiah Wright in his campaign; says a lot of elites live in our capital and New York City.] [PALIN, McCAIN \u2013 repeatedly bring up Ayers.]  \n\n(Studio: Brian Williams) Tomorrow\u2019s interviews previewed. ", "segment_duration": 500, "segment_type_id": 2, "segment_start_time": "63280.0", "legacy_segment_id": 921903, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_nam