{"data": [{"broadcast_id": "wxAoREn0nL", "broadcast_date": "2004-08-11", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1710, "broadcast_description": null, "legacy_broadcast_id": 762011, "segment_id": "xEJRNTQVse", "segment_broadcast_id": "wxAoREn0nL", "segment_title": "Preview/Introduction Tom Brokaw (Greece)", "segment_description": "NOTE: Local weather bulletin on screen from 5:52:20 to 5:54:40 and 5:55:30 to end.", "segment_duration": 70, "segment_type_id": 1, "segment_start_time": "63000.0", "legacy_segment_id": 762011, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "Preview", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "wxAoREn0nL", "broadcast_date": "2004-08-11", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1710, "broadcast_description": null, "legacy_broadcast_id": 762011, "segment_id": "jLc2exAOpn", "segment_broadcast_id": "wxAoREn0nL", "segment_title": "Terrorism / Al Qaeda / Babar Case", "segment_description": "(Athens: Tom Brokaw) Report introduced. \n (Washington: Pete Williams) The investigation of the role of Pakistani-American Mohammed Babar, who was arrested in Britain, in the Al Qaeda plot against US financial institutions featured; details given of Babar\u2019s background, his possible connection with a British cell that included Issa al-Hindi, and his meetings in Pakistan. [In 2001, BABAR \u2013 says his loyalty will always be with the Muslims.] [Terrorism expert Bruce HOFFMAN&#134;- says our ability to link disparate Al Qaeda activity in different countries has improved since September 11.]", "segment_duration": 140, "segment_type_id": 2, "segment_start_time": "63070.0", "legacy_segment_id": 762012, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "wxAoREn0nL", "broadcast_date": "2004-08-11", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1710, "broadcast_description": null, "legacy_broadcast_id": 762011, "segment_id": "CZ3rE2N15r", "segment_broadcast_id": "wxAoREn0nL", "segment_title": "Iraq / Al-Sadr Revolt", "segment_description": "(Athens: Tom Brokaw) Report introduced. \n (Baghdad: Jennifer Eccleston) The conflict in Iraq between US & Iraqi forces and militants loyal to Shiite cleric Muqtada al-Sadr reviewed; scenes shown of fighting in Najaf, Kut and Baghdad\u2019s Sadr City, and of a protest in Nasiriyah against interim Iraqi Prime Minister Iyad Allawi; details given of US plans for a final assault on Najaf and Iraq\u2019s dependency on the US for security. [Iraq analyst Amatzia BARAM&#134;- comments on al-Sadr\u2019s followers and his ability to create trouble for the government.] \n (Athens: Tom Brokaw) The CIA\u2019s debunking of a video on an Islamic militant Website purporting to show the beheading of a CIA agent in Iraq noted.", "segment_duration": 180, "segment_type_id": 2, "segment_start_time": "63210.0", "legacy_segment_id": 762013, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "wxAoREn0nL", "broadcast_date": "2004-08-11", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1710, "broadcast_description": null, "legacy_broadcast_id": 762011, "segment_id": "bNMx4BNnd6", "segment_broadcast_id": "wxAoREn0nL", "segment_title": "Divided We Stand (Hispanic Voters)", "segment_description": "(Athens: Tom Brokaw) Occasional series that looks at groups of voters who could make a big difference in the presidential election introduced.   (Albuquerque, New Mexico: David Gregory) The fight between President Bush & Senator John Kerry to win Hispanic voters featured; map shown of Hispanic battleground states; Spanish-language ads shown. [In New Mexico & Arizona, BUSH, KERRY \u2013 speak Spanish.] [Southwest Voter Project Antonio GONZALES&#134;&#134;- notes Hispanics have become \u201csexy.\u201d] [Election analyst Roberto SURO&#134;- states education is the top issue for Hispanics.] [Casa Grande, Arizona, voters Francisco MEDINA&#135;, Rosa MARTINEZ&#135;- state views.]", "segment_duration": 140, "segment_type_id": 2, "segment_start_time": "63390.0", "legacy_segment_id": 762014, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "wxAoREn0nL", "broadcast_date": "2004-08-11", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1710, "broadcast_description": null, "legacy_broadcast_id": 762011, "segment_id": "fZ9TQSnTb4", "segment_broadcast_id": "wxAoREn0nL", "segment_title": "Olympic Games / Security", "segment_description": "(Athens: Tom Brokaw) The return of the Olympic torch to Athens, Greece, after its trip around the world noted; scenes shown.   (Athens: Richard Engel) The extraordinary security measures in Athens launched by Greece & NATO forces featured; scenes shown of AWACS planes and a Kevlar-skinned blimp on patrol and of other security efforts; details given of the difficulty in monitoring the extensive coastlines and an increase in Al Qaeda chatter about Athens; map shown of known Al Qaeda cells nearby. [AWACS radar surveillance officer Capt. Mario LaROSE&#134;- comments.] [Terrorism expert M.J. GOHEL&#134;- notes the temptation of the Olympics for global jihadists.] The attention to Piraeus&#134;&#134; harbor, where VIPs, including the US basketball team, will be staying on cruise ships & yachts, noted; scenes shown of a security drill in the harbor.", "segment_duration": 200, "segment_type_id": 2, "segment_start_time": "63530.0", "legacy_segment_id": 762015, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "wxAoREn0nL", "broadcast_date": "2004-08-11", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1710, "broadcast_description": null, "legacy_broadcast_id": 762011, "segment_id": "JzlaEqH1JO", "segment_broadcast_id": "wxAoREn0nL", "segment_title": "Upcoming Items (Athens: Tom Brokaw)", "segment_description": "null", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "63730.0", "legacy_segment_id": 762016, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "wxAoREn0nL", "broadcast_date": "2004-08-11", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1710, "broadcast_description": null, "legacy_broadcast_id": 762011, "segment_id": "Tygf2tR2Lw", "segment_broadcast_id": "wxAoREn0nL", "segment_title": "(Commercial: Capital One; Maalox; Sonicare; Detrol; \"Hardball.\")", "segment_description": "null", "segment_duration": 140, 