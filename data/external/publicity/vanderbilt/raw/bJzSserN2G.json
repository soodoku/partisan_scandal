{"data": [{"broadcast_id": "bJzSserN2G", "broadcast_date": "2004-08-01", "broadcast_start_time": "0.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 761315, "segment_id": "U2DkL9JjtR", "segment_broadcast_id": "bJzSserN2G", "segment_title": "Preview/Introduction Don Dahler (New York)", "segment_description": "Note: Time numerals represent seconds into broadcast, not clock time, since the telecast originated in West Virginia", "segment_duration": 40, "segment_type_id": 1, "segment_start_time": "0.0", "legacy_segment_id": 761315, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "Preview", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "bJzSserN2G", "broadcast_date": "2004-08-01", "broadcast_start_time": "0.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 761315, "segment_id": "IryG1I2xNv", "segment_broadcast_id": "bJzSserN2G", "segment_title": "Terrorism / Al Qaeda Threat / Financial Institutions / Clarke Interview / New York", "segment_description": "(Studio: Don Dahler)  Report that terrorists are targeting financial companies in New York, New Jersey & Washington, DC, introduced.  [Secretary of Homeland Security Tom RIDGE&nbsp- says the preferred method of attack is car & truck bombs.] \n (Washington: Pierre Thomas)  The intelligence giving specifics on the targeting of the New York Stock Exchange, the Citigroup complex, the Prudential Financial building & the World Bank & International Monetary Fund buildings in Washington, reviewed; details given about what the Al Qaeda suspects discussed.  [RIDGE&nbsp- comments on the Al Qaeda plans & the quality of the intelligence.] \n (Studio: Don Dahler)  Live interview held with ABC counterterrorism analyst Richard Clarke about the threat.  [CLARKE&nbsp- cites the consistent story emerging from multiple sources about Al Qaeda still going after New York; notes the terrorists always have backup targets.] \n (New York: Bob Jamieson)  Security in New York City in response to the threats featured; details given of the state of high alert in the city since September 11.  [New York City Mayor Michael BLOOMBERG&#134;- talks about the counterterrorism resources.]  [RIDGE&nbsp- comments on protecting the financial system.]  [Former emergency management official Jerry HAUER&#134;- says security has dropped off around the city.]  [Two city WORKERS&nbsp- react.] \n (Studio: Don Dahler)  The reaction of Senator John Kerry's campaign to the terrorism announcement noted.", "segment_duration": 420, "segment_type_id": 2, "segment_start_time": "40.0", "legacy_segment_id": 761316, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "bJzSserN2G", "broadcast_date": "2004-08-01", "broadcast_start_time": "0.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 761315, "segment_id": "Ic7K4zj0j8", "segment_broadcast_id": "bJzSserN2G", "segment_title": "Iraq / Attacks / Church Bombings", "segment_description": "(Studio: Don Dahler)  Report introduced.   (Baghdad: Mike Lee)  A devastating string of coordinated attacks in Iraq against Christian churches featured; scenes shown from the sites of church attacks; details given of prior attacks on Christian-owned businesses, including liquor stores.  [WOMAN&nbsp- reacts to the attack.]  [Sarah Lawrence College professor Fawaz GERGES&#134;- outlines the basic goals of the attack.]   (Studio: Don Dahler)  Today's US casualties in attacks in Iraq by insurgents reported.", "segment_duration": 140, "segment_type_id": 2, "segment_start_time": "460.0", "legacy_segment_id": 761317, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "bJzSserN2G", "broadcast_date": "2004-08-01", "broadcast_start_time": "0.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 761315, "segment_id": "bEEQVtq0AK", "segment_broadcast_id": "bJzSserN2G", "segment_title": "Paraguay / Supermarket Fire", "segment_description": "(Studio: Don Dahler)  Fire at a supermarket in Ascunsion, Paraguay, reported; scenes shown.", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "600.0", "legacy_segment_id": 761318, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "bJzSserN2G", "broadcast_date": "2004-08-01", "broadcast_start_time": "0.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1680, "broadcast_description": null, "legacy_broadcast_id": 761315, "segment_id": "BenRa4Ojp9", "segment_broadcast_id": "bJzSserN2G", "segment_title": "Upcoming Items (Studio: Don Dahler)", "segment_description": "null", "segment_duration": 30, "segment_type_id": 2, "segment_start_time": "610.0", "legacy_segment_id": 761319, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names