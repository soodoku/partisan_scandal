iving on his roof.] [WOMAN {thru translator} \u2013 describes what happened to her.] [2 WOMEN {thru translator} \u2013 comment on being hungry and thirsty.] [CARE Tom FREIDEBERG&#134;- reacts to this situation.] ", "segment_duration": 150, "segment_type_id": 2, "segment_start_time": "63940.0", "legacy_segment_id": 919424, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "uinqBnL6eZ", "broadcast_date": "2008-09-26", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1730, "broadcast_description": null, "legacy_broadcast_id": 919418, "segment_id": "rzbdn1EDk4", "segment_broadcast_id": "uinqBnL6eZ", "segment_title": "Stock Market Report (Oxford, Mississippi: Brian Williams)", "segment_description": " ", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "64090.0", "legacy_segment_id": 919425, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "uinqBnL6eZ", "broadcast_date": "2008-09-26", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1730, "broadcast_description": null, "legacy_broadcast_id": 919418, "segment_id": "I21VXLeMX7", "segment_broadcast_id": "uinqBnL6eZ", "segment_title": "Upcoming Items (Oxford, Mississippi: Brian Williams)", "segment_description": " ", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "64100.0", "legacy_segment_id": 919426, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributor