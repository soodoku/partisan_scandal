4, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "ZJ64AMu99o", "broadcast_date": "2004-08-17", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 762463, "segment_id": "DJJg7zCV4z", "segment_broadcast_id": "ZJ64AMu99o", "segment_title": "Internet Terrorism (Part II)", "segment_description": "(Studio: Scott Pelley) Two-part series on the fight against the spread of terrorism on the Internet continued.   (London: Mark Phillips) Terror Websites that advocate violence, sometimes providing cryptic instructions about how & when to strike, featured; screen shots shown, including one showing Al Qaeda leader Osama bin Laden and a map of Manhattan, New York, and details for building a bomb into a wedding cake; details given about a survey showing the majority of terror Websites are based in the US. [\u201cTerror Tracker\u201d author Neil DOYLE&#134;- comments on Al Qaeda cryptography; notes that sites close down after being discovered, only to show up somewhere else.] [Former British intelligence officer Crispin BLACK&#134;- says a number of terrorists in the Al Qaeda network are \u201ccomputer nerds.\u201d]", "segment_duration": 200, "segment_type_id": 2, "segment_start_time": "64190.0", "legacy_segment_id": 762475, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "ZJ64AMu99o", "broadcast_date": "2004-08-17", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broad