{"data": [{"broadcast_id": "ZJ64AMu99o", "broadcast_date": "2004-08-17", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 762463, "segment_id": "MuJ6T1iDBh", "segment_broadcast_id": "ZJ64AMu99o", "segment_title": "Preview/Introduction Scott Pelley (New York)", "segment_description": "null", "segment_duration": 50, "segment_type_id": 1, "segment_start_time": "63000.0", "legacy_segment_id": 762463, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Preview", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "ZJ64AMu99o", "broadcast_date": "2004-08-17", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 762463, "segment_id": "84cBdMDRGk", "segment_broadcast_id": "ZJ64AMu99o", "segment_title": "Hurricane Charley / Florida / Aftermath", "segment_description": "(Studio: Scott Pelley) Report introduced. \n (Ft. Myers, Florida: Kelly Cobiella) The frustration of Florida residents who have been displaced and are without food, water & power in the aftermath of Hurricane Charley featured; video shown of a confrontation at a roadblock to a barrier island, where police used a Taser gun to restrain a man who tried to drive his family through; scenes shown of people waiting for supplies. [Lee County Sheriff\u2019s Department Sgt. Bob CARMICHAEL\u2020- urges people to be calm.] \n (Studio: Scott Pelley) Report introduced. \n (Punta Gorda, Florida: Jim Acosta) The slow road to recovery featured; details given about job losses after the storm wiped out thousands of businesses; statistics on unemployment claims cited. [Punta Gorda residents Janice DERRICO\u2020, Teresa FOGOLINE\u2020, Thomas WARDEN\u2020, former Punta Gorda city councilman Sandy MacGIBBON\u2020- comment on the lack of resources for filing claims and the possibility of moving away.]", "segment_duration": 250, "segment_type_id": 2, "segment_start_time": "63050.0", "legacy_segment_id": 762464, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "ZJ64AMu99o", "broadcast_date": "2004-08-17", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 762463, "segment_id": "YLgKMN99tt", "segment_broadcast_id": "ZJ64AMu99o", "segment_title": "Terrorism / Al Qaeda Plot / Financial Institutions", "segment_description": "(Studio: Scott Pelley) Report introduced. \n (London: Richard Roth) The arrest in Britain of Dhiren Barot&#134; {aka Issa al-Britani&#134;}, an Al Qaeda suspect with reconnaissance plans for financial institutions in the US, featured; charges against Barot & 7 other men arrested last week outlined; details given of the identification of Barot in the 9/11 Commission report as the man sent by Al Qaeda leader Osama bin Laden to case targets in New York City, and of a plot to attack Britain. [Asia Pacific Foundation M.J. GOHEL&#134;- says these are not the big fish.]", "segment_duration": 120, "segment_type_id": 2, "segment_start_time": "63300.0", "legacy_segment_id": 762465, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "ZJ64AMu99o", "broadcast_date": "2004-08-17", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 762463, "segment_id": "nqGHBawvcT", "segment_broadcast_id": "ZJ64AMu99o", "segment_title": "Iraq / Al-Sadr Revolt", "segment_description": "(Studio: Scott Pelley) More coalition casualties in Iraq reported.   (Baghdad: Barry Petersen) Continued fighting in Najaf despite the Iraqi government\u2019s appeal to end the insurgency featured; details given of stalled negotiations between a government delegation and radical cleric Muqtada al-Sadr, who is leading the resistance; scenes shown of fighting in Najaf, where the US launched new strikes against al-Sadr\u2019s forces, and of a US tank being hit by enemy fire in Baghdad.", "segment_duration": 150, "segment_type_id": 2, "segment_start_time": "63420.0", "legacy_segment_id": 762466, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "ZJ64AMu99o", "broadcast_date": "2004-08-17", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 762463, "segment_id": "nNbyNfeeRz", "segment_broadcast_id": "ZJ64AMu99o", "segment_title": "Upcoming Items; fallen hero Army Spc. Orenthial Smith&#134<!-- spelling on screen --> profiled. (Studio: Scott Pelley; Dan Rather)", "segment_description": "null", "segment_duration": 50, "segment_type_id": 2, "segment_start_time": "63570.0", "legacy_segment_id": 762467, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_i