Mu99o", "segment_title": "Inside Story (Halliburton Overcharges)", "segment_description": "(Studio: Scott Pelley) Report introduced. \n (Washington: Sharyl Attkisson) Allegations against Halliburton for overcharging for food, shelter & services for troops in Iraq examined; details given about employees for Halliburton and its subsidiaries housed in luxury hotels, overcharging for soldiers\u2019 laundry and Halliburton\u2019s claim that the charges are politically motivated in an election year. [Former Halliburton employee Marie DeYOUNG&#134;- says there was no regard for spending limits.]", "segment_duration": 160, "segment_type_id": 2, "segment_start_time": "63800.0", "legacy_segment_id": 762470, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "ZJ64AMu99o", "broadcast_date": "2004-08-17", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 762463, "segment_id": "ox3o5DQnpn", "segment_broadcast_id": "ZJ64AMu99o", "segment_title": "Auto Industry / SUV Safety", "segment_description": "(Studio: Scott Pelley) Government figures on accident rates for SUVs compared to cars noted.", "segment_duration": 20, "segment_type_id": 2, "segment_start_time": "63960.0", "legacy_segment_id": 762471, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "ZJ64AMu99o", "broadcast_date": "2004-08-17", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadc