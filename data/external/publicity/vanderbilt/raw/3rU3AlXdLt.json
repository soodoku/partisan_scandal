d to the soldiers who have died in Iraq featured; scenes shown from the town of Whitman&#134;, Massachusetts, of the wall of baseballs each with a soldier's name on it on displayed at a local ball field.  [Wall founders Chris JOHNSON&#134;&#134;, Don RICE&#134;&#134;- recount their idea of putting a soldier's name on a ball.]  [At the ball wall, MAN, Little Leaguers Anthony VARASSO&#135;, sons Pat & Tim JOHNSON&nbsp- react to the memorial.]", "segment_duration": 210, "segment_type_id": 2, "segment_start_time": "64500.0", "legacy_segment_id": 761730, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "3rU3AlXdLt", "broadcast_date": "2004-08-07", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1710, "broadcast_description": null, "legacy_broadcast_id": 761715, "segment_id": "mN1fWWzxix", "segment_broadcast_id": "3rU3AlXdLt", "segment_title": "Good Night", "segment_description": "null", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "64710.0", "legacy_segment_id": 761731, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}]}