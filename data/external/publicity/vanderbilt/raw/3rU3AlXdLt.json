k_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "3rU3AlXdLt", "broadcast_date": "2004-08-07", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1710, "broadcast_description": null, "legacy_broadcast_id": 761715, "segment_id": "V3001X1eau", "segment_broadcast_id": "3rU3AlXdLt", "segment_title": "Iraq / Beheading Video Hoax", "segment_description": "(Studio: Bob Woodruff)  Report introduced. \n (Washington: Jake Tapper)  The hoax involving a report that an American was beheaded in Iraq examined; scenes shown from a BBC TV report & from the \"kidnap\" video.  [Staged hoax, Ben VANDERFORD&#134;- explains the intention of tricking the press.]  [\"The Museum of Hoaxes\" author Alex BOESE&#134;- says anyone can manipulate information on the Internet.]  [June 8, Attorney General John ASHCROFT&nbsp- speaks out against hoaxes.]", "segment_duration": 110, "segment_type_id": 2, "segment_start_time": "63230.0", "legacy_segment_id": 761717, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "3rU3AlXdLt", "broadcast_date": "2004-08-07", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1710, "broadcast_description": null, "legacy_broadcast_id": 761715, "segment_id": "kThT9f1m31", "segment_broadcast_id": "3rU3AlXdLt", "segment_title": "Upcoming Items (Studio: Bob Woodruff)", "segment_description": "null", "segment_duration": 30, "segment_type_id": 2, "segment_start_time": "63340.0", "legacy_segment_id": 761718, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "3rU3AlXdLt", "broadcast_date": "2004-08-07", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1710, "broadcast_description": null, "legacy_broadcast_id": 761715, "segment_id": "rP4ddJc4Tl", "segment_broadcast_id": "3rU3AlXdLt", "segment_title": "(Commercial: Prevacid; Lanacane; Glade; Bayer; Sea-Bond; \"This Week.\")", "segment_description": "null", "segment_duration": 170, "segment_type_id": 3, "segment_start_time": "63370.0", "legacy_segment_id": 761719, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "3rU3AlXdLt", "broadcast_date": "2004-08-07", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1710, "broadcast_description": null, "legacy_broadcast_id": 761715, "segment_id": "G0F0EZQbPe", "segment_broadcast_id": "3rU3AlXdLt", "segment_title": "Campaign 2004 / Bush vs. Kerry", "segment_description": "(Studio: Bob Woodruff)  Report introduced.   (La Junta, Colorado: Dan Harris)  The presidential election campaign featured; scenes shown of Senator John Kerry  campaigning in Colorado & of President Bush fishing in Maine.  [KERRY&nbsp- speaks about jobs.]  [In radio address, BUSH&nbsp- says the nation is in danger.]  [Yesterday, BUSH&nbsp- speaks about Iraq & Kerry's position.]  [In response, Kerry adviser Jamie RUBIN&#134;- states Kerry's position on then-Iraqi President Saddam Hussein.]   (Studio: Bob Woodruff)  The standings of the race