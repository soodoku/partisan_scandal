{"data": [{"broadcast_id": "0kOxjYNEXh", "broadcast_date": "2008-09-24", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1730, "broadcast_description": null, "legacy_broadcast_id": 918839, "segment_id": "7zetPBGLg5", "segment_broadcast_id": "0kOxjYNEXh", "segment_title": "Preview/Introduction Brian Williams (Texas)", "segment_description": null, "segment_duration": 60, "segment_type_id": 1, "segment_start_time": "63000.0", "legacy_segment_id": 918839, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "Preview", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "0kOxjYNEXh", "broadcast_date": "2008-09-24", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1730, "broadcast_description": null, "legacy_broadcast_id": 918839, "segment_id": "4JbisxE052", "segment_broadcast_id": "0kOxjYNEXh", "segment_title": "Economy: Financial Crisis / Bailout Plan / Decision 2008", "segment_description": "(Houston: Brian Williams) The economic crisis introduced.  \n\n(Capitol: Tom Costello) The push for agreement on a bailout plan featured; details given of President Bush\u2019s plan to address the nation and Senator John McCain\u2019s suspension of his presidential campaign; scenes shown of several Congressmembers commenting on taxpayer anger. [Representative John BOEHNER\u2020- says Congress has a responsibility to act.] [Treasury Secretary Henry PAULSON \u2013 comments on the issue of executive compensation.] [Federal Reserve Board chairman Ben BERNANKE \u2013 says this is the most significant financial crisis in the post-war period.] Investor Warren Buffett\u2019s investment in Goldman Sachs noted.  \n\n(Houston: Brian Williams) Report introduced.  \n\n(New York: Kelly O\u2019Donnell) McCain\u2019s decision to freeze his political schedule and his call to stop Friday\u2019s debate featured; details given of Senator Barack Obama\u2019s proposal for a joint statement with McCain. [McCAIN \u2013 calls for delaying the debate; says partisan divisions have prevented us from addressing our national challenges.]  \n\n(Houston: Brian Williams) Report introduced.  \n\n(Chicago: Lee Cowan) Obama\u2019s response to McCain\u2019s actions featured. [OBAMA \u2013 reacts to McCain\u2019s postponement plan; says the people need to hear from the person who will be responsible for dealing with this mess; says he can be anywhere any time.]  \n\n(Houston: Brian Williams) Report introduced.  \n\n(New York: Chuck Todd) The day\u2019s events with the bailout plan and McCain\u2019s campaign examined in light of the findings of the latest NBC News/\"Wall Street Journal\" poll.  \n\n(Houston: Brian Williams; CNBC headquarters: Steve Liesman; New York: Maria Bartiromo) The hurry for a deal on the financial crisis and the reaction of the markets discussed. ", "segment_duration": 700, "segment_type_id": 2, "segment_start_time": "63060.0", "legacy_segment_id": 918840, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "0kOxjYNEXh", "broadcast_date": "2008-09-24", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1730, "broadcast_description": null, "legacy_broadcast_id": 918839, "segment_id": "DEtUhN1xGv", "segment_broadcast_id": "0kOxjYNEXh", "segment_title": "Hurricane Ike / Texas", "segment_description": "(Houston: Brian Williams) The situation in Texas in the aftermath of Hurricane Ike reviewed.  \n\n(Galveston: Don Teague) The return of Galveston residents to their homes featured; scenes shown of traffic, ruined homes. [Residents Ethel DICKERT&#135;, Doris ROSE&nbsp- react.] ", "segment_duration": 150, "segment_type_id": 2, "segment_start_time": "63760.0", "legacy_segment_id": 918841, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "0kOxjYNEXh", "broadcast_date": "2008-09-24", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1730, "broadcast_description": null, "legacy_broadcast_id": 918839, "segment_id": "HSD5B8Hmqc", "segment_broadcast_id": "0kOxjYNEXh", "segment_title": "Upcoming Items (Houston: Brian Williams)", "segment_description": " ", "segment_duration": 20, "segment_type_id": 2, "segment_start_time": "63910.0", "legacy_segment_id": 918842, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "0kOxjYNEXh", "broadcast_date": "2008-09-24", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1730, "broadcast_description": null, "legacy_broadcast_id": 918839, "segment_id": "SNjCbYzxrc", "segment_broadcast_id": "0kOxjYNEXh", "segment_title": "(Commercial: Lipitor; NetZero; One-A-Day; Glad.)", "segment_description": " ", "segment_duration": 120, "segment_type_id": 3, "segment_start_time": "63930.0", "legacy_segment_id": 918843, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "0kOxjYNEXh", "broadcast_date": "2008-09-24", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1730, "broadcast_description": null, "legacy_broadcast_id": 918839, "segment_id": "jClnxZYUvb", "segment_broadcast_id": "0kOxjYNEXh", "segment_title": "Hurricane Ike / Texas / White Interview", "segment_description": "(Houston: Brian Williams) Interview held with Houston Mayor Bill White about the recovery after Hurricane Ike; scenes and photos shown. [WHITE \u2013 reviews the impact of the storm surge on the country\u2019s 4th largest city; says we would like some funding and want to be sure the federal government doesn\u2019t forget this community while it\u2019s bailing out Merrill Lynch and others; notes spirits are high despite power outages.] ", "segment_duration": 140, "segment_type_id": 2, "segment_start_time": "64050.0", "legacy_segment_id": 918844, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "0kOxjYNEXh", "broadcast_date": "2008-09-24", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1730, "broadcast_description": null, "legacy_broadcast_id": 918839, "segment_id": "V3iste6rBi", "segment_broadcast_id": "0kOxjYNEXh", "segment_title": "Upcoming Items (Houston: Brian Williams)", "segment_description": " ", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "64190.0", "legacy_segment_id": 918845, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id":