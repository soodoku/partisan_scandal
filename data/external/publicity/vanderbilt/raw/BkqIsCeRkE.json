 and the presidential campaign. [KERRY \u2013 comments on President Bush\u2019s characterization of Iran as part of the \u201caxis of evil\u201d; says Iran & North Korea were greater problems at the time the president started the war in Iraq; proposes a deal for Iran; comments on the Israeli-Palestinian conflict; reacts to NAACP head Julian Bond\u2019s criticism of the Republican Party.] Kerry\u2019s address to the National Urban League in Detroit today and Bush\u2019s appearance there tomorrow noted.", "segment_duration": 200, "segment_type_id": 2, "segment_start_time": "64230.0", "legacy_segment_id": 760546, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "BkqIsCeRkE", "broadcast_date": "2004-07-22", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1710, "broadcast_description": null, "legacy_broadcast_id": 760536, "segment_id": "2fOB4Zj1xO", "segment_broadcast_id": "BkqIsCeRkE", "segment_title": "Stock Market Report  (Studio: Tom Brokaw)", "segment_description": "null", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "64430.0", "legacy_segment_id": 760547, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "BkqIsCeRkE", "broadcast_date": "2004-07-22", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1710, "broadcast_description": null, "legacy_broadcast_id": 760536, "segment_id": "tTPR25rxs2", "segment_broadcast_id": "BkqIsCeRkE", "segment_title": "Cycling / Tour de Fra