{"data": [{"broadcast_id": "QCyN9NeAbo", "broadcast_date": "2004-08-25", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1670, "broadcast_description": null, "legacy_broadcast_id": 763237, "segment_id": "mQE4SPuHhZ", "segment_broadcast_id": "QCyN9NeAbo", "segment_title": "Preview/Introduction Dan Rather (New York)", "segment_description": "null", "segment_duration": 50, "segment_type_id": 1, "segment_start_time": "63000.0", "legacy_segment_id": 763237, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Preview", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "QCyN9NeAbo", "broadcast_date": "2004-08-25", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1670, "broadcast_description": null, "legacy_broadcast_id": 763237, "segment_id": "83qFy9yEJD", "segment_broadcast_id": "QCyN9NeAbo", "segment_title": "Campaign 04 / Bush vs. Kerry / Kerry\u2019s War Record", "segment_description": "(Studio: Dan Rather) Report introduced. \n (Crawford, Texas: John Roberts) The resignation of President Bush\u2019s campaign attorney, Benjamin Ginsberg&#134;, after it was revealed that he consulted with Swift Boat Veterans for Truth, who are running ads attacking Senator John Kerry\u2019s Vietnam service record, featured; details given of outside consulting by Democratic attorneys Bob Bauer&#134; & Joe Sandler&#134;; scenes shown of former Senator Max Cleland & former Kerry crewmate Jim Rassmann attempting to deliver a letter to Bush at his Texas ranch demanding that he condemn the attack ads. [GINSBERG \u2013 says this is the product of the desperation of the Kerry campaign.] [Democracy 21 Fred WERTHEIMER&#134;- says there are issues on the table for both Democratic & Republican lawyers.] [CLELAND \u2013 says we want Bush to put up or shut up.] The Bush campaign\u2019s response to Cleland noted.", "segment_duration": 160, "segment_type_id": 2, "segment_start_time": "63050.0", "legacy_segment_id": 763238, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "QCyN9NeAbo", "broadcast_date": "2004-08-25", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1670, "broadcast_description": null, "legacy_broadcast_id": 763237, "segment_id": "1qfoPHn5X0", "segment_broadcast_id": "QCyN9NeAbo", "segment_title": "Russia / Plane Crashes", "segment_description": "(Studio: Dan Rather) Report introduced. \n (Moscow: Richard Roth) The investigation into the crash of 2 passenger planes that went down almost simultaneously in Russia featured; scenes shown of the wreckage at both crash sites; details given of the possibility of terrorism by rebels from Chechnya; animation shown. [Aviation safety consultant Paul DUFFY&#134;- says it\u2019s hard to think of any other major likelihood.]", "segment_duration": 150, "segment_type_id": 2, "segment_start_time": "63210.0", "legacy_segment_id": 763239, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "QCyN9NeAbo", "broadcast_date": "2004-08-25", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1670, "broadcast_description": null, "legacy_broadcast_id": 763237, "segment_id": "3WRLJNQOoQ", "segment_broadcast_id": "QCyN9NeAbo", "segment_title": "Iraq / Prisoner Abuse Scandal", "segment_description": "(Studio: Dan Rather) Senator John Kerry\u2019s call for Secretary of Defense Donald Rumsfeld to resign because he is ultimately responsible for the prisoner abuse scandal at Abu Ghraib in Iraq, and the findings of an Army report on the abuse noted.", "segment_duration": 40, "segment_type_id": 2, "segment_start_time": "63360.0", "legacy_segment_id": 763240, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "QCyN9NeAbo", "broadcast_date": "2004-08-25", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1670, "broadcast_description": null, "legacy_broadcast_id": 763237, "segment_id": "Mt81FVnJ5n", "segment_broadcast_id": "QCyN9NeAbo", "segment_title": "Iraq / Al-Sadr Revolt / Al-Sistani", "segment_description": "(Studio: Dan Rather) The continuing standoff in Najaf reviewed.   (Baghdad: Barry Petersen) The call for an end to the fighting in Najaf from Shiite leader Grand Ayatollah Ali al-Sistani, who returned to Iraq from medical treatment abroad, featured; scenes shown of peace supporters being shot at as they streamed toward Najaf. [Mideast expert Adel DARWISH&#134;- notes the rarity of al-Sistani taking a political stand; says it shows a sign of maturity that the Americans did not rush into attacking the shrine in Najaf.]", "segment_duration": 140, "segment_type_id": 2, "segment_start_time": "63400.0", "legacy_segment_id": 763241, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "QCyN9NeAbo", "broadcast_date": "2004-08-25", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1670, "broadcast_description": null, "legacy_broadcast_id": 763237, "segment_id": "EJVytPBwQo", "segment_broadcast_id": "QCyN9NeAbo", "segment_title": "Guantanamo Bay, Cuba / Tribunals", "segment_description": "(Studio: Dan Rather) The second day of pre-trial hearings for terror suspects held at Guantanamo Bay, Cuba, noted.   (Guantanamo Bay, Cuba: Mark Strassmann) The hearing for detainee David Hicks, an Australian accused of fighting with the Taliban in Afghanistan, featured; photo shown of Hicks holding a rocket-propelled grenade launcher in Kosovo; courtroom sketches by Art Lien shown; details given of calls for Hicks to be tried in his own country, as in the case of \u201cAmerican Taliban\u201d John Walker Lindh&#134;&#134;; scenes shown of Hicks\u2019 father caging himself in protest of his son\u2019s plight. [Father Terry HICKS&#134;- comments on his son.] [Hicks\u2019 family attorney Stephen KENNY&#134;- asks if Australians are second-class citizens.]", "segment_duration": 120, "segment_type_id": 2, "segment_start_time": "63540.0", "legacy_segment_id": 763242, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "QCyN9NeAbo", "broadcast_date": "2004-08-25", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1670, "broadcast_description": null, "legacy_broadcast_id": 763237, "segment_id": "Nr19ef6btY", "segment_broadcast_id": "QCyN9NeAbo", "segment_title": "Yemen / USS Cole", "segment_description": "(Studio: Dan Rather) New evidence implicating Yemen\u2019s government in the attack on the USS Cole in 2000 reported.", "segment_duration": 30, "segment_type_id": 2, "segment_start_time": "63660.0", "legacy_segment_id": 763243, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "QCyN9NeAbo", "broadcast_date": "2004-08-25", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1670, "broadcast_description": null, "legacy_broadcast_id": 763237, "segment_id": "dOL6s5e88r", "segment_broadcast_id": "QCyN9NeAbo", "segment_title": "Upcoming Items; fallen hero Army Pfc. Diego Rincon&#134<!-- spelling on screen --> profiled. (Studio: Dan Rather)", "segment_description": "null", "segment_duration": 50, "segment_type_id": 2, "segment_start_time": "63690.0", "legacy_segment_id": 763244, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "QCyN9NeAbo", "broadcast_date": "2004-08-25", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1670, "broadcast_description": null, "legacy_broadcast_id": 763237, "segment_id": "01Qu6PU8IZ", "segment_broadcast_id": "QCyN9NeAbo", "segment_title": "(Commercial: Metamucil; L\u2019Oreal; Plavix; Allegra; Viagra; Vioxx.)", "segment_description": "null", "segment_duration": 150, "segment_type_id": 3, "segment_start_time": "63740.0", "legacy_segment_id": 763245, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "QCyN9NeAbo", "broadcast_date": "2004-08-25", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1670, "broadcast_description": null, "legacy_broadcast_id": 763237, "segment_id": "hS1M7ELIQI", "segment_broadcast_id": "QCyN9NeAbo", "segment_title": "Inside Story (Same-Sex Marriage / Cheney)", "segment_description": "(Studio: Dan Rather) Report introduced. \n (White House: Bill Plante) The dispute within the Republican Party on the issue of same-sex marriage examined; details given of Vice President Dick Cheney\u2019s public break with President Bush over a constitutional amendment banning gay marriage. [Yesterday, CHENEY \u2013 speaks of freedom in relationships.] [Family Research Council Tony PERKINS&#134;, Log Cabin Republicans Christopher BARRON&#134;- express views.]", "segment_duration": 140, "segment_type_id": 2, "segment_start_time": "63890.0", "legacy_segment_id": 763246, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "QCyN9NeAbo", "broadcast_date": "2004-08-25", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1670, "broadcast_description": null, "legacy_broadcast_id": 763237, "segment_id": "AtAB1hSEup", "segment_broadcast_id": "QCyN9NeAbo", "segment_title": "Upcoming Items (Studio: Dan Rather)", "segment_description": "null", "segment_duration": 20, "segment_type_id": 2, "segment_start_time": "64030.0", "legacy_segment_id": 763247, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "QCyN9NeAbo", "broadcast_date": "2004-08-25", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1670, "broadcast_description": null, "legacy_broadcast_id": 763237, "segment_id": "YzFSXw7F1Y", "segment_broadcast_id": "QCyN9NeAbo", "segment_title": "(Commercial: Bush\u2019s Beans; Ex-Lax; Pampers; American Egg Board; Cialis; Your Credit Card Companies; Congressman Lincoln Davis.)", "segment_description": "null", "segment_duration": 150, "segment_type_id": 3, "segment_start_time": "64050.0", "legacy_segment_id": 763248, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "QCyN9NeAbo", "broadcast_date": "2004-08-25", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1670, "broadcast_description": null, "legacy_broadcast_id": 763237, "segment_id": "hPdfb7I5ki", "segment_broadcast_id": "QCyN9NeAbo", "segment_title": "Campaign 04 / Republican National Convention / Security", "segment_description": "(Studio: Dan Rather) Report introduced. \n (New York: Bob Orr) Security preparations in New York City for next week\u2019s Republican National Convention featured; details given about worries that Al Qaeda is intent on attacking the US political process and about disruptive demonstrations. [Mayor Michael BLOOMBERG- says we will be safe.] [Secretary of Homeland Security Tom RIDGE \u2013 comments on the Al Qaeda threat.] [New York Civil Liberties Union Donna LIEBERMAN&#134;- notes the importance of police not clamping down on protests.] [Federal Protective Service Ron LIBBY&#134;- comments on the police \u201chelmet cam.\u201d]", "segment_duration": 130, "segment_type_id": 2, "segment_start_time": "64200.0", "legacy_segment_id": 763249, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "QCyN9NeAbo", "broadcast_date": "2004-08-25", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1670, "broadcast_description": null, "legacy_broadcast_id": 763237, "segment_id": "UNYVoDUU4w", "segment_broadcast_id": "QCyN9NeAbo", "segment_title": "Upcoming Items (Studio: Dan Rather)", "segment_description": "null", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "64330.0", "legacy_segment_id": 763250, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "QCyN9NeAbo", "broadcast_date": "2004-08-25", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1670, "broadcast_description": null, "legacy_broadcast_id": 763237, "segment_id": "pq9KQ7UsR4", "segment_broadcast_id": "QCyN9NeAbo", "segment_title": "(Commercial: \"CBS Evening News\"; Kia Sorento; Serenity; Florida orange juice; Phillips\u2019; Singulair; Kia Sorento; NewsChannel 5.)", "segment_description": "null", "segment_duration": 170, "segment_type_id": 3, "segment_start_time": "64340.0", "legacy_segment_id": 763251, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "QCyN9NeAbo", "broadcast_date": "2004-08-25", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1670, "broadcast_description": null, "legacy_broadcast_id": 763237, "segment_id": "RuXyl5pNwK", "segment_broadcast_id": "QCyN9NeAbo", "segment_title": "Summer Vacations / Heading North", "segment_description": "(Studio: Dan Rather) Report introduced. \n (North Pole: Jerry Bowen) The increasing popularity of vacationing at the North Pole featured; scenes shown of tourists arriving by helicopter and on skis. [North Pole adventurer Wave VIDMAR&#134;- describes an encounter with a polar bear.] [North Pole skier Alison LEVINE&#134;- explains why she came.] [North Pole adventurer Carol POST-PFAELZER&#134;- comments.]", "segment_duration": 160, "segment_type_id": 2, "segment_start_time": "64510.0", "legacy_segment_id": 763252, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "QCyN9NeAbo", "broadcast_date": "2004-08-25", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1670, "broadcast_description": null, "legacy_broadcast_id": 763237, "segment_id": "JPKa4ZL5AF", "segment_broadcast_id": "QCyN9NeAbo", "segment_title": "Good Night", "segment_description": "null", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "64670.0", "legacy_segment_id": 763253, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}]}