oadcast_id": "HBOyva83Ur", "segment_title": "Consumer Alert (Mislabeled Fish)", "segment_description": "(Studio: Dan Rather) Report introduced. \n (Madeira Beach, Florida: Cynthia Bowers) A study finding that fresh seafood is often mislabeled featured; statistics cited on mislabeled red snapper; details given of the impact of the practice on the seafood industry. [University of North Carolina researcher Peter MARKO&#134;- says we had no idea we would find so many mislabeled.] [Southern Offshore Fishing Assn. Bob SPAETH&#134;- says it goes on behind closed doors.] [Commercial fishing captain Eric SCHMIDT&#134;- comments on cheaper imports flooding the market.]", "segment_duration": 140, "segment_type_id": 2, "segment_start_time": "64240.0", "legacy_segment_id": 760594, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "HBOyva83Ur", "broadcast_date": "2004-07-23", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 760581, "segment_id": "UnixAK7JSB", "segment_broadcast_id": "HBOyva83Ur", "segment_title": "Upcoming Items (Studio: Dan Rather)", "segment_description": "null", "segment_duration": 20, "segment_type_id": 2, "segment_start_time": "64380.0", "legacy_segment_id": 760595, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "HBOyva83Ur", "broadcast_date": "2004-07-23", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_des