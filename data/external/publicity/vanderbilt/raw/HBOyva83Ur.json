{"data": [{"broadcast_id": "HBOyva83Ur", "broadcast_date": "2004-07-23", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 760581, "segment_id": "PPAby17ZPz", "segment_broadcast_id": "HBOyva83Ur", "segment_title": "Preview/Introduction Dan Rather (New York)", "segment_description": "null", "segment_duration": 50, "segment_type_id": 1, "segment_start_time": "63000.0", "legacy_segment_id": 760581, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Preview", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "HBOyva83Ur", "broadcast_date": "2004-07-23", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 760581, "segment_id": "IFI3A8uaaa", "segment_broadcast_id": "HBOyva83Ur", "segment_title": "National Laboratories Shutdown / Los Alamos National Lab", "segment_description": "(Studio: Dan Rather) Report introduced. \n (Washington: Sharyl Attkisson) The Energy Department\u2019s unprecedented shutdown of classified operations at facilities responsible for weapons design and security research, prompted by security breaches at Los Alamos National Lab, featured; details given of the disappearance of computer disks at Los Alamos; statement from Senator Pete Domenici&#134; quoted. [Federation of American Scientists Ivan OELRICH&#134;- says something clearly is afoot here.]", "segment_duration": 140, "segment_type_id": 2, "segment_start_time": "63050.0", "legacy_segment_id": 760582, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "HBOyva83Ur", "broadcast_date": "2004-07-23", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 760581, "segment_id": "NzO53EB81u", "segment_broadcast_id": "HBOyva83Ur", "segment_title": "September 11 / Commission Report / Recommendations", "segment_description": "(Studio: Dan Rather) President Bush\u2019s appointment of an administration task force to review the recommendations in the report of the panel that investigated the September 11 attacks noted. \n (Washington: Jim Stewart) Pressure on Congress & the president to quickly adopt the 9/11 Commission\u2019s recommendations featured; details given of the political complications for Bush of appointing a national intelligence director, to whom the CIA & FBI would both report, and a national counterterrorism center. [9/11 Commission Timothy ROEMER&#134;- says Al Qaeda is not waiting for the American people to have hearings; states we want accountability.] [Yesterday, Senator John McCAIN \u2013 comments on \u201cremoving somebody\u2019s turf.\u201d] The Commission\u2019s recommendation for Congress to streamline its operation noted.", "segment_duration": 150, "segment_type_id": 2, "segment_start_time": "63190.0", "legacy_segment_id": 760583, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "HBOyva83Ur", "broadcast_date": "2004-07-23", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 760581, "segment_id": "NAQlBUiqff", "segment_broadcast_id": "HBOyva83Ur", "segment_title": "Campaign 04 / Bush vs. Kerry / African Americans", "segment_description": "(Studio: Dan Rather) Report introduced. \n (White House: John Roberts) President Bush\u2019s address to the National Urban League conference in Detroit, where he tried to win black votes, featured; \u201cCBS News\u201d/BET poll findings cited; details given of African American anger over the 2000 election. [BUSH \u2013 asks if the Democratic Party takes African American voters for granted; asks for votes.] [National Urban League participant Peter DANGERFIELD&#134;- says minds have been made up based on what happened since the president has gone into office.] [Black America\u2019s Political Action Committee Alvin WILLIAMS&#134;- comments on the importance of the African American vote for Bush.]", "segment_duration": 140, "segment_type_id": 2, "segment_start_time": "63340.0", "legacy_segment_id": 760584, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "HBOyva83Ur", "broadcast_date": "2004-07-23", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 760581, "segment_id": "ByfH0EHBee", "segment_broadcast_id": "HBOyva83Ur", "segment_title": "Bush / Military Service Records", "segment_description": "(Studio: Dan Rather) The Pentagon\u2019s release of President Bush\u2019s military payroll records that it once said were destroyed reported.", "segment_duration": 30, "segment_type_id": 2, "segment_start_time": "63480.0", "legacy_segment_id": 760585, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "HBOyva83Ur", "broadcast_date": "2004-07-23", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 760581, "segment_id": "i6HV255JTY", "segment_broadcast_id": "HBOyva83Ur", "segment_title": "Campaign 04 / Bush vs. Kerry / Kerry", "segment_description": "(Studio: Dan Rather) Report introduced.   (Denver: Byron Pitts) Senator John Kerry\u2019s campaign trip to Denver, where he was born, featured; details given of Kerry\u2019s attempt to show a softer side. [KERRY \u2013 jokes about being born in the west wing.] [Daughter Vanessa KERRY&#134;- describes her dad as loving & compassionate.]   (Studio: Dan Rather) Coverage of the Democratic National Convention noted.", "segment_duration": 140, "segment_type_id": 2, "segment_start_time": "63510.0", "legacy_segment_id": 760586, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "HBOyva83Ur", "broadcast_date": "2004-07-23", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 760581, "segment_id": "iDRHXYSNLX", "segment_broadcast_id": "HBOyva83Ur", "segment_title": "Iraq / Attacks", "segment_description": "(Studio: Dan Rather) The deaths of 2 more US soldiers in a roadside bombing in Iraq; the kidnapping of an Egyptian diplomat, and a US air strike against suspected militants west of Baghdad reported.", "segment_duration": 20, "segment_type_id": 2, "segment_start_time": "63650.0", "legacy_segment_id": 760587, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "HBOyva83Ur", "broadcast_date": "2004-07-23", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 760581, "segment_id": "9haFfI4Kwn", "segment_broadcast_id": "HBOyva83Ur", "segment_title": "Upcoming Items; fallen soldier Army CW1 Erik Kesterson&#134<!-- spelling on screen --> profiled. (Studio: Dan Rather)", "segment_description": "null", "segment_duration": 50, "segment_type_id": 2, "segment_start_time": "63670.0", "legacy_segment_id": 760588, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "HBOyva83Ur", "broadcast_date": "2004-07-23", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 760581, "segment_id": "JSTwUa1Oby", "segment_broadcast_id": "HBOyva83Ur", "segment_title": "(Commercial: AFLAC; Hidden Valley Ranch; Florida orange juice; Bayer; Prilosec; Ambien; Thompson\u2019s Water Seal.)", "segment_description": "null", "segment_duration": 160, "segment_type_id": 3, "segment_start_time": "63720.0", "legacy_segment_id": 760589, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "HBOyva83Ur", "broadcast_date": "2004-07-23", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 760581, "segment_id": "8vwEsJsgTj", "segment_broadcast_id": "HBOyva83Ur", "segment_title": "Inside Story (Bryant Rape Case)", "segment_description": "(Studio: Dan Rather) Report introduced. \n (Los Angeles: Bill Whitaker) Judge Terry Ruckriegle&#134;\u2019s ruling that Kobe Bryant\u2019s defense team can present evidence about the sexual activities of his accuser around the time of her encounter with Bryant featured; details given about the case for the defense; courtroom scenes & sketches by Pat Lopez shown. [Former federal prosecutor Laurie LEVENSON&#134;- notes the significance for the prosecution of the ruling.] [Criminal defense attorney Larry POZNER&#134;- says this case is upside down & sinking.] [Accuser\u2019s former friend Laie WEATHERWAX&#134;- describes the accuser\u2019s attempts to get attention from a former boyfriend.]", "segment_duration": 170, "segment_type_id": 2, "segment_start_time": "63880.0", "legacy_segment_id": 760590, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "HBOyva83Ur", "broadcast_date": "2004-07-23", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1690, "broadcast_description": null, "legacy_broadcast_id": 760581, "segment_id": "2jE6PyzeK6", "segment_broadcast_id": "HBOyva83Ur", "segment_title": "Upcoming Items (Studio: Dan Rather)", "segment_description": "null", "segment_duration": 20, "segment_type_id": 2, "segment_start_time": "64050.0", "legacy_segment_id": 760591, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "b