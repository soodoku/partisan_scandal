{"data": [{"broadcast_id": "DX7nS7Tm37", "broadcast_date": "2008-10-16", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 921645, "segment_id": "ZqDxsouqCj", "segment_broadcast_id": "DX7nS7Tm37", "segment_title": "Preview/Introduction Brian Williams (New York)", "segment_description": null, "segment_duration": 50, "segment_type_id": 1, "segment_start_time": "63000.0", "legacy_segment_id": 921645, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "Preview", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "DX7nS7Tm37", "broadcast_date": "2008-10-16", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 921645, "segment_id": "WOr7yzK5jp", "segment_broadcast_id": "DX7nS7Tm37", "segment_title": "Decision 2008 / Obama vs. McCain / Final Stretch / Joe, the Plumber", "segment_description": "(Studio: Brian Williams) Last night\u2019s presidential debate between Senators Barack Obama and John McCain briefly reviewed.  \n\n(Studio: Andrea Mitchell) The final stretch in the campaign featured; details given about the emergence of Joe, the Plumber {Joe Wurzelbacher&#134;&#134;} to represent angry taxpayers; scenes shown of McCain repeatedly mentioning Joe during the debate and the candidates asserting their positions on abortion. [In New Hampshire, OBAMA \u2013 recalls his loss in the New Hampshire primary.] [McCAIN \u2013 says the real winner last night was Joe, the Plumber.] [In debate, McCAIN \u2013 says he is not President Bush.] [In debate, OBAMA \u2013 tells McCain he has been a supporter of Bush.]  \n\n(Studio: Brian Williams) Report introduced.  \n\n(Holland, Ohio: Kevin Tibbles) Wurzelbacher profiled; scenes shown of him questioning Obama on taxes; details given of his tax problems in Ohio. [WURZELBACHER \u2013 says they were using me to make a point; says he would be receiving Obama\u2019s tax cuts.] [On the phone with CBS\u2019s Katie Couric, voice of WURZELBACHER \u2013 says he got a tap dance when he questioned Obama.] [Political analyst Sherry Bebitch JEFFE&#134;- says McCain bringing Joe into the debate wasn\u2019t smart.] [Political analyst Jonathan WILCOX&#134;- says the question is a lot more important.] ", "segment_duration": 320, "segment_type_id": 2, "segment_start_time": "63050.0", "legacy_segment_id": 921646, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "DX7nS7Tm37", "broadcast_date": "2008-10-16", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 921645, "segment_id": "R62N060dxt", "segment_broadcast_id": "DX7nS7Tm37", "segment_title": "Making Your Vote Count (Ohio Voter Fraud Case)", "segment_description": "(Studio: Brian Williams) Report introduced.   (Washington: Pete Williams) The Republican Party\u2019s lawsuit against Ohio over the Help America Vote Act and possible voter fraud featured; details given of the impact of the case on the upcoming presidential election. ", "segment_duration": 90, "segment_type_id": 2, "segment_start_time": "63370.0", "legacy_segment_id": 921647, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "DX7nS7