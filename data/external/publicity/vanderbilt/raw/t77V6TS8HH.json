{"data": [{"broadcast_id": "t77V6TS8HH", "broadcast_date": "2004-09-06", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 764495, "segment_id": "jpEwEZMEoe", "segment_broadcast_id": "t77V6TS8HH", "segment_title": "Preview/Introduction Brian Williams (New York)", "segment_description": "null", "segment_duration": 50, "segment_type_id": 1, "segment_start_time": "63000.0", "legacy_segment_id": 764495, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "Preview", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "t77V6TS8HH", "broadcast_date": "2004-09-06", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 764495, "segment_id": "3TXjZIRDh7", "segment_broadcast_id": "t77V6TS8HH", "segment_title": "Hurricane Frances / Florida", "segment_description": "(Studio: Brian Williams) Map shown of the location of Hurricane Frances, which is now a tropical storm; statistics on deaths & damages cited. \n (Tallahassee, Florida: Jim Cummins) The second landfall of Frances in the Florida panhandle featured; scenes shown of wind & rain damage, including downed power lines. [Residents Charlie GREENWELL&#135;, Elkin AUSTIN&#135;, Daytona Beach evacuee Elizabeth O\u2019NEAL&#135;- react.] \n (Studio: Brian Williams) Report introduced. \n (Satellite Beach, Florida: Robert Hager) The aftermath of Frances featured; scenes shown of damage, floods & people lined up for supplies. [Victim Sandy CIMPARRI&#135;- reacts to the destruction of her home.] Damage at Cape Canaveral noted.", "segment_duration": 260, "segment_type_id": 2, "segment_start_time": "63050.0", "legacy_segment_id": 764496, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "t77V6TS8HH", "broadcast_date": "2004-09-06", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 764495, "segment_id": "DkwM7bKMn5", "segment_broadcast_id": "t77V6TS8HH", "segment_title": "Clinton / Health", "segment_description": "(Studio: Brian Williams) Reports introduced. \n (New York: Robert Bazell) Former President Bill Clinton\u2019s successful heart bypass surgery reviewed; animation shown of the procedure. [Surgeon Dr. Craig SMITH&#134;- says there was nothing outside the realm of the routine.] [Cardiologist Dr. Allan SCHWARTZ&#134;- says there is a likelihood that he would have had a substantial heart attack.]", "segment_duration": 120, "segment_type_id": 2, "segment_start_time": "63310.0", "legacy_segment_id": 764497, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "t77V6TS8HH", "broadcast_date": "2004-09-06", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 764495, "segment_id": "le8TS28SZo", "segment_broadcast_id": "t77V6TS8HH", "segment_title": "Iraq / Attacks / Fallujah", "segment_description": "(Studio: Brian Williams) Report introduced.   (Baghdad: Richard Engel) The violent day in Iraq reviewed; details given about the continuing problems in Fallujah and the announcement of the capture of insurgent leader Izzat Ibrahim al-Douri&#134;&#134;, later proved to be another man; scenes shown from the site of a suicide bombing that killed 7 US Marines near Fallujah; US Marine Corps statement quoted.", "segment_duration": 100, "segment_type_id": 2, "segment_start_time": "63430.0", "legacy_segment_id": 764498, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "t77V6TS8HH", "broadcast_date": "2004-09-06", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 764495, "segment_id": "f094Hcj8jj", "segment_broadcast_id": "t77V6TS8HH", "segment_title": "Middle East / Israelis vs. Palestinians / Violence", "segment_description": "(Studio: Brian Williams) A series of explosions in Gaza, killing many Palestinians, reported; scenes shown from Gaza City.", "segment_duration": 20, "segment_type_id": 2, "segment_start_time": "63530.0", "legacy_segment_id": 764499, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "t77V6TS8HH", "broadcast_date": "2004-09-06", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 764495, "segment_id": "KOo4T5ynZc", "segment_broadcast_id": "t77V6TS8HH", "segment_title": "Russia / School Standoff / Aftermath", "segment_description": "(Studio: Brian Williams) Report introduced.   (Beslan, Russia: Jim Maceda) The aftermath of the school invasion in Beslan, Russia, where hundreds of hostages were killed by rebels from Chechnya, featured; scenes shown of funeral processions, grieving families, hospitalized victims & the burned-out building; details given of Russian President Vladimir Putin\u2019s response and about the planning behind the attack. [Russian affairs analyst Martin McCAULEY&#134;- says Russian troops didn\u2019t have a contingency plan; predicts there will be other outrages.]", "segment_duration": 130, "segment_type_id": 2, "segment_start_time": "63550.0", "legacy_segment_id": 764500, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "t77V6TS8HH", "broadcast_date": "2004-09-06", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 764495, "segment_id": "tmm3nivRcb", "segment_broadcast_id": "t77V6TS8HH", "segment_title": "Upcoming Items (Studio: Brian Williams)", "segment_description": "null", "segment_duration": 30, "segment_type_id": 2, "segment_start_time": "63680.0", "legacy_segment_id": 764501, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "t77V6TS8HH", "broadcast_date": "2004-09-06", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 764495, "segment_id": "2za2JvafYw", "segment_broadcast_id": "t77V6TS8HH", "segment_title": "(Commercial: Procrit; Gas-X; Levitra; Hyundai Sonata; Beneful; \"Dateline.\")", "segment_description": "null", "segment_duration": 130, "segment_type_id": 3, "segment_start_time": "63710.0", "legacy_segment_id": 764502, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "t77V6TS8HH", "broadcast_date": "2004-09-06", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 764495, "segment_id": "cS30Vs9X9v", "segment_broadcast_id": "t77V6TS8HH", "segment_title": "In Depth (12 Ways to Make America Safer) Part I", "segment_description": "(Studio: Brian Williams) Special week-long series on steps that government, individuals & business can take to make a terrorist attack less likely introduced. \n (Washington: Pete Williams) Calls for more control over sales of the widely-used fertilizer ammonium nitrate, also a common explosive that was used in the Oklahoma City bombing, featured; examples cited of terrorist uses of the substance; details given of state restrictions. [Senator Charles SCHUMER&#134;- says you can be on a terrorist watch list and buy as much ammonium nitrate as you want.] [Fertilizer industry spokeswoman Kathy MATHERS&#134;- says we recognize that the security landscape has changed.] [Specialty Fertilizer CEO Larry SANDERS&#134;- describes progress toward preventing ammonium nitrate from working as an explosive.]", "segment_duration": 160, "segment_type_id": 2, "segment_start_time": "63840.0", "legacy_segment_id": 764503, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "t77V6TS8HH", "broadcast_date": "2