{"data": [{"broadcast_id": "jkcxwDB6g4", "broadcast_date": "2004-09-01", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 764275, "segment_id": "cOTlL7yn5F", "segment_broadcast_id": "jkcxwDB6g4", "segment_title": "Preview/Introduction Peter Jennings (Republican National Convention)", "segment_description": "null", "segment_duration": 90, "segment_type_id": 1, "segment_start_time": "63000.0", "legacy_segment_id": 764275, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "Preview", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "jkcxwDB6g4", "broadcast_date": "2004-09-01", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 764275, "segment_id": "vl46ECobH5", "segment_broadcast_id": "jkcxwDB6g4", "segment_title": "Hurricane Frances / Florida", "segment_description": "(Convention floor: Peter Jennings)  Report introduced. \n (Miami: Jeffrey Kofman)  The scramble in Florida to prepare for Hurricane Frances featured; various readiness scenes & damages from Hurricane Charley shown.  [Governor Jeb BUSH&nbsp- comments on the storm.]  [National Hurricane Center director Max MAYFIELD&#134;- comments on forecasting.]", "segment_duration": 100, "segment_type_id": 2, "segment_start_time": "63090.0", "legacy_segment_id": 764276, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "jkcxwDB6g4", "broadcast_date": "2004-09-01", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 764275, "segment_id": "vexQcuCeYi", "segment_broadcast_id": "jkcxwDB6g4", "segment_title": "Colorado / Bryant Rape Trial", "segment_description": "(Convention floor: Peter Jennings)  Report introduced. \n (Eagle, Colorado: Bill Redeker)  The prosecution's request to Judge Terry Ruckriegle that the rape case against basketball player Kobe Bryant be dismissed because the victim is no longer willing to testify examined; scenes shown of the Eagle, Colorado, hotel where the incident took place; details given of earlier court rulings.  [Legal analyst Lisa WAYNE&#134;- comments on the victim's crucial role & the prosecution's screwups.]", "segment_duration": 110, "segment_type_id": 2, "segment_start_time": "63190.0", "legacy_segment_id": 764277, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "jkcxwDB6g4", "broadcast_date": "2004-09-01", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 764275, "segment_id": "tb0SFgNeZW", "segment_broadcast_id": "jkcxwDB6g4", "segment_title": "Russia / School Standoff / Chechnya", "segment_description": "(Convention floor: Peter Jennings)  Report introduced. \n (Moscow: Jim Sciutto)  The siege at a school in the North Ossetia region of Russia after armed attackers from Chechnya took over featured; scenes shown from outside the Beslan school, of the recently downed airplanes & of yesterday's suicide bombing in Moscow.  [Carnegie Endowment for Peace Lilia SHEVTSOVA\u2020- says people don't trust Russian law enforcement.]", "segment_duration": 140, "segment_type_id": 2, "segment_start_time": "63300.0", "legacy_segment_id": 764278, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "jkcxwDB6g4", "broadcast_date": "2004-09-01", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 764275, "segment_id": "yAQUs6fmG5", "segment_broadcast_id": "jkcxwDB6g4", "segment_title": "Russia / Air Security", "segment_description": "(Convention floor: Peter Jennings)  President Bush's order for security on direct flights to the US from Russia after two planes were downed by explosives carried on board reported.", "segment_duration": 20, "segment_type_id": 2, "segment_start_time": "63440.0", "legacy_segment_id": 764279, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "jkcxwDB6g4", "broadcast_date": "2004-09-01", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 764275, "segment_id": "ez0ODQ6Q5K", "segment_broadcast_id": "jkcxwDB6g4", "segment_title": "Upcoming Items (Convention floor: Peter Jennings)", "segment_description": "null", "segment_duration": 30, "segment_type_id": 2, "segment_start_time": "63460.0", "legacy_segment_id": 764280, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "jkcxwDB6g4", "broadcast_date": "2004-09-01", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 764275, "segment_id": "KePsL7pX5e", "segment_broadcast_id": "jkcxwDB6g4", "segment_title": "(Commercial: Pfizer's Viagra; Glucerna; Tylenol; Benefiber; Transitions; Phillips'.)", "segment_description": "null", "segment_duration": 150, "segment_type_id": 3, "segment_start_time": "63490.0", "legacy_segment_id": 764281, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "jkcxwDB6g4", "broadcast_date": "2004-09-01", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 764275, "segment_id": "P2DNW5NSRS", "segment_broadcast_id": "jkcxwDB6g4", "segment_title": "Campaign 2004 / Bush vs. Kerry / Republican Convention / Kerry on Iraq / Cheney Interview", "segment_description": "(Convention floor: Peter Jennings)  President Bush's campaigning in Ohio & the unruly anti-Bush demonstration at the Republican National Convention in New York City today shown. \n (Nashville: Dan Harris)  Senator John Kerry's speech critiquing Bush's Iraq policy featured; scenes shown from Nashville.  [At the American Legion convention, KERRY&nbsp- says terrorists have secured havens in Iraq; states he would never have gone to war without a plan for peace & he would have done \"almost everything differently.\"]  Republican TV ad shown.  [BUSH&nbsp- questions Kerry's approach.] \n (Convention floor: Peter Jennings)  Report introduced. \n (Convention floor & Wyoming: Claire Shipman)  Vice President Dick Cheney's speech tonight to promote the president previewed; excerpts from his speech on Kerry & Bush quoted.  [In Wyoming interview, CHENEY&nbsp- says we have to be tough & aggressive against terrorists; states the greatest threat is a terrorist weapons attack on an American city.]  How Cheney remains a polarizing figure among moderate Republicans noted.", "segment_duration": 360, "segment_type_id": 2, "segment_start_time": "63640.0", "legacy_segment_id": 764282, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "jkcxwDB6g4", "broadcast_date": "2004-09-01", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 764275, "segment_id": "B2VLdZkscc", "segment_broadcast_id": "jkcxwDB6g4", "segment_title": "Upcoming Items (Convention floor: Peter Jennings)", "segment_description": "null", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "64000.0", "legacy_segment_id": 764283, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "jkcxwDB6g4", "broadcast_date": "2004-09-01", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 764275, "segment_id": "3qo1EU82uX", "segment_broadcast_id": "jkcxwDB6g4", "segment_title": "(Commercial: Prilosec; Ex-Lax; Alavert; Centrum; Celebrex; Florida orange juice.)", "segment_description": "null", "segment_duration": 150, "segment_type_id": 3, "segment_start_time": "64010.0", "legacy_segment_id": 764284, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "jkcxwDB6g4", "broadcast_date": "2004-09-01", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 764275, "segment_id": "hXU3Ji1te8", "segment_broadcast_id": "jkcxwDB6g4", "segment_title": "Campaign 2004 / Republican Convention / Miller", "segment_description": "(Convention floor: Peter Jennings)  Georgia Democratic Senator Zell Miller, who is the keynote speaker tonight at the Republican National Convention & 12 years ago at the Democratic National Convention, featured.  [Yesterday, MILLER&nbsp- says he wants to tell the people why a lifelong conservative Democrat is supporting President Bush for re-election so he can take this fight to the terrorists; explains why he will stay a Democrat; comments on how \"they\" view the rural South.]", "segment_duration": 180, "segment_type_id": 2, "segment_start_time": "64160.0", "legacy_segment_id": 764285, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "jkcxwDB6g4", "broadcast_date": "2004-09-01", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 764275, "segment_id": "yB09b4g6pd", "segment_broadcast_id": "jkcxwDB6g4", "segment_title": "Upcoming Items (Convention floor: Peter Jennings)", "segment_description": "null", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "64340.0", "legacy_segment_id": 764286, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "jkcxwDB6g4", "broadcast_date": "2004-09-01", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 764275, "segment_id": "45ZJbvS745", "segment_broadcast_id": "jkcxwDB6g4", "segment_title": "(Commercial: Quaker Oatmeal; Cialis; Capital One; Benadryl; 1-800-Medicare; Preparation H; \"Lost.\")", "segment_description": "null", "segment_duration": 170, "segment_type_id": 3, "segment_start_time": "64350.0", "legacy_segment_id": 764287, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "jkcxwDB6g4", "broadcast_date": "2004-09-01", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 764275, "segment_id": "eHyQXkZwnH", "segment_broadcast_id": "jkcxwDB6g4", "segment_title": "The Money Trail (Convention Campaign Finances) Part III", "segment_description": "(Convention floor: Peter Jennings)  Report introduced. \n (New York: Brian Ross)  Politics & money at the Republican National Convention featured; details given about the \"war lobby,\" which represents companies seeking to profit from the war on terrorism & the war in Iraq; scenes shown from a party thrown by Blank Rome.  [LOBBYIST&nbsp- says it's good for America.]  [ANALYST&nbsp- talks about their insider access.]  [HHS Secretary Tommy THOMPSON&nbsp- comments on attending the party.]  The role of the president's brother, Neil Bush, in a Houston-based company called Crest Investments, a financial partner with former Bush officials who help companies get contracts in Iraq, outlined; videotaped deposition of Neil Bush stating his role with Crest shown.  [World Policy Inst. William HARTNUNG&#134;- comments on the benefits of having the president's brother involved.]", "segment_duration": 180, "segment_type_id": 2, "segment_start_time": "64520.0", "legacy_segment_id": 764288, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "jkcxwDB6g4", "broadcast_date": "2004-09-01", "broadcast_start_time": "63000.0", "network": 1, "distributor": 8, "broadcast_title": "World News Tonight", "broadcast_type_id": 1, "broadcast_duration": 1700, "broadcast_description": null, "legacy_broadcast_id": 764275, "segment_id": "SD0U3mIOdf", "segment_broadcast_id": "jkcxwDB6g4", "segment_title": "Good Night", "segment_description": "null", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "64700.0", "legacy_segment_id": 764289, "network_name": "ABC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}]}