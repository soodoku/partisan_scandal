{"data": [{"broadcast_id": "N0OTgZe9qp", "broadcast_date": "2004-08-11", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 761992, "segment_id": "75OphJpv2z", "segment_broadcast_id": "N0OTgZe9qp", "segment_title": "Preview/Introduction Scott Pelley (New York)", "segment_description": "NOTE: Local weather bulletin on screen from 5:52:10 to end.", "segment_duration": 40, "segment_type_id": 1, "segment_start_time": "63000.0", "legacy_segment_id": 761992, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Preview", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "N0OTgZe9qp", "broadcast_date": "2004-08-11", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 761992, "segment_id": "sny41ZZ0xt", "segment_broadcast_id": "N0OTgZe9qp", "segment_title": "Weather / Florida / Bonnie & Charley", "segment_description": "(Studio: Scott Pelley) Map shown of the track of Tropical Storm Bonnie headed toward Florida\u2019s panhandle and of Hurricane Charley, which is moving toward the Florida Keys. \n (Panama City, Florida: Jim Acosta) The unusual occurrence of two storms headed to the same state at the same time featured; satellite photos, animated maps & animation of the possible storm surge shown. [National Hurricane Center director Max MAYFIELD&#134;- comments on the double threat.] [Tourists Michael MENARD&#134;, Ms. GRISLER&#135;- react.]", "segment_duration": 140, "segment_type_id": 2, "segment_start_time": "63040.0", "legacy_segment_id": 761993, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "N0OTgZe9qp", "broadcast_date": "2004-08-11", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 761992, "segment_id": "c3scM5f1ZS", "segment_broadcast_id": "N0OTgZe9qp", "segment_title": "Iraq / Violence", "segment_description": "(Studio: Scott Pelley) The continuing violence in Iraq noted; scenes shown of a rally in Najaf of supporters of radical Shiite cleric Muqtada al-Sadr, of American tanks patrolling Baghdad\u2019s Sadr City, and of a house in Fallujah destroyed in a US air strike. \n (Pentagon: David Martin) The reluctance of US commanders to use their full firepower in Iraq due to the concern of creating more anti-US feelings featured; details given of efforts aimed at preparing Iraqi forces to put down the insurgency and of delays in reconstruction caused by the ongoing security problems; State Department security report on daily attacks outlined.", "segment_duration": 160, "segment_type_id": 2, "segment_start_time": "63180.0", "legacy_segment_id": 761994, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "N0OTgZe9qp", "broadcast_date": "2004-08-11", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 761992, "segment_id": "rZTdWeIdCn", "segment_broadcast_id": "N0OTgZe9qp", "segment_title": "Afghanistan / Rumsfeld Visit / Election", "segment_description": "(Studio: Scott Pelley) Report introduced. \n (Kabul: 