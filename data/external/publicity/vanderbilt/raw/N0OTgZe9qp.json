, "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "N0OTgZe9qp", "broadcast_date": "2004-08-11", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 761992, "segment_id": "igOiMKp7jA", "segment_broadcast_id": "N0OTgZe9qp", "segment_title": "Eye on America (Asian Carp)", "segment_description": "(Studio: Scott Pelley) Report introduced.   (Lake City, Minnesota: Bob McNamara) Minnesota\u2019s efforts to thwart the invasion of Asian carp, which are a threat to native fish, featured; scenes shown of the fish jumping out of the water at the sound of motor noise; map shown of how the carp have migrated up the Mississippi River from Louisiana to Minnesota; details given about the movement to install a wall of bubbles in the river to scare the carp away. [Fisherman Tim ADAMS\u2020- comments.] [Minnesota Department of Natural Resources John HOXMEIER\u2020, Jay RENDALL\u2020- note on the urgency of preventing the spread of the fish.]   (NOTE: Local weather bulletin on screen.)", "segment_duration": 160, "segment_type_id": 2, "segment_start_time": "64180.0", "legacy_segment_id": 762006, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "N0OTgZe9qp", "broadcast_date": "2004-08-11", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 761992, "segment_id": "k48i8QOT25", "segment_broadcast_id": "N0OTgZe9qp", "segment_title": "Upcoming Items (Studio: Scott Pelley)", "segment_description": "null", "segment_duration": 10, "segment_type_id": 2, "segment_start_time": "64340.0", "legacy_segment_id": 762007, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "N0OTgZe9qp", "broadcast_date": "2004-08-11", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 761992, "segment_id": "iMYpwwwns0", "segment_broadcast_id": "N0OTgZe9qp", "segment_title": "(Commercial: Kia Spectra; Celebrex; Pepcid; Excellence; Cialis; Kia Spectra; NewsChannel 5.)", "segment_description": "null", "segment_duration": 160, "segment_type_id": 3, "segment_start_time": "64350.0", "legacy_segment_id": 762008, "network_name": "CBS", "broadcast_type_name": "Evening News", "segment_type_name": "Commercial", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "N0OTgZe9qp", "broadcast_date": "2004-08-11", "broadcast_start_time": "63000.0", "network": 2, "distributor": 9, "broadcast_title": "CBS Evening News", "broadcast_type_id": 1, "broadcast_duration": 1660, "broadcast_description": null, "legacy_broadcast_id": 761992, "segment_id": "NksWJJasTp", "segment_broadcast_id": "N0OTgZe9qp", "segment_title": "New York, New York / Wallace Arrest", "segment_description": "(Studio: Scott Pelley) The arrest in New York City of \u201c60 Minutes\u201d reporter Mike Wallace for disorderly conduct after an incident involving his driver outside a restaurant featured; excerpts from \u201c60 Minutes\u201d shown. [WALLACE \u2013 explains his story; states he doesn\u2019t want to go to jail.] [Luke\u2019s Bar owner Luigi MILITELLO\u2020- describes wha