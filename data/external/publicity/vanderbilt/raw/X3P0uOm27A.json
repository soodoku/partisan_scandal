rease in cases of high blood pressure due to an increase in obesity reported.", "segment_duration": 30, "segment_type_id": 2, "segment_start_time": "64240.0", "legacy_segment_id": 763140, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "X3P0uOm27A", "broadcast_date": "2004-08-23", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 763130, "segment_id": "yNXA92G6zG", "segment_broadcast_id": "X3P0uOm27A", "segment_title": "Hurricane Charley / Florida / Aftermath", "segment_description": "(Studio: Tom Brokaw) The reopening of schools in some Florida counties that were hit by Hurricane Charley reported; scenes shown from Poinciana.", "segment_duration": 20, "segment_type_id": 2, "segment_start_time": "64270.0", "legacy_segment_id": 763141, "network_name": "NBC", "broadcast_type_name": "Evening News", "segment_type_name": "News", "segment_contributors_with_roles": null, "broadcast_contributors_with_roles": null, "topic_names": null, "location_names": null}, {"broadcast_id": "X3P0uOm27A", "broadcast_date": "2004-08-23", "broadcast_start_time": "63000.0", "network": 3, "distributor": 10, "broadcast_title": "NBC Nightly News", "broadcast_type_id": 1, "broadcast_duration": 1720, "broadcast_description": null, "legacy_broadcast_id": 763130, "segment_id": "A0KkLgZlf0", "segment_broadcast_id": "X3P0uOm27A", "segment_title": "Norway / \"The Scream\" Heist", "segment_description": "(Studio: Tom Brokaw) The status of the investigation into the theft of Edvard Munch\u2019s \u201cThe Scream\u201d and another painting from a Norway museum updated.", "segment_duration": 20, "segment_type_id": 2, "segment_start_time": "64290.0", "legacy_seg